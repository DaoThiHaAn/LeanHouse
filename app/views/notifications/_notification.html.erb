<%= tag.div id: dom_id(notification),
            class: "detail-noti card border shadow-sm rounded-3 #{'unread' unless notification.read?}" do %>
  <div class="card-body p-3">
    <div class="d-flex justify-content-between align-items-start gap-2">
      <div class="d-flex align-items-center gap-2">
        <% unless notification.read? %>
          <span class="badge bg-primary rounded-circle p-1" title="<%= t('noti.unread') %>"></span>
        <% end %>
        <h2 class="h6 fw-bold mb-0 text-dark">
          <%= notification.title %>
        </h2>
      </div>
      <span class="text-muted small text-nowrap fst-italic">
        <%= time_ago_in_words(notification.created_at) + " " + t("ago").downcase %>
      </span>
    </div>

    <div class="notification-full-message text-secondary mb-3">
      <%= notification.message %>
    </div>

    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
      <div class="d-flex gap-2">
        <% if notification.respond_to?(:url) && notification.url.present? %>
          <%= link_to t("view_detail"), notification.url, class: "btn btn-sm btn-outline-primary" %>
        <% end %>
      </div>

      <div>
        <% unless notification.read? %>
          <%= button_to mark_as_read_notification_path(notification),
                method: :patch,
                class: "btn btn-sm btn-link text-muted text-decoration-none d-flex align-items-center gap-1 p-0",
                title: t("noti.mark_as_read") do %>
            <span class="material-symbols-outlined fs-6">done</span>
            <span class="small"><%= t("noti.mark_as_read") %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
