<div class="overflow-x-auto collapse navbar-collapse" id="navbarSupportedContent">
    <ul class="navbar-nav d-flex align-items-md-center">
    <%if !logged_in?%>
        <%= nav_item t("bar.home"), "Home", path: root_path, icon: "home" %>
        <%= nav_item t("bar.find_rooms"), "Finding Rooms", path: posts_path, icon: "search" %>
        <%= nav_item t("bar.features"), "Features", path: root_path(anchor: "features")%>
        <%= nav_item t("bar.about"), "About", path: root_path(anchor: "about-us") %>
        <%= nav_item t("bar.contact"), "Contact", path: root_path(anchor: "contact") %>

    <%elsif current_user.landlord?%>
        <%= nav_item t("bar.dashboard"), "Dashboard", path: landlord_dashboard_path, icon: "insert_chart" %>
        <%= nav_item t("bar.house_mng"), "House Management", word: "house", path: landlord_houses_path, is_img: true, img_src: "house-mg.png", img_active_src: "house-mg-white.png" %>
        <%= nav_item t("bar.post_mng"), "Post", path: landlord_posts_path()%>
        <%= nav_item t("bar.request_handle"), "Requests", path: landlord_requests_path %>

    <%elsif current_user.tenant?%>
        <%= nav_item t("bar.dashboard"), "Dashboard", path: tenant_dashboard_path, icon: "insert_chart" %>
        <%= nav_item t("bar.my_room"), "My Room", path: tenant_room_path, icon: "location_home" %>
        <%= nav_item t("bar.my_contract"), "My Contract", path: tenant_contract_path%>
        <%= nav_item t("bar.applied_services"), "Services", path: tenant_services_path%>
        <%= nav_item t("bar.my_invoices"), "My Invoices", path: tenant_invoices_path %>
        <%= nav_item t("bar.my_requests"), "My Requests", path: tenant_requests_path %>
        <%= nav_item t("bar.find_rooms"), "Finding Rooms", path: posts_path, icon: "search" %>
    <%end%>
    </ul>
</div>
