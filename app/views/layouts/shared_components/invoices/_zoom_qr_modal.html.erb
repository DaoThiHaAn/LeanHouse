<%
  inv = local_assigns[:invoice] || @invoice
  bank_acc = local_assigns[:bank_account] || @bank_account
  qr = local_assigns[:qr_url] || inv.vietqr_url(bank_acc)
%>

<!-- Modal Phóng to Mã QR VietQR -->
<% if bank_acc && qr %>
  <div class="modal fade" id="zoomQrModal" tabindex="-1" aria-labelledby="zoomQrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-vietqr-dialog">
      <div class="modal-content rounded-4 shadow border-0">
        <div class="modal-header border-bottom bg-light">
          <h2 class="modal-title d-flex align-items-center gap-1" id="zoomQrModalLabel">
            <span class="material-symbols-outlined fs-3">qr_code_2</span>
            <%= t('invoice.vietqr.title') %>
          </h2>
          <% if inv.payos_configured?(bank_acc) %>
            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 small ms-auto me-2 d-inline-flex align-items-center gap-1">
              <span class="material-symbols-outlined fs-6">qr_code_2</span>
              <span><%= t('invoice.payos.static_qr_badge') %></span>
            </span>
          <% end %>
          <button type="button" class="btn-close <%= 'ms-0' if inv.payos_configured?(bank_acc) %>" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body text-center p-4">
          <div class="p-2 border rounded-3 bg-white shadow-sm d-inline-block mb-3">
            <img src="<%= qr %>" alt="<%= t('invoice.vietqr.qr_zoomed_alt') %>" class="rounded vietqr-modal-img">
          </div>

          <% if inv.payos_configured?(bank_acc) && !inv.paid? %>
            <div class="alert alert-info border border-info-subtle bg-info-subtle text-dark p-3 rounded-3 text-start small mb-3">
              <div class="d-flex align-items-start gap-2 <%= 'mb-2' if inv.payos_checkout_url.present? %>">
                <span class="material-symbols-outlined text-info-emphasis fs-5 flex-shrink-0 mt-0.5">info</span>
                <div class="text-secondary small">
                  <%= sanitize(t('invoice.payos.static_qr_notice_html')) %>
                </div>
              </div>
              <% if inv.payos_checkout_url.present? %>
                <a href="<%= inv.payos_checkout_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-success text-white d-inline-flex align-items-center justify-content-center gap-1 px-3 py-2 rounded-pill w-100 fw-semibold shadow-sm">
                  <span class="material-symbols-outlined fs-6">open_in_new</span>
                  <span><%= t('invoice.payos.open_checkout') %></span>
                </a>
              <% end %>
            </div>
          <% end %>

          <div class="bg-light p-3 rounded-3 text-start mb-3 border font-monospace small">
            <div class="mb-1"><strong><%= t('invoice.bank_name') %>:</strong> <%= bank_acc.bank.short_name %> (<%= bank_acc.bank.code %>)</div>
            <div class="mb-1"><strong><%= t('invoice.account_number') %>:</strong> <span class="text-primary fw-bold fs-6"><%= inv.effective_bank_account_number(bank_acc) %></span></div>
            <div class="mb-1"><strong><%= t('invoice.account_holder') %>:</strong> <%= bank_acc.account_holder %></div>
            <div class="mb-1"><strong><%= t('invoice.vietqr.amount') %>:</strong> <span class="text-danger fw-bold fs-6"><%= format_money(inv.total_amount) %></span></div>

            <% effective_note = inv.effective_transfer_note(bank_acc) %>
            <% if effective_note.present? %>
              <div class="mb-0" data-controller="clipboard"
                   data-clipboard-copied-text-value="<%= t('invoice.vietqr.copied') %>"
                   data-clipboard-original-text-value="<%= t('invoice.vietqr.copy') %>">
                <strong><%= t('invoice.transfer_note') %>:</strong>
                <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded border mt-1">
                  <span class="fw-bold text-dark" data-clipboard-target="source"><%= effective_note %></span>
                  <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 py-1 px-2"
                          data-action="click->clipboard#copy"
                          data-clipboard-target="button">
                    <%= t('invoice.vietqr.copy') %>
                  </button>
                </div>
              </div>
            <% else %>
              <p class="text-secondary small fst-italic">
                <span class="material-symbols-outlined fs-6 align-middle text-secondary">info</span>
                <%= t('invoice.no_strict_transfer_note') %>
              </p>
            <% end %>
          </div>
          <p class="text-secondary small"><%= t('invoice.vietqr.scan_app_instruction') %></p>
        </div>

        <div class="modal-footer border-top">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('invoice.actions.close') %></button>
        </div>
      </div>
    </div>
  </div>
<% end %>
