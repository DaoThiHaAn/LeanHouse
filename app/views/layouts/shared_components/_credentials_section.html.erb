<%# locals: (user:, change_tel_url:, change_pw_url:) %>
<div class="border-bottom pb-4">
  <h2 class="mb-4"><%= t("form.profile.security") %></h2>

  <!-- Telephone -->
  <div class="mb-4">
    <div class="d-flex gap-2 align-items-center mb-3">
      <p class="fw-medium flex-shrink-0 mb-0" style="min-width: 100px;"><%= t("form.profile.tel") %></p>

      <div class="input-group profile-credentials-group">
        <%= telephone_field_tag :tel, user.tel, disabled: true, class: "form-control" %>
        <%= link_to t("form.profile.change_tel"), change_tel_url,
          class: "custom-primary-btn text-nowrap rounded-end" %>
      </div>
    </div>
    <%= render 'layouts/shared_components/new_tel_owner' %>
  </div>

  <!-- Password -->
  <div class="d-flex gap-2 align-items-center">
    <p class="fw-medium flex-shrink-0 mb-0" style="min-width: 100px;"><%= t("form.profile.password") %></p>

    <div class="input-group profile-credentials-group">
      <%= password_field_tag :password, "••••••••", disabled: true, class: "form-control" %>
      <%= link_to t("form.profile.change_pw"), change_pw_url,
        class: "custom-primary-btn text-nowrap rounded-end" %>
    </div>
  </div>
</div>
