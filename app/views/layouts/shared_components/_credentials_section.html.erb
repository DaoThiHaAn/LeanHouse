<%# locals: (user:, change_tel_url:, change_pw_url:) %>
<div class="border-bottom pb-4">
  <h2 class="mb-4">
    <span class="material-symbols-outlined fs-3">security</span>
    <%= t("form.profile.security") %>
  </h2>

  <!-- Telephone -->
  <div class="mb-4">
    <div class="d-flex gap-2 align-items-center flex-wrap mb-3">
      <p class="fw-medium flex-shrink-0 mb-0" style="min-width: 100px;"><%= t("form.profile.tel") %></p>

      <div class="input-group profile-credentials-group">
        <%= telephone_field_tag :tel, user.tel, disabled: true, class: "form-control" %>
        <%= link_to t("form.profile.change_tel"), change_tel_url,
            data: {
              turbo_method: :get,
              turbo_confirm: t("form.profile.change_tel_cf")
            },
            class: "custom-primary-btn text-nowrap rounded-end d-inline-flex align-items-center" %>
      </div>
    </div>
    <%= render 'layouts/shared_components/new_tel_owner' %>
  </div>

  <!-- Password -->
  <div class="d-flex gap-2 align-items-center">
    <p class="fw-medium flex-shrink-0"><%= t("form.profile.password") %></p>

    <%= link_to change_pw_url,
        data: {
          turbo_method: :get,
          turbo_confirm: t("form.profile.change_pw_cf")
        },
        class: "btn btn-outline-secondary d-inline-flex align-items-center gap-1" do %>
      <span class="material-symbols-outlined fs-5">key_vertical</span>
      <%= t("form.profile.change_pw") %>
    <% end %>
  </div>
</div>
