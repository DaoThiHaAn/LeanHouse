<%= turbo_frame_tag "account_delete_modal" do %>
  <div class="modal fade" id="accountCheckDeleteBlockedModal" tabindex="-1" aria-hidden="true"
        data-controller="modal" data-modal-auto-open-value="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-bottom pb-2 bg-danger">
          <h2 class="modal-title d-flex align-items-center gap-2 fs-5 text-white">
              <span class="material-symbols-filled fs-3">person_remove</span>
            <%= t("form.profile.delete_blocked_title") %>
          </h2>

          <button type="button" class="btn-close" data-bs-dismiss="modal" data-bs-theme="dark" aria-label="Close"></button>
        </div>

        <div class="modal-body py-3">
          <p class="text-secondary mb-3">
            <%= t("form.profile.delete_blocked_desc") %>
          </p>

          <div class="d-flex flex-column gap-2">
            <% @check.blockers.each do |blocker| %>
              <div class="p-2 rounded bg-light border border-danger-subtle d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2 text-danger">
                  <span class="material-symbols-filled fs-5">cancel</span>
                  <span class="small fw-medium">
                    <%= t("form.profile.blockers.#{blocker.key}", count: blocker.count) %>
                  </span>
                </div>

                <div>
                  <% case blocker.key %>
                  <% when :active_tenants %>
                    <% if local_assigns[:resolve_tenants_url] %>
                      <%= link_to t("form.profile.resolutions.view_houses"), resolve_tenants_url,
                            data: { turbo_frame: "_top" },
                            class: "btn btn-outline-primary btn-sm py-0 px-2" %>
                    <% end %>
                  <% when :active_stay %>
                    <% if local_assigns[:resolve_stay_url] %>
                      <%= link_to t("form.profile.resolutions.view_dashboard"), resolve_stay_url,
                            data: { turbo_frame: "_top" },
                            class: "btn btn-outline-primary btn-sm py-0 px-2" %>
                    <% end %>
                  <% when :pending_requests %>
                    <% if local_assigns[:resolve_requests_url] %>
                      <%= link_to t("form.profile.resolutions.view_requests"), resolve_requests_url,
                            data: { turbo_frame: "_top" },
                            class: "btn btn-outline-primary btn-sm py-0 px-2" %>
                    <% end %>
                  <% when :unpaid_invoices %>
                    <% if local_assigns[:resolve_invoices_url] %>
                      <%= link_to t("form.profile.resolutions.view_invoices"), resolve_invoices_url,
                            data: { turbo_frame: "_top" },
                            class: "btn btn-outline-primary btn-sm py-0 px-2" %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="modal-footer border-top pt-2">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
            <%= t("form.profile.i_understand") %>
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>
