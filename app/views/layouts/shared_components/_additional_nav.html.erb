<%# Local variable: house, other_houses %>

<div class="secondary-nav-container" data-controller="secondary-nav">
<!-- Collapsible Navigation Bar -->
<nav class="collapse show secondary-nav-wrapper"
    id="secondaryNavbar" data-secondary-nav-target="navbar">
    <div class="secondary-nav px-3 py-2 navbar-nav navbar-nav-scroll
                d-flex flex-row flex-nowrap justify-content-start justify-content-lg-center gap-3 align-items-center">
        <%# Back to the House Index %>
        <%= link_to landlord_houses_path, title: t("bar.back_house_index"),
            class: "back card rounded-circle flex-shrink-0" do %>
           <span class="material-symbols-outlined m-auto">arrow_left_alt</span>
        <% end %>

        <!-- House card with change btn -->
        <div class="card active house-card dropdown me-4 flex-shrink-0">
            <div class="card-body px-2 py-1 d-flex gap-1 align-items-center justify-content-between">
                <div>
                    <p class="card-title fw-bold d-flex align-items-center gap-1 mb-0">
                        <span class="material-symbols-filled">roofing</span>
                        <%= house.name %>
                    </p>
                    <p class="card-text text-clamp-2 mb-0"><%= house.full_address %></p>
                </div>

                <!-- Change house Button -->
                <button type="button" 
                        class="other-house-btn d-flex align-items-center rounded-circle" 
                        title="<%= t('bar.other_houses') %>">
                    <%= link_to other_houses_landlord_house_path(house), data: {turbo_frame: "other_houses"} do %>
                        <span class="material-symbols-outlined">more_vert</span>
                    <% end %>
                </button>
            </div>
        </div>

        <!-- Other cards -->
        <%= link_to landlord_house_rooms_path(house), class: class_names("card", "other-card", active: controller_name == "rooms") do %>
            <div class="card-body p-0 d-flex flex-column gap-1 align-items-center justify-content-center">
                <%= image_tag "room.png", alt: "Room Icon" %>
                <h5 class="card-title text-center m-0 d-flex align-items-center ">
                    <%= t("bar.rooms") %>
                </h5>
            </div>
        <% end %>

        <%= link_to landlord_house_tenants_path(house), class: class_names("card", "other-card", active: controller_name == "tenants") do %>
            <div class="card-body p-0 d-flex flex-column gap-1 align-items-center justify-content-center">
                <%= image_tag "human-resources.png", alt: "People Icon" %>
                <h5 class="m-0 text-center card-title d-flex align-items-center">
                    <%= t("bar.tenants") %>
                </h5>
            </div>
        <% end %>

        <%= link_to landlord_house_assets_path(house),
                    class: class_names("card", 
                                        "other-card", 
                                        active: ["assets", "maintenance_logs"].include?(controller_name)) do %>
            <div class="card-body p-0 d-flex flex-column gap-1 align-items-center justify-content-center">
                <%= image_tag "property.png", alt: "Property Icon" %>
                <h5 class="m-0 text-center card-title d-flex align-items-center">
                    <%= t("bar.properties") %>
                </h5>
            </div>
        <% end %>

        <%= link_to landlord_house_services_path(house), class: class_names("card", "other-card", active: controller_name == "services") do %>
            <div class="card-body p-0 d-flex flex-column gap-1 align-items-center justify-content-center">
                <%= image_tag "home-services.png", alt: "Home services Icon" %>
                <h5 class="m-0 text-center card-title d-flex align-items-center">
                    <%= t("bar.services") %>
                </h5>
            </div>
        <% end %>

        <%= link_to landlord_house_contracts_path(house), class: class_names("card", "other-card", active: controller_name == "contracts") do %>
            <div class="card-body p-0 d-flex flex-column gap-1 align-items-center justify-content-center">
                <%= image_tag "contracts.png", alt: "Contract Icon" %>
                <h5 class="m-0 text-center card-title d-flex align-items-center">
                    <%= t("bar.contracts") %>
                </h5>
            </div>
        <% end %>

        <%= link_to landlord_house_invoices_path(house), class: class_names("card", "other-card", active: controller_name == "invoices") do %>
            <div class="card-body p-0 d-flex flex-column gap-1 align-items-center justify-content-center">
                <%= image_tag "expenses.png", alt: "Invoice Icon" %>
                <h5 class="m-0 text-center card-title d-flex align-items-center">
                    <%= t("bar.invoices") %>
                </h5>
            </div>
        <% end %>

        <%= link_to landlord_house_vehicles_path(house), class: class_names("card", "other-card", active: controller_name == "vehicles") do %>
            <div class="card-body p-0 d-flex flex-column gap-1 align-items-center justify-content-center">
                <%= image_tag "car.png", alt: "Car Icon" %>
                <h5 class="m-0 text-center card-title d-flex align-items-center">
                    <%= t("bar.vehicles") %>
                </h5>
            </div>
        <% end %>
    </div>
</nav>

<!-- Collapse Trigger Button -->
 <button
    id="secondaryNavbarToggle"
    class="p-1 d-flex align-items-center gap-1 toggle-nav-btn"
    type="button"
    data-bs-toggle="collapse"
    data-bs-target="#secondaryNavbar"
    aria-expanded="true"
    aria-controls="secondaryNavbar"
    title="<%= t('bar.secondary_toggle_close') %>"
    data-title-open="<%= t('bar.secondary_toggle_expand') %>"
    data-title-close="<%= t('bar.secondary_toggle_close') %>"
    data-secondary-nav-target="button">
    <span class="material-symbols-outlined toggle-icon">
      chevron_line_up
    </span>
  </button>
</div>
