<%# Local varianles: unread_count, notifications %>

<% if logged_in? %>
    <!--TODO Profile -->
    <div class="dropdown profile-dropdown">
        <button class="py-1 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <%= display_avatar %>
            <div class="d-flex flex-column align-items-start">
                <p class="fw-bold fullname"><%= format_name(current_user.fullname) %></p>
                <p class="role"><%= get_role %></p>
            </div>
        </button>

        <ul class="dropdown-menu">
          <% if current_user.role == "landlord" %>
            <li><a class="dropdown-item" href="<%= landlord_profile_path %>"><%= t('bar.my_profile') %></a></li>
            <li><a class="dropdown-item" href="<%= landlord_profile_path %>"><%= t("bar.my_bank_acc") %></a></li>
          <% else %>
            <li><a class="dropdown-item" href="<%= tenant_profile_path %>"><%= t('bar.my_profile') %></a></li>
            <li><a class="dropdown-item" href="<%= tenant_vehicles_path %>"><%= t("bar.my_vehicle") %></a></li>
            <li><a class="dropdown-item" href="#"><%= t("bar.my_saved_post") %></a></li>
          <% end %>
          <li><a class="dropdown-item d-flex gap-1 align-items-center" href="<%= logout_path %>">
            <%= t("auth.log_out") %>
            <span class="material-symbols-outlined">logout</span>
          </a></li>
        </ul>
    </div>

    <!-- TODO: Notification -->
    <!-- Mở kết nối WebSocket lắng nghe thông báo riêng của current_user -->
    <%= turbo_stream_from current_user, :notifications %>

    <div id="notification_box">
      <%= render "layouts/shared_components/notification_dropdown",
            unread_count: unread_count,
            notifications: notifications %>
    </div>

<% else %>
    <%= link_to t("auth.sign_up"), signup_path, class: "signup-btn" %>

    <%= link_to login_path, class: "login-btn gap-1 d-flex align-items-center flex-shrink-0" do %>
        <%= t("auth.log_in") %>
        <span class="material-symbols-filled">door_open</span>
    <% end %>
<% end %>
