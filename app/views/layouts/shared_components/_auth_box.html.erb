<% if logged_in?%>
    <!--TODO Profile -->
    <div class="dropdown profile-dropdown">
        <button class="dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <%= display_avatar %>
            <div class="d-flex flex-column align-items-start">
                <p class="fw-bold fullname"><%=format_name(current_user.fullname) %></p>
                <p class="role"><%=get_role%></p>
            </div>
        </button>

        <ul class="dropdown-menu">
             <li><a class="dropdown-item" href="#"><%=t('bar.my_profile')%></a></li>
            <% if current_user.role == "landlord" %>
                <li><a class="dropdown-item" href="#"><%=t("bar.my_bank_acc")%></a></li>
            <%else%>
                <li><a class="dropdown-item" href="#"><%=t("bar.my_vehicle")%></a></li>
                <li><a class="dropdown-item" href="#"><%=t("bar.my_saved_post")%></a></li>
            <%end%>
            <li><a class="dropdown-item d-flex gap-1 align-items-center" href="<%=logout_path%>">
                    <%=t("auth.log_out")%>
                    <span class="material-symbols-outlined">logout</span>
            </a></li>
        </ul>
    </div>

    <!-- TODO: Notification -->
    <div class="dropdown notification-dropdown">
			<button class="dropdown-toggle" type="button" data-bs-toggle="dropdown"
							aria-expanded="false" title="<%= t("click_open")%>">
				<div class="position-relative">
					<span class="noti material-symbols-filled">notifications</span>
					<div class="notification-badge"><%=noti_count(3)%></div>
				</div>
			</button>


        <ul class="dropdown-menu dropdown-menu-end p-0">
					<%# Mark as read %>
					<li class="py-2 px-3 d-flex justify-content-end">
						<%= link_to "#", class: "text-danger fw-medium fst-italic mark-as-read" do %>
							<span class="text-danger material-symbols-outlined">done_all</span>
							<%= t("form.noti.mark_as_read") %>
						<% end %>
					</li>
					<li class="read py-2 px-3 d-flex flex-column gap-2">
						<p class="fw-semibold text-clamp-1"> <%= "NOTIFICATION TITLE" %></p>
						<p class="noti-content text-clamp-2"> <%= "Detiai klsf fklf fnkls kjsflsk klfsjfdl fnksf kjsfnsk laf alkfalkf flf" %></p>
						<div class="noti-footer d-flex justify-content-between text-muted">
							<p><%= "11:00:23 1/12/2025" %></p>
							<p><%= "Xem chi tiet" %></p>
						</div>
					</li>
					<li>
						<a class="dropdown-item" href="#">Notification 2</a>
					</li>
        </ul>
    </div>




<%else%>
    <%= link_to t("auth.sign_up"), signup_path, class: "signup-btn"%>

    <%= link_to login_path, class: "login-btn gap-1 d-flex align-items-center" do %>
        <%= t("auth.log_in") %>
        <span class="material-symbols-filled">door_open</span>
    <% end %>
<%end%>