<% flash.each do |type, message| %>
  <% next if type.to_sym == :development_otp %>
  <% bootstrap_class =
      case type.to_sym
      when :notice then "alert-success"
      when :alert  then "alert-danger"
      else "alert-info"
      end %>

  <div class="flash-container shadow-sm">
    <div class="m-0 alert <%= bootstrap_class %> alert-dismissible fade show" role="alert" aria-live="polite" id="flash-message-<%= SecureRandom.hex(4) %>">
      <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('close', default: 'Đóng') %>"></button>
    </div>
  </div>
<% end %>
