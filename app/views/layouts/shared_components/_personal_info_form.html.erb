<%# locals: (user:, update_profile_url:, check_delete_url:) %>
<div class="py-4">
  <h2 class="mb-4">
    <span class="material-symbols-filled fs-2">user_attributes</span>
    <%= t("form.profile.personal_info") %>
  </h2>

  <%= form_with model: user, url: update_profile_url, method: :patch, local: true,
        class: "d-flex flex-column gap-3 mx-auto", style: "max-width: 600px;",
        data: {
          controller: "loading",
          loading_text_value: "#{t('saving')}...",
          action: "submit->loading#submit"
        } do |f| %>

    <!-- Fullname -->
    <div class="form-group mb-2" data-controller="form">
      <%= f.label :fullname, class: "form-label d-flex justify-content-between" do %>
        <div class="fw-bold">
          <%= t("form.profile.fullname") %>:
        </div>

        <small class="counter-text">
          <span data-form-target="charCount">0</span>
        </small>
      <% end %>

      <%= f.text_field :fullname,
          maxlength: 50,
          class: "form-control #{invalid_class(user, :fullname)}",
          placeholder: t("form.profile.fullname_placeholder"),
          required: true,
          data: {
            form_target: "input",
            action: "input->form#update"
          } %>
      <%= field_error(user, :fullname) %>
    </div>

    <!-- Sex -->
    <div class="form-group d-flex gap-4 align-items-center mb-2 flex-wrap">
      <%= f.label :sex, class: "form-label fw-bold d-block mb-0" do %>
        <%= t("form.profile.sex") %>:
      <% end %>

      <div class="d-flex gap-4 align-items-center">
        <label class="d-flex align-items-center gap-2 mb-0" style="cursor: pointer;">
          <%= f.radio_button :sex, "male" %>
          <%= t("form.profile.male") %>
        </label>

        <label class="d-flex align-items-center gap-2 mb-0" style="cursor: pointer;">
          <%= f.radio_button :sex, "female" %>
          <%= t("form.profile.female") %>
        </label>
      </div>
      <%= field_error(user, :sex) %>
    </div>

    <!-- Birthday -->
    <div class="form-group d-flex gap-4 align-items-center mb-2 flex-wrap">
      <%= f.label :bday, class: "form-label fw-bold flex-shrink-0" do %>
        <%= t("form.profile.bday") %>:
      <% end %>

      <%= f.date_field :bday,
          class: "form-control profile-date-input #{invalid_class(user, :bday)}",
          required: true %>
      <%= field_error(user, :bday) %>
    </div>

    <!-- Address -->
    <div class="form-group" data-controller="form">
      <%= f.label :address, class: "form-label d-flex justify-content-between" do %>
        <div class="fw-bold">
          <%= t("form.profile.address") %>:
        </div>

        <small class="counter-text">
          <span data-form-target="charCount">0</span>
        </small>
      <% end %>

      <%= f.text_field :address,
          maxlength: 100,
          class: "form-control #{invalid_class(user, :address)}",
          placeholder: t("form.profile.address_placeholder"),
          required: true,
          data: {
            form_target: "input",
            action: "input->form#update"
          } %>
      <%= field_error(user, :address) %>
    </div>

    <div class="p-2 bg-danger-subtle border border-danger-subtle d-flex align-items-start gap-2 w-100 text-danger-emphasis">
        <span class="material-symbols-filled fs-5 mt-1">info</span>
        <small><%= t("auth.auth_fields_reminder_html") %></small>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-center gap-3 mt-3">
      <button type="reset" class="cancel-btn d-inline-flex align-items-center gap-1 px-3 py-2">
        <span class="material-symbols-outlined fs-5">close</span>
        <%= t("cancel") %>
      </button>

      <%= f.button type: :submit,
            class: "custom-primary-btn d-inline-flex align-items-center justify-content-center gap-2 px-4 py-2",
            data: { loading_target: "button" } do %>
        <span class="material-symbols-outlined fs-5" data-loading-target="icon">save</span>
        <span class="material-symbols-outlined spin d-none fs-5" data-loading-target="spinner">progress_activity</span>
        <span data-loading-target="text"><%= t("save_changes") %></span>
      <% end %>
    </div>

  <% end %>
</div>
<hr class="mt-2">

<!-- Delete Account -->
<div class="d-flex gap-2 align-items-center justify-content-between pt-2 mt-4">
  <div>
    <h2 class="fs-5 text-danger"><%= t("form.profile.delete_account_title") %></h2>
    <small class="text-secondary"><%= t("form.profile.delete_account_desc") %></small>
  </div>

  <%= link_to check_delete_url,
        data: {
          controller: "loading",
          loading_text_value: t("form.profile.checking_delete"),
          action: "click->loading#start",
          turbo_frame: "account_delete_modal"
        },
        class: "btn btn-outline-danger btn-sm d-flex align-items-center gap-1 text-nowrap" do %>
    <span class="material-symbols-filled fs-5" data-loading-target="icon">delete</span>
    <span class="material-symbols-outlined fs-6 spin d-none" data-loading-target="spinner">progress_activity</span>
    <span class="fw-medium" data-loading-target="text"><%= t("form.profile.delete_account_btn") %></span>
  <% end %>
</div>
