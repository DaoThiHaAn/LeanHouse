<%# locals: (invoice:, bank_account: nil, actions_partial: nil) %>
<%
  bank_account ||= invoice.bank_account
  qr_url = invoice.vietqr_url(bank_account)
  accent_class = case invoice.status
                 when "paid" then "accent-paid"
                 when "cancelled" then "accent-cancelled"
                 when "overdue" then "accent-overdue"
                 else invoice.overdue? ? "accent-overdue" : "accent-pending"
                 end
%>

<!-- Main Invoice Card -->
<div id="invoice-printable" class="card invoice-card invoice-document-card mb-4">
  <!-- Status Accent Bar -->
  <div class="invoice-doc-accent <%= accent_class %>"></div>

  <div class="p-4 p-md-5">
    <!-- Header: Title, Code & Badges -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4 pb-3 border-bottom">
      <div>
        <h1 class="mb-4">
          <span class="material-symbols-outlined fs-1">receipt_long</span>
          <%= invoice.title %>
        </h1>

        <div class="d-flex align-items-center gap-2 mt-2 flex-wrap" data-controller="clipboard"
             data-clipboard-copied-text-value="<%= t('invoice.vietqr.copied') %>"
             data-clipboard-original-text-value="<%= t('invoice.vietqr.copy') %>">
          <span class="invoice-code-pill">
            <span class="text-secondary small"><%= t('invoice.code') %>:</span>
            <strong data-clipboard-target="source">#<%= invoice.code %></strong>
          </span>
          <button type="button" class="btn btn-copy-quick d-inline-flex align-items-center gap-1 d-print-none" data-action="click->clipboard#copy" data-clipboard-target="button">
            <span class="material-symbols-outlined fs-6">content_copy</span>
            <span><%= t('invoice.vietqr.copy') %></span>
          </button>
        </div>
      </div>

      <div class="d-flex gap-2 align-items-center flex-wrap">
        <%= invoice_term_badge(invoice) %>
        <%= invoice_payment_status_badge(invoice) %>
      </div>
    </div>

    <!-- Parties Section: Biller & Payer Cards -->
    <div class="row g-3 mb-4">
      <!-- Bên cho thuê (Biller) -->
      <div class="col-12 col-md-6">
        <div class="invoice-party-box">
          <div class="invoice-party-label">
            <span class="material-symbols-outlined fs-5">apartment</span>
            <span><%= t('invoice.biller_info') %></span>
          </div>
          <div class="invoice-party-name"><%= invoice.house.name %></div>
          <div class="invoice-party-info">
            <div><span class="text-secondary"><%= t('form.house.addr') %>:</span>&nbsp;
            <%= invoice.house.full_address %></div>
            <div>
              <span class="text-secondary"><%= t('role.landlord') %>:</span>&nbsp;
              <strong><%= invoice.house.landlord.user.fullname %></strong>
              (<%= t('invoice.phone_abbr') %>: <%= invoice.house.landlord.user.tel %>)
            </div>
          </div>
        </div>
      </div>

      <!-- Bên thanh toán (Payer) -->
      <div class="col-12 col-md-6">
        <div class="invoice-party-box">
          <div class="invoice-party-label">
            <span class="material-symbols-outlined fs-5">person</span>
            <span><%= t('invoice.payer_info') %></span>
          </div>
          <div class="invoice-party-name">
            <%= invoice.room.title_name %>
            (<%= invoice.room.floor.title_name %>)
          </div>
          <div class="invoice-party-info">
            <% if (invoice.individual? || invoice.custom?) && invoice.tenant&.user.present? %>
              <div>
                <span class="text-secondary"><%= t('role.tenant') %>:</span>&nbsp;
                <strong><%= invoice.tenant.user.fullname %></strong>
                <% if invoice.tenant.user.tel.present? %>
                  (<%= t('invoice.phone_abbr') %>: <%= invoice.tenant.user.tel %>)
                <% end %>
              </div>
              <div>
                <span class="text-secondary"><%= t('invoice.payment_mode') %>:</span>
                <span class="badge bg-secondary-subtle text-secondary border">
                  <% if invoice.custom? %>
                    <%= t('invoice.badge_custom') %>
                  <% else %>
                    <%= t('invoice.badge_self_pay') %>
                  <% end %>
                </span>
              </div>
            <% else %>
              <div>
                <span class="text-secondary"><%= t('invoice.payment_mode') %>:</span>
                <span class="badge bg-secondary-subtle text-secondary border">
                  <%= t('invoice.badge_representative') %>
                </span>
              </div>
              <div class="text-secondary small mt-1">
                <span class="material-symbols-outlined fs-6 align-middle text-muted">group</span>
                <span><%= t('invoice.room_occupants_notice') %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Profile Notice -->
    <div class="d-flex align-items-center gap-1 text-secondary opacity-75 small mb-4 fst-italic px-1">
      <span class="material-symbols-outlined fs-6">info</span>
      <span><%= t('invoice.parties_live_info_hint') %></span>
    </div>

    <!-- Timeline & Key Dates Strip -->
    <div class="invoice-meta-strip mb-4">
      <div class="row g-3 text-center text-sm-start">
        <div class="col-6 col-md-4">
          <div class="invoice-meta-item-label"><%= t('invoice.created_time') %></div>
          <div class="invoice-meta-item-value">
            <span class="material-symbols-outlined fs-6 align-middle text-secondary me-1">event</span>
            <%= format_date(invoice.created_at) %>
          </div>
        </div>
        <div class="col-6 col-md-4">
          <div class="invoice-meta-item-label"><%= t('invoice.payment_term') %></div>
          <div class="invoice-meta-item-value">
            <span class="material-symbols-outlined fs-6 align-middle text-secondary me-1">date_range</span>
            <%= invoice.payment_period_text %>
          </div>
        </div>
        <% if invoice.overdue? %>
          <div class="col-12 col-md-4">
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1"><%= t('invoice.status.overdue') %></span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Ghi chú nếu có -->
    <% if invoice.note.present? %>
      <div class="alert alert-light border rounded-3 p-3 mb-3 d-flex align-items-start gap-2 mb-5">
        <span class="material-symbols-outlined text-secondary fs-5 mt-0.5">sticky_note_2</span>
        <div class="small">
          <strong><%= t('invoice.note') %>:</strong>
          <span class="text-secondary"><%= invoice.note %></span>
        </div>
      </div>
    <% end %>

    <!-- Line Items Section -->
    <div class="mb-4 px-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0 d-flex align-items-center gap-2">
          <span class="material-symbols-outlined fs-3">format_list_bulleted</span>
          <span><%= t('invoice.breakdown') %></span>
        </h2>
        <% if invoice.service_items.any? %>
          <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-secondary small d-inline-flex align-items-center gap-1 d-print-none" data-bs-toggle="modal" data-bs-target="#serviceInstructionsModal">
            <span class="material-symbols-outlined fs-6">help</span> <%= t('invoice.service_instructions') %>
          </button>
        <% end %>
      </div>

      <!-- 1. Tiền thuê phòng (Room Rent) -->
      <% if invoice.rent_total > 0 %>
        <div class="invoice-rent-card d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
          <div>
            <div class="fw-bold text-dark d-flex align-items-center gap-1">
              <span class="material-symbols-outlined text-success fs-5">bed</span>
              <span><%= t('invoice.rent_fee') %>: <%= invoice.room.title_name %></span>
            </div>
            <div class="small text-secondary mt-1">
              <%= t('invoice.billing_month') %>: <strong><%= format_month(invoice.billing_month) %></strong>
              <span class="mx-1">•</span>
              <%= invoice.rent_period_text %>
            </div>
          </div>
          <div class="text-sm-end">
            <div class="fw-bold fs-5">
              <%= format_money(invoice.rent_total) %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- 2. Phí dịch vụ (Services Table) -->
      <% if invoice.service_items.any? %>
        <h3><%= t("service.list")%></h3>

        <div class="table-responsive rounded-3 border mb-3 overflow-hidden">
          <table class="table table-hover align-middle mb-0 invoice-items-table">
            <thead class="table-light border-bottom">
              <tr class="text-secondary small text-uppercase">
                <th class="ps-3 py-2"><%= t('invoice.service_name') %></th>
                <th class="py-2 text-center"><%= t('invoice.unit') %></th>
                <th class="py-2 text-end"><%= t('invoice.unit_price') %></th>
                <th class="py-2 text-center"><%= t('invoice.usage_quantity') %></th>
                <th class="pe-3 py-2 text-end"><%= t('invoice.amount') %></th>
              </tr>
            </thead>
            <tbody>
              <% invoice.service_items.each do |item| %>
                <tr>
                  <td class="ps-3">
                    <div class="fw-semibold"><%= item.name %></div>
                    <div class="small text-secondary">
                      <%= format_date(item.effective_start_date(invoice)) %> → <%= format_date(item.effective_end_date(invoice)) %>
                    </div>
                  </td>
                  <td class="text-center text-secondary"><%= item.unit %></td>
                  <td class="text-end text-secondary">
                    <%= format_money(item.unit_price) %>
                  </td>
                  <td class="text-center">
                    <% if item.prev_reading.present? && item.latest_reading.present? %>
                      <div class="meter-reading-breakdown">
                        <div class="meter-row">
                          <span class="meter-label"><%= t('invoice.prev_reading', default: 'Chỉ số cũ') %>:</span>
                          <span class="meter-value"><%= item.prev_reading %></span>
                        </div>
                        <div class="meter-row">
                          <span class="meter-label"><%= t('invoice.latest_reading', default: 'Chỉ số mới') %>:</span>
                          <span class="meter-value"><%= item.latest_reading %></span>
                        </div>
                        <div class="meter-row meter-usage-row">
                          <span class="meter-label text-primary fw-semibold"><%= t('invoice.used_amount', default: 'Tiêu thụ') %>:</span>
                          <span class="meter-usage-value"><%= item.quantity %></span>
                        </div>
                      </div>
                    <% else %>
                      <span class="fw-medium font-monospace"><%= item.quantity %></span>
                    <% end %>
                  </td>
                  <td class="pe-3 text-end custom-text-primary fw-bold">
                    <%= format_money(item.amount) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot class="table-light border-top">
              <tr class="fw-bold">
                <td colspan="4" class="ps-3 text-secondary"><%= t('invoice.total_services') %>:</td>
                <td class="pe-3 text-end fs-5 custom-text-primary">
                  <strong><%= format_money(invoice.services_total) %></strong>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% end %>

      <!-- 3. Khoản cộng thêm (+) & Khoản giảm trừ (-) -->
      <% if invoice.addition_items.any? || invoice.discount_items.any? %>
        <div class="row g-3 mb-3">
          <% if invoice.addition_items.any? %>
            <div class="col-12 <%= invoice.discount_items.any? ? 'col-md-6' : '' %>">
              <div class="border rounded-3 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="text-primary fw-bold small text-uppercase d-flex align-items-center gap-1">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">+</span>
                    <%= t('invoice.addition_items') %>
                  </span>
                  <span class="fw-bold text-primary small">
                    +<%= number_to_currency(invoice.additions_total, unit: "₫", precision: 0) %>
                  </span>
                </div>
                <div class="table-responsive">
                  <table class="table table-sm align-middle mb-0">
                    <tbody>
                      <% invoice.addition_items.each do |item| %>
                        <tr>
                          <td class="small"><%= item.name %></td>
                          <td class="text-end text-primary fw-semibold small">
                            +<%= format_money(item.amount) %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          <% end %>

          <% if invoice.discount_items.any? %>
            <div class="col-12 <%= invoice.addition_items.any? ? 'col-md-6' : '' %>">
              <div class="border rounded-3 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="text-danger fw-bold small text-uppercase d-flex align-items-center gap-1">
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">-</span>
                    <%= t('invoice.discount_items') %>
                  </span>
                  <span class="fw-bold text-danger small">
                    -<%= format_money(invoice.discounts_total) %>
                  </span>
                </div>
                <div class="table-responsive">
                  <table class="table table-sm align-middle mb-0">
                    <tbody>
                      <% invoice.discount_items.each do |item| %>
                        <tr>
                          <td class="text-dark small"><%= item.name %></td>
                          <td class="text-end text-danger fw-semibold small">
                            -<%= format_money(item.amount.abs) %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Financial Summary (Totals Block) -->
      <div class="invoice-summary-card ms-auto">
        <% if invoice.rent_total > 0 %>
          <div class="invoice-summary-item">
            <span><%= t('invoice.rent_fee') %></span>
            <span class="fw-semibold"><%= format_money(invoice.rent_total) %></span>
          </div>
        <% end %>

        <% if invoice.service_items.any? %>
          <div class="invoice-summary-item">
            <span><%= t('invoice.service_fee') %></span>
            <span class="fw-semibold"><%= format_money(invoice.services_total) %></span>
          </div>
        <% end %>

        <% if invoice.additions_total > 0 %>
          <div class="invoice-summary-item text-primary">
            <span><%= t('invoice.total_addition_summary') %></span>
            <span class="fw-semibold">+<%= format_money(invoice.additions_total) %></span>
          </div>
        <% end %>

        <% if invoice.discounts_total > 0 %>
          <div class="invoice-summary-item text-danger">
            <span><%= t('invoice.total_discount_summary') %></span>
            <span class="fw-semibold">-<%= format_money(invoice.discounts_total) %></span>
          </div>
        <% end %>

        <div class="invoice-grand-total-row">
          <p class="fw-bold"><%= t('invoice.total_payment') %></p>
          <p class="invoice-grand-total-amount <%= invoice.paid? ? 'is-paid' : (invoice.overdue? ? 'is-overdue' : '') %>">
            <%= format_money(invoice.total_amount) %>
          </p>
        </div>
      </div>
    </div>

    <!-- Thông tin Chuyển khoản & Thanh toán -->
    <div class="p-4" id="invoice_payment_card_section_<%= invoice.id %>">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h2 class="mb-0 d-flex align-items-center gap-2">
          <span class="material-symbols-outlined fs-3">account_balance</span>
          <span><%= t('invoice.bank_transfer_info') %></span>
        </h2>
        <% if invoice.payos_configured? %>
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1-5 d-inline-flex align-items-center gap-1 shadow-sm">
            <span class="material-symbols-outlined fs-6">bolt</span>
            <span class="fw-semibold"><%= t('invoice.payos.realtime_badge') %></span>
          </span>
        <% end %>
      </div>

      <div class="row g-4 align-items-stretch">
        <!-- Cột trái: Thẻ VietQR & Số tài khoản -->
        <div class="col-12 col-md-6">
          <% if bank_account && qr_url %>
            <div class="invoice-bank-card gap-3 d-flex flex-column align-items-center justify-content-center">
              <button type="button"
                      class="btn btn-link text-decoration-none btn-sm p-0 text-secondary d-flex align-items-center gap-1 d-print-none"
                      data-bs-toggle="modal" data-bs-target="#zoomQrModal"
                      title="<%= t('invoice.vietqr.click_to_zoom') %>">
                <span class="material-symbols-outlined fs-6">zoom_in</span>
                <span class="small"><%= t('invoice.vietqr.click_to_zoom') %></span>
              </button>

              <%= image_tag qr_url, alt: t('invoice.vietqr.qr_alt'), class: "d-block mx-auto", width: "200px" %>

              <% if invoice.payos_checkout_url.present? %>
                <div class="text-center d-print-none mb-1">
                  <a href="<%= invoice.payos_checkout_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill">
                    <span><%= t('invoice.payos.open_checkout') %></span>
                    <span class="material-symbols-outlined fs-6">open_in_new</span>
                  </a>
                </div>
              <% end %>

              <div class="bg-light p-3 rounded-3 border small font-monospace">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="text-secondary"><%= t('invoice.bank_name') %>:</span>
                  <strong class="text-dark"><%= bank_account.bank.short_name %> (<%= bank_account.bank.code %>)</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1" data-controller="clipboard"
                      data-clipboard-copied-text-value="<%= t('invoice.vietqr.copied') %>"
                      data-clipboard-original-text-value="<%= t('invoice.vietqr.copy') %>">
                  <span class="text-secondary"><%= t('invoice.account_number') %>:</span>
                  <div class="d-flex align-items-center gap-1">
                    <strong class="text-primary fs-6" data-clipboard-target="source"><%= bank_account.account_number %></strong>
                    <button type="button" class="btn btn-copy-quick d-print-none" data-action="click->clipboard#copy" data-clipboard-target="button">
                      <%= t('invoice.vietqr.copy') %>
                    </button>
                  </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="text-secondary"><%= t('invoice.account_holder') %>:</span>
                  <strong class="text-dark"><%= bank_account.account_holder %></strong>
                </div>

                <% effective_note = invoice.effective_transfer_note %>
                <% if effective_note.present? %>
                  <div class="border-top pt-2 mt-2" data-controller="clipboard"
                        data-clipboard-copied-text-value="<%= t('invoice.vietqr.copied') %>"
                        data-clipboard-original-text-value="<%= t('invoice.vietqr.copy') %>">
                    <div class="text-secondary mb-1 d-flex align-items-center justify-content-between">
                      <span><%= t('invoice.transfer_note_strict') %>:</span>
                      <% if invoice.payos_configured? %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle small">payOS</span>
                      <% end %>
                    </div>
                    <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded border">
                      <span class="fw-bold text-dark font-monospace text-break" data-clipboard-target="source"><%= effective_note %></span>
                      <button type="button" class="btn btn-copy-quick ms-2 flex-shrink-0 d-print-none" data-action="click->clipboard#copy" data-clipboard-target="button">
                        <%= t('invoice.vietqr.copy') %>
                      </button>
                    </div>
                  </div>
                <% else %>
                  <div class="border-top pt-2 mt-2 text-secondary small fst-italic">
                    <span class="material-symbols-outlined fs-6 align-middle text-muted">info</span>
                    <%= t('invoice.no_strict_transfer_note', default: 'Nội dung chuyển khoản: Tùy ý (Không bắt buộc)') %>
                  </div>
                <% end %>
              </div>
            </div>

          <% else %>
            <div class="p-4 bg-light rounded-3 text-secondary small border d-flex align-items-center gap-3 h-100">
              <span class="material-symbols-outlined text-warning fs-2">warning</span>
              <div>
                <strong class="text-dark d-block mb-1"><%= t('invoice.bank_transfer_info') %></strong>
                <span><%= current_user.landlord? ? t('invoice.no_bank_account_landlord') : t('invoice.no_bank_account_tenant') %></span>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Cột phải: Hướng dẫn thanh toán & Thao tác hành động -->
        <div class="col-12 col-md-6 d-flex flex-column justify-content-between">
          <div>
            <% if invoice.undo_reason.present? && !invoice.paid? %>
              <div class="undo-reason-banner mb-3">
                <div class="d-flex align-items-center gap-2 undo-reason-title mb-1">
                  <span class="material-symbols-outlined fs-5 text-danger">warning</span>
                  <span><%= t('invoice.previous_undo_alert') %></span>
                  <% if invoice.undone_at.present? %>
                    <span class="text-secondary fw-normal small">(<%= format_datetime(invoice.undone_at) %>)</span>
                  <% end %>
                </div>
                <p class="undo-reason-text"><strong><%= t('invoice.undo_reason_view') %>:</strong> <%= invoice.undo_reason %></p>
              </div>
            <% end %>

            <!-- Guidance Box -->
            <div class="info-container p-3 mb-4">
              <h6 class="invoice-guidance-item fs-6 fw-bold mb-2">
                <%= t('invoice.payment_instructions') %>
              </h6>

              <div class="invoice-guidance-item">
                <span class="material-symbols-filled fs-6 mt-0.5">verified</span>
                <span><%= t('invoice.warning_check') %></span>
              </div>

              <div class="invoice-guidance-item">
                <span class="material-symbols-filled fs-5 mt-0.5">edit_note</span>
                <span><%= t('invoice.warning_report') %></span>
              </div>

              <div class="invoice-guidance-item">
                <span class="material-symbols-filled fs-6 mt-0.5">add_a_photo</span>
                <span><%= t('invoice.warning_proof') %></span>
              </div>
            </div>
          </div>

          <!-- Dynamic Action Slot -->
          <div class="pt-2">
            <% if block_given? %>
              <%= yield %>
            <% elsif local_assigns[:actions_partial].present? %>
              <%= render actions_partial, invoice: invoice %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
