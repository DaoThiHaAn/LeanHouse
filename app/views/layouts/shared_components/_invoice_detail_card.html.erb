<%# locals: (invoice:, bank_account: nil, actions_partial: nil) %>
<%
  bank_account ||= invoice.bank_account
  qr_url = invoice.vietqr_url(bank_account)
%>

<!-- Main Invoice Card -->
<div id="invoice-printable" class="card invoice-card p-4 p-md-5 bg-white mb-4">
  <!-- Header: Title & Badges -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4 pb-3 border-bottom">
    <div>
      <h2 class="fw-bolder mb-1 text-danger">
        <%= t('invoice.month_invoice', month: invoice.billing_month.strftime("%m")) %>
      </h2>
      <div class="text-secondary small font-monospace">
        <%= t('invoice.code') %>: <span class="fw-bold invoice-code-tag">#<%= invoice.code %></span> (<%= t('invoice.id') %>: <%= invoice.id %>)
      </div>
    </div>

    <div class="d-flex gap-2 align-items-center flex-wrap">
      <%= invoice_term_badge(invoice) %>
      <%= invoice_payment_status_badge(invoice) %>
    </div>
  </div>

  <!-- Meta Information Section -->
  <div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-3">
      <% if invoice.custom? %>
        <span class="material-symbols-outlined text-secondary fs-5">tune</span>
        <span class="fw-bold text-dark"><%= t('invoice.badge_custom') %>:</span>
        <span class="text-primary fw-semibold"><%= invoice.tenant&.user&.fullname %> (<%= t('invoice.phone_abbr') %>: <%= invoice.tenant&.user&.tel %>)</span>
        <span class="text-secondary small">- <%= t('invoice.room') %>: <%= invoice.room.title_name %>, <%= invoice.room.floor.name %> (<%= invoice.house.name %>)</span>
      <% elsif invoice.individual? %>
        <span class="material-symbols-outlined text-secondary fs-5">person</span>
        <span class="fw-bold text-dark"><%= t('invoice.mode_self_pay') %>:</span>
        <span class="text-primary fw-semibold"><%= invoice.tenant&.user&.fullname %> (<%= t('invoice.phone_abbr') %>: <%= invoice.tenant&.user&.tel %>)</span>
        <span class="text-secondary small">- <%= t('invoice.room') %>: <%= invoice.room.title_name %>, <%= invoice.room.floor.name %> (<%= invoice.house.name %>)</span>
      <% else %>
        <span class="material-symbols-outlined text-secondary fs-5">apartment</span>
        <span class="fw-bold text-dark"><%= t('invoice.mode_representative') %>:</span>
        <span class="text-primary fw-semibold"><%= invoice.room.title_name %> (<%= invoice.room.floor.name %>, <%= invoice.house.name %>)</span>
      <% end %>
    </div>

    <div class="row g-2 text-dark small">
      <div class="col-sm-6">
        <span class="text-secondary"><%= t('invoice.created_time') %>:</span>
        <span class="fw-semibold"><%= format_datetime(invoice.created_at) %></span>
      </div>
      <div class="col-sm-6">
        <span class="text-secondary"><%= t('invoice.payment_term') %>:</span>
        <span class="fw-semibold"><%= invoice.payment_period_text %></span>
      </div>
    </div>

    <div class="d-flex align-items-center gap-2 mt-3">
      <span class="fw-bold fs-6"><%= t('invoice.total') %>:</span>
      <span class="badge fs-5 px-3 py-2 font-monospace invoice-total-badge">
        <%= format_money(invoice.total_amount) %>
      </span>
      <button type="button" class="btn btn-link btn-sm p-0 text-secondary d-print-none" data-bs-toggle="modal" data-bs-target="#invoiceInfoModal" title="<%= t('invoice.view_details') %>">
        <span class="material-symbols-outlined fs-6 align-middle">info</span>
      </button>
    </div>
  </div>

  <!-- Toggle Collapse Detail -->
  <div class="mb-4">
    <a class="text-decoration-none fw-bold d-inline-flex align-items-center gap-1 invoice-collapse-toggle d-print-none" data-bs-toggle="collapse" href="#invoiceDetailCollapse" role="button" aria-expanded="true" aria-controls="invoiceDetailCollapse">
      <span><%= t('invoice.view_details') %></span>
      <span class="material-symbols-outlined fs-6">expand_circle_up</span>
    </a>
  </div>

  <div class="collapse show" id="invoiceDetailCollapse">
    <!-- Lý do thu tiền -->
    <div class="mb-3">
      <span class="fw-bold"><%= t('invoice.reason') %>:</span>
      <span class="text-secondary"><%= invoice.title.presence || t('invoice.default_title') %></span>
    </div>

    <!-- Diễn giải -->
    <div class="mb-4">
      <div class="fw-bold mb-2"><%= t('invoice.breakdown') %>:</div>

      <!-- 1. Tiền thuê nhà -->
      <% if invoice.rent_total > 0 %>
        <div class="mb-3 ps-2">
          <span class="text-primary fw-bold"><%= t('invoice.rent_fee') %>:</span>
          <span class="font-monospace fw-bold"><%= format_money(invoice.rent_total) %></span>
          <span class="text-secondary small">(<%= invoice.rent_period_text %>)</span>
        </div>
      <% end %>

      <!-- 2. Phí sử dụng dịch vụ -->
      <% if invoice.service_items.any? || (invoice.rent_total == 0 && invoice.discount_items.empty? && invoice.addition_items.empty?) %>
        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-primary fw-bold"><%= t('invoice.service_fee') %>:</span>
            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-secondary small d-inline-flex align-items-center gap-1 d-print-none" data-bs-toggle="modal" data-bs-target="#serviceInstructionsModal">
              <span class="material-symbols-outlined fs-6">help</span> <%= t('invoice.service_instructions') %>
            </button>
          </div>

          <div class="table-responsive rounded-3 border">
            <table class="table table-bordered align-middle mb-0 text-center invoice-items-table">
              <thead class="table-light">
                <tr>
                  <th class="text-start ps-3"><%= t('invoice.service_name') %></th>
                  <th><%= t('invoice.start_date') %></th>
                  <th><%= t('invoice.end_date') %></th>
                  <th><%= t('invoice.unit') %></th>
                  <th class="text-end"><%= t('invoice.unit_price') %></th>
                  <th><%= t('invoice.prev_reading') %></th>
                  <th><%= t('invoice.latest_reading') %></th>
                  <th><%= t('invoice.usage_quantity') %></th>
                  <th class="text-end pe-3"><%= t('invoice.amount') %></th>
                </tr>
              </thead>
              <tbody>
                <% invoice.service_items.each do |item| %>
                  <tr>
                    <td class="text-start ps-3 fw-semibold text-dark"><%= item.name %></td>
                    <td class="text-secondary"><%= format_date(item.effective_start_date(invoice)) %></td>
                    <td class="text-secondary"><%= format_date(item.effective_end_date(invoice)) %></td>
                    <td class="text-secondary"><%= item.unit %></td>
                    <td class="text-end font-monospace"><%= number_to_currency(item.unit_price, unit: "", precision: 0) %></td>
                    <td class="font-monospace text-secondary"><%= item.prev_reading.presence || "-" %></td>
                    <td class="font-monospace fw-bold text-primary"><%= item.latest_reading.presence || "-" %></td>
                    <td class="font-monospace fw-bold text-success"><%= item.quantity %></td>
                    <td class="text-end pe-3 font-monospace fw-bold text-dark">
                      <%= number_to_currency(item.amount, unit: "", precision: 0) %>
                    </td>
                  </tr>
                <% end %>
                <% if invoice.service_items.empty? %>
                  <tr>
                    <td colspan="9" class="text-secondary py-3"><%= t('invoice.no_services') %></td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot class="table-group-divider bg-light">
                <tr class="fw-bold">
                  <td colspan="8" class="text-start ps-3"><%= t('invoice.total_services') %>:</td>
                  <td class="text-end pe-3 font-monospace fs-6 text-dark">
                    <%= number_to_currency(invoice.services_total, unit: "", precision: 0) %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      <% end %>

      <!-- 3. Khoản được giảm (nếu có) -->
      <% if invoice.discount_items.any? %>
        <div class="mb-4">
          <span class="text-danger fw-bold d-block mb-2"><%= t('invoice.discount_items') %>:</span>
          <div class="table-responsive rounded-3 border invoice-subtable-wrapper">
            <table class="table table-bordered align-middle mb-0 invoice-items-table">
              <thead class="table-light">
                <tr>
                  <th class="ps-3"><%= t('invoice.discount_reason') %></th>
                  <th class="text-end pe-3 th-subtable-amount"><%= t('invoice.discount_amount') %></th>
                </tr>
              </thead>
              <tbody>
                <% invoice.discount_items.each do |item| %>
                  <tr>
                    <td class="ps-3 text-dark"><%= item.name %></td>
                    <td class="text-end pe-3 font-monospace text-danger fw-semibold">
                      <%= number_to_currency(item.amount.abs, unit: "", precision: 0) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot class="table-group-divider bg-light">
                <tr class="fw-bold">
                  <td class="ps-3"><%= t('invoice.total_services') %>:</td>
                  <td class="text-end pe-3 font-monospace text-danger">
                    <%= number_to_currency(invoice.discounts_total, unit: "", precision: 0) %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      <% end %>

      <!-- 4. Khoản cộng thêm (nếu có) -->
      <% if invoice.addition_items.any? %>
        <div class="mb-4">
          <span class="text-primary fw-bold d-block mb-2"><%= t('invoice.addition_items') %>:</span>
          <div class="table-responsive rounded-3 border invoice-subtable-wrapper">
            <table class="table table-bordered align-middle mb-0 invoice-items-table">
              <thead class="table-light">
                <tr>
                  <th class="ps-3"><%= t('invoice.addition_reason') %></th>
                  <th class="text-end pe-3 th-subtable-amount"><%= t('invoice.addition_amount') %></th>
                </tr>
              </thead>
              <tbody>
                <% invoice.addition_items.each do |item| %>
                  <tr>
                    <td class="ps-3 text-dark"><%= item.name %></td>
                    <td class="text-end pe-3 font-monospace text-primary fw-semibold">
                      <%= number_to_currency(item.amount, unit: "", precision: 0) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot class="table-group-divider bg-light">
                <tr class="fw-bold">
                  <td class="ps-3"><%= t('invoice.total_services') %>:</td>
                  <td class="text-end pe-3 font-monospace text-primary">
                    <%= number_to_currency(invoice.additions_total, unit: "", precision: 0) %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      <% end %>

      <!-- 5. Ghi chú -->
      <% if invoice.note.present? %>
        <div class="text-secondary small mt-3">
          <strong><%= t('invoice.note') %>:</strong> <%= invoice.note %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Thông tin Chuyển khoản VietQR -->
  <div class="pt-4 border-top">
    <h6 class="fw-bold text-dark mb-3"><%= t('invoice.bank_transfer_info') %>:</h6>
    <div class="row align-items-center g-4">
      <div class="col-md-4 text-center text-md-start">
        <% if bank_account && qr_url %>
          <div class="d-inline-block bg-white p-2 border rounded-3 shadow-sm text-center position-relative cursor-pointer" data-bs-toggle="modal" data-bs-target="#zoomQrModal" title="<%= t('invoice.vietqr.click_to_zoom') %>">
            <div class="small fw-bold text-danger mb-1 font-monospace d-flex justify-content-between align-items-center px-1">
              <span>VIETQR</span>
              <span class="material-symbols-outlined text-secondary fs-6 d-print-none">zoom_in</span>
            </div>
            <%= image_tag qr_url, alt: t('invoice.vietqr.qr_alt'), class: "rounded vietqr-thumb-img" %>
            <div class="small text-secondary mt-1 font-monospace vietqr-account-subtext">
              <%= bank_account.bank.code %> - <%= bank_account.account_number %>
            </div>
          </div>
        <% else %>
          <div class="p-3 bg-light rounded-3 text-secondary small border d-flex align-items-center gap-2">
            <span class="material-symbols-outlined text-warning fs-5">warning</span>
            <span><%= current_user.landlord? ? t('invoice.no_bank_account_landlord') : t('invoice.no_bank_account_tenant') %></span>
          </div>
        <% end %>
      </div>

      <div class="col-md-8">
        <div class="ps-md-2 invoice-warning-text">
          <% if invoice.undo_reason.present? && !invoice.paid? %>
            <div class="undo-reason-banner mb-3">
              <div class="d-flex align-items-center gap-2 undo-reason-title mb-1">
                <span class="material-symbols-outlined fs-5 text-danger">warning</span>
                <span><%= t('invoice.previous_undo_alert') %></span>
                <% if invoice.undone_at.present? %>
                  <span class="text-secondary fw-normal small">(<%= format_datetime(invoice.undone_at) %>)</span>
                <% end %>
              </div>
              <p class="undo-reason-text"><strong><%= t('invoice.undo_reason_view') %>:</strong> <%= invoice.undo_reason %></p>
            </div>
          <% end %>

          <p class="text-danger mb-2"><%= t('invoice.warning_check') %></p>
          <p class="text-danger mb-2"><%= t('invoice.warning_report') %></p>
          <p class="text-danger mb-4"><%= t('invoice.warning_proof') %></p>

          <!-- Dynamic Action Slot -->
          <% if block_given? %>
            <%= yield %>
          <% elsif local_assigns[:actions_partial].present? %>
            <%= render actions_partial, invoice: invoice %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
