<% content_for :title, t("admin.notifications.title") %>

<div class="d-flex flex-column align-items-center gap-2 pb-3 mb-4 border-bottom">
  <h1 class="admin-title"><%= t("admin.notifications.title") %></h1>
  <p class="text-secondary text-center mb-0">
    <%= t("admin.notifications.subtitle") %>
  </p>
</div>

<!-- Filter Form -->
<div class="mb-5">
  <%= form_with url: admin_notifications_path, method: :get,
                class: "row g-3 align-items-center justify-content-center",
                data: {
                  controller: "search",
                  turbo_frame: "admin_notifications_table",
                  turbo_action: "advance"
                } do |f| %>

    <!-- Time Range Filter (From Date - To Date, limited up to today) with Floating Label -->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
      <div class="position-relative border rounded-3 bg-white shadow-sm px-3 pt-2 pb-1" style="min-height: 58px;">
        <label class="text-secondary small fw-medium d-flex align-items-center gap-1 mb-0" style="font-size: 0.75rem; line-height: 1;">
          <span class="material-symbols-outlined fs-6">calendar_month</span>
          <span><%= t("admin.notifications.sent_time", default: "Thời gian gửi") %></span>
        </label>
        <div class="d-flex align-items-center gap-2 mt-1">
          <label for="from_date" class="text-secondary small"><%= t("admin.notifications.from_date", default: "Từ") %></label>
          <%= f.date_field :from_date,
              value: @from_date,
              max: Date.current,
              id: "from_date",
              class: "form-control form-control-sm border-0 p-0 shadow-none bg-transparent",
              data: {
                action: "change->search#changed"
              } %>
          <label for="to_date" class="text-secondary small"><%= t("admin.notifications.to_date", default: "Đến") %></label>
          <%= f.date_field :to_date,
              value: @to_date.presence || Date.current,
              max: Date.current,
              id: "to_date",
              class: "form-control form-control-sm border-0 p-0 shadow-none bg-transparent",
              data: {
                default_value: Date.current.to_s,
                action: "change->search#changed"
              } %>
        </div>
      </div>
    </div>

    <!-- Priority / Level Filter -->
    <div class="col-6 col-sm-6 col-md-3 col-xl-2">
      <div class="form-floating shadow-sm rounded">
        <%= f.select :level,
            options_for_select([
              [t("admin.notifications.filter.all_priorities"), ""],
              [t("admin.notifications.levels.info"), "info"],
              [t("admin.notifications.levels.warning"), "warning"],
              [t("admin.notifications.levels.urgent"), "urgent"]
            ], @level),
            {},
            class: "form-select shadow-none",
            id: "floatingLevelSelect",
            data: {
              action: "change->search#changed"
            } %>
        <label for="floatingLevelSelect" class="text-secondary small fw-medium">
          <%= t("admin.notifications.filter.filter_priority") %>
        </label>
      </div>
    </div>

    <!-- Recipients / Target Audience Filter -->
    <div class="col-6 col-sm-6 col-md-3 col-xl-2">
      <div class="form-floating shadow-sm rounded">
        <%= f.select :audience,
            options_for_select([
              [t("admin.notifications.filter.all_recipients"), ""],
              [t("admin.notifications.audience.all"), "all"],
              [t("admin.notifications.audience.landlords"), "landlords"],
              [t("admin.notifications.audience.tenants"), "tenants"]
            ], @audience),
            {},
            class: "form-select shadow-none",
            id: "floatingAudienceSelect",
            data: {
              action: "change->search#changed"
            } %>
        <label for="floatingAudienceSelect" class="text-secondary small fw-medium">
          <%= t("admin.notifications.filter.filter_recipients") %>
        </label>
      </div>
    </div>

    <!-- Clear Filter Button -->
    <div class="col-auto <%= 'd-none' unless @from_date.present? || (@to_date.present? && @to_date != Date.current.to_s) || @level.present? || @audience.present? %>" data-search-target="clearButton">
      <button type="button"
              class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm px-3"
              data-action="click->search#clear">
        <span class="material-symbols-outlined fs-6">filter_alt_off</span>
        <span class="small"><%= t("clear_filter") %></span>
      </button>
    </div>
  <% end %>
</div>

<!-- History Table (Turbo Frame) -->
<%= render "table" %>
