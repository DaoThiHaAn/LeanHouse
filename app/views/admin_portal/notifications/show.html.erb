<%
  p = (@event.params || {}).with_indifferent_access
  lvl = p[:level].presence || "info"
  aud = p[:target_audience].presence || "all"
  sender_name = p[:sender_name].presence || @event.record&.fullname || t("admin.self")
%>

<% content_for :title, "#{t('admin.notifications.show_title')}: #{p['title']}" %>

<!-- Top Back & Actions Bar -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <%= link_to admin_notifications_path, class: "btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" do %>
    <span class="material-symbols-outlined fs-6">arrow_back</span>
    <span><%= t("admin.notifications.back_to_history") %></span>
  <% end %>

  <h1><%= t('admin.notifications.show_title') %></h1>

  <div>
    <span class="badge bg-secondary-subtle text-secondary border d-inline-flex align-items-center gap-1 px-3 py-2">
      <span class="material-symbols-outlined fs-6">lock</span>
      <span><%= t("admin.notifications.immutable_badge") %></span>
    </span>
  </div>
</div>

<!-- Main Broadcast Card -->
<div class="card border bg-white rounded-4 shadow-sm p-4 mb-4">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 pb-3 mb-3 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
        <%= notification_level_badge(lvl) %>
        <%= notification_audience_badge(aud) %>
      </div>

      <h2 class="h4 fw-bold text-dark mb-1"><%= p["title"] %></h2>
      <div class="text-secondary small">
        <%= t("admin.notifications.sent_by_at", sender: sender_name, time: format_date(@event.created_at) + " " + @event.created_at.strftime("%H:%M")) %>
      </div>
    </div>

    <!-- Read Rate Metric -->
    <div class="text-sm-end">
      <span class="stat-subtext text-secondary d-block"><%= t("admin.notifications.read_rate_label") %></span>
      <span class="fs-4 fw-bold font-monospace text-primary"><%= @read_rate %>%</span>
      <p class="small text-dark-emphasis">
        <%= @read_count %>/<%= @total_count %>
        <%= t("admin.notifications.recipients_read") %>
      </p>
    </div>
  </div>

  <!-- Message Body -->
  <div class="p-3 bg-light rounded-3 border mb-3">
    <div class="text-dark small lh-base">
      <%= simple_format(p["message"], class: "mb-0") %>
    </div>
  </div>

  <% if p["url"].present? %>
    <div class="d-flex align-items-center gap-2 pt-2 border-top">
      <span class="text-secondary small fw-medium"><%= t("admin.notifications.action_link") %>:</span>
      <a href="<%= p['url'] %>" target="_blank" class="text-primary font-monospace small d-inline-flex align-items-center gap-1">
        <span><%= p["url"] %></span>
        <span class="material-symbols-outlined fs-6">open_in_new</span>
      </a>
    </div>
  <% end %>
</div>

<!-- Recipients Delivery Log Table -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="d-flex align-items-center gap-2 mb-0 ms-2">
    <span class="material-symbols-filled fs-4">people</span>
    <span><%= t("admin.notifications.recipient_list_title") %></span>
  </h2>
  <span class="badge bg-light text-secondary border">
    <%= t("admin.notifications.total_recipients_count", count: @total_count) %>
  </span>
</div>

<div class="table-responsive border bg-white rounded-3 shadow-sm mb-4">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th class="ps-3"><%= t("form.profile.fullname") %></th>
        <th><%= t("form.profile.tel") %></th>
        <th><%= t("role.self") %></th>
        <th><%= t("admin.notifications.table.read_status") %></th>
        <th class="text-end pe-3"><%= t("admin.notifications.table.read_at") %></th>
      </tr>
    </thead>
    <tbody>
      <% @notifications.each do |noti| %>
        <% user = noti.recipient %>
        <tr>
          <td class="ps-3 fw-medium text-dark">
            <%= user&.fullname || t("unknown") %>
          </td>
          <td class="font-monospace small text-secondary">
            <%= user&.tel || "-" %>
          </td>
          <td>
            <% if user&.landlord? %>
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"><%= t("role.landlord") %></span>
            <% else %>
              <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><%= t("role.tenant") %></span>
            <% end %>
          </td>
          <td>
            <% if noti.read? %>
              <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 d-inline-flex align-items-center gap-1">
                <span class="material-symbols-outlined fs-6">done_all</span>
                <%= t("noti.read") %>
              </span>
            <% else %>
              <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 d-inline-flex align-items-center gap-1">
                <span class="material-symbols-outlined fs-6">schedule</span>
                <%= t("noti.unread") %>
              </span>
            <% end %>
          </td>
          <td class="text-end pe-3 font-monospace small text-secondary">
            <% if noti.read_at.present? %>
              <%= format_date(noti.read_at) %> <%= noti.read_at.strftime("%H:%M") %>
            <% else %>
              -
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="d-flex justify-content-center">
  <%= paginate @notifications %>
</div>
