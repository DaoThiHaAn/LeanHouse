<% content_for :title, t("page_titles.admin_dashboard") %>

<div class="dashboard-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-3 mb-4 border-bottom">
  <div>
    <h1 class="mb-3 admin-title"><%= t("admin.dashboard.title") %></h1>
    <p class="text-secondary">
      <%= t("admin.dashboard.subtitle") %>
    </p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 d-flex align-items-center gap-1">
      <span class="material-symbols-outlined fs-5">cloud_done</span>
      <span><%= t("admin.dashboard.system_healthy") %></span>
    </span>
  </div>
</div>

<!-- KPI Stat Cards Row -->
<div class="row g-4 mb-5">
  <!-- Landlords Card -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="admin-stat-card admin-stat-purple">
      <div class="d-flex align-items-start justify-content-between">
        <div class="d-flex gap-3 align-items-center">
          <span class="material-symbols-filled fs-1 admin-stat-icon">real_estate_agent</span>
          <div>
            <div class="fw-bold text-secondary small text-uppercase"><%= t("admin.dashboard.landlords") %></div>
            <div class="fs-3 fw-bold admin-stat-number"><%= @stats.total_landlords %></div>
          </div>
        </div>
        <%= link_to admin_users_path(role: 'landlord'), class: "action-arrow-btn text-decoration-none text-secondary", title: t("admin.dashboard.view_list") do %>
          <span class="material-symbols-outlined">arrow_forward</span>
        <% end %>
      </div>
      <div class="mt-3 pt-2 border-top small text-secondary d-flex justify-content-between">
        <span><%= t("admin.dashboard.active_count") %>: <strong class="text-success"><%= @stats.active_landlords %></strong></span>
        <span><%= t("admin.dashboard.locked_count") %>: <strong class="text-danger"><%= @stats.locked_landlords %></strong></span>
      </div>
    </div>
  </div>

  <!-- Tenants Card -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="admin-stat-card admin-stat-green">
      <div class="d-flex align-items-start justify-content-between">
        <div class="d-flex gap-3 align-items-center">
          <span class="material-symbols-filled fs-1 admin-stat-icon">groups</span>
          <div>
            <div class="fw-bold text-secondary small text-uppercase"><%= t("admin.dashboard.tenants") %></div>
            <div class="fs-3 fw-bold admin-stat-number"><%= @stats.total_tenants %></div>
          </div>
        </div>
        <%= link_to admin_users_path(role: 'tenant'), class: "action-arrow-btn text-decoration-none text-secondary", title: t("admin.dashboard.view_list") do %>
          <span class="material-symbols-outlined">arrow_forward</span>
        <% end %>
      </div>
      <div class="mt-3 pt-2 border-top small text-secondary d-flex justify-content-between">
        <span><%= t("admin.dashboard.active_count") %>: <strong class="text-success"><%= @stats.active_tenants %></strong></span>
        <span><%= t("admin.dashboard.locked_count") %>: <strong class="text-danger"><%= @stats.locked_tenants %></strong></span>
      </div>
    </div>
  </div>

  <!-- Houses Card -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="admin-stat-card admin-stat-blue">
      <div class="d-flex align-items-start justify-content-between">
        <div class="d-flex gap-3 align-items-center">
          <span class="material-symbols-filled fs-1 admin-stat-icon">home_work</span>
          <div>
            <div class="fw-bold text-secondary small text-uppercase"><%= t("admin.dashboard.houses") %></div>
            <div class="fs-3 fw-bold admin-stat-number"><%= @stats.total_houses %></div>
          </div>
        </div>
        <%= link_to admin_houses_path, class: "action-arrow-btn text-decoration-none text-secondary", title: t("admin.dashboard.view_houses") do %>
          <span class="material-symbols-outlined">arrow_forward</span>
        <% end %>
      </div>
      <div class="mt-3 pt-2 border-top small text-secondary d-flex justify-content-between">
        <span><%= t("admin.dashboard.room_houses") %>: <strong><%= @stats.room_houses %></strong></span>
        <span><%= t("admin.dashboard.bed_houses") %>: <strong><%= @stats.bed_houses %></strong></span>
      </div>
    </div>
  </div>

  <!-- Active Contracts & Rooms Card -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="admin-stat-card admin-stat-orange">
      <div class="d-flex align-items-start justify-content-between">
        <div class="d-flex gap-3 align-items-center">
          <span class="material-symbols-filled fs-1 admin-stat-icon">contract</span>
          <div>
            <div class="fw-bold text-secondary small text-uppercase"><%= t("admin.dashboard.contracts") %></div>
            <div class="fs-3 fw-bold admin-stat-number"><%= @stats.active_contracts %></div>
          </div>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top small text-secondary">
        <span><%= t("admin.dashboard.new_this_month", month: Date.current.strftime("%m/%Y")) %>: <strong class="text-success">+<%= @stats.new_contracts_this_month %></strong></span>
      </div>
    </div>
  </div>
</div>

<!-- Lower Section: Recent Users & Recent Houses -->
<div class="row g-4">
  <!-- Recent Users Table -->
  <div class="col-12 col-lg-7">
    <div class="card admin-card h-100">
      <div class="card-header bg-white py-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 border-bottom">
        <div>
          <h2 class="mb-2 d-flex align-items-center gap-2 fs-5">
            <span class="material-symbols-filled fs-3">user_attributes</span>
            <span><%= t("admin.dashboard.recent_users") %></span>
          </h2>

          <div class="d-flex align-items-center gap-2">
            <div class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
              <%= t("admin.dashboard.this_month_badge", count: @stats.new_users_this_month, month: Date.current.strftime("%m/%Y")) %>
            </div>

            <p class="small text-secondary">
              <%= t("admin.dashboard.new_users_month_summary", count: @stats.new_users_this_month, landlords: @stats.new_landlords_this_month, tenants: @stats.new_tenants_this_month, month: Date.current.strftime("%m/%Y")) %>
            </p>
          </div>
        </div>
        <%= link_to admin_users_path, class: "btn btn-sm btn-outline-secondary flex-shrink-0" do %>
          <%= t("view_all") %>
        <% end %>
      </div>
      <div class="card-body p-0">
        <%= turbo_frame_tag "admin_recent_users", src: recent_users_admin_dashboard_path, loading: :lazy do %>
          <%= loading_spinner %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Recent Houses Table -->
  <div class="col-12 col-lg-5">
    <div class="card admin-card h-100">
      <div class="card-header bg-white py-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 border-bottom">
        <div>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <h2 class="mb-0 d-flex align-items-center gap-2 fs-5">
              <span class="material-symbols-filled fs-3">house</span>
              <span><%= t("admin.dashboard.recent_houses") %></span>
            </h2>
            <div class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">
              <%= t("admin.dashboard.this_month_badge", count: @stats.new_houses_this_month, month: Date.current.strftime("%m/%Y")) %>
            </div>
          </div>
          <div class="small text-secondary mt-1">
            <%= t("admin.dashboard.new_houses_month_summary", count: @stats.new_houses_this_month, room_houses: @stats.new_room_houses_this_month, bed_houses: @stats.new_bed_houses_this_month, month: Date.current.strftime("%m/%Y")) %>
          </div>
        </div>
        <%= link_to admin_houses_path, class: "btn btn-sm btn-outline-secondary flex-shrink-0" do %>
          <%= t("view_all") %>
        <% end %>
      </div>
      <div class="card-body p-0">
        <%= turbo_frame_tag "admin_recent_houses", src: recent_houses_admin_dashboard_path, loading: :lazy do %>
          <%= loading_spinner %>
        <% end %>
      </div>
    </div>
  </div>
</div>
