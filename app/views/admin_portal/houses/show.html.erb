<% content_for :title, t("page_titles.admin_house_detail") %>

<div class="d-flex align-items-center gap-3 mb-5">
  <%= back_link_to admin_houses_path, t("admin.houses.back_to_list") %>
  <h1 class="flex-grow-1 text-center mb-0"><%= t("page_titles.admin_house_detail") %></h1>
</div>

<div class="row g-4">
  <!-- Left Column: House Sidebar -->
  <div class="col-12 col-lg-4 col-xl-3">
    <%= render "admin_portal/houses/house_sidebar", house: @house, active_tab: :structure %>
  </div>

  <!-- Right Column: Main Content (Turbo Frame) -->
  <div class="col-12 col-lg-8 col-xl-9">
    <%= turbo_frame_tag "house_tab_content", data: { turbo_action: "advance" } do %>
      <div class="d-flex flex-column gap-3">
        <!-- Header & Search/Filter Card -->
        <div class="card admin-card shadow-sm">
          <div class="card-header border-0 bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 class="d-flex align-items-center gap-2 mb-0">
              <span class="material-symbols-outlined fs-3">layers</span>
              <%= t("admin.houses.floors_and_rooms_structure") %>
            </h2>
            <span class="badge bg-light text-secondary border">
              <%= @total_rooms_count %> <%= t("form.room.self").downcase %>
            </span>
          </div>

          <!-- Room Filter & Search Form -->
          <div class="card-body p-3 room-search-form-container">
            <%= form_with url: admin_house_path(@house), method: :get, local: true, class: "row g-2 align-items-center",
                data: {
                  controller: "search",
                  turbo_frame: "admin_house_rooms",
                  turbo_action: "advance"
                } do |f| %>
              <!-- Room Name Search Input -->
              <div class="col-12 col-sm-6 col-md-4">
                <div class="input-group rounded-3 overflow-hidden shadow-sm transition-all">
                  <span class="input-group-text border-0 bg-white pe-1">
                    <span class="material-symbols-outlined fs-6 text-secondary">search</span>
                  </span>
                  <%= f.search_field :q,
                                     value: @query,
                                     placeholder: t("admin.houses.search_room_placeholder"),
                                     class: "form-control border-0 ps-2 bg-white",
                                     data: {
                                       search_target: "input",
                                       action: "input->search#debounce search->search#debounce"
                                     } %>
                </div>
              </div>

              <!-- Floor Dropdown Filter -->
              <div class="col-6 col-sm-6 col-md-3">
                <div class="form-floating shadow-sm rounded-3">
                  <%= f.select :floor_id,
                               options_for_select([[t("admin.houses.all_floors"), ""]] + @floors.map { |fl| ["#{fl.title_name} (#{fl.rooms_count})", fl.id] }, @floor_filter),
                               {},
                               class: "form-select border-0",
                               id: "floatingFloorSelect",
                               data: {
                                 action: "change->search#changed"
                               } %>
                  <label for="floatingFloorSelect" class="text-secondary small fw-medium">
                    <%= t("admin.houses.floor_filter") %>
                  </label>
                </div>
              </div>

              <!-- Occupancy Status Filter -->
              <div class="col-6 col-sm-6 col-md-3">
                <div class="form-floating shadow-sm rounded-3">
                  <%= f.select :status,
                               options_for_select([
                                 [t("admin.houses.all_occupancy"), ""],
                                 [t("admin.houses.filter_vacant"), "available"],
                                 [t("admin.houses.filter_occupied"), "occupied"],
                                 [t("admin.houses.filter_full"), "full"]
                               ], @status_filter),
                               {},
                               class: "form-select border-0",
                               id: "floatingStatusSelect",
                               data: {
                                 action: "change->search#changed"
                               } %>
                  <label for="floatingStatusSelect" class="text-secondary small fw-medium">
                    <%= t("admin.houses.occupancy_filter") %>
                  </label>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="col-12 col-sm-6 col-md-2 d-flex gap-2 justify-content-end">
                <button type="button"
                        class="btn btn-outline-secondary d-flex align-items-center gap-1 <%= 'd-none' unless @query.present? || @floor_filter.present? || @status_filter.present? %>"
                        data-search-target="clearButton"
                        data-action="click->search#clear"
                        title="<%= t('clear_filter') %>">
                  <span class="material-symbols-outlined fs-6">filter_alt_off</span>
                  <span class="d-none d-md-inline"><%= t("clear_filter") %></span>
                </button>
              </div>
            <% end %>
          </div>

          <!-- Batched Rooms Grid -->
          <%= turbo_frame_tag "admin_house_rooms",
                data: {
                  turbo_action: "advance",
                  controller: "pagination-sync",
                  pagination_sync_canonical_url_value: admin_house_path(@house),
                  pagination_sync_default_params_value: { floor_id: "", status: "", q: "" }.to_json,
                  pagination_sync_query_params_value: ["floor_id", "status", "q"].to_json,
                  pagination_sync_total_pages_selector_value: "[data-pagination-total-pages]",
                  action: "turbo:frame-load->pagination-sync#updateUrl"
                } do %>
            <!-- Used by stimulus to update url -->
            <span hidden data-pagination-total-pages="<%= @rooms.total_pages %>"></span>

            <div class="card-body p-3">
            <% if @rooms.any? %>
              <div class="row g-3 mb-3">
                <% @rooms.each do |room| %>
                  <% if @house.room? %>
                    <%# ROOM MODE %>
                    <div class="col-12 col-sm-6 col-xl-4">
                      <div class="bg-white border rounded-3 p-3 shadow-sm h-100 d-flex flex-column justify-content-between">
                        <div>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-primary fs-6"><%= room.title_name %></strong>
                            <small class="text-secondary"><%= room.area %> m²</small>
                          </div>
                          <div class="small text-secondary mb-2"><%= room.floor.title_name %></div>

                          <div class="small text-secondary d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <span><%= t("admin.houses.room_rent") %>:</span>
                            <strong class="text-dark"><%= room_rent_display(@house, room) %></strong>
                          </div>

                          <div class="small text-secondary d-flex justify-content-between align-items-center mb-2">
                            <span><%= t("admin.houses.occupancy") %>:</span>
                            <span class="badge <%= room.tenants_count >= room.max_slots && room.max_slots > 0 ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-light text-dark border' %>">
                              <%= room.tenants_count %> / <%= room.max_slots %>
                            </span>
                          </div>
                        </div>

                        <div class="pt-2 border-top">
                          <div class="small text-secondary mb-1 fw-semibold"><%= t("admin.houses.current_tenants") %>:</div>
                          <% if room.staying_tenants.any? %>
                            <div class="d-flex flex-column gap-1 admin-tenant-list-scroll pe-1">
                              <% room.staying_tenants.each do |st| %>
                                <div class="d-flex align-items-center justify-content-between small bg-light rounded px-2 py-1">
                                  <div class="d-flex align-items-center gap-1 text-truncate">
                                    <span class="material-symbols-outlined fs-6 text-secondary">person</span>
                                    <%= link_to st.user.fullname, admin_user_path(st.user), class: "link-primary fw-semibold text-truncate" %>
                                  </div>
                                  <span class="font-monospace text-secondary small ms-1"><%= st.user.tel %></span>
                                </div>
                              <% end %>
                            </div>
                          <% else %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                              <%= t("admin.houses.vacant") %>
                            </span>
                          <% end %>
                        </div>
                      </div>
                    </div>

                  <% else %>
                    <%# BED MODE %>
                    <% active_beds = room.beds.reject(&:deleted?).sort_by(&:name) %>
                    <div class="col-12 col-lg-6 col-xl-6">
                      <div class="bg-white border rounded-3 p-3 shadow-sm h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1 pb-1">
                          <div>
                            <strong class="text-primary fs-6"><%= room.title_name %></strong>
                            <small class="text-secondary ms-2"><%= room.area %> m²</small>
                          </div>
                          <span class="badge <%= room.tenants_count >= room.max_slots && room.max_slots > 0 ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle' %>">
                            <%= t("admin.houses.occupied_slots") %>: <%= room.tenants_count %>/<%= room.max_slots %>
                          </span>
                        </div>
                        <div class="small text-secondary mb-2"><%= room.floor.title_name %></div>

                        <div class="small text-secondary mb-2 fw-semibold pt-2 border-top">
                          <%= t("admin.houses.beds_list") %> (<%= active_beds.size %>):
                        </div>

                        <% if active_beds.any? %>
                          <div class="d-flex flex-column gap-2 admin-bed-list-scroll pe-1">
                            <% active_beds.each do |bed| %>
                              <% tenant_user = bed.staying_tenant&.user %>
                              <div class="d-flex flex-wrap justify-content-between align-items-center bg-light rounded p-2 small border gap-1">
                                <div class="d-flex align-items-center gap-2">
                                  <span class="material-symbols-outlined fs-5 text-secondary">single_bed</span>
                                  <div>
                                    <strong class="text-dark"><%= t("form.bed.self") %> <%= bed.name %></strong>
                                    <span class="text-secondary ms-1">(<%= number_with_delimiter(bed.rental_unit&.rent || 0) %>đ)</span>
                                  </div>
                                </div>

                                <div>
                                  <% if tenant_user %>
                                    <div class="d-flex align-items-center gap-1">
                                      <span class="material-symbols-outlined fs-6 text-secondary">person</span>
                                      <%= link_to tenant_user.fullname, admin_user_path(tenant_user), class: "link-primary fw-semibold" %>
                                      <span class="font-monospace text-secondary small ms-1">(<%= tenant_user.tel %>)</span>
                                    </div>
                                  <% else %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                      <%= t("admin.houses.vacant") %>
                                    </span>
                                  <% end %>
                                </div>
                              </div>
                            <% end %>
                          </div>
                        <% else %>
                          <p class="text-secondary small mb-0 fst-italic"><%= t("admin.houses.no_beds") %></p>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>

              <!-- Pagination Bar for High-Volume Rooms -->
              <div class="d-flex justify-content-center mt-3">
                <%= paginate @rooms, params: { floor_id: @floor_filter, q: @query, status: @status_filter } %>
              </div>

            <% else %>
              <div class="text-center text-secondary py-5">
                <span class="material-symbols-outlined fs-1 text-secondary mb-2">meeting_room</span>
                <p class="mb-0"><%= t("admin.houses.no_rooms_found") %></p>
              </div>
            <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
