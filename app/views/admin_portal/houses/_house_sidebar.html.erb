<%# Locals: house, active_tab %>
<% active_tab ||= :structure %>

<!-- House General Info Card -->
<div class="card admin-card mb-3 mb-lg-4 shadow-sm">
  <div class="card-header bg-white py-3 border-bottom">
    <h2 class="h5 mb-0 d-flex align-items-center gap-2">
      <span class="material-symbols-filled fs-3 text-primary">house</span>
      <%= t("admin.houses.house_info") %>
    </h2>
  </div>
  <div class="card-body p-3 d-flex flex-column gap-2">
    <div>
      <h3 class="fs-5 fw-bold text-dark mb-1"><%= house.name %></h3>
      <p class="text-muted small mb-0 text-break"><%= [house.address_l1, house.address_l2, house.address_l3].compact_blank.join(", ") %></p>
    </div>

    <div class="pt-2 border-top">
      <div class="small text-muted mb-1"><%= t("admin.houses.owner") %>:</div>
      <% if house.landlord&.user %>
        <%= link_to house.landlord.user.fullname, admin_user_path(house.landlord.user), class: "link fw-bold" %>
        <div class="small text-muted font-monospace"><%= house.landlord.user.tel %></div>
      <% else %>
        <span class="text-muted">-</span>
      <% end %>
    </div>

    <div class="pt-2 border-top d-flex justify-content-between align-items-center">
      <span class="text-muted small"><%= t("admin.houses.rental_mode") %>:</span>
      <span class="badge <%= house.room? ? 'bg-primary-subtle text-primary border border-primary-subtle' : 'bg-info-subtle text-info border border-info-subtle' %>">
        <%= house.room? ? t("admin.houses.mode_room") : t("admin.houses.mode_bed") %>
      </span>
    </div>

    <div class="pt-2 border-top d-flex justify-content-between align-items-center">
      <span class="text-muted small"><%= t("admin.houses.scale") %>:</span>
      <span class="fw-semibold small"><%= house.floors_count %> <%= t("form.floor.self").downcase %> - <%= house.rooms.active.count %> <%= t("form.room.self").downcase %></span>
    </div>

    <div class="pt-2 border-top">
      <div class="small text-muted"><%= t("created_at") %>: <%= l(house.created_at, format: :default) rescue house.created_at.strftime("%d/%m/%Y") %></div>
    </div>
  </div>
</div>

<!-- House Navigation Menu -->
<div class="card admin-card shadow-sm">
  <div class="card-header bg-white py-2 py-lg-3 border-bottom">
    <h3 class="fs-6 fw-bold mb-0 text-muted text-uppercase small">
      <%= t("admin.houses.house_menu", default: "Danh mục quản lý") %>
    </h3>
  </div>
  <div class="card-body p-2">
    <div class="nav nav-pills d-flex flex-row flex-lg-column gap-1 overflow-x-auto pb-1 pb-lg-0 admin-sidebar-nav flex-nowrap" data-controller="admin-house-nav">
      <%= link_to admin_house_path(house),
                  class: "nav-link d-flex align-items-center justify-content-between px-3 py-2 flex-shrink-0 #{'active' if active_tab == :structure}",
                  data: {
                    turbo_frame: "house_tab_content",
                    turbo_action: "advance",
                    admin_house_nav_target: "link",
                    action: "click->admin-house-nav#select"
                  } do %>
        <div class="d-flex align-items-center gap-2">
          <span class="material-symbols-outlined fs-5">layers</span>
          <span><%= t("admin.houses.floors_and_rooms_structure") %></span>
        </div>
      <% end %>

      <%= link_to admin_house_services_path(house),
                  class: "nav-link d-flex align-items-center justify-content-between px-3 py-2 flex-shrink-0 #{'active' if active_tab == :services}",
                  data: {
                    turbo_frame: "house_tab_content",
                    turbo_action: "advance",
                    admin_house_nav_target: "link",
                    action: "click->admin-house-nav#select"
                  } do %>
        <div class="d-flex align-items-center gap-2">
          <span class="material-symbols-filled fs-5">bolt</span>
          <span><%= t("admin.houses.services_and_amenities") %></span>
        </div>
        <span class="badge bg-light text-secondary border small ms-2">
          <%= house.services.count %>
        </span>
      <% end %>

      <%= link_to admin_house_assets_path(house),
                  class: "nav-link d-flex align-items-center justify-content-between px-3 py-2 flex-shrink-0 #{'active' if active_tab == :assets}",
                  data: {
                    turbo_frame: "house_tab_content",
                    turbo_action: "advance",
                    admin_house_nav_target: "link",
                    action: "click->admin-house-nav#select"
                  } do %>
        <div class="d-flex align-items-center gap-2">
          <span class="material-symbols-filled fs-5">inventory_2</span>
          <span><%= t("admin.houses.assets_and_maintenance", default: "Tài sản & Bảo trì") %></span>
        </div>
        <span class="badge bg-light text-secondary border small ms-2">
          <%= house.assets.count %>
        </span>
      <% end %>
    </div>
  </div>
</div>
