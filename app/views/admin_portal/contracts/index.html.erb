<% content_for :title, t("page_titles.admin_house_contracts", house_name: @house.name) %>
<div class="d-flex align-items-center gap-3 mb-4">
  <%= back_link_to admin_houses_path, t("admin.houses.back_to_list") %>
  <h1 class="flex-grow-1 text-center mb-0"><%= t("page_titles.admin_house_detail") %></h1>
</div>
<div class="row g-4">
  <!-- Left Column: House Sidebar -->
  <div class="col-12 col-lg-4 col-xl-3">
    <%= render "admin_portal/houses/house_sidebar", house: @house, active_tab: :contracts %>
  </div>
  <!-- Right Column: Main Content (Turbo Frame) -->
  <div class="col-12 col-lg-8 col-xl-9">
    <%= turbo_frame_tag "house_tab_content", data: { turbo_action: "advance" } do %>
      <div class="d-flex flex-column gap-4">
        <!-- Header & KPIs Card -->
        <div class="card admin-card shadow-sm">
          <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 class="mb-0 d-flex align-items-center gap-2">
              <span class="material-symbols-filled fs-4">contract</span>
              <%= t("admin.contracts.title") %>
            </h2>
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-light text-secondary border">
                <%= @total_contracts_count %> <%= t("admin.contracts.items_unit") %>
              </span>
            </div>
          </div>
          <div class="card-body p-3 bg-light">
            <div class="row g-3 text-center text-sm-start">
              <div class="col-6 col-sm-3">
                <div class="small text-secondary mb-1"><%= t("admin.contracts.total_contracts") %>:</div>
                <strong class="fs-5 text-dark"><%= @total_contracts_count %></strong>
              </div>
              <div class="col-6 col-sm-3">
                <div class="small text-secondary mb-1"><%= t("admin.contracts.active_contracts") %>:</div>
                <strong class="fs-5 text-success"><%= @active_contracts_count %></strong>
              </div>
              <div class="col-6 col-sm-3">
                <div class="small text-secondary mb-1"><%= t("admin.contracts.state_nearly_due") %>:</div>
                <strong class="fs-5 text-warning-emphasis"><%= @nearly_due_count %></strong>
              </div>
              <div class="col-6 col-sm-3">
                <div class="small text-secondary mb-1"><%= t("admin.contracts.state_overdue") %>:</div>
                <strong class="fs-5 text-danger"><%= @overdue_count %></strong>
              </div>
            </div>
          </div>
        </div>
        <!-- Filters Bar -->
        <div class="room-search-form-container py-3">
          <%= form_with url: admin_house_contracts_path(@house),
                        method: :get,
                        data: {
                          controller: "search",
                          turbo_frame: "house_tab_content",
                          turbo_action: "advance"
                        },
                        class: "row g-3 align-items-center px-3" do |f| %>
            <div class="col-12 col-sm-6 col-md-5">
              <div class="input-group rounded-3 overflow-hidden shadow-sm">
                <span class="input-group-text border-0 bg-white pe-1">
                  <span class="material-symbols-outlined fs-6 text-secondary">search</span>
                </span>
                <%= f.search_field :q,
                                   value: @query,
                                   placeholder: t("admin.contracts.search_placeholder"),
                                   class: "form-control border-0 ps-2 bg-white",
                                   data: {
                                     search_target: "input",
                                     action: "input->search#debounce search->search#debounce"
                                   } %>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
              <div class="form-floating rounded-3">
                <%= f.select :state,
                             options_for_select([
                               [t("admin.contracts.all_states"), ""],
                               [t("admin.contracts.state_active"), "active"],
                               [t("admin.contracts.state_nearly_due"), "nearly_due"],
                               [t("admin.contracts.state_overdue"), "overdue"],
                               [t("admin.contracts.state_finished"), "finished"]
                             ], @state),
                             {},
                             class: "form-select shadow-sm border-0",
                             id: "floatingContractStateSelect",
                             onchange: "this.form.requestSubmit()" %>
                <label for="floatingContractStateSelect" class="text-secondary small fw-medium">
                  <%= t("admin.contracts.status") %>
                </label>
              </div>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
              <% if @query.present? || @state.present? %>
                <%= link_to admin_house_contracts_path(@house),
                            class: "btn btn-outline-secondary d-flex align-items-center justify-content-center gap-1 flex-grow-1 shadow-sm",
                            data: { turbo_frame: "house_tab_content", turbo_action: "advance" } do %>
                  <span class="material-symbols-outlined fs-6">filter_alt_off</span>
                  <span><%= t("admin.houses.clear_filter") %></span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
        <!-- Contracts Table Card -->
        <div class="card admin-card shadow-sm border">
          <div class="card-body p-0">
            <% if @contracts.any? %>
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th class="ps-3"><%= t("admin.contracts.contract_name") %></th>
                      <th><%= t("admin.contracts.tenant") %></th>
                      <th><%= t("admin.contracts.rental_unit") %></th>
                      <th><%= t("admin.contracts.duration") %></th>
                      <th><%= t("admin.contracts.deposit") %></th>
                      <th><%= t("admin.contracts.status") %></th>
                      <th class="text-end pe-3"><%= t("admin.contracts.actions") %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @contracts.each do |contract| %>
                      <% stay = @house.tenant_stay_for(contract.tenant_id) %>
                      <tr>
                        <td class="ps-3">
                          <%= link_to contract.name,
                                      admin_contract_path(contract),
                                      class: "fw-bold link text-dark",
                                      data: { turbo_frame: "contract_detail_modal" } %>
                        </td>
                        <td>
                          <% if contract.tenant&.user %>
                            <%= link_to contract.tenant.user.fullname,
                                        admin_user_path(contract.tenant.user),
                                        class: "link fw-semibold" %>
                            <div class="small text-secondary font-monospace"><%= contract.tenant.user.tel %></div>
                          <% else %>
                            <span class="text-secondary">-</span>
                          <% end %>
                        </td>
                        <td>
                          <% if stay&.rental_unit %>
                            <span class="badge bg-light text-dark border">
                              <%= stay.rental_unit.location_info %>
                            </span>
                          <% else %>
                            <span class="text-secondary small fst-italic">-</span>
                          <% end %>
                        </td>
                        <td>
                          <div class="small fw-semibold text-dark">
                            <%= l(contract.start_date, format: :default) rescue contract.start_date.strftime("%d/%m/%Y") %> → <%= l(contract.due_date, format: :default) rescue contract.due_date.strftime("%d/%m/%Y") %>
                          </div>
                        </td>
                        <td>
                          <% if contract.deposit_paid? %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                              <%= t("admin.users.deposit_paid") %>
                            </span>
                          <% else %>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                              <%= t("admin.users.deposit_unpaid") %>
                            </span>
                          <% end %>
                        </td>
                        <td>
                          <% if contract.end_date.present? %>
                            <span class="badge bg-secondary"><%= t("admin.contracts.state_finished") %></span>
                          <% elsif contract.due_date < Date.current %>
                            <span class="badge bg-danger"><%= t("admin.contracts.state_overdue") %></span>
                          <% elsif contract.due_date <= Date.current + Contract::NEARLY_DUE_DAYS.days %>
                            <span class="badge bg-warning text-dark"><%= t("admin.contracts.state_nearly_due") %></span>
                          <% else %>
                            <span class="badge bg-success"><%= t("admin.contracts.state_active") %></span>
                          <% end %>
                        </td>
                        <td class="text-end pe-3">
                          <%= link_to admin_contract_path(contract),
                                      class: "table-action",
                                      title: t("admin.contracts.view_detail"),
                                      data: { turbo_frame: "contract_detail_modal" } do %>
                            <span class="material-symbols-filled fs-5">visibility</span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
              <!-- Pagination Container -->
              <div class="d-flex justify-content-between align-items-center p-3 border-top bg-white flex-wrap gap-2">
                <div class="small text-secondary">
                  <%= t("admin.houses.total_houses", count: @contracts.total_count) rescue "#{t('admin.contracts.total_contracts')}: #{@contracts.total_count}" %>
                </div>
                <div>
                  <%= paginate @contracts, theme: "bootstrap-5" rescue paginate @contracts %>
                </div>
              </div>
            <% else %>
              <div class="text-center py-5">
                <div class="mb-3">
                  <span class="material-symbols-outlined fs-1 text-secondary">contract</span>
                </div>
                <h3 class="h5 text-secondary"><%= t("admin.contracts.no_contracts") %></h3>
                <p class="text-secondary small mb-0"><%= t("admin.contracts.no_contracts_hint") %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
