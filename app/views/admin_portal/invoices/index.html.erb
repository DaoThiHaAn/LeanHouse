<% content_for :title, t("page_titles.admin_house_invoices", house_name: @house.name) %>
<div class="d-flex align-items-center gap-3 mb-4">
  <%= back_link_to admin_houses_path, t("admin.houses.back_to_list") %>
  <h1 class="flex-grow-1 text-center mb-0"><%= t("page_titles.admin_house_detail") %></h1>
</div>
<div class="row g-4">
  <!-- Left Column: House Sidebar -->
  <div class="col-12 col-lg-4 col-xl-3">
    <%= render "admin_portal/houses/house_sidebar", house: @house, active_tab: :invoices %>
  </div>
  <!-- Right Column: Main Content (Turbo Frame) -->
  <div class="col-12 col-lg-8 col-xl-9">
    <%= turbo_frame_tag "house_tab_content", data: { turbo_action: "advance" } do %>
      <div class="d-flex flex-column gap-4">
        <!-- Header & KPIs Card -->
        <div class="card admin-card shadow-sm">
          <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 class="mb-0 d-flex align-items-center gap-2">
              <span class="material-symbols-filled fs-4">receipt_long</span>
              <%= t("admin.invoices.title") %>
            </h2>
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-light text-secondary border">
                <%= @total_invoices_count %> <%= t("admin.invoices.items_unit") %>
              </span>
            </div>
          </div>
          <div class="card-body p-3 bg-light">
            <div class="row g-3 text-center text-sm-start">
              <div class="col-6 col-sm-3">
                <div class="small text-secondary mb-1"><%= t("admin.invoices.total_invoices") %>:</div>
                <strong class="fs-5 text-dark"><%= @total_invoices_count %></strong>
              </div>
              <div class="col-6 col-sm-3">
                <div class="small text-secondary mb-1"><%= t("admin.invoices.state_paid") %>:</div>
                <strong class="fs-5 text-success"><%= @paid_invoices_count %></strong>
              </div>
              <div class="col-6 col-sm-3">
                <div class="small text-secondary mb-1"><%= t("admin.invoices.state_pending") %>:</div>
                <strong class="fs-5 text-warning-emphasis"><%= @pending_invoices_count %></strong>
              </div>
              <div class="col-6 col-sm-3">
                <div class="small text-secondary mb-1"><%= t("admin.invoices.state_overdue") %>:</div>
                <strong class="fs-5 text-danger"><%= @overdue_count || @overdue_invoices_count %></strong>
              </div>
            </div>
          </div>
        </div>
        <!-- Filters Bar -->
        <div class="room-search-form-container py-3">
          <%= form_with url: admin_house_invoices_path(@house),
                        method: :get,
                        data: {
                          controller: "search",
                          turbo_frame: "house_tab_content",
                          turbo_action: "advance"
                        },
                        class: "row g-3 align-items-center px-3" do |f| %>
            <div class="col-12 col-sm-6 col-md-5">
              <div class="input-group rounded-3 overflow-hidden shadow-sm">
                <span class="input-group-text bg-white border-end-0">
                  <span class="material-symbols-outlined text-secondary fs-5">search</span>
                </span>
                <%= f.search_field :q,
                                   value: @query,
                                   class: "form-control border-start-0 ps-0 shadow-none",
                                   placeholder: t("admin.invoices.search_placeholder"),
                                   data: {
                                     search_target: "input",
                                     action: "input->search#debounce search->search#debounce"
                                   } %>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
              <div class="input-group rounded-3 overflow-hidden shadow-sm">
                <span class="input-group-text bg-white border-end-0">
                  <span class="material-symbols-outlined text-secondary fs-5">filter_list</span>
                </span>
                <%= f.select :state,
                             [
                               [t("admin.invoices.all_states"), ""],
                               [t("admin.invoices.state_paid"), "paid"],
                               [t("admin.invoices.state_pending"), "pending"],
                               [t("admin.invoices.state_overdue"), "overdue"],
                               [t("admin.invoices.state_cancelled"), "cancelled"]
                             ],
                             { selected: @state },
                             {
                               class: "form-select border-start-0 ps-0 shadow-none",
                               data: { action: "change->search#changed" }
                             } %>
              </div>
            </div>
            <% if @query.present? || @state.present? %>
              <div class="col-12 col-md-3 text-md-end">
                <%= link_to admin_house_invoices_path(@house),
                            class: "btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1",
                            data: { turbo_frame: "house_tab_content", turbo_action: "advance" } do %>
                  <span class="material-symbols-outlined fs-6">close</span>
                  <span><%= t("admin.invoices.clear_filter") %></span>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
        <!-- Invoices Table Card -->
        <div class="card admin-card shadow-sm">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="ps-3"><%= t("admin.invoices.code") %></th>
                    <th><%= t("admin.invoices.target") %></th>
                    <th><%= t("admin.invoices.term") %></th>
                    <th><%= t("admin.invoices.due_date") %></th>
                    <th><%= t("admin.invoices.total_amount") %></th>
                    <th><%= t("admin.invoices.payment_method") %></th>
                    <th><%= t("admin.invoices.status") %></th>
                    <th class="text-end pe-3"><%= t("admin.invoices.actions") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% if @invoices.any? %>
                    <% @invoices.each do |inv| %>
                      <tr>
                        <td class="ps-3">
                          <%= link_to "##{inv.code}", admin_invoice_path(inv),
                                      class: "fw-bold link font-monospace",
                                      data: { turbo_frame: "invoice_detail_modal" } %>
                        </td>
                        <td>
                          <% if inv.individual? && inv.tenant %>
                            <div class="fw-semibold text-dark"><%= inv.tenant.user&.fullname %></div>
                            <div class="small text-secondary"><%= inv.room.title_name %></div>
                          <% else %>
                            <div class="fw-semibold text-dark"><%= inv.room.title_name %></div>
                            <div class="small text-secondary"><%= inv.room.floor.name %></div>
                          <% end %>
                        </td>
                        <td>
                          <span class="fw-semibold"><%= inv.billing_month.strftime("%m/%Y") %></span>
                        </td>
                        <td>
                          <span class="small <%= 'text-danger fw-bold' if inv.overdue? %>">
                            <%= inv.due_date ? inv.due_date.strftime("%d/%m/%Y") : "-" %>
                          </span>
                        </td>
                        <td>
                          <span class="fw-bold font-monospace text-primary">
                            <%= inv.formatted_total_amount %>
                          </span>
                        </td>
                        <td>
                          <% if inv.paid? %>
                            <span class="badge bg-light text-dark border">
                              <%= inv.cash? ? t("invoice.payment_methods.cash") : t("invoice.payment_methods.transfer") %>
                            </span>
                          <% else %>
                            <span class="text-secondary">-</span>
                          <% end %>
                        </td>
                        <td>
                          <% if inv.paid? %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                              <%= t("admin.invoices.state_paid") %>
                            </span>
                          <% elsif inv.cancelled? %>
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                              <%= t("admin.invoices.state_cancelled") %>
                            </span>
                          <% elsif inv.overdue? %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                              <%= t("admin.invoices.state_overdue") %>
                            </span>
                          <% else %>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                              <%= t("admin.invoices.state_pending") %>
                            </span>
                          <% end %>
                        </td>
                        <td class="text-end pe-3">
                          <%= link_to admin_invoice_path(inv),
                                      class: "table-action",
                                      title: t("admin.invoices.view_detail"),
                                      data: { turbo_frame: "invoice_detail_modal" } do %>
                            <span class="material-symbols-filled fs-5">visibility</span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  <% else %>
                    <tr>
                      <td colspan="8" class="text-center text-secondary py-4">
                        <%= t("admin.invoices.no_invoices_found") %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <% if @invoices.total_pages > 1 %>
              <div class="card-footer bg-white border-top py-3 d-flex justify-content-center">
                <%= paginate @invoices %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
