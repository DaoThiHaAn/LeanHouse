<% content_for :title, t("page_titles.admin_issue_reports") %>

<div class="d-flex flex-column align-items-center gap-3 pb-3 mb-4 border-bottom">
  <h1 class="admin-title mb-0"><%= t("admin.issue_reports.title") %></h1>
  <p class="text-secondarytext-center">
    <%= t("admin.issue_reports.subtitle") %>
  </p>
</div>

<!-- Search & Filter Form (AJAX via Turbo Frame and Stimulus SearchController) -->
<div class="mb-5">
  <%= form_with url: admin_issue_reports_path, method: :get,
                class: "row g-3 align-items-center justify-content-center",
                data: {
                  controller: "search",
                  turbo_frame: "admin_issue_reports_table",
                  turbo_action: "advance"
                } do |f| %>

    <!-- Search Input -->
    <div class="col-12 col-sm-6 col-lg-4">
      <div class="input-group border rounded-3 overflow-hidden shadow-sm">
        <span class="input-group-text bg-white border-0 pe-1">
          <span class="material-symbols-outlined fs-5 text-secondary">search</span>
        </span>
        <%= f.search_field :q,
            value: @query,
            placeholder: t("admin.issue_reports.search_placeholder"),
            class: "form-control border-0 ps-2 bg-white shadow-none",
            data: {
              search_target: "input",
              action: "input->search#debounce search->search#debounce"
            } %>
      </div>
    </div>

    <!-- Time Range Filter (From Date - To Date, limited up to today) with Floating Label -->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
      <div class="position-relative border rounded-3 bg-white shadow-sm px-3 pt-2 pb-1" style="min-height: 58px;">
        <label class="text-secondary small fw-medium d-flex align-items-center gap-1 mb-0" style="font-size: 0.75rem; line-height: 1;">
          <span class="material-symbols-outlined fs-6">calendar_month</span>
          <span><%= t("admin.issue_reports.sent_time", default: "Thời gian gửi") %></span>
        </label>
        <div class="d-flex align-items-center gap-2 mt-1">
          <label for="from_date" class="text-secondary small"><%= t("admin.issue_reports.from_date", default: "Từ") %></label>
          <%= f.date_field :from_date,
              value: @from_date,
              max: Date.current,
              id: "from_date",
              class: "form-control form-control-sm border-0 p-0 shadow-none bg-transparent",
              data: {
                action: "change->search#changed"
              } %>
          <label for="to_date" class="text-secondary small"><%= t("admin.issue_reports.to_date", default: "Đến") %></label>
          <%= f.date_field :to_date,
              value: @to_date.presence || Date.current,
              max: Date.current,
              id: "to_date",
              class: "form-control form-control-sm border-0 p-0 shadow-none bg-transparent",
              data: {
                default_value: Date.current.to_s,
                action: "change->search#changed"
              } %>
        </div>
      </div>
    </div>

    <!-- Status Filter -->
    <div class="col-6 col-sm-4 col-lg-2">
      <div class="form-floating shadow-sm rounded">
        <%= f.select :status,
            options_for_select([
              [t("admin.issue_reports.filter_all_statuses"), ""],
              [t("admin.issue_reports.status_pending"), "pending"],
              [t("admin.issue_reports.status_in_progress"), "in_progress"],
              [t("admin.issue_reports.status_resolved"), "resolved"]
            ], @status),
            {},
            class: "form-select shadow-none",
            id: "floatingStatusSelect",
            data: {
              action: "change->search#changed"
            } %>
        <label for="floatingStatusSelect" class="text-secondary small fw-medium">
          <%= t("admin.issue_reports.status") %>
        </label>
      </div>
    </div>

    <!-- Clear Filter Button -->
    <div class="col-auto <%= 'd-none' unless @query.present? || @from_date.present? || (@to_date.present? && @to_date != Date.current.to_s) || @status.present? %>" data-search-target="clearButton">
      <button type="button"
              class="btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm"
              data-action="click->search#clear">
        <span class="material-symbols-outlined fs-6">filter_alt_off</span>
        <span class="small"><%= t("clear_filter", default: "Xóa lọc") %></span>
      </button>
    </div>
  <% end %>
</div>

<!-- Table (Turbo Frame) -->
<%= turbo_frame_tag "admin_issue_reports_table",
      data: {
        controller: "pagination-sync",
        pagination_sync_canonical_url_value: admin_issue_reports_path,
        pagination_sync_default_params_value: {}.to_json,
        pagination_sync_query_params_value: ["q", "status", "from_date", "to_date"].to_json,
        pagination_sync_total_pages_selector_value: "[data-pagination-total-pages]",
        action: "turbo:frame-load->pagination-sync#updateUrl"
      } do %>

  <span hidden data-pagination-total-pages="<%= @issue_reports.respond_to?(:total_pages) ? @issue_reports.total_pages : 1 %>"></span>

  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0 d-flex align-items-center gap-2">
      <span class="material-symbols-filled fs-3">report_problem</span>
      <span><%= t("admin.issue_reports.list", default: "Danh sách Báo cáo Sự cố") %></span>
    </h2>

    <div class="d-flex align-items-center gap-2 flex-wrap">
      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle p-2 fs-6 d-inline-flex align-items-center gap-1">
        <span class="material-symbols-filled fs-6">hourglass_top</span>
        <span><%= t("admin.issue_reports.pending_count", count: @pending_count) %></span>
      </span>

      <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle p-2 fs-6 d-inline-flex align-items-center gap-1">
        <span class="material-symbols-filled fs-6">sync</span>
        <span><%= t("admin.issue_reports.in_progress_count", count: @in_progress_count) %></span>
      </span>

      <span class="badge bg-light text-dark border p-2 fs-6">
        <%= t("admin.issue_reports.total_reports", count: @issue_reports.respond_to?(:total_count) ? @issue_reports.total_count : @issue_reports.size) %>
      </span>
    </div>
  </div>

  <div class="table-responsive bg-white rounded-3 shadow-sm border">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col" class="py-3 px-3"><%= t("admin.issue_reports.id") %></th>
          <th scope="col" class="py-3 px-3"><%= t("admin.issue_reports.reporter") %></th>
          <th scope="col" class="py-3 px-3"><%= t("admin.issue_reports.subject") %></th>
          <th scope="col" class="py-3 px-3 text-center"><%= t("admin.issue_reports.status") %></th>
          <th scope="col" class="py-3 px-3 text-center"><%= t("admin.issue_reports.sent_at") %></th>
          <th scope="col" class="py-3 px-3 text-center"><%= t("admin.issue_reports.resolved_info") %></th>
          <th scope="col" class="py-3 px-3 text-center"><%= t("admin.issue_reports.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% if @issue_reports.empty? %>
          <tr>
            <td colspan="7" class="text-center py-5 text-secondary fw-semibold">
              <span class="material-symbols-outlined fs-2 text-secondary d-block mb-2">report_problem</span>
              <%= t("admin.issue_reports.no_reports") %>
            </td>
          </tr>
        <% else %>
          <% @issue_reports.each do |report| %>
            <%= render "admin_portal/issue_reports/report_row", report: report %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @issue_reports if @issue_reports.respond_to?(:total_pages) %>
  </div>
<% end %>
