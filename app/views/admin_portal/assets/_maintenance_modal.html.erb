<!-- Maintenance History Modal -->
<div class="modal fade" id="maintenanceModal_<%= asset.id %>" tabindex="-1" aria-labelledby="maintenanceModalLabel_<%= asset.id %>" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
    <div class="modal-content">

      <div class="modal-header py-3 border-bottom">
        <div class="flex-grow-1 text-center">
          <h5 class="modal-title fw-bold mb-0" id="maintenanceModalLabel_<%= asset.id %>">
            <span class="material-symbols-filled fs-3">build</span>
            <%= t("admin.assets.maintenance_history") %> - <%= asset.human_category %> (<%= asset.room.title_name %>)
          </h5>
          <p class="text-info-emphasis fw-medium ms-5"><%= [asset.brand, asset.model].compact_blank.join(" - ") %></p>
        </div>
        <button type="button" class="btn-close align-self-start" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-0 text-start">
        <div class="bg-light border-bottom py-2 d-flex align-items-center">
          <div class="ps-3" style="width: 22%;">
            <span class="fw-semibold text-dark"><%= t("admin.assets.logs_count", count: logs.size) %></span>
          </div>
          <div class="px-2" style="width: 78%;">
            <span class="text-secondary small me-1"><%= t("admin.assets.total_maintenance_cost") %>:</span>
            <strong class="text-danger fs-6"><%= format_money(logs.sum(&:cost)) %></strong>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="table-layout: fixed;">
            <thead class="table-light">
              <tr>
                <th class="ps-3" style="width: 22%;"><%= t("admin.assets.performed_date") %></th>
                <th class="px-2" style="width: 22%;"><%= t("admin.assets.cost") %></th>
                <th class="pe-3" style="width: 56%;"><%= t("admin.assets.content") %></th>
              </tr>
            </thead>
            <tbody>
              <% logs.each do |log| %>
                <tr>
                  <td class="ps-3 fw-semibold"><%= l(log.performed_on, format: :default) rescue log.performed_on.strftime("%d/%m/%Y") %></td>
                  <td class="px-2"><strong class="text-danger"><%= format_money(log.cost) %></strong></td>
                  <td class="pe-3 text-break"><%= log.content %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t("close") %></button>
      </div>
    </div>
  </div>
</div>
