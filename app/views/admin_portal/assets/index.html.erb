<% content_for :title, t("page_titles.admin_house_assets", house_name: @house.name) %>

<div class="d-flex align-items-center gap-3 mb-4">
  <%= back_link_to admin_houses_path, t("admin.houses.back_to_list") %>
  <h1 class="flex-grow-1 text-center mb-0"><%= t("page_titles.admin_house_detail") %></h1>
</div>

<div class="row g-4">
  <!-- Left Column: House Sidebar -->
  <div class="col-12 col-lg-4 col-xl-3">
    <%= render "admin_portal/houses/house_sidebar", house: @house, active_tab: :assets %>
  </div>

  <!-- Right Column: Main Content (Turbo Frame) -->
  <div class="col-12 col-lg-8 col-xl-9">
    <%= turbo_frame_tag "house_tab_content", data: { turbo_action: "advance" } do %>
      <div class="d-flex flex-column gap-4">
        <!-- Header & KPIs Card -->
        <div class="card admin-card shadow-sm">
          <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 class="mb-0 d-flex align-items-center gap-2">
              <span class="material-symbols-filled fs-4">inventory_2</span>
              <%= t("admin.assets.title") %>
            </h2>
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-light text-secondary border">
                <%= @stats[:total_count] %> <%= t("admin.assets.items_unit") %>
              </span>
            </div>
          </div>

          <div class="card-body p-3 bg-light">
            <div class="row g-3 text-center text-sm-start">
              <div class="col-12 col-sm-4">
                <div class="small text-secondary mb-1"><%= t("admin.assets.total_assets") %>:</div>
                <strong class="fs-5 text-dark"><%= @stats[:total_count] %></strong>
              </div>
              <div class="col-12 col-sm-4">
                <div class="small text-secondary mb-1"><%= t("admin.assets.asset_condition") %>:</div>
                <div class="fs-6">
                  <span class="text-success fw-bold"><%= @stats[:normal_count] %> <%= t("admin.assets.normal_short") %></span> ·
                  <span class="text-danger fw-bold"><%= @stats[:damaged_count] %> <%= t("admin.assets.damaged_short") %></span>
                </div>
              </div>
              <div class="col-12 col-sm-4 text-sm-end">
                <div class="small text-secondary mb-1"><%= t("admin.assets.total_value") %>:</div>
                <strong class="text-primary fs-5"><%= format_money(@stats[:total_price]) %></strong>
              </div>
            </div>
          </div>
        </div>

        <!-- Filters Bar -->
        <div class="admin-filter-container rounded-3">
          <%= form_with url: admin_house_assets_path(@house), method: :get, local: true, class: "row g-2 align-items-center" do |f| %>
            <div class="col-12 col-sm-6 col-md-4">
              <div class="form-floating">
                <%= f.select :category,
                             options_for_select([[t("admin.assets.all_categories"), ""]] + @available_categories, @category_filter),
                             {},
                             class: "form-select shadow-sm",
                             id: "floatingCategorySelect",
                             onchange: "this.form.submit()" %>
                <label for="floatingCategorySelect" class="text-secondary small fw-medium">
                  <%= t("admin.assets.filter_category") %>
                </label>
              </div>
            </div>

            <div class="col-12 col-sm-6 col-md-4">
              <div class="form-floating">
                <%= f.select :status,
                             options_for_select([
                               [t("admin.assets.all_statuses"), ""],
                               [t("enums.asset.status.normal"), "normal"],
                               [t("enums.asset.status.damaged"), "damaged"],
                               [t("enums.asset.status.under_repair"), "under_repair"]
                             ], @status_filter),
                             {},
                             class: "form-select shadow-sm",
                             id: "floatingStatusSelect",
                             onchange: "this.form.submit()" %>
                <label for="floatingStatusSelect" class="text-secondary small fw-medium">
                  <%= t("admin.assets.filter_status") %>
                </label>
              </div>
            </div>

            <div class="col-12 col-md-4 d-flex gap-2">
              <% if @category_filter.present? || @status_filter.present? %>
                <%= link_to admin_house_assets_path(@house),
                            class: "btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm",
                            data: { turbo_frame: "house_tab_content", turbo_action: "advance" } do %>
                  <span class="material-symbols-outlined fs-6">filter_alt_off</span>
                  <%= t("clear_filter") %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Assets Table -->
        <% if @assets.any? %>
          <div class="card admin-card shadow-sm border">
            <div class="card-body p-1">
              <div class="table-responsive">
                <table class="table table-hover align-middle">
                  <thead class="table-light">
                    <tr>
                      <th class="ps-3" style="width: 25%;"><%= t("admin.assets.asset_info") %></th>
                      <th style="width: 20%;"><%= t("admin.assets.location") %></th>
                      <th style="width: 15%;"><%= t("admin.assets.price_and_purchased") %></th>
                      <th class="text-center" style="width: 15%;"><%= t("form.house.state") %></th>
                      <th class="pe-3 text-center" style="width: 25%;"><%= t("admin.assets.maintenance_history") %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @assets.each do |asset| %>
                      <% logs = asset.maintenance_logs %>
                      <tr>
                        <td class="ps-3">
                          <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-filled fs-3 text-secondary">inventory_2</span>
                            <div>
                              <strong class="text-dark"><%= asset.human_category %></strong>
                              <% if asset.brand.present? || asset.model.present? %>
                                <div class="small">
                                  <%= [asset.brand, asset.model].compact_blank.join(" - ") %>
                                </div>
                              <% end %>
                              <% if asset.note.present? %>
                                <small class="text-secondary fst-italic d-block"><%= asset.note %></small>
                              <% end %>
                            </div>
                          </div>
                        </td>

                        <td>
                          <p class="fw-semibold"><%= asset.room.title_name %></p>
                          <p class="small"><%= asset.room.floor.title_name %></p>
                        </td>

                        <td>
                          <strong class="text-primary"><%= format_money(asset.price) %></strong>
                          <% if asset.purchased_at.present? %>
                            <div class="small text-secondary"><%= l(asset.purchased_at, format: :default) rescue asset.purchased_at.strftime("%d/%m/%Y") %></div>
                          <% end %>
                        </td>

                        <td class="text-center">
                          <%= asset_status_badge(asset) %>
                        </td>

                        <td class="pe-3 text-center">
                          <% if logs.any? %>
                            <!-- Modal Trigger Button -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary d-inline-flex align-items-center justify-content-center gap-1"
                                    data-bs-toggle="modal"
                                    data-bs-target="#maintenanceModal_<%= asset.id %>"
                                    title="<%= t('admin.assets.view_maintenance_logs') %>">
                              <span class="material-symbols-filled fs-6">build</span>
                              <span><%= t("admin.assets.logs_count", count: logs.size) %></span>
                              <%= asset_maintenance_cost_badge(logs) %>
                            </button>

                            <%= render "maintenance_modal", asset: asset, logs: logs %>
                          <% else %>
                            <span class="text-secondary small fst-italic"><%= t("admin.assets.no_maintenance_logs") %></span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Pagination Bar -->
          <% if @assets.total_pages > 1 %>
            <div class="d-flex justify-content-center mt-3 mb-2">
              <%= paginate @assets %>
            </div>
          <% end %>
        <% else %>
          <div class="card admin-card p-5 text-center shadow-sm">
            <span class="material-symbols-outlined fs-1 text-secondary mb-2">inventory_2</span>
            <h3 class="fs-5 fw-bold text-secondary mb-1"><%= t("admin.assets.no_assets_found") %></h3>
            <p class="text-secondary small mb-0"><%= t("admin.assets.no_assets_hint") %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
