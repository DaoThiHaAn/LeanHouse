<% content_for :title, t("page_titles.admin_house_assets", house_name: @house.name, default: "Tài sản: #{@house.name}") %>

<div class="d-flex align-items-center gap-3 mb-4">
  <%= back_link_to admin_houses_path, t("admin.houses.back_to_list") %>
  <h1 class="flex-grow-1 text-center mb-0"><%= t("page_titles.admin_house_detail") %></h1>
</div>

<div class="row g-4">
  <!-- Left Column: House Sidebar -->
  <div class="col-12 col-lg-4 col-xl-3">
    <%= render "admin_portal/houses/house_sidebar", house: @house, active_tab: :assets %>
  </div>

  <!-- Right Column: Main Content (Turbo Frame) -->
  <div class="col-12 col-lg-8 col-xl-9">
    <%= turbo_frame_tag "house_tab_content", data: { turbo_action: "advance" } do %>
      <div class="d-flex flex-column gap-4">
        <!-- Header & KPIs Card -->
        <div class="card admin-card shadow-sm">
          <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 class="fs-5 fw-bold mb-0 d-flex align-items-center gap-2">
              <span class="material-symbols-filled fs-4 text-primary">inventory_2</span>
              <%= t("admin.assets.title", default: "Danh sách Tài sản & Lịch sử bảo trì") %>
            </h2>
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-light text-secondary border">
                <%= @total_assets_count %> <%= t("admin.assets.items_unit", default: "thiết bị") %>
              </span>
            </div>
          </div>

          <div class="card-body p-3 bg-light">
            <div class="row g-3 text-center text-sm-start">
              <div class="col-12 col-sm-4">
                <div class="small text-muted mb-1"><%= t("admin.assets.total_assets", default: "Tổng số thiết bị") %>:</div>
                <strong class="fs-5 text-dark"><%= @total_assets_count %></strong>
              </div>
              <div class="col-12 col-sm-4">
                <div class="small text-muted mb-1"><%= t("admin.assets.asset_condition", default: "Tình trạng") %>:</div>
                <div class="fs-6">
                  <span class="text-success fw-bold"><%= @normal_count %> <%= t("admin.assets.normal_short", default: "tốt") %></span> ·
                  <span class="text-danger fw-bold"><%= @damaged_count %> <%= t("admin.assets.damaged_short", default: "hỏng/sửa") %></span>
                </div>
              </div>
              <div class="col-12 col-sm-4 text-sm-end">
                <div class="small text-muted mb-1"><%= t("admin.assets.total_value", default: "Tổng giá trị đầu tư") %>:</div>
                <strong class="text-primary fs-5"><%= format_money(@total_price) %></strong>
              </div>
            </div>
          </div>
        </div>

        <!-- Filters Bar -->
        <div class="admin-filter-container">
          <%= form_with url: admin_house_assets_path(@house), method: :get, local: true, class: "row g-2 align-items-end" do |f| %>
            <div class="col-12 col-sm-6 col-md-4">
              <%= f.label :category, t("admin.assets.filter_category", default: "Loại thiết bị"), class: "form-label small text-muted mb-1" %>
              <%= f.select :category,
                           options_for_select([[t("admin.assets.all_categories", default: "Tất cả loại thiết bị"), ""]] + @available_categories, @category_filter),
                           {},
                           class: "form-select form-select-sm",
                           onchange: "this.form.submit()" %>
            </div>

            <div class="col-12 col-sm-6 col-md-4">
              <%= f.label :status, t("admin.assets.filter_status", default: "Trạng thái"), class: "form-label small text-muted mb-1" %>
              <%= f.select :status,
                           options_for_select([
                             [t("admin.assets.all_statuses", default: "Tất cả trạng thái"), ""],
                             [t("enums.asset.status.normal", default: "Bình thường"), "normal"],
                             [t("enums.asset.status.damaged", default: "Hư hỏng"), "damaged"],
                             [t("enums.asset.status.under_repair", default: "Đang sửa chữa"), "under_repair"]
                           ], @status_filter),
                           {},
                           class: "form-select form-select-sm",
                           onchange: "this.form.submit()" %>
            </div>

            <div class="col-12 col-md-4 d-flex gap-2">
              <%= f.submit t("filter", default: "Lọc"), class: "btn btn-sm btn-primary px-3" %>
              <% if @category_filter.present? || @status_filter.present? %>
                <%= link_to t("admin.users.clear_filter", default: "Xóa lọc"),
                            admin_house_assets_path(@house),
                            class: "btn btn-sm btn-outline-secondary",
                            data: { turbo_frame: "house_tab_content", turbo_action: "advance" } %>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Assets Table -->
        <% if @assets.any? %>
          <div class="card admin-card shadow-sm">
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th class="ps-3" style="width: 25%;"><%= t("admin.assets.asset_info", default: "Thiết bị / Tài sản") %></th>
                      <th style="width: 20%;"><%= t("admin.assets.location", default: "Vị trí lắp đặt") %></th>
                      <th style="width: 15%;"><%= t("admin.assets.price_and_purchased", default: "Giá trị & Ngày mua") %></th>
                      <th style="width: 15%;"><%= t("form.house.state", default: "Trạng thái") %></th>
                      <th class="pe-3 text-center text-md-start" style="width: 25%;"><%= t("admin.assets.maintenance_history", default: "Lịch sử bảo trì") %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @assets.each do |asset| %>
                      <% logs = asset.maintenance_logs %>
                      <tr>
                        <td class="ps-3">
                          <div class="d-flex align-items-center gap-2">
                            <span class="material-symbols-filled fs-3 text-secondary">inventory_2</span>
                            <div>
                              <strong class="text-dark"><%= asset.human_category %></strong>
                              <% if asset.brand.present? || asset.model.present? %>
                                <div class="small text-muted">
                                  <%= [asset.brand, asset.model].compact_blank.join(" - ") %>
                                </div>
                              <% end %>
                              <% if asset.note.present? %>
                                <small class="text-muted fst-italic d-block"><%= asset.note %></small>
                              <% end %>
                            </div>
                          </div>
                        </td>

                        <td>
                          <strong><%= asset.room.title_name %></strong>
                          <div class="small text-muted"><%= asset.room.floor.title_name %></div>
                        </td>

                        <td>
                          <strong class="text-primary"><%= format_money(asset.price) %></strong>
                          <% if asset.purchased_at.present? %>
                            <div class="small text-muted"><%= l(asset.purchased_at, format: :default) rescue asset.purchased_at.strftime("%d/%m/%Y") %></div>
                          <% end %>
                        </td>

                        <td>
                          <% case asset.status %>
                          <% when "normal" %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                              <span class="material-symbols-outlined fs-6">check_circle</span>
                              <span><%= t("enums.asset.status.normal", default: "Bình thường") %></span>
                            </span>
                          <% when "damaged" %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle d-inline-flex align-items-center gap-1">
                              <span class="material-symbols-outlined fs-6">error</span>
                              <span><%= t("enums.asset.status.damaged", default: "Hư hỏng") %></span>
                            </span>
                          <% when "under_repair" %>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle d-inline-flex align-items-center gap-1">
                              <span class="material-symbols-outlined fs-6">build</span>
                              <span><%= t("enums.asset.status.under_repair", default: "Đang sửa chữa") %></span>
                            </span>
                          <% end %>
                        </td>

                        <td class="pe-3 text-center text-md-start">
                          <% if logs.any? %>
                            <!-- Modal Trigger Button -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                    data-bs-toggle="modal"
                                    data-bs-target="#maintenanceModal_<%= asset.id %>"
                                    title="<%= t('admin.assets.view_maintenance_logs', default: 'Xem chi tiết nhật ký bảo trì') %>">
                              <span class="material-symbols-outlined fs-6">build</span>
                              <span><%= t("admin.assets.logs_count", count: logs.size, default: "#{logs.size} lần") %></span>
                              <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">
                                <%= format_money(logs.sum(&:cost)) %>
                              </span>
                            </button>

                            <!-- Maintenance History Modal -->
                            <div class="modal fade" id="maintenanceModal_<%= asset.id %>" tabindex="-1" aria-labelledby="maintenanceModalLabel_<%= asset.id %>" aria-hidden="true">
                              <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                                <div class="modal-content">
                                  <div class="modal-header py-3 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                      <span class="material-symbols-filled fs-3 text-primary">build</span>
                                      <div class="text-start">
                                        <h5 class="modal-title fw-bold mb-0" id="maintenanceModalLabel_<%= asset.id %>">
                                          <%= t("admin.assets.maintenance_history") %> - <%= asset.human_category %> (<%= asset.room.title_name %>)
                                        </h5>
                                        <small class="text-muted"><%= [asset.brand, asset.model].compact_blank.join(" - ") %></small>
                                      </div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                  </div>
                                  <div class="modal-body p-0 text-start">
                                    <div class="p-3 bg-light d-flex justify-content-between align-items-center border-bottom flex-wrap gap-2">
                                      <span class="fw-semibold text-dark"><%= t("admin.assets.logs_count", count: logs.size, default: "#{logs.size} lần bảo trì") %></span>
                                      <span><%= t("admin.assets.total_maintenance_cost", default: "Tổng chi phí") %>: <strong class="text-danger fs-6"><%= format_money(logs.sum(&:cost)) %></strong></span>
                                    </div>
                                    <div class="table-responsive">
                                      <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                          <tr>
                                            <th class="ps-3" style="width: 22%;"><%= t("admin.assets.performed_date", default: "Ngày thực hiện") %></th>
                                            <th style="width: 22%;"><%= t("admin.assets.cost", default: "Chi phí") %></th>
                                            <th class="pe-3" style="width: 56%;"><%= t("admin.assets.content", default: "Nội dung sửa chữa") %></th>
                                          </tr>
                                        </thead>
                                        <tbody>
                                          <% logs.each do |log| %>
                                            <tr>
                                              <td class="ps-3 fw-semibold"><%= l(log.performed_on, format: :default) rescue log.performed_on.strftime("%d/%m/%Y") %></td>
                                              <td><strong class="text-danger"><%= format_money(log.cost) %></strong></td>
                                              <td class="pe-3 text-break"><%= log.content %></td>
                                            </tr>
                                          <% end %>
                                        </tbody>
                                      </table>
                                    </div>
                                  </div>
                                  <div class="modal-footer py-2">
                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t("close", default: "Đóng") %></button>
                                  </div>
                                </div>
                              </div>
                            </div>
                          <% else %>
                            <span class="text-muted small fst-italic"><%= t("admin.assets.no_maintenance_logs", default: "Chưa có bảo trì") %></span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        <% else %>
          <div class="card admin-card p-5 text-center shadow-sm">
            <span class="material-symbols-outlined fs-1 text-muted mb-2">inventory_2</span>
            <h3 class="fs-5 fw-bold text-muted mb-1"><%= t("admin.assets.no_assets_found", default: "Không tìm thấy tài sản nào") %></h3>
            <p class="text-muted small mb-0"><%= t("admin.assets.no_assets_hint", default: "Chưa có tài sản nào được đăng ký theo bộ lọc này.") %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
