<% content_for :title, t("admin.uploaded_files.title") %>

<!-- Header Stats & Guidance Action -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
  <div class="border-bottom pb-3 w-100">
    <h1 class="mb-2">
      <%= t("admin.uploaded_files.title") %>
    </h1>
    <p class="text-secondary small">
      <%= t("admin.uploaded_files.subtitle") %>
    </p>
  </div>
</div>

<!-- Stats Grid -->
<div class="row g-3 mb-4">
  <!-- Total Files Card -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="admin-stat-card admin-stat-blue">
      <div class="d-flex align-items-start justify-content-between">
        <div class="d-flex gap-3 align-items-center">
          <span class="material-symbols-filled fs-1 admin-stat-icon">folder_shared</span>
          <div>
            <div class="fw-bold text-secondary small text-uppercase"><%= t("admin.uploaded_files.stats.total_files") %></div>
            <div class="fs-3 fw-bold admin-stat-number"><%= @total_files_count %></div>
          </div>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top small text-secondary">
        <%= t("admin.uploaded_files.stats.across_system") %>
      </div>
    </div>
  </div>

  <!-- Total Storage Card -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="admin-stat-card admin-stat-purple">
      <div class="d-flex align-items-start justify-content-between">
        <div class="d-flex gap-3 align-items-center">
          <span class="material-symbols-filled fs-1 admin-stat-icon">cloud_done</span>
          <div>
            <div class="fw-bold text-secondary small text-uppercase"><%= t("admin.uploaded_files.stats.total_storage") %></div>
            <div class="fs-3 fw-bold admin-stat-number"><%= number_to_human_size(@total_storage_bytes) %></div>
          </div>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top small text-secondary">
        <%= t("admin.uploaded_files.stats.active_storage") %>
      </div>
    </div>
  </div>

  <!-- Images & Media Card -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="admin-stat-card admin-stat-green">
      <div class="d-flex align-items-start justify-content-between">
        <div class="d-flex gap-3 align-items-center">
          <span class="material-symbols-filled fs-1 admin-stat-icon">perm_media</span>
          <div>
            <div class="fw-bold text-secondary small text-uppercase"><%= t("admin.uploaded_files.stats.images") %></div>
            <div class="fs-3 fw-bold admin-stat-number"><%= @images_count + @videos_count %></div>
          </div>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top small text-secondary">
        <%= @images_count %> <%= t("admin.uploaded_files.formats.image") %> • <%= @videos_count %> <%= t("admin.uploaded_files.formats.video") %>
      </div>
    </div>
  </div>

  <!-- System Guidance Button Card -->
  <div class="col-12 col-sm-6 col-lg-3">
    <div class="admin-stat-card admin-stat-amber">
      <div class="d-flex align-items-start justify-content-between">
        <div class="d-flex gap-3 align-items-center">
          <span class="material-symbols-filled fs-1 admin-stat-icon">shield</span>
          <div>
            <div class="fw-bold text-secondary small text-uppercase"><%= t("admin.uploaded_files.stats.guidance_title") %></div>
            <div class="small fw-semibold text-secondary"><%= t("admin.uploaded_files.stats.guidance_desc") %></div>
          </div>
        </div>
      </div>
      <div class="mt-3 pt-2 border-top">
        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill w-100 d-flex align-items-center justify-content-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#uploadedFilesGuidanceModal">
          <span class="material-symbols-outlined fs-6">help_outline</span>
          <span><%= t("admin.uploaded_files.stats.view_guidance_btn") %></span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Filters & Search Bar Card -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <% has_filter = @query.present? || (@record_type_filter.present? && @record_type_filter != "all") || (@file_type_filter.present? && @file_type_filter != "all") %>
    <%= form_with url: admin_uploaded_files_path, method: :get,
                  data: {
                    controller: "search",
                    turbo_frame: "uploaded_files_table",
                    turbo_action: "advance"
                  },
                  class: "row g-3 align-items-end" do |f| %>
      <!-- Search Input -->
      <div class="col-12 col-md-4">
        <label class="form-label small fw-semibold mb-1" for="admin_files_search_q">
          <%= t("admin.uploaded_files.search_label") %>
        </label>
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light border-end-0">
            <span class="material-symbols-outlined fs-6 text-secondary">search</span>
          </span>
          <%= f.search_field :q,
                           id: "admin_files_search_q",
                           value: @query,
                           placeholder: t("admin.uploaded_files.search_placeholder"),
                           class: "form-control border-start-0 ps-0",
                           data: {
                             search_target: "input",
                             action: "input->search#debounce search->search#debounce"
                           } %>
        </div>
      </div>

      <!-- Record Type Filter -->
      <div class="col-12 col-sm-6 col-md-3">
        <label class="form-label small fw-semibold mb-1" for="admin_files_record_type">
          <%= t("admin.uploaded_files.record_type_label") %>
        </label>
        <%= f.select :record_type,
                     options_for_select([
                       [t("admin.uploaded_files.filter_all_records"), "all"],
                       ["#{t('admin.uploaded_files.record_types.User')} (#{t('admin.uploaded_files.types.user_avatar')})", "User"],
                       ["#{t('admin.uploaded_files.record_types.Contract')} (#{t('admin.uploaded_files.types.contract')})", "Contract"],
                       ["#{t('admin.uploaded_files.record_types.ServiceUsageLog')} (#{t('admin.uploaded_files.types.service_usage_log')})", "ServiceUsageLog"],
                       ["#{t('admin.uploaded_files.record_types.Invoice')} (#{t('admin.uploaded_files.types.invoice')})", "Invoice"],
                       ["#{t('admin.uploaded_files.record_types.RepairRequest')} (#{t('admin.uploaded_files.types.repair_request')})", "RepairRequest"],
                       ["#{t('admin.uploaded_files.record_types.VehicleRequest')}", "VehicleRequest"],
                       ["#{t('admin.uploaded_files.record_types.Vehicle')}", "Vehicle"],
                       ["#{t('admin.uploaded_files.record_types.House')} (#{t('admin.uploaded_files.types.house')})", "House"],
                       ["#{t('admin.uploaded_files.record_types.VariantRecord')}", "ActiveStorage::VariantRecord"]
                     ], @record_type_filter),
                     {},
                     { id: "admin_files_record_type", class: "form-select form-select-sm", data: { action: "change->search#changed" } } %>
      </div>


      <!-- File Type Filter -->
      <div class="col-12 col-sm-6 col-md-3">
        <label class="form-label small fw-semibold mb-1" for="admin_files_file_type">
          <%= t("admin.uploaded_files.file_type_label") %>
        </label>
        <%= f.select :file_type,
                     options_for_select([
                       [t("admin.uploaded_files.filter_all_types"), "all"],
                       ["#{t('admin.uploaded_files.formats.image')} (JPG, PNG, WEBP)", "image"],
                       ["#{t('admin.uploaded_files.formats.video')} (MP4, MOV)", "video"],
                       ["#{t('admin.uploaded_files.formats.pdf')}", "pdf"],
                       ["#{t('admin.uploaded_files.formats.document')}", "document"]
                     ], @file_type_filter),
                     {},
                     { id: "admin_files_file_type", class: "form-select form-select-sm", data: { action: "change->search#changed" } } %>
      </div>

      <!-- Reset / Clear Button -->
      <div class="col-12 col-md-2 d-flex align-items-end">
        <button type="button"
                class="btn btn-sm btn-outline-secondary w-100 d-inline-flex align-items-center justify-content-center gap-1 <%= 'd-none' unless has_filter %>"
                data-search-target="clearButton"
                data-action="click->search#clear"
                title="<%= t('admin.uploaded_files.reset_filter') %>">
          <span class="material-symbols-outlined fs-6">filter_alt_off</span>
          <span><%= t("clear_filter") %></span>
        </button>
      </div>
    <% end %>
  </div>
</div>


<!-- Uploaded Files Table Container -->
<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
  <%= render "admin_portal/uploaded_files/table" %>
</div>

<!-- Guidance Modal Partial -->
<%= render "admin_portal/uploaded_files/guidance_modal" %>
