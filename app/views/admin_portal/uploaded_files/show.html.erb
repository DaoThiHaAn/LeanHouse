<%= turbo_frame_tag "uploaded_file_detail_modal" do %>
  <div class="modal fade show d-block admin-file-modal-backdrop" id="uploadedFileDetailModal" tabindex="-1" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-dark text-white">
          <div class="d-flex align-items-center gap-2">
            <span class="material-symbols-outlined fs-5">visibility</span>
            <h5 class="modal-title mb-0 text-truncate admin-file-modal-title"><%= @attachment.blob.filename %></h5>
          </div>
          <%= link_to admin_uploaded_files_path, class: "btn-close btn-close-white", data: { turbo_frame: "uploaded_file_detail_modal" } do %><% end %>
        </div>

        <div class="modal-body p-4">
          <!-- Live Preview Box -->
          <div class="text-center p-3 bg-light rounded-3 mb-4 border">
            <% if @attachment.blob.image? %>
              <%= image_tag url_for(@attachment),
                            alt: @attachment.blob.filename,
                            class: "img-fluid rounded shadow-sm admin-file-preview-img" %>
            <% elsif @attachment.blob.video? %>
              <video controls class="rounded shadow-sm w-100 admin-file-preview-video">
                <source src="<%= url_for(@attachment) %>" type="<%= @attachment.blob.content_type %>">
                <%= t("admin.uploaded_files.detail.browser_no_video") %>
              </video>
            <% elsif @attachment.blob.content_type == "application/pdf" %>
              <div class="py-4">
                <span class="material-symbols-outlined fs-1 text-danger mb-2">picture_as_pdf</span>
                <p class="small text-secondary mb-3"><%= t("admin.uploaded_files.detail.pdf_doc_label") %> <strong><%= @attachment.blob.filename %></strong></p>
                <%= link_to rails_blob_path(@attachment, disposition: "inline"), target: "_blank", class: "btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" do %>
                  <span class="material-symbols-outlined fs-6">open_in_new</span>
                  <span><%= t("admin.uploaded_files.detail.open_pdf_new_tab") %></span>
                <% end %>
              </div>
            <% else %>
              <div class="py-4">
                <span class="material-symbols-outlined fs-1 text-secondary mb-2">description</span>
                <p class="small text-secondary mb-3"><%= t("admin.uploaded_files.detail.general_file_label") %> <strong><%= @attachment.blob.filename %></strong></p>
                <%= link_to rails_blob_path(@attachment, disposition: "attachment"), class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" do %>
                  <span class="material-symbols-outlined fs-6">download</span>
                  <span><%= t("admin.uploaded_files.detail.download_file") %></span>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Metadata Grid -->
          <div class="row g-3">
            <div class="col-md-6">
              <div class="p-3 border rounded-3 h-100">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-2 d-flex align-items-center gap-1">
                  <span class="material-symbols-outlined fs-6 text-primary">info</span>
                  <span><%= t("admin.uploaded_files.detail.file_info") %></span>
                </h6>
                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                  <span class="text-secondary small"><%= t("admin.uploaded_files.detail.filename_label") %></span>
                  <span class="small fw-semibold text-dark text-break"><%= @attachment.blob.filename %></span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                  <span class="text-secondary small"><%= t("admin.uploaded_files.detail.mime_label") %></span>
                  <span class="small text-dark"><%= @attachment.blob.content_type %></span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                  <span class="text-secondary small"><%= t("admin.uploaded_files.detail.size_label") %></span>
                  <span class="small text-dark"><%= number_to_human_size(@attachment.blob.byte_size) %></span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                  <span class="text-secondary small"><%= t("admin.uploaded_files.detail.uploaded_date_label") %></span>
                  <span class="small text-dark"><%= @attachment.created_at.strftime("%d/%m/%Y %H:%M:%S") %></span>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="p-3 border rounded-3 h-100">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-2 d-flex align-items-center gap-1">
                  <span class="material-symbols-outlined fs-6 text-primary">link</span>
                  <span><%= t("admin.uploaded_files.detail.linked_record") %></span>
                </h6>
                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                  <span class="text-secondary small"><%= t("admin.uploaded_files.detail.record_type_label") %></span>
                  <span class="badge <%= record_type_badge_class(@attachment.record_type) %>"><%= record_type_badge_text(@attachment.record_type) %></span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                  <span class="text-secondary small"><%= t("admin.uploaded_files.detail.linked_detail") %></span>
                  <span class="small fw-semibold">
                    <% admin_link = record_admin_link(@attachment) %>
                    <% if admin_link %>
                      <%= link_to record_friendly_description(@attachment), admin_link, class: "text-decoration-none text-primary", data: { turbo_frame: "_top" } %>
                    <% else %>
                      <%= record_friendly_description(@attachment) %>
                    <% end %>
                  </span>
                </div>
                <div class="py-1">
                  <span class="text-secondary small d-block mb-1"><%= t("admin.uploaded_files.uploader_info") %></span>
                  <% senders = find_senders_for_attachment(@attachment) %>
                  <% if senders.any? %>
                    <% senders.each do |user| %>
                      <div class="d-flex align-items-center justify-content-between bg-light p-2 rounded-2 mt-1">
                        <div>
                          <div class="small fw-bold text-dark"><%= user.fullname %> (<%= user_role_badge_text(user) %>)</div>
                          <div class="text-secondary admin-file-text-xs"><%= user.tel %></div>
                        </div>
                        <%= link_to admin_user_path(user), class: "btn btn-sm btn-outline-secondary py-0 px-2", data: { turbo_frame: "_top" } do %>
                          <span class="small"><%= t("admin.uploaded_files.detail.view_profile") %></span>
                        <% end %>
                      </div>
                    <% end %>

                  <% else %>
                    <span class="text-secondary small fst-italic"><%= t("admin.uploaded_files.unknown_uploader") %></span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer bg-light d-flex justify-content-between">
          <div>
            <%= link_to rails_blob_path(@attachment, disposition: "attachment"), class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" do %>
              <span class="material-symbols-outlined fs-6">download</span>
              <span><%= t("download") %></span>
            <% end %>
          </div>
          <div class="d-flex align-items-center gap-2">
            <%= link_to t("close"), admin_uploaded_files_path, class: "btn btn-secondary btn-sm", data: { turbo_frame: "uploaded_file_detail_modal" } %>
            <button type="button"
                    class="btn btn-sm btn-danger d-inline-flex align-items-center gap-1"
                    data-bs-toggle="modal"
                    data-bs-target="#deleteFileModal-<%= @attachment.id %>">
              <span class="material-symbols-outlined fs-6">delete</span>
              <span><%= t("admin.uploaded_files.delete_btn") %></span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%= render "admin_portal/uploaded_files/delete_modal", attachment: @attachment %>
<% end %>
