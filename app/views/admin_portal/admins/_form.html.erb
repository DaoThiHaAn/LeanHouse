<%= form_with model: [:admin, admin],
              local: true,
              class: "admin-form needs-validation",
              data: {
                controller: "loading",
                loading_text_value: t("saving", default: "Đang lưu..."),
                action: "submit->loading#submit"
              } do |f| %>
  <%= f.hidden_field :role, value: "support" %>

  <!-- Account Information Card -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
      <span class="icon material-symbols-filled fs-3">badge</span>
      <h2 class="mb-0">
        <%= t("form.profile.personal_info") %>
      </h2>
      <span class="ms-auto badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1 rounded-pill small">
        <%= t("admin.admins.role_support") %>
      </span>
    </div>
    <div class="card-body p-4">
      <div class="row g-3">
        <!-- Fullname -->
        <div class="col-12 col-md-6">
          <div class="form-floating shadow-sm rounded">
            <%= f.text_field :fullname,
                class: "form-control #{invalid_class(admin, :fullname)}",
                id: "adminFullname",
                placeholder: t("form.profile.staff_name_placeholder"),
                required: true %>
            <label for="adminFullname">
              <%= t("form.profile.fullname") %> <span class="text-danger">*</span>
            </label>
            <%= field_error(admin, :fullname) %>
          </div>
        </div>
        <!-- Email -->
        <div class="col-12 col-md-6">
          <div class="form-floating shadow-sm rounded">
            <%= f.email_field :email,
                class: "form-control #{invalid_class(admin, :email)}",
                id: "adminEmail",
                placeholder: "xxx@leanhouse.vn",
                required: true %>
            <label for="adminEmail">
              <%= t("form.profile.email") %> <span class="text-danger">*</span>
            </label>
            <%= field_error(admin, :email) %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Security / Password Card -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
      <span class="icon material-symbols-filled fs-3">lock</span>
      <h2 class="mb-0"><%= t("form.profile.security") %></h2>
    </div>
    <div class="card-body p-4" data-controller="password-validation">
      <div class="row g-3">
        <!-- Password -->
        <div class="col-12 col-md-6" data-controller="form">
          <div class="form-floating shadow-sm rounded position-relative">
            <%= f.password_field :password,
                class: "form-control pe-5 #{invalid_class(admin, :password)}",
                id: "adminPassword",
                autocomplete: "new-password",
                placeholder: "••••••••",
                required: admin.new_record?,
                data: {
                  form_target: "input",
                  password_validation_target: "input"
                } %>
            <label for="adminPassword">
              <%= t("form.profile.password") %> <span class="text-danger">*</span>
            </label>
            <span class="eye position-absolute end-0 top-50 translate-middle-y me-3 material-symbols-outlined"
                  style="cursor: pointer; z-index: 5;"
                  data-action="click->form#togglePasswordVisibility">
              visibility
            </span>
            <%= field_error(admin, :password) %>
          </div>
        </div>
        <!-- Password Confirmation -->
        <div class="col-12 col-md-6" data-controller="form">
          <div class="form-floating shadow-sm rounded position-relative">
            <%= f.password_field :password_confirmation,
                class: "form-control pe-5 #{invalid_class(admin, :password_confirmation)}",
                id: "adminPasswordConfirmation",
                autocomplete: "new-password",
                placeholder: "••••••••",
                required: admin.new_record?,
                data: { form_target: "input" } %>
            <label for="adminPasswordConfirmation">
              <%= t("form.profile.password_confirmation") %> <span class="text-danger">*</span>
            </label>
            <span class="eye position-absolute end-0 top-50 translate-middle-y me-3 material-symbols-outlined"
                  style="cursor: pointer; z-index: 5;"
                  data-action="click->form#togglePasswordVisibility">
              visibility
            </span>
            <%= field_error(admin, :password_confirmation) %>
          </div>
        </div>

        <!-- Dynamic Password Requirement Checklist -->
        <div class="col-12">
          <div class="p-3 bg-light rounded-3 border small">
            <div class="field-info mb-2 d-flex align-items-center gap-1 fw-semibold text-secondary">
              <span class="material-symbols-outlined fs-5">info</span>
              <span class="mb-0"><%= t("form.profile.required_pw") %></span>
            </div>
            <ul class="field-info list-unstyled d-flex flex-column gap-1 mb-0 ps-1 pw-requirements" id="new-admin-password-rules" aria-live="polite">
              <li class="pw-requirement d-flex align-items-center gap-2"
                  data-password-validation-target="rule"
                  data-rule="length">
                <span class="material-symbols-outlined pw-rule-icon fs-6" data-password-validation-target="icon" aria-hidden="true">radio_button_unchecked</span>
                <span class="pw-rule-text"><%= t("form.profile.pw_length") %></span>
              </li>
              <li class="pw-requirement d-flex align-items-center gap-2"
                  data-password-validation-target="rule"
                  data-rule="letter">
                <span class="material-symbols-outlined pw-rule-icon fs-6" data-password-validation-target="icon" aria-hidden="true">radio_button_unchecked</span>
                <span class="pw-rule-text"><%= t("form.profile.pw_letters") %></span>
              </li>
              <li class="pw-requirement d-flex align-items-center gap-2"
                  data-password-validation-target="rule"
                  data-rule="number">
                <span class="material-symbols-outlined pw-rule-icon fs-6" data-password-validation-target="icon" aria-hidden="true">radio_button_unchecked</span>
                <span class="pw-rule-text"><%= t("form.profile.pw_numbers") %></span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Actions -->
  <div class="d-flex justify-content-end gap-3">
    <%= link_to admin_admins_path, class: "btn btn-outline-secondary px-3 align-self-center d-flex align-items-center gap-1" do %>
      <span class="material-symbols-outlined fs-5">close</span>
      <span><%= t("cancel") %></span>
    <% end %>

    <%= f.button type: :submit,
                 class: "custom-primary-btn py-2 px-4 d-flex align-items-center gap-2 shadow-sm",
                 data: { loading_target: "button" } do %>
      <span class="material-symbols-outlined fs-5">save</span>
      <span data-loading-target="text"><%= t("save") %></span>
      <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">progress_activity</span>
    <% end %>
  </div>
<% end %>
