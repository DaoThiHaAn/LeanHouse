<%# Variables: @house, @landlord, @floors, @communes, @provinces %>

<% content_for :title, t("page_titles.edit_house") %>

<div class="edit-house main-container w-70">
  <div class="d-flex align-items-center mb-5">
    <%= link_to :back, class: "d-flex align-items-center gap-1 turn-back link" do%>
              <span class="material-symbols-outlined ms-2">arrow_left_alt</span>
              <%=t('turn_back')%>
    <%end%>
    <div class="flex-grow-1 d-flex flex-column gap-3">
      <h1 class="text-center">
        <%=t('page_titles.edit_house') %> - <%= @house.name %>
      </h1>

      <p class="text-center text-secondary fst-italic"><%= "#{t("last_updated")}: #{l(@house.updated_at, format: :default)}" %></p>
    </div>
  </div>  


  <%# Main section %>
  <div class="d-flex gap-3 align-items-start">
    <%# Sidebar %>
    <div class="border-end border-2 pe-4 flex-shrink-0">
      <div class="d-flex flex-column side-bar align-items-stretch">
        <%= house_mode_badge(@house) %>

        <%= button_to change_mode_landlord_house_path(@house), 
            class:"d-flex align-items-center justify-content-center p-2",
            data: {
              turbo_confirm: t("form.house.change_mode_cf"),
              **tooltip( "left",
                          "form.house.change_mode_info_1",
                          "form.house.change_mode_info_2",
                          "form.house.change_mode_info_3"
                        )
            } do %>
          <span class="material-symbols-outlined">change_circle</span>
          <%= t('form.house.change_mode')%>
        <%end%>
      </div>
  
      <%# Content table %>
      <div class="mt-3 d-flex flex-column gap-2 px-2" data-controller="toc">
        <a class="title-toc active" href="#general-info">
          <%= t("form.house.general_info")%>
        </a>
        <a class="title-toc" href="#floors">
          <%= t("form.house.floor_map")%>
        </a>
      </div>

      <%# Delete house button %>
      <%= link_to check_delete_landlord_house_path(@house),
          class: "mt-5 btn btn-danger d-flex align-items-center justify-content-center gap-2 fw-bold",
          data: {turbo_frame: "house_delete_modal"} do %>
        <span class="material-symbols-outlined">delete</span>
        <%= t('form.house.delete')%>
      <%end%>
    </div>

    <div class="px-3 flex-grow-1 edit-house-form">
      <%# General info form %>
      <section id="general-info" class="mb-5">
        <h3 class="mb-4"><%= t("general_info") %></h3>

        <%= turbo_frame_tag "edit_house_form" do 
          render "general_info_form", house: @house, provinces: @provinces, communes: @communes
        end%>
      </section>

      <%# Floor section %>
      <section id="floors" class="house-form border-top py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h3 class="mb-0">
            <%= t("form.house.floor_map") %>
          </h3>

          <%# Add floor button %>
          <%= link_to new_landlord_house_floor_path(@house),
                      class: "main-btn d-flex align-items-center gap-2 px-2 py-1",
                      data: { turbo_frame: "new_floor_modal", turbo_prefetch: false } do %>
            <span class="material-symbols-outlined">add</span>
            <%= t("form.floor.add") %>
          <% end %>
        </div>

        <div class="mt-3 d-flex align-items-center gap-2">
          <span class="material-symbols-outlined">list_arrow</span>
          <%= t("form.floor.order") %>
        </div>

        <div class="info-container px-4 py-1 my-3 mx-auto">
          <%= field_info(
              [ t("form.floor.create_info_1"),
              t("form.floor.create_info_2"),
              t("form.floor.create_info_3", num: 50),
              t("form.floor.create_info_4_html") ],
              extra_classes: "my-3 gap-2")  %>
        </div>

        <div data-controller="sortable"
          data-sortable-url-value="<%= sort_landlord_house_floors_path(@house) %>"
          class="px-5">

          <%# Floor items %>
          <%= render "landlord_portal/floors/floor_list", floors: @floors, house: @house %>

          <%# Save order button %>
          <div class="d-flex justify-content-center mt-4">
            <button disabled
              type="button"
              class="custom-primary-btn main-form"
              data-sortable-target="saveOrderBtn"
              data-action="click->sortable#saveOrder">
              <%= t("save_order") %>
            </button>
          </div>
        </div>

      </section>
    </div>
  </div>
</div>

<%= turbo_frame_tag "floor_delete_modal" %>

<%= turbo_frame_tag "house_delete_modal" %>

<%= turbo_frame_tag "new_floor_modal" %>

<%# To close the modal automatically %>
<div id="events"></div>