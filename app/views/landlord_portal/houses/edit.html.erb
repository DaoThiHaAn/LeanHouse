<%# Variables: @house, @landlord, @floors, @communes, @provinces %>

<% content_for :title, t("page_titles.edit_house") %>

<div class="main-container w-70">
  <div class="d-flex align-items-center mb-5">
    <%= link_to :back, class: "d-flex align-items-center gap-1 turn-back link" do%>
              <span class="material-symbols-outlined ms-2">arrow_left_alt</span>
              <%=t('turn_back')%>
    <%end%>
    <div class="flex-grow-1 d-flex flex-column gap-3">
      <h1 class="text-center">
        <%=t('page_titles.edit_house') %> - <%= @house.name %>
      </h1>

      <p class="text-center text-secondary fst-italic"><%= "#{t("last_updated")}: #{l(@house.updated_at, format: :default)}" %></p>
    </div>
  </div>  


  <%# Main section %>
  <div class="d-flex gap-3 align-items-start">
    <%# Sidebar %>
    <div class="border-end border-2 pe-4 flex-shrink-0">
      <div class="d-flex flex-column side-bar align-items-stretch">
        <%= house_mode_badge(@house) %>
        <%= button_to change_mode_landlord_house_path(@house), 
            class:"d-flex align-items-center justify-content-center p-2",
            data: {
              turbo_confirm: t("form.house.change_mode_cf")
            } do%>
          <span class="material-symbols-outlined">change_circle</span>
          <%= t('form.house.change_mode')%>
        <%end%>
      </div>
  
      <%# Content table %>
      <div class="mt-3 d-flex flex-column gap-2 px-2">
        <a class="title-toc active" href="#general-info"><%= t("form.house.general_info")%></a>
        <a class="title-toc" href="#floors"><%= t("form.house.floor_map")%></a>
      </div>

      <%# Delete button %>
      <%= link_to check_delete_landlord_house_path(@house),
          class: "mt-5 btn btn-danger d-flex align-items-center justify-content-center gap-2 fw-bold" do %>
        <span class="material-symbols-outlined">delete</span>
        <%= t('form.house.delete')%>
      <%end%>
    </div>

    <div class="px-3 flex-grow-1">
      <%# General info form %>
      <section id="general-info" class="mb-5">
        <h3 class="mb-3"><%= t("general_info") %></h3>

        <%= form_with model: @house, url: landlord_houses_path(@house), local: true, 
                class:"house-form d-flex align-items-center flex-column gap-4" ,
                data: { 
                  controller: "loading",
                  loading_text_value: t("saving") + "...",
                  action: "submit->loading#submit"
                } do |f| %>

          <!-- Name -->   
          <div class="form-group" data-controller="form">
              <%= f.label :name , class: "form-label d-flex justify-content-between",
                          value: @house.name do%>
                  <div>
                    <%= t('form.house.name') +  ": "%>
                    <span class="asterisk">*</span>
                  </div>

                  <small class="counter-text">
                    <span data-form-target="charCount">0</span>
                  </small>
              <% end %>

              <%= f.text_field :name, minlength: 1, maxlength: 100, class: "mb-1 form-control #{invalid_class(@house, :name)}", 
                  placeholder: t('form.house.name_placeholder'), required: true,
                  data: {
                      form_target: "input",
                      action: "input->form#update"
                  } 
              %>

              <%= field_error(@house, :name) %>
          </div>

          <!-- Address -->
          <%# 2 dropdowns to show locations %>
          <div class="form-group d-flex flex-column flex-wrap"
              data-controller="location"
              data-location-provinces-value="<%= json_escape @provinces.to_json %>"
              data-location-communes-value="<%= json_escape @communes.to_json %>"
              data-location-selected-province-value="<%= @house.address_l1 %>"
              data-location-selected-commune-value="<%= @house.address_l2 %>">
            <p class="form-label" >
              <%= t('form.house.addr') + ": "%> 
              <span class="asterisk">*</span>
            </p>

            <div class="d-flex gap-3 align-items-center">
              <p class="text-nowrap flex-shrink-0">
                <%= t("form.house.loc.vietnam") %>
              </p>

              <!-- Province -->
              <%= f.select :address_l1,
                    [],
                    { prompt: t("form.house.loc.l1") },
                    class: "form-select", required: true,
                    data: {
                      location_target: "province",
                      action: "change->location#provinceChanged"
                    } %>

              <!-- Commune -->
              <%= f.select :address_l2,
                    [],
                    { prompt: t("form.house.loc.l2") },
                    class: "form-select", required: true,
                    disabled: true,
                    data: {
                      location_target: "commune"
                    } %>
            </div>
          </div>

          <!-- Address detail-->
          <div class="form-group" data-controller="form">
              <%= f.label :address_l3, class: "form-label d-flex justify-content-between" do%>
                  <div>
                      <%= t('form.house.detailed_addr') +  ": "%>
                      <span class="asterisk">*</span>
                  </div>

                  <small class="counter-text">
                      <span data-form-target="charCount">0</span>
                  </small>
              <% end %>

              <%= f.text_field :address_l3, minlength: 2, maxlength: 100, class: "form-control", 
                  value: @house.address_l3,
                  placeholder: t('form.house.detailed_addr_placeholder'), required: true,
                  data: {
                      form_target: "input",
                      action: "input->form#update"
                  } 
              %>
          </div>

          <!--Invoice creation date-->
          <div class="form-group">
            <div class="d-flex align-items-center gap-3">
              <%= f.label :inv_creation_date, class: "form-label m-0 flex-shrink-0 text-nowrap" do %>
                <%= t("form.house.inv_creation_date") %>:
                <span class="asterisk">*</span>
              <% end %>

              <%= f.number_field :inv_creation_date, in: 1..31, step: 1, required: true, 
                  placeholder: "1-31", value: @house.inv_creation_date,
                  class: "number form-control" 
              %>
            </div>
            
            <div class="field-info my-2 d-flex align-items-center gap-1">
              <span class="material-symbols-outlined">info</span>
              <small><%= t('form.house.inv_creation_date_info') %></small>
            </div>
          </div>

          <!-- Regulation file -->
          <div class="form-group" data-controller="file-input"
                data-file-input-confirm-message-value="<%= t('form.house.remove_regulation_cf') %>">
            <div class="d-flex align-items-center gap-3 flex-wrap">
              <%= f.label :regulation_file, class: "form-label m-0 flex-shrink-0 text-nowrap" do %>
                <%= t("form.house.regulation") %>:
              <% end %>

              <div class="flex-grow-1">

                <% if @house.regulation_file.attached? %>
                  <div class="position-relative"
                      data-file-input-target="currentFile">

                    <div class="input-group w-100">
                      <label class="input-group-text">
                        <%= t("form.house.file_type") %>: .pdf
                      </label>

                      <%= link_to @house.regulation_file.filename,
                            rails_blob_path(@house.regulation_file, disposition: :inline),
                            target: "_blank",
                            class: "form-control text-decoration-none" %>
                    </div>

                    <button type="button"
                            class="btn btn-outline-danger position-absolute top-50 end-0 me-1 translate-middle-y p-0 d-flex align-items-center justify-content-center"
                            data-action="click->file-input#removeExistingFile">
                      <span class="material-symbols-outlined">close</span>
                    </button>
                  </div>
                <% end %>

                <div class="<%= 'd-none' if @house.regulation_file.attached? %>"
                    data-file-input-target="fileInput">

                  <div class="position-relative">
                    <div class="input-group w-100">
                      <label class="input-group-text">
                        <%= t("form.house.file_type") %>: .pdf
                      </label>

                      <%= f.file_field :regulation_file,
                            class: "form-control",
                            accept: ".pdf",
                            data: {
                              file_input_target: "input",
                              action: "change->file-input#updateRemoveButton"
                            } %>
                    </div>

                    <button type="button"
                            class="btn btn-outline-danger position-absolute top-50 end-0 me-1 translate-middle-y d-none p-0 d-flex align-items-center justify-content-center"
                            data-file-input-target="removeBtn"
                            data-action="click->file-input#clearFile">

                      <span class="material-symbols-outlined">
                        close
                      </span>
                    </button>
                  </div>
                </div>

                <%= f.hidden_field :remove_regulation_file, value: 0,
                    data: { file_input_target: "removeExistingInput" } %>

              </div>
            </div>
          </div>

          <%# Submit button %>
          <%= f.submit t("save"), 
                class: "custom-primary-btn main-form d-flex align-items-center justify-content-center gap-2",
                data: {loading_target: "button"} do%>
                <span data-loading-target="text"><%= t("save") %></span>

                <span class="material-symbols-outlined spin d-none"
                  data-loading-target="spinner">
                  progress_activity
                </span>
            <%end%>

        <%end%>
      </section>


      <%# Floor section %>
      <section id="floors" class="house-form border-top py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h3 class="mb-0">
            <%= t("form.house.floor_map") %>
          </h3>

          <%= link_to new_landlord_house_floor_path(@house),
                      class: "custom-primary-btn",
                      data: { turbo_frame: "new_floor_modal" } do %>
            <span class="material-symbols-outlined">add</span>
            <%= t("add") %>
          <% end %>
        </div>

        <div
          data-controller="sortable"
          data-sortable-url-value="<%= sort_landlord_house_floors_path(@house) %>">

          <% @floors.each_with_index do |floor, index| %>

            <div
              class="border rounded p-3 mb-3 d-flex align-items-center gap-3 floor-row"
              data-id="<%= floor.id %>">

              <!-- Position -->
              <div
                class="fw-bold text-secondary"
                style="width:40px;">
                <%= index + 1 %>.
              </div>

              <!-- Drag handle -->
              <span
                class="material-symbols-outlined drag-handle"
                style="cursor:grab;">
                drag_indicator
              </span>

              <!-- Floor name -->
              <%= form_with model: floor,
                            url: landlord_house_floor_path(@house, floor),
                            method: :patch,
                            class: "flex-grow-1" do |f| %>

                <%= f.text_field :name,
                      class: "form-control",
                      maxlength: 100,
                      required: true %>

              <% end %>

              <!-- Delete -->
              <%= link_to check_delete_landlord_house_floor_path(@house, floor),
                          data: { turbo_frame: "floor_delete_modal" },
                          title: t("delete"),
                          class: "table-action" do %>
                <span class="material-symbols-outlined">delete</span>
              <% end %>

            </div>

          <% end %>

        </div>

      </section>
      
    </div>

  </div>

</div>

<%= turbo_frame_tag "floor_delete_modal" %>

<%= turbo_frame_tag "house_delete_modal" %>

<%= turbo_frame_tag "new_floor_modal" %>
