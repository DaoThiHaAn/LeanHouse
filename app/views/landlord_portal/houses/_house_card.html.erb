<%# Local variables: house %>

<div class="d-flex gap-1 align-items-center detailed-house-card w-100">
  <%# Detail %>
  <div class="house-content d-flex flex-column gap-2">
      <div class="d-flex align-items-center justify-content-start gap-1">
        <span class="material-symbols-filled">location_home</span>

        <%# Turbo link to open modal on click %>
        <%= link_to house.name, landlord_house_path(house),
                    title: t("form.house.open_modal"),
                    data: { turbo_frame: "house_detail_modal" }, 
                    class: "title text-clamp-2 text-decoration-none fw-bold" %>
      </div>

      <p class="text-clamp-2"><%= house.full_address %></p>

      <div class="d-flex flex-column flex-lg-row align-items-lg-center">
        <div class="d-flex align-items-center text-nowrap gap-1">
          <span class="material-symbols-outlined">group</span>
          <%= occupied_rate_format(house) %>
        </div>
        <p class="ms-lg-4 mt-1 mt-lg-0 fst-italic text-secondary text-nowrap"><%= house_mode(house) %></p>
      </div>
  </div>

  <%# Buttons %>
  <div class="house-actions d-flex flex-column align-items-center gap-1 ms-auto">
      <%= link_to edit_landlord_house_path(house),
            data: { 
              turbo_frame: "_top", # force Rails to direct to a new page
              **tooltip("right", :"edit") 
            },
            class: "house-btn p-2 rounded-circle" do %>
        <span class="material-symbols-filled">edit</span>
      <% end %>

      <%= link_to check_deletion_landlord_house_path(house),
                class: "house-btn p-2 rounded-circle",
                data: {turbo_frame: "house_delete_modal"} do %>
        <span class="material-symbols-filled">delete</span>
      <% end %>

      <%= link_to landlord_house_rooms_path(house), 
                data: { 
                  turbo_frame: "_top", # force Rails to direct to a new page
                  **tooltip("right", :"form.house.enter") 
                },
                class: "house-btn p-2 rounded-circle d-flex align-items-center justify-content-center" do %>
        <span class="material-symbols-filled">arrow_right_alt</span>
      <% end %>
  </div>
</div>

<%= turbo_frame_tag "house_delete_modal" %>
