<%# Local variables: house %>

<div class="d-flex gap-1 align-items-center detailed-house-card">
	<%# Detail %>
	<div class="house-content d-flex flex-column gap-2">
			<div class="d-flex align-items-center justify-content-start gap-1">
				<span class="material-symbols-filled">location_home</span>
				<p class="title text-clamp-2"><%=house.name%></p>
			</div>
			<p class="text-clamp-2"><%=house_address(house)%></p>
			<div class="d-flex gap-1 align-items-center">
				<span class="material-symbols-outlined">group</span>
				<%=occupied_rate_format(house)%>
				<p class="ms-3 fst-italic text-secondary"><%=house_mode(house)%></p>
			</div>
	</div>

	<%# Buttons %>
	<div class="house-actions d-flex flex-column align-items-center gap-1">
			<%= button_to edit_landlord_house_path(house),
								class: "house-btn p-2 rounded-circle" do %>
				<span class="material-symbols-filled">edit</span>
			<%end%>

			<%= button_to landlord_house_path(house), method: :delete,
								class: "house-btn p-2 rounded-circle" do %>
				<span class="material-symbols-filled">delete</span>
			<%end%>

			<%= link_to landlord_house_rooms_path(house), 
								data: { 
										turbo_frame: "_top",  # Avoid turbo mismatch - explicitly tell to navigate to a whole new page
										**tooltip("right", "form.house.enter") 
								},
								class: "house-btn p-2 rounded-circle d-flex align-items-center justify-content-center" do %>
				<span class="material-symbols-filled">arrow_right_alt</span>
			<%end%>
	</div>
</div>