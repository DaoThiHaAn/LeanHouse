<%# Variables: @houses, @landlord %>

<% content_for :title, t("page_titles.house_mng") %>

<div class="house-main-container py-4 px-3 px-md-4">
  <!-- Page Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 px-3 border-bottom w-100">
    <div>
      <h1><%= t("form.house.house_list") %></h1>

      <div class="mt-3 d-flex align-items-center gap-2 text-secondary">
        <span><%= t("form.house.num_house") %></span>
        <span class="badge bg-light text-secondary border px-2 py-1 rounded-pill">
          <%= @landlord.houses_count %> / 20
        </span>
        <span><%= t("form.house.self").downcase %></span>
        <span class="material-symbols-outlined max-house-info fs-6 cursor-pointer"
              <%= tooltip("right", :"form.house.max_house", html: true) %>>
          info
        </span>
      </div>
    </div>

    <div>
      <% if @landlord.houses_count >= 20 %>
        <button type="button" class="main-btn disabled opacity-50 pe-none" aria-disabled="true"
                <%= tooltip("left", :"form.house.max_house", html: true) %>>
          <div class="d-flex align-items-center gap-2">
            <span class="material-symbols-filled">add_home</span>
            <span><%= t('form.house.add') %></span>
          </div>
        </button>
      <% else %>
        <%= link_to new_landlord_house_path, class: "main-btn shadow-sm text-decoration-none" do %>
          <div class="d-flex align-items-center gap-2">
            <span class="material-symbols-filled fs-3">add_home</span>
            <span><%= t('form.house.add') %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Search & Filter Toolbar %>
  <%= form_with url: landlord_houses_path, method: :get,
                class: "row g-4 align-items-center justify-content-center mb-5",
                data: {
                  controller: "search",
                  turbo_frame: "house-grid",
                  turbo_action: "advance"
                } do |f| %>

    <div class="col-12 col-md-5 col-lg-4">
      <div class="input-group shadow-sm search-group">
        <span class="input-group-text bg-white border-end-0">
          <span class="material-symbols-outlined fs-5">search</span>
        </span>
        <%= f.search_field :query,
            value: params[:query],
            placeholder: "#{t("form.house.search")}...",
            class: "form-control border-start-0 ps-0 bg-white",
            data: {
              search_target: "input",
              action: "input->search#debounce"
            } %>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-md-3 col-xl-2">
      <div class="d-flex align-items-center gap-2">
        <%= f.label :state, t("form.house.state"), class: "fw-semibold text-secondary text-nowrap small mb-0" %>
        <%= f.select :state,
            [[t("all"), ""],
              [t("form.house.state_not_empty"), "not_empty"],
              [t("form.house.state_available"), "available"],
              [t("form.house.state_full"), "full"],
              [t("form.house.state_empty"), "empty"]],
            { selected: params[:state] },
            class: "form-select form-select-sm shadow-sm",
            data: { action: "change->search#changed" },
            onchange: "this.form.requestSubmit()" %>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-md-4 col-xl-3">
      <div class="d-flex align-items-center gap-2">
        <%= f.label :invoice_status, t("form.house.invoice_status"), class: "fw-semibold text-secondary text-nowrap small mb-0" %>
        <%= f.select :invoice_status,
            [[t("form.house.invoice_status_all"), ""],
              [t("form.house.invoice_status_has_unpaid"), "has_unpaid"],
              [t("form.house.invoice_status_all_paid"), "all_paid"]],
            { selected: params[:invoice_status] },
            class: "form-select form-select-sm shadow-sm flex-grow-1",
            data: { action: "change->search#changed" },
            onchange: "this.form.requestSubmit()" %>
      </div>
    </div>

    <div class="col-5 col-sm-4 col-md-3 col-xl-2">
      <div class="d-flex align-items-center gap-2">

        <button type="button"
                class="btn btn-outline-secondary d-flex align-items-center gap-1 flex-shrink-0 d-none"
                data-search-target="clearButton"
                data-action="click->search#clear">
          <span class="material-symbols-outlined fs-5">filter_alt_off</span>
          <span class="d-none d-md-inline"><%= t("clear_filter") %></span>
        </button>
      </div>
    </div>
  <% end %>

  <%# House card grid %>
  <%= turbo_frame_tag "house-grid", class: "d-block w-100" do %>
    <% if @houses.empty? %>
      <div class="empty card text-center py-5 my-3 bg-white rounded-3 shadow-sm p-4">
        <span class="material-symbols-outlined text-muted fs-1">home_work</span>
        <p class="fs-5 text-secondary fw-semibold mt-1"><%= t("form.house.no_houses_found") %></p>
      </div>

    <% else %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        <% @houses.each do |house| %>
          <div class="col d-flex align-items-stretch">
            <%= render "landlord_portal/houses/house_card", house: house %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<%# Target container for dynamic house detail modal rendering %>
<%= turbo_frame_tag "house_detail_modal" %>
