<%# Variables: @houses, @landlord %>

<% content_for :title, t("page_titles.house_mng") %>

<div class="main-container d-flex flex-column align-items-center w-75">
  <h1 class="text-center flex-grow-1 mb-5"><%= t("form.house.house_list") %></h1>

  <%# Search & State Filter Bar %>
  <%= form_with url: landlord_houses_path, method: :get,
                class: "d-flex align-items-center flex-wrap gap-3 mb-4 w-75 justify-content-center",
                data: {
                  controller: "search",
                  turbo_frame: "house-grid",
                  turbo_action: "advance"
                } do |f| %>

    <div class="input-group search-bar flex-grow-1" style="min-width: 250px;">
      <span class="input-group-text">
        <span class="material-symbols-outlined">search</span>
      </span>

      <%= f.search_field :query,
          value: params[:query],
          placeholder: "#{t("form.house.search")}...",
          class: "form-control shadow-sm",
          data: {
            search_target: "input",
            action: "input->search#debounce"
          } %>
    </div>

    <div class="d-flex align-items-center gap-2">
      <%= f.label :state, t("form.house.state"), class: "fw-semibold text-nowrap" %>
      <%= f.select :state,
          [[t("all"), ""],
           [t("form.house.state_not_empty"), "not_empty"],
           [t("form.house.state_available"), "available"],
           [t("form.house.state_full"), "full"],
           [t("form.house.state_empty"), "empty"]],
          { selected: params[:state] },
          class: "form-select w-auto shadow-sm",
          onchange: "this.form.requestSubmit()" %>
    </div>
  <% end %>

  <!-- Add House Button (disabled when houses_count >= 20) -->
  <div class="d-flex align-items-center gap-2 mb-3">
    <% if @landlord.houses_count >= 20 %>
      <button type="button" class="main-btn disabled" aria-disabled="true">
        <div class="d-flex align-items-center gap-2">
          <span class="material-symbols-filled">add_home</span>
          <%= t('form.house.add') %>
        </div>
      </button>
    <% else %>
      <!-- Active State  -->
      <%= link_to new_landlord_house_path, class: "shadow-sm main-btn" do %>
        <div class="d-flex align-items-center gap-2">
          <span class="material-symbols-filled">add_home</span>
          <%= t('form.house.add') %>
        </div>
      <% end %>
    <% end %>

    <span class="material-symbols-outlined max-house-info fs-5"
          <%= tooltip("right", :"form.house.max_house", html: true) %>>
      info
    </span>
  </div>

  <p><%= t("form.house.num_house", num: @landlord.houses_count) %></p>

  <%# House card grid %>
  <%= turbo_frame_tag "house-grid", class: "d-block w-100" do %>
    <% if @houses.empty? %>
      <div class="text-center py-5">
        <p class="fs-5 text-muted fw-semibold"><%= t("form.house.no_houses_found") %></p>
      </div>
    <% else %>
      <div class="mt-3 row row-cols-1 row-cols-md-2 g-4 justify-content-center mx-auto">
        <% @houses.each do |house| %>
          <div class="col d-flex align-items-stretch">
            <%= render "landlord_portal/houses/house_card", house: house %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<%# Target container for dynamic house detail modal rendering %>
<%= turbo_frame_tag "house_detail_modal" %>
