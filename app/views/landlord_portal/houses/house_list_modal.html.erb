<!-- Modal to show a card list of houses-->

<%= turbo_frame_tag "other_houses" do %>
<div class="modal fade" id="houseListModal" tabindex="-1" aria-labelledby="houseModalLabel" aria-hidden="true"
      data-controller="modal" data-modal-auto-open-value="true">
  <div class="modal-dialog modal-sm modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content px-2">
      <div class="modal-header">
        <h1 class="modal-title w-100 fs-5 text-center" id="houseListModalLabel"><%= t("bar.other_houses")%></h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body py-4">
        <% if @other_houses.any? %>
          <div class="d-flex flex-column justify-content-center gap-3">
            <% @other_houses.each do |other_house| %>
              <%= render "house_list_card", house: other_house, url: landlord_house_rooms_path(other_house) %>
            <% end %>
          </div>
        <% else %>
          <li><span class="dropdown-item-text text-muted"><%= t('bar.no_other_houses') %></span></li>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>