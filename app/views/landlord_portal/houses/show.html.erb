<%# Variables: @house, @floors, @services %>

<%= turbo_frame_tag "house_detail_modal" do %>
  <div class="modal fade" id="houseDetailModal" tabindex="-1" aria-hidden="true"
        data-controller="modal" data-modal-auto-open-value="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content px-2">
        <div class="modal-header py-0">
          <div class="d-flex align-items-center justify-content-start gap-1 mx-auto">
            <span class="icon material-symbols-filled">location_home</span>
            <h1 class="modal-title fs-5" id="houseDetailModalLabel"><%= @house.name %></h1>
          </div>
          <button type="button" class="m-0 btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <%= house_mode_badge(@house) %>

          <div class="d-flex align-items-center gap-2 mt-3">
            <span class="material-symbols-outlined">location_on</span>
            <p class="text-clamp-2 mb-0"><%= house_address(@house) %></p>
          </div>

          <div class="d-flex align-items-center gap-2 mt-3">
            <h6 class="fw-bold m-0"><%=t("form.house.inv_creation_date") + ": "%></h6>
            <p class="m-0"><%= @house.inv_creation_date %></p>
          </div>

          <%# Display Regulation File %>
          <div class="d-flex align-items-center gap-3 mt-3">
            <h6 class="fw-bold m-0"><%=t("form.house.regulation") + ": "%></h6>

            <% if @house.regulation_file.attached? %>
              <div>
                <%= link_to rails_blob_path(@house.regulation_file, disposition: "inline"), 
                            target: "_blank",  title: t("form.file.view"),
                            rel: "noopener", 
                            class: "btn btn-outline-primary d-inline-flex align-items-center gap-2" do %>
                  <span class="material-symbols-outlined">description</span>
                  <%= @house.regulation_file.filename.to_s %>
                  <span class="material-symbols-outlined fs-6">open_in_new</span>
                <% end %>
              </div>
            <% else %>
              <p class="text-muted fst-italic fs-7"><%= t("none") %></p>
            <% end %>
          </div>

          <%# Floors & Rooms %>
          <div class="mt-3 pt-3 border-top">
            <div class="d-flex gap-2 align-items-center">
              <h6 class="fw-bold m-0"><%="#{@house.floors_count} #{t("form.floor.self")}:" %></h6>

              <%= link_to landlord_house_rooms_path(@house), class: "d-inline-flex align-items-center",
                data: { turbo_frame: "_top",
                      **tooltip("right", "view_detail")} do %>
                <span class="material-symbols-outlined">arrow_right_alt</span>
              <% end %>
            </div>

            <div class="floor table-responsive border rounded mt-2">
              <table class="table table-bordered table-hover table-sm align-middle mb-0">
                <thead class="table-light sticky-top">
                  <tr>
                    <th><%= t("form.floor.self") %></th>
                    <th><%= t("form.room.num") %></th>
                    <th><%= t("form.floor.total_slots") %></th>
                  </tr>
                </thead>

                <tbody>
                  <% @floors.each do |floor| %>
                    <tr>
                      <td><%= truncate(floor.name, length: 20) %></td>
                      <td><%= floor.rooms_count %></td>
                      <td><%= floor.total_slots %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>

          <%# Services %>
          <div class="mt-3 pt-3 border-top">
            <div class="d-flex gap-2 align-items-center">
              <h6 class="fw-bold m-0"><%= t("form.service.self") + ":" %></h6>

              <%= link_to landlord_house_services_path(@house), class: "d-inline-flex align-items-center",
                data: { turbo_frame: "_top",
                      **tooltip("right", "view_detail")} do %>
                <span class="material-symbols-outlined">arrow_right_alt</span>
              <% end %>
            </div>
            
            <div class="floor table-responsive border rounded mt-2">
              <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light sticky-top">
                  <tr>
                    <th><%= t("form.service.price") %></th>
                    <th><%= t("form.service.unit") %></th>
                    <th class="text-center"><%= t("form.service.real_time_short") %></th>
                  </tr>
                </thead>

                <tbody>
                  <% @services.each do |service| %>

                    <!-- Service name -->
                    <tr class="colspan">
                      <td colspan="3">
                        <p class="fw-semibold mb-0"><%= service.name %></p>

                        <% if service.note.present? %>
                          <div class="mt-1">
                            <%= image_tag "note.png", alt: "Note icon", class: "note-icon" %>
                            <span class="text-secondary fw-light"><%= service.note %></span>
                          </div>
                        <% end %>
                      </td>
                    </tr>

                    <!-- Service variants -->
                    <% service.service_variants.each do |variant| %>
                      <tr>
                        <td><%= number_with_delimiter(variant.fee, delimiter: ",") %></td>
                        <td><%= t("enums.room_service.unit.#{variant.unit}") %></td>
                        <td class="text-center align-middle">
                          <% if variant.is_real_time %>
                            <span class="material-symbols-outlined d-inline-flex">
                              check_circle
                            </span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>

          <%# Assets %>
          <div class="mt-3 pt-3 border-top">
            <div class="d-flex gap-2 align-items-center">
              <h6 class="fw-bold m-0"><%= t("form.property.title") + ":" %></h6>

              <%= link_to landlord_house_assets(@house), class: "d-inline-flex align-items-center",
                data: { turbo_frame: "_top",
                      **tooltip("right", "view_detail")} do %>
                <span class="material-symbols-outlined">arrow_right_alt</span>
              <% end %>
            </div>
            
          </div>
        </div>


        <div class="modal-footer d-flex justify-content-between align-items-center">
          <%# Edit button %>
          <%= link_to edit_landlord_house_path(@house), 
                data: { turbo_frame: "_top" }, # force Rails to direct to a new page
                class: "main-btn d-flex align-items-center justify-content-center gap-1" do %>
            <span class="material-symbols-filled">edit</span>
            <%=t("edit")%>
          <% end %>

          <p class="text-secondary fst-italic mb-0"><%= "#{t("last_updated")}: #{l(@house.updated_at, format: :default)}" %></p>
        </div>
      </div>
    </div>
  </div>
<% end %>