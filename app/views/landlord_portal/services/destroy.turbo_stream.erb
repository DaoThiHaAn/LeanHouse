<%= turbo_stream.remove dom_id(@service) %>

<%= turbo_stream.update "sidebar_services_count" do %>
  <%= t("service.total", val: @house.services.count) %>
<% end %>

<%= turbo_stream.update "service_workspace" do %>
  <div class="d-flex flex-column align-items-center justify-content-center h-100 text-secondary p-5">
    <div class="empty-state-icon mb-3 d-flex align-items-center justify-content-center rounded-circle bg-light">
      <span class="material-symbols-outlined fs-1 text-secondary">touch_app</span>
    </div>
    <p class="fs-5 fw-bold text-secondary text-center mb-1">
      <%= t("service.select_service_prompt") %>
    </p>
  </div>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "layouts/shared_components/flash_message" %>
<% end %>
