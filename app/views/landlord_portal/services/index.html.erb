<!-- Variables: @services -->

<% content_for :title, t("page_titles.service_mng") %>

<% provide :container_width, "d-flex flex-column vh-100 w-95 px-0 pb-0" %>

<h1 class="text-center mb-5"> <%= t("page_titles.service_mng") %></h1>

<% if @services.empty? %>
  <p class="fs-5 text-center fw-bold"><%= t("form.asset.none") %></p>

  <!-- Add service btn -->
  <%= link_to new_landlord_house_service_path(@house),
      class: "shadow-sm main-btn px-2 py-1 d-flex align-items-center gap-2 mx-auto mt-3",
      data: {turbo_frame: "new_service_modal"} do %>
    <span class="material-symbols-filled">add_circle</span>
    <%= t('form.service.add') %>
  <% end %>
<% else %>
  <div class="d-flex h-100 position-relative" data-controller="sidebar">
    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar" data-sidebar-target="sidebar">

      <!-- Tag-styled Toggle Button with Arrow -->
      <button id="sidebarToggle"
          class="sidebar-toggle-tag"
          type="button"
          data-action="click->sidebar#toggle"
          aria-label="Toggle sidebar"
          title="<%= t("sidebar.click_to_open") %>">
        <span class="material-symbols-outlined icon-close">arrow_menu_close</span>
        <span class="material-symbols-outlined icon-open">arrow_menu_open</span>
      </button>

      <!-- Sidebar Inner Content -->
      <div class="sidebar-content w-100 h-100 overflow-y-auto">
          <div class="d-flex gap-1 m-4 w-80 align-items-center">
            <h2 class="fw-bold text-center fs-5 flex-grow-1 m-0">
              <%= t("form.service.list") %>
            </h2>

            <!-- Add service btn -->
            <%= link_to new_landlord_house_service_path(@house),
                title: t("form.service.add"),
                class: "add-sv-btn shadow-sm d-flex align-items-center justify-content-center rounded-circle",
                data: {turbo_frame: "new_service_modal"} do %>
              <span class="material-symbols-filled">add_circle</span>
            <% end %>
          </div>

        <nav class="sidebar-nav mt-2 px-3">
          <!-- Service card list -->
          <%= turbo_frame_tag "service_list" do %>
            <p class="fw-semibold text-center mb-3">
              <%= t("form.service.total", val: @services.length) %>
            </p>

            <div class="d-flex flex-column gap-3 h-100 overflow-y-auto">
              <% @services.each do |service| %>
                <!-- Service card -->
                <div class="d-flex gap-1 align-items-center service-card <%= selected?() %> w-100 py-2 ps-3 pe-2">
                  <span class="material-symbols-filled tag-icon">shoppingmode</span>
                  <%= link_to landlord_house_service_path(@house, service),
                      class: "d-block flex-grow-1",
                      title: t("click_choose") do %>
                    <%= service.name %>
                  <% end %>

                  <div class="service-actions d-flex flex-column align-items-center gap-2 ms-auto">
                    <% unless service.note.blank? %>
                      <%= image_tag 'note.png', alt: "Note icon", width: "25px",
                          class: "d-block", data: {**tooltip("right", service.note)} %>
                    <% end %>

                    <%= link_to edit_landlord_house_service_path(@house, service),
                          data: { 
                            turbo_frame: "edit_service_modal",
                          },
                          title: t("form.service.edit"),
                          class: "service-btn p-1 rounded-circle" do %>
                      <span class="material-symbols-filled">edit</span>
                    <% end %>

                    <%= button_to landlord_house_service_path(@house, service), method: :delete,
                              class: "service-btn p-1 rounded-circle",
                              title: t("form.service.delete"),
                              data: {
                                turbo_confirm: [
                                  t("form.service.delete_cf", name: service.name),
                                  t("form.service.delete_warning_1")
                                ].join("\n\n") ,
                                turbo_frame: "_top"} do %>
                      <span class="material-symbols-filled">delete</span>
                    <% end %>
                  </div>
                </div>

              <% end %>
            </div>

          <% end %>

          <!-- Variant zone -->

          <!-- Room-service table -->

        </nav>
      </div>
     </aside>

    <!-- Main zone -->
    <div class="flex-grow-1">
        MAIN ZONE
    </div>

  </div>
<% end %>

<%= turbo_frame_tag "new_service_modal" %>
<%= turbo_frame_tag "edit_service_modal" %>
