<%# Variables: @house, @services, @selected_service, @total_house_rooms %>

<% content_for :title, t("page_titles.service_mng") %>

<h1 class="text-center mb-3"><%= t("page_titles.service_mng") %></h1>
<p class="text-secondary text-center border-bottom pb-2 mb-5"><%= t("form.service.mng_note") %></p>

<% if @services.empty? %>
  <div class="text-center pb-3">
    <%= image_tag 'services.png', alt: "Services icon", width: "150px" %>
    <p class="fs-5 text-center fw-bold my-3"><%= t("form.service.none") %></p>

    <!-- Add service btn -->
    <%= link_to new_landlord_house_service_path(@house),
        class: "shadow-sm main-btn d-inline-flex align-items-center gap-2 mx-auto",
        data: { turbo_frame: "new_service_modal" } do %>
      <span class="material-symbols-filled">add_circle</span>
      <%= t('form.service.add') %>
    <% end %>
  </div>

<% else %>
  <div class="d-flex position-relative shadow-sm bg-light"
       data-controller="sidebar service-filter">
    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar" data-sidebar-target="sidebar">
      <!-- Tag-styled Toggle Button with Arrow -->
      <button id="sidebarToggle"
          class="sidebar-toggle-tag"
          type="button"
          data-action="click->sidebar#toggle"
          aria-label="Toggle sidebar"
          title="<%= t("sidebar.click_to_open") %>">
        <span class="material-symbols-outlined icon-close">arrow_menu_close</span>
        <span class="material-symbols-outlined icon-open">arrow_menu_open</span>
      </button>

      <!-- Sidebar Inner Content -->
      <div class="sidebar-content w-100 h-100 d-flex flex-column">
        <div class="d-flex gap-2 p-3 align-items-center justify-content-between border-bottom">
          <h2 class="fw-bold fs-6 m-0 text-truncate">
            <%= t("form.service.list") %>
          </h2>

          <!-- Add service btn -->
          <%= link_to new_landlord_house_service_path(@house),
              title: t("form.service.add"),
              class: "add-sv-btn shadow-sm d-flex align-items-center justify-content-center rounded-circle",
              data: { turbo_frame: "new_service_modal" } do %>
            <span class="material-symbols-filled">add_circle</span>
          <% end %>
        </div>

        <!-- Search Bar -->
        <div class="input-group input-group-sm my-3 w-85 mx-auto">
          <span class="input-group-text bg-white border-end-0 text-secondary">
            <span class="material-symbols-outlined fs-6">search</span>
          </span>
          <input type="text" autocomplete="off"
                  class="form-control border-start-0 ps-0"
                  placeholder="<%= t('form.service.search_placeholder') %>"
                  data-service-filter-target="input"
                  data-action="input->service-filter#filter">
        </div>

        <p id="sidebar_services_count" class="fw-semibold text-center mb-3 px-3 small text-secondary">
          <%= t("form.service.total", val: @services.length) %>
        </p>

        <!-- Service Cards List -->
        <div id="services_list_items" class="d-flex flex-column gap-1 overflow-y-auto px-2 pb-3 flex-grow-1">
          <% @services.each do |service| %>
            <%= render "service_card",
                       service: service,
                       house: @house,
                       is_selected: (@selected_service&.id == service.id) %>
          <% end %>
        </div>

        <!-- Filter Empty Message -->
        <div data-service-filter-target="emptyMessage" class="text-center text-secondary small py-3 px-2 d-none">
          <%= t("form.service.filter_empty") %>
        </div>
      </div>
    </aside>

    <!-- Main Workspace Area -->
    <div class="flex-grow-1 h-100 bg-light bg-opacity-25 overflow-y-auto">
      <%= turbo_frame_tag "service_workspace", class: "d-block h-100" do %>
        <% if @selected_service.present? %>
          <%= render "service_workspace",
                     service: @selected_service,
                     house: @house,
                     total_rooms: @total_house_rooms %>
        <% else %>
          <!-- Empty State Prompt -->
          <div class="d-flex flex-column align-items-center justify-content-center h-100 text-secondary p-5">
            <div class="empty-state-icon mb-3 d-flex align-items-center justify-content-center rounded-circle bg-white border shadow-sm" style="width: 70px; height: 70px;">
              <span class="material-symbols-outlined fs-1 text-primary">left_click</span>
            </div>
            <h5 class="fw-bold text-dark mb-2 text-center"><%= t("form.service.select_service_prompt") %></h5>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<%= turbo_frame_tag "new_service_modal" %>
<%= turbo_frame_tag "edit_service_modal" %>
<%= turbo_frame_tag "service_variant_modal" %>
