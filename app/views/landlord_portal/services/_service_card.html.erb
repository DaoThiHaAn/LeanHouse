<%# Locals: service, house, is_selected %>
<% is_selected = local_assigns[:is_selected] || (@selected_service&.id == service.id) %>

<div id="<%= dom_id(service) %>"
     class="service-card-item w-100 mb-2"
     data-service-filter-target="card"
     data-service-name="<%= service.name %>">
  <div class="d-flex align-items-center service-card <%= 'selected' if is_selected %> w-100 py-2 ps-3 pe-2">
    <span class="material-symbols-filled tag-icon me-2">shoppingmode</span>

    <%= link_to landlord_house_service_path(house, service),
                class: "service-title-link flex-grow-1 text-truncate",
                title: t("click_choose", default: "Nhấp để chọn"),
                data: {
                  turbo_frame: "service_workspace",
                  turbo_action: "advance"
                } do %>
      <span class="fw-semibold"><%= service.name %></span>
    <% end %>

    <div class="service-actions d-flex align-items-center gap-1 ms-auto">
      <% if service.note.present? %>
        <%= image_tag "note.png", alt: "Note icon", width: "20px", height: "20px",
            class: "d-block opacity-75", data: { **tooltip("top", service.note) } %>
      <% end %>

      <%= link_to edit_landlord_house_service_path(house, service),
                  data: { turbo_frame: "edit_service_modal" },
                  title: t("form.service.edit"),
                  class: "service-btn p-1 rounded-circle" do %>
        <span class="material-symbols-filled">edit</span>
      <% end %>

      <%= button_to landlord_house_service_path(house, service),
                    method: :delete,
                    class: "service-btn p-1 rounded-circle",
                    title: t("form.service.delete"),
                    data: {
                      turbo_confirm: [
                        t("form.service.delete_cf", name: service.name),
                        t("form.service.delete_warning_1")
                      ].join("\n\n")
                    } do %>
        <span class="material-symbols-filled">delete</span>
      <% end %>
    </div>
  </div>
</div>

