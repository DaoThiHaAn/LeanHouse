<%# Locals: service, house, total_rooms %>
<% total_rooms = local_assigns[:total_rooms] || house.rooms.active.count %>
<% variants = service.service_variants %>

<div class="service-workspace-container d-flex flex-column h-100 p-3 p-md-4">
  <%# Service Header %>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-4 ms-3 border-bottom">
    <div class="d-flex align-items-center gap-3">
      <!-- Service icon -->
      <div class="service-header-icon rounded-circle d-flex align-items-center justify-content-center">
        <span class="material-symbols-filled fs-2 text-primary">shoppingmode</span>
      </div>

      <div>
        <div class="d-flex align-items-center gap-3">
          <h2 class="fs-4 fw-bold m-0 text-dark"><%= service.name %></h2>
          <span id="service_variants_count" class="badge bg-light text-secondary border">
            <%= t("form.service.total_variants", val: variants.size) %>
          </span>
        </div>
        <% if service.note.present? %>
          <div class="d-flex align-items-center gap-1 mt-2 text-muted small">
            <span class="material-symbols-outlined fs-6">note</span>
            <span><%= service.note %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="d-flex align-items-center gap-2">
      <%# Add Variant Button %>
      <%= link_to new_landlord_house_service_service_variant_path(house, service),
                  class: "custom-primary-btn d-flex align-items-center gap-2 px-3 py-2",
                  data: { turbo_frame: "service_variant_modal" } do %>
        <span class="material-symbols-filled fs-5">add_circle</span>
        <span><%= t("form.service.variant.add") %></span>
      <% end %>
    </div>
  </div>

  <%# Variants List %>
  <div class="flex-grow-1 overflow-y-auto">
    <div id="service_variants_list" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
      <% if variants.any? %>
        <% variants.each do |variant| %>
          <div class="col" id="<%= dom_id(variant) %>_col">
            <%= render "landlord_portal/service_variants/variant_card",
                       variant: variant,
                       house: house,
                       service: service,
                       total_rooms: total_rooms %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Empty State if no variants %>
    <div id="no_variants_prompt" class="text-center py-5 <%= 'd-none' if variants.any? %>">
      <span class="empty-state-icon material-symbols-outlined text-muted mb-3">category</span>
      
      <p class="fw-bold text-secondary mb-2 fs-5"><%= t("form.service.no_variants") %></p>
      <p class="text-muted mx-auto mb-4">
        <%= t("form.service.no_variants_prompt") %>
      </p>
    </div>
  </div>
</div>

