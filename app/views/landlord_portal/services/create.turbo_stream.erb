<%= turbo_stream.append "services_list_items" do %>
  <%= render "service_card", service: @service, house: @house, is_selected: false %>
<% end %>

<%= turbo_stream.update "sidebar_services_count" do %>
  <%= t("service.total", val: @house.services.count) %>
<% end %>

<%= turbo_stream.update "new_service_modal", "" %>

<%= turbo_stream.update "flash" do %>
  <%= render "layouts/shared_components/flash_message" %>
<% end %>
