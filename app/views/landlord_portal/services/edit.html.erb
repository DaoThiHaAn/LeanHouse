<%# Variables: @house, @service %>

<%= turbo_frame_tag "edit_service_modal" do %>
  <div class="modal fade" id="editServiceModal" tabindex="-1" aria-hidden="true"
       data-controller="modal" data-modal-auto-open-value="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content px-2">
        <div class="modal-header py-2">
          <h1 class="modal-title fs-5 w-100 text-center" id="editServiceModalLabel">
            <%= t("service.edit") %>
          </h1>
          <button type="button" class="m-0 btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-3">
          <%= form_with model: [@house, @service],
                        url: landlord_house_service_path(@house, @service),
                        method: :patch,
                        class: "d-flex flex-column gap-3",
                        data: {
                          controller: "loading",
                          loading_text_value: t("saving", default: "Đang lưu...") + "...",
                          action: "submit->loading#submit"
                        } do |f| %>

            <%# Name %>
            <div class="form-group">
              <%= f.label :name, class: "form-label fw-semibold" do %>
                <%= t("service.self") %> <span class="text-danger">*</span>
              <% end %>
              <%= f.text_field :name, required: true,
                               class: "form-control #{invalid_class(@service, :name)}" %>
              <%= field_error(@service, :name) %>
            </div>

            <%# Note %>
            <div class="form-group">
              <%= f.label :note, t("note", default: "Ghi chú"), class: "form-label fw-semibold" %>
              <%= f.text_area :note, rows: 3,
                              class: "form-control #{invalid_class(@service, :note)}" %>
              <%= field_error(@service, :note) %>
            </div>

            <%# Submit %>
            <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t("cancel", default: "Hủy") %></button>
              <%= f.button :submit,
                           class: "custom-primary-btn d-flex align-items-center gap-2",
                           data: { loading_target: "button" } do %>
                <span class="material-symbols-outlined fs-5">save</span>
                <span data-loading-target="text"><%= t("save", default: "Lưu") %></span>
                <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">progress_activity</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
