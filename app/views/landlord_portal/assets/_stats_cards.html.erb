<%
  total_count = stats[:total_count].to_i
  damaged_count = stats[:damaged_count].to_i
  normal_count = stats[:normal_count].to_i
  has_assets = total_count.positive?
  has_damaged = damaged_count.positive?

  condition_theme = if !has_assets
                      "stat-card-gray"
                    elsif has_damaged
                      "stat-card-orange"
                    else
                      "stat-card-green"
                    end

  condition_icon = if !has_assets
                     "devices"
                   elsif has_damaged
                     "build"
                   else
                     "verified"
                   end
%>

<div id="asset_stats_grid" class="row row-cols-1 row-cols-md-3 g-3 mb-5">
  <%# 1. Total Assets (Teal Theme) %>
  <div class="col">
    <div class="card stat-card stat-card-teal shadow-sm h-100 p-3">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <p class="stat-card-title fw-bold">
          <%= t("admin.assets.total_assets") %>
        </p>
        <div class="stat-icon-wrap rounded-circle d-flex align-items-center justify-content-center">
          <span class="material-symbols-filled fs-3">inventory_2</span>
        </div>
      </div>
      <div class="d-flex align-items-baseline gap-2">
        <span class="fs-3 fw-bold stat-card-value"><%= total_count %></span>
        <p class="stat-card-subtext fw-semibold"><%= t("admin.assets.items_unit") %></p>
      </div>
      <small class="text-secondary mt-1 fst-italic"><%= t("admin.assets.total_subtext") %></small>
    </div>
  </div>

  <%# 2. Condition (Green / Orange / Gray Theme) %>
  <div class="col">
    <div class="card stat-card <%= condition_theme %> shadow-sm h-100 p-3">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <p class="stat-card-title fw-bold">
          <%= t("admin.assets.asset_condition") %>
        </p>
        <div class="stat-icon-wrap rounded-circle d-flex align-items-center justify-content-center <%= 'text-danger' if has_damaged %>">
          <span class="material-symbols-filled fs-3 <%= 'warning-pulse' if has_damaged %>">
            <%= condition_icon %>
          </span>
        </div>
      </div>
      <div class="d-flex align-items-baseline gap-2 flex-wrap">
        <% if has_assets %>
          <span class="fs-3 fw-bold stat-card-value text-success"><%= normal_count %></span>
          <span class="text-success fw-semibold"><%= t("admin.assets.normal_short") %></span>
          <span class="text-secondary fs-3">·</span>
          <span class="fs-3 fw-bold stat-card-value <%= has_damaged ? 'text-danger' : 'text-secondary' %>"><%= damaged_count %></span>
          <span class="<%= has_damaged ? 'text-danger' : 'text-secondary' %> fw-semibold"><%= t("admin.assets.damaged_short") %></span>
        <% else %>
          <span class="fs-3 fw-bold stat-card-value text-secondary">0</span>
          <span class="text-secondary fw-semibold"><%= t("admin.assets.normal_short") %></span>
          <span class="text-secondary fs-3">·</span>
          <span class="fs-3 fw-bold stat-card-value text-secondary">0</span>
          <span class="text-secondary fw-semibold"><%= t("admin.assets.damaged_short") %></span>
        <% end %>
      </div>
      <small class="<%= has_damaged ? 'text-danger fw-semibold' : 'text-secondary' %> mt-1 fst-italic">
        <% if !has_assets %>
          <%= t("admin.assets.no_assets") %>
        <% elsif has_damaged %>
          <%= damaged_count %> <%= t("admin.assets.needs_repair") %>
        <% else %>
          <%= t("admin.assets.all_good") %>
        <% end %>
      </small>
    </div>
  </div>

  <%# 3. Total Investment Value (Blue Theme) %>
  <div class="col">
    <div class="card stat-card stat-card-blue shadow-sm h-100 p-3">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <p class="stat-card-title fw-bold">
          <%= t("admin.assets.total_value") %>
        </p>
        <div class="stat-icon-wrap rounded-circle d-flex align-items-center justify-content-center">
          <span class="material-symbols-filled fs-3">payments</span>
        </div>
      </div>
      <div class="d-flex align-items-baseline gap-2">
        <span class="fs-3 fw-bold stat-card-value text-primary"><%= format_money(stats[:total_price]) %></span>
      </div>
      <small class="text-secondary mt-1 fst-italic"><%= t("admin.assets.investment_subtext") %></small>
    </div>
  </div>
</div>
