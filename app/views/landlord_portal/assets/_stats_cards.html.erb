<%# Locals: stats, house %>

<div id="asset_stats_grid" class="row row-cols-1 row-cols-md-3 g-3 mb-5">
  <%# 1. Total Assets (Teal Theme) %>
  <div class="col">
    <div class="card stat-card stat-card-teal shadow-sm h-100 p-3">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <p class="stat-card-title fw-bold">
          <%= t("admin.assets.total_assets") %>
        </p>
        <div class="stat-icon-wrap rounded-circle d-flex align-items-center justify-content-center">
          <span class="material-symbols-filled fs-3">inventory_2</span>
        </div>
      </div>
      <div class="d-flex align-items-baseline gap-2">
        <span class="fs-3 fw-bold stat-card-value"><%= stats[:total_count] %></span>
        <p class="stat-card-subtext fw-semibold"><%= t("admin.assets.items_unit") %></p>
      </div>
      <small class="text-secondary mt-1 fst-italic"><%= t("admin.assets.total_subtext") %></small>
    </div>
  </div>

  <%# 2. Condition (Green / Orange Theme) %>
  <div class="col">
    <div class="card stat-card <%= stats[:damaged_count].to_i.positive? ? 'stat-card-orange' : 'stat-card-green' %> shadow-sm h-100 p-3">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <p class="stat-card-title fw-bold">
          <%= t("admin.assets.asset_condition") %>
        </p>
        <div class="stat-icon-wrap rounded-circle d-flex align-items-center justify-content-center <%= 'text-danger' if stats[:damaged_count].to_i.positive? %>">
          <span class="material-symbols-filled fs-3 <%= 'warning-pulse' if stats[:damaged_count].to_i.positive? %>">
            <%= stats[:damaged_count].to_i.positive? ? 'build' : 'verified' %>
          </span>
        </div>
      </div>
      <div class="d-flex align-items-baseline gap-2 flex-wrap">
        <span class="fs-3 fw-bold stat-card-value text-success"><%= stats[:normal_count] %></span>
        <span class="text-success fw-semibold"><%= t("admin.assets.normal_short") %></span>
        <span class="text-secondary fs-3">·</span>
        <span class="fs-3 fw-bold stat-card-value <%= stats[:damaged_count].to_i.positive? ? 'text-danger' : 'text-secondary' %>"><%= stats[:damaged_count] %></span>
        <span class="<%= stats[:damaged_count].to_i.positive? ? 'text-danger' : 'text-secondary' %> fw-semibold"><%= t("admin.assets.damaged_short") %></span>
      </div>
      <small class="<%= stats[:damaged_count].to_i.positive? ? 'text-danger fw-semibold' : 'text-secondary' %> mt-1 fst-italic">
        <% if stats[:damaged_count].to_i.positive? %>
          <%= stats[:damaged_count] %> <%= t("admin.assets.needs_repair") %>
        <% else %>
          <%= t("admin.assets.all_good") %>
        <% end %>
      </small>
    </div>
  </div>

  <%# 3. Total Investment Value (Blue Theme) %>
  <div class="col">
    <div class="card stat-card stat-card-blue shadow-sm h-100 p-3">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <p class="stat-card-title fw-bold">
          <%= t("admin.assets.total_value") %>
        </p>
        <div class="stat-icon-wrap rounded-circle d-flex align-items-center justify-content-center">
          <span class="material-symbols-filled fs-3">payments</span>
        </div>
      </div>
      <div class="d-flex align-items-baseline gap-2">
        <span class="fs-3 fw-bold stat-card-value text-primary"><%= format_money(stats[:total_price]) %></span>
      </div>
      <small class="text-secondary mt-1 fst-italic"><%= t("admin.assets.investment_subtext") %></small>
    </div>
  </div>
</div>
