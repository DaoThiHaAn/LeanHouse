<%# Local variables: house, assets %>

<%= turbo_frame_tag "asset_table" do %>
  <!-- Dùng cho Stimulus pagination-sync cập nhật url -->
  <span hidden data-pagination-total-pages="<%= assets.total_pages %>"></span>

  <div class="floor table-responsive border rounded mt-2">
    <table class="table table-bordered table-hover align-middle mb-0">
      <thead class="table-light sticky-top">
        <tr>
          <th><%= t("form.asset.cat") %></th>
          <th><%= t("form.asset.location") %></th>
          <th><%= t("form.asset.price") %> (đ)</th>
          <th><%= t("form.asset.brand") %></th>
          <th><%= t("form.asset.model") %></th>
          <th><%= t("form.asset.purchase_date") %></th>
          <th><%= t("note") %></th>
          <th class="text-center"><%= t("actions") %></th>
        </tr>
      </thead>

      <tbody>
        <% if assets.empty? %>
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">
              <%= t("form.asset.none") %>
            </td>
          </tr>
        <% else %>
          <% assets.each do |asset| %>
            <tr>
              <td><%= asset.human_category %></td>
              <td><%= asset.location %></td>
              <td><%= number_with_delimiter(asset.price) %></td>
              <td><%= asset.brand %></td>
              <td><%= asset.model %></td>
              <td><%= asset.purchased_at %></td>
              <td class="text-muted fst-italic"><%= asset.note %></td>
              <td>
                <div class="d-flex align-items-center justify-content-center gap-1">
                  <%= link_to edit_landlord_house_asset_path(house, asset),
                            data: { turbo_frame: "edit_asset_modal" },
                            title: t("edit"),
                            class: "table-action" do %>
                    <span class="material-symbols-filled">edit</span>
                  <% end %>

                  <%= link_to landlord_house_asset_repair_history_index_path(house, asset),
                            data: { turbo_frame: "_top" },
                            title: t("form.repair_history.view"),
                            class: "table-action" do %>
                    <span class="material-symbols-outlined">manage_history</span>
                  <% end %>

                  <%= button_to landlord_house_asset_path(house, asset), method: :delete,
                            title: t("delete"),
                            data: { turbo_confirm: [t("form.asset.delete_cf"), t("not_redo")].join("\n\n") },
                            class: "table-action" do %>
                    <span class="material-symbols-filled">delete</span>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-3">
    <%= paginate assets, params: { category: params[:category] } %>
  </div>
<% end %>
