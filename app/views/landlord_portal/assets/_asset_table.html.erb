<%# Local variables: house, assets %>

<%= turbo_frame_tag "asset_table" do %>
  <!-- Dùng cho Stimulus pagination-sync cập nhật url -->
  <span hidden data-pagination-total-pages="<%= assets.total_pages %>"></span>

  <div class="asset table-responsive border rounded mt-2">
    <table class="table table-bordered table-hover align-middle mb-0">
      <thead class="table-light sticky-top">
        <tr>
          <th><%= t("form.asset.cat") %></th>
          <th><%= t("form.asset.location") %></th>
          <th><%= t("form.asset.price") %> </th>
          <th class="text-center"><%= t("form.asset.status") %></th>
          <th><%= t("form.asset.brand") %></th>
          <th><%= t("form.asset.model") %></th>
          <th><%= t("form.asset.purchase_date") %></th>
          <th><%= t("note") %></th>
          <th class="text-center"><%= t("actions") %></th>
        </tr>
      </thead>

      <tbody>
        <% if assets.empty? %>
          <tr>
            <td colspan="8" class="text-center py-4 text-secondary">
              <%= t("form.asset.none") %>
            </td>
          </tr>
        <% else %>
          <% assets.each do |asset| %>
            <%= render "landlord_portal/assets/asset_row", house: house, asset: asset %>          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-3">
    <%= paginate assets, 
        params: { category: params[:category], status: params[:status] } %>
  </div>
<% end %>
