<!-- Variables: @category_options, @rooms, @rooms_option, @floors-->

<%= turbo_frame_tag "new_asset_modal" do %>

  <div class="modal fade" id="newAssetModal" tabindex="-1" aria-hidden="true"
        data-controller="modal" data-modal-auto-open-value="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">

      <div class="modal-content px-2">
        <div class="modal-header">
          <h1 class="modal-title fs-4 flex-grow-1 text-center" id="newAssetModalLabel"><%= t("form.asset.new") %></h1>
          <button type="button" class="m-0 btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body d-flex flex-column align-items-center">
          <%= form_with model: @asset, url: landlord_house_assets_path(@house), method: :post,
                class:"px-4 py-2 mx-auto mb-2 d-flex flex-column gap-3" ,
                data: { 
                  turbo_frame: "_top",
                  controller: "loading",
                  loading_text_value: t("adding") + "...",
                  action: "submit->loading#submit"
                } do |f| %>

            <h2 class="fw-bold"><%= t("form.asset.info") %></h2>

            <!-- Category dropdown -->
            <div class="mb-3" data-controller="custom-category">
              <div class="input-group">
                <%= f.label :category, class: "input-group-text" do %>
                  <%= t("form.asset.cat") + ":" %><span class="ms-1 asterisk">*</span>
                <% end %>
                <%= select_tag :category_select,
                      options_for_select([[t("form.asset.select_cat"), ""]] + @category_options),
                      class: "form-select",
                      required: true,
                      data: {
                        custom_category_target: "select",
                        action: "change->custom-category#toggle"
                      } %>
              </div>
              <%# Ô nhập category khác (ẩn theo mặc định, hiện ra khi chọn 'other') %>
              <div class="input-group mt-2 d-none" data-custom-category-target="customContainer">
                <span class="input-group-text"><%= t("form.asset.cat_name") %>:</span>
                <%= text_field_tag :custom_category, nil,
                      class: "form-control",
                      placeholder: t("form.asset.other_cat_placeholder"),
                      data: { custom_category_target: "customInput" },
                      disabled: true %>
              </div>
            </div>

            <!-- Price -->
            <div class="room-name form-group">
              <div class="d-flex align-items-center gap-3">
                <%= f.label :price, class: "form-label flex-shrink-0" do %>
                  <%= t('form.asset.price') + ": " %><span class="asterisk">*</span>
                <% end %>
                <%= f.number_field :price, min: 1, max: 1000000000, class: "form-control w-50", required: true %>
              </div>
            </div>

            <!-- Brand -->
            <div class="room-name form-group">
              <div class="d-flex align-items-center gap-3" data-controller="form">
                <%= f.label :brand, class: "form-label flex-shrink-0" do %>
                      <%= t('form.asset.brand') +  ": " %>
                <% end %>

                <%= f.text_field :brand, maxlength: 100, class: "mb-1 form-control w-50", 
                    placeholder: t('form.asset.brand_placeholder'),
                    data: {
                        form_target: "input",
                        action: "input->form#update"
                    } 
                %>

                <small class="counter-text">
                  <span data-form-target="charCount">0</span>
                </small>
              </div>
            </div>

            <!-- Model -->
            <div class="room-name form-group">
              <div class="d-flex align-items-center gap-3" data-controller="form">
                <%= f.label :model, class: "form-label flex-shrink-0" do %>
                      <%= t('form.asset.model') +  ": " %>
                <% end %>

                <%= f.text_field :model, maxlength: 100, class: "mb-1 form-control w-50", 
                    placeholder: t('form.asset.model_placeholder'),
                    data: {
                        form_target: "input",
                        action: "input->form#update"
                    } 
                %>

                <small class="counter-text">
                  <span data-form-target="charCount">0</span>
                </small>
              </div>
            </div>

            <!-- Note -->
            <div class="room-name form-group">
              <div class="d-flex align-items-center gap-3" data-controller="form">
                <%= f.label :note, class: "form-label flex-shrink-0" do %>
                      <%= t('note') +  ": " %>
                <% end %>

                <%= f.text_area :note, maxlength: 1000, class: "mb-1 form-control", 
                    placeholder: t('note_placeholder'),
                    rows: 5,
                    data: {
                        form_target: "input",
                        action: "input->form#update"
                    } 
                %>

                <small class="counter-text">
                  <span data-form-target="charCount">0</span>
                </small>
              </div>
            </div>

            <!-- Purchase date -->
            <div class="form-group d-flex align-items-center gap-3">
              <%= f.label :purchased_at, class: "form-label flex-shrink-0" do %>
                      <%= t('form.asset.purchase_date') +  ": " %>
              <% end %>
              <%= f.date_field :purchased_at, class: "date form-control" %>
            </div>

            <!-- Location: Floor -> Room -->
            <h2 class="fw-bold mt-3"><%= t("form.asset.select_room") %></h2>

            <div data-controller="dependent-rental-unit"
                data-dependent-rental-unit-rooms-value="<%= @room_options.to_json %>"
            >
              <%# Floor %>
              <div class="input-group mb-3">
                <%= label_tag :floor_id, class: "input-group-text" do %>
                  <%= t("form.floor.self") + ":" %><span class="ms-1 asterisk">*</span>
                <% end %>
                <%= select_tag :floor_id,
                      options_for_select([[t("form.room.select_floor"), ""]] + @floors.map { |floor| [floor.name, floor.id] }),
                      class: "form-select", required: true,
                      data: { 
                        dependent_rental_unit_target: "floor",
                        action: "change->dependent-rental-unit#floorChanged" 
                      } %>
              </div>

              <%# Room %>
              <div class="input-group mb-3">
                <%= f.label :room_id, class: "input-group-text" do %>
                  <%= t("form.room.self") + ":" %><span class="ms-1 asterisk">*</span>
                <% end %>

                <%= f.select :room_id, [], {}, class: "form-select", required: true,
                      data: { 
                        dependent_rental_unit_target: "room", 
                        action: "change->dependent-rental-unit#roomChanged" 
                      } %>
              </div>
            </div>

            <%= f.button type: :submit, 
                  class: "mt-2 custom-primary-btn mx-auto main-form d-flex align-items-center justify-content-center gap-2",
                  data: { loading_target: "button" } do %>
                  <span data-loading-target="text"><%= t("add") %></span>

                  <span class="material-symbols-outlined spin d-none"
                    data-loading-target="spinner">
                    progress_activity
                  </span>
            <% end %>
          <% end %>

        </div>
      </div>
    </div>
  </div>
<% end %>
