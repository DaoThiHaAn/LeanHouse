<%# Variables: @contract, @user, @house %>

<% content_for :title, t("page_titles.new_contract") %>

<div class="contract-container w-50 shadow">
  <div class="d-flex align-items-center mb-5">
    <%= back_link_to %>
    <h1 class="text-center flex-grow-1"><%= t('page_titles.new_contract') %></h1>
  </div>

  <%= render "tenant_info_card", user: @user %>

  <%= render "form",
            contract: @contract,
            url: landlord_house_tenant_contract_path(@house, @user.tenant) %>
</div>
