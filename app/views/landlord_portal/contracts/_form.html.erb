<%# locals: (contract:, url:, old_contract: nil, submit_text: nil, is_edit: false) %>

<%
  existing_docs = if contract.persisted? && contract.documents.attached?
    contract.documents.map do |doc|
      {
        id: doc.id,
        url: rails_blob_path(doc, disposition: "inline"),
        name: doc.filename.to_s
      }
    end
  else
    []
  end
%>

<%= form_with model: contract, url: url,
    class: "px-4 mt-4 d-flex flex-column gap-4",
    data: { 
      controller: "loading",
      loading_text_value: t("saving") + "...",
      action: "submit->loading#submit"
    } do |f| %>

  <% if old_contract.present? %>
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-0 py-2 px-3">
      <span class="material-symbols-outlined fs-5 text-warning-emphasis">warning</span>
      <span class="fw-medium">
        <%= t("form.contract.sign_new_note", id: old_contract.id, default: "Lưu ý: Ký hợp đồng mới sẽ tự động kết thúc hợp đồng hiện tại (mã số: #{old_contract.id}).") %>
      </span>
    </div>
  <% end %>

  <!-- Name -->
  <div class="form-group" data-controller="form">
    <%= f.label :name, class: "form-label d-flex justify-content-between" do %>
      <div>
          <%= t('form.contract.name') +  ": " %>
          <span class="asterisk">*</span>
      </div>

      <small class="counter-text">
          <span data-form-target="charCount">0</span>
      </small>
    <% end %>

    <div class="input-group">
      <span class="input-group-text"><%= t("form.contract.self") %></span>
      <%= f.text_field :name, maxlength: 50, class: "form-control #{invalid_class(contract, :name)}", 
        placeholder: t('form.contract.name_placeholder'), required: true,
        data: {
            form_target: "input",
            action: "input->form#update"
        } 
      %>
    </div>

    <%= field_error(contract, :name) %>
  </div>

  <!-- Landlord Citizen ID -->
  <div class="form-group" data-controller="form">
    <%= f.label :landlord_citizen_id, class: "form-label d-flex justify-content-between" do %>
      <div>
          <%= t('form.contract.landlord_citizen_id') +  ": " %>
          <span class="asterisk">*</span>
      </div>

      <small class="counter-text">
          <span data-form-target="charCount">0</span>
      </small>
    <% end %>

    <%= f.text_field :landlord_citizen_id, maxlength: 12, class: "form-control #{invalid_class(contract, :landlord_citizen_id)}", 
      placeholder: t('form.contract.citizen_id_placeholder'), required: true,
      data: {
          form_target: "input",
          action: "input->form#update"
      } 
    %>

    <%= field_error(contract, :landlord_citizen_id) %>
  </div>

  <!-- Tenant Citizen ID -->
  <div class="form-group" data-controller="form">
    <%= f.label :tenant_citizen_id, class: "form-label d-flex justify-content-between" do %>
      <div>
          <%= t('form.contract.tenant_citizen_id') +  ": " %>
          <span class="asterisk">*</span>
      </div>

      <small class="counter-text">
          <span data-form-target="charCount">0</span>
      </small>
    <% end %>

    <%= f.text_field :tenant_citizen_id, maxlength: 12, class: "form-control #{invalid_class(contract, :tenant_citizen_id)}", 
      placeholder: t('form.contract.citizen_id_placeholder'), required: true,
      data: {
          form_target: "input",
          action: "input->form#update"
      } 
    %>

    <%= field_error(contract, :tenant_citizen_id) %>
  </div>

  <!-- Period -->
  <div class="form-group">
    <div class="d-flex gap-1">
      <p class="fw-semibold"><%= t('form.contract.period') +  ": " %></p>
      <span class="asterisk">*</span>
    </div>

    <% if local_assigns[:is_edit] %>
      <p class="fst-italic mt-2 mb-3 text-muted fw-medium"><%= t("form.contract.period_note") %></p>

      <div class="d-flex justify-content-between mt-2 gap-2">
        <div class="input-group mb-3">
          <span class="input-group-text"><%= t("form.contract.start") %></span>
          <%= f.date_field :start_date, class: "date form-control bg-light", disabled: true %>
        </div>

        <div class="input-group mb-3">
          <span class="input-group-text"><%= t("form.contract.end") %></span>
          <%= f.date_field :due_date, class: "date form-control bg-light", disabled: true %>
        </div>
      </div>
    <% else %>
      <p class="fst-italic mt-2 mb-3 text-danger-emphasis fw-medium"><%= t("form.contract.period_note") %></p>

      <div class="d-flex justify-content-between mt-2 gap-2">
        <div class="input-group mb-3">
          <span class="input-group-text"><%= t("form.contract.start") %></span>
          <%= f.date_field :start_date, class: "date form-control", required: true %>
        </div>

        <div class="input-group mb-3">
          <span class="input-group-text"><%= t("form.contract.end") %></span>
          <%= f.date_field :due_date, class: "date form-control", required: true %>
        </div>
      </div>

      <%= field_error(contract, :due_date) %>
    <% end %>
  </div>

  <!-- Deposit paid -->
  <div class="form-group">
    <div class="d-flex align-items-center gap-3">
      <%= f.label :deposit_paid, 
            t("form.contract.deposit_paid", default: "Đã chuyển tiền cọc") + ":", 
            class: "form-label fw-semibold m-0 flex-shrink-0 cursor-pointer", 
            for: "deposit_paid_switch" %>

      <div class="form-check form-switch m-0">
        <%= f.check_box :deposit_paid, 
              class: "form-check-input", 
              role: "switch", 
              id: "deposit_paid_switch" %>
      </div>
    </div>
    <%= field_error(contract, :deposit_paid) %>
  </div>

  <!-- Temp residence registration -->
  <div class="form-group" data-controller="toggle-extra-fields">
    <div class="d-flex gap-4">
      <label class="form-label fw-semibold m-0 flex-shrink-0">
        <%= t("form.contract.resid_register", default: "Đăng ký tạm trú") %>:
      </label>

      <div class="d-flex flex-column gap-2">
        <%# Chưa %>
        <div class="form-check m-0 d-flex align-items-center gap-1">
          <%= f.radio_button :temp_resid_registered, "false",
                checked: !contract.temp_resid_registered?,
                class: "form-check-input",
                id: "temp_resid_false",
                data: { action: "change->toggle-extra-fields#toggle" } %>
          <%= label_tag "temp_resid_false", "Chưa", class: "form-check-label" %>
        </div>

        <%# Rồi %>
        <div class="d-flex gap-3">
          <div class="form-check m-0 d-flex align-items-center gap-2">
            <%= f.radio_button :temp_resid_registered, "true",
                  checked: contract.temp_resid_registered?,
                  class: "form-check-input",
                  id: "temp_resid_true",
                  data: {
                    toggle_extra_fields_target: "checkbox",
                    action: "change->toggle-extra-fields#toggle"
                  } %>
            <%= label_tag "temp_resid_true", "Rồi", class: "form-check-label" %>
          </div>

          <%# Hạn: date input %>
          <div class="d-flex align-items-center gap-2 <%= "d-none" unless contract.temp_resid_registered? %>"
              data-toggle-extra-fields-target="extraFields">
            <span class="fw-semibold"><%= t("form.contract.due") %>:</span>
            <%= f.date_field :temp_resid_due_date,
                  min: Date.current.to_s,
                  class: "date form-control",
                  placeholder: "dd/mm/yyyy" %>
          </div>
        </div>
      </div>
    </div>

    <%= field_error(contract, :temp_resid_due_date, classes: "mt-2") %>
  </div>

  <!-- Note -->
  <div class="form-group" data-controller="form">
    <div class="d-flex align-items-center justify-content-between gap-3">
      <%= f.label :note, class: "form-label flex-shrink-0" do %>
            <%= t('note') +  ": " %>
      <% end %>

      <small class="counter-text">
        <span data-form-target="charCount">0</span>
      </small>
    </div>

    <%= f.text_area :note, maxlength: 1000, class: "form-control", 
        placeholder: t('note_placeholder'),
        rows: 5,
        data: {
            form_target: "input",
            action: "input->form#update"
        } 
    %>
  </div>

  <!-- Chứng từ hợp đồng -->
  <div class="form-group mb-3" data-controller="image-upload"
        data-image-upload-max-files-value="10"
        data-image-upload-max-size-mb-value="20"
        data-image-upload-existing-files-value="<%= existing_docs.to_json %>">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <div class="d-flex gap-1">
        <p class="fw-semibold m-0"><%= t("form.contract.documents") %>:</p>
        <span class="asterisk">*</span>
      </div>

      <small class="counter-text">
        <span data-image-upload-target="fileCount"><%= existing_docs.size %></span>/10
      </small>
    </div>

    <%= field_info(
      [t("form.contract.img_note_1"), t("form.contract.img_note_2")],
      extra_classes: "gap-2 mb-3",
    ) %>

    <div class="d-flex flex-wrap gap-3 align-items-center">
      <button type="button"
              class="upload-img-btn btn btn-light border d-flex align-items-center justify-content-center p-0"
              data-action="click->image-upload#triggerUpload"
              title="<%= t("add_img") %>">
        <span class="material-symbols-outlined text-secondary">
          add_photo_alternate
        </span>
      </button>

      <%= f.file_field :documents,
            multiple: true,
            accept: "image/*",
            class: "d-none",
            data: {
              image_upload_target: "input",
              action: "change->image-upload#handleFiles"
            } %>

      <div class="d-flex flex-wrap gap-3 align-items-center" data-image-upload-target="previewContainer"></div>
      <div data-image-upload-target="purgeContainer"></div>
    </div>

    <small class="text-danger d-none mt-1 d-block" data-image-upload-target="errorMessage"></small>
    <%= field_error(contract, :documents, classes: "mt-2") %>
  </div>

  <div class="info-container px-3 py-2 mb-2 mx-auto">
    <%= field_info(
      [t("form.contract.note")],
      extra_classes: "gap-2")  %>
  </div>

  <div class="d-flex justify-content-center align-items-center gap-3 mt-3">
    <button type="reset"
            class="cancel-btn d-inline-flex align-items-center justify-content-center gap-1 px-4 py-2"
            title="<%= t("reset") %>">
      <span class="material-symbols-outlined fs-5">restart_alt</span>
      <%= t("reset") %>
    </button>

    <%= f.button :submit, 
      class: "custom-primary-btn main-form d-flex align-items-center justify-content-center gap-2 m-0",
      data: { loading_target: "button" } do %>
      <span data-loading-target="text"><%= local_assigns[:submit_text] || t("save") %></span>
      <span class="material-symbols-outlined spin d-none"
        data-loading-target="spinner">
        progress_activity
      </span>
    <% end %>
  </div>
<% end %>
