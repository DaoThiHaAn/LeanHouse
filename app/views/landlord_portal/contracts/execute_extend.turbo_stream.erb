<%= turbo_stream.replace ActionView::RecordIdentifier.dom_id(@contract) do %>
  <%= render "landlord_portal/contracts/contract_row", house: @house, contract: @contract %>
<% end %>

<%= turbo_stream.replace "contract_detail" do %>
  <%= render "landlord_portal/contracts/detail", house: @house, contract: @contract, tenant_stay: @tenant_stay %>
<% end %>

<%= turbo_stream.append "events" do %>
  <%= render "layouts/shared_components/event", event: "close-modal" %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "layouts/shared_components/flash_message" %>
<% end %>

