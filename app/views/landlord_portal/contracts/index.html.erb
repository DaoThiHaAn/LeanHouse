<!-- Variables: @unsigned_tenants, @has_contracts -->

<% content_for :title, t("page_titles.contract_mng") %>
<% provide :container_width, "h-100 full" %>

<h1 class="text-center mb-5"><%= t("page_titles.contract_mng") %></h1>

<div class="d-flex gap-5">
  <%# 1. Unsigned tenants collapsible sidebar ... %>
  <% unless @unsigned_tenants.empty? %>
    <div class="unsigned alert alert-warning card p-0 align-self-start shadow-sm"
         data-controller="collapsible">

      <%# 1. Khung hiển thị đầy đủ (Expanded) %>
      <div class="unsigned-expanded d-flex flex-column h-100" data-collapsible-target="expanded">
        <div class="card-header d-flex align-items-center justify-content-between py-2 px-3">
          <h2 class="fs-6 fw-bold mb-0 d-flex align-items-center gap-2 text-warning-emphasis">
            <span class="material-symbols-outlined warning-pulse">warning</span>
            <%= t("form.tenant.without_contract") %>!
            <span class="badge bg-warning text-dark rounded-pill"><%= @unsigned_tenants.size %></span>
          </h2>

          <%# Nút bấm thu gọn %>
          <button type="button" 
                  class="btn btn-sm btn-link p-0 text-secondary d-flex align-items-center"
                  data-action="click->collapsible#toggle"
                  title="Thu gọn">
            <span class="material-symbols-outlined fs-5">chevron_left</span>
          </button>
        </div>

        <div class="card-body overflow-y-auto d-flex flex-column gap-2 align-items-center p-3">
          <% @unsigned_tenants.each do |tenant| %>
            <div class="unsigned-card py-2 px-2 rounded w-100">
              <!-- Name + Actions -->
              <div class="d-flex align-items-center gap-2">
                <p class="flex-grow-1 text-wrap fw-semibold mb-0"><%= vn_name(tenant.user.fullname) %></p>

                <%= link_to new_landlord_house_tenant_contract_path(@house, tenant),
                    class: "d-block",
                    title: t("form.contract.sign") do %>
                  <span class="material-symbols-filled">ink_pen</span>
                <% end %>
              </div>

              <!-- Staying info -->
              <p class="text-muted fst-italic staying-info mb-0 mt-1"><%= tenant.current_staying_info %></p>
            </div>
          <% end %>
        </div>
      </div>

      <%# 2. Khung nhỏ khi thu gọn (Collapsed: Chỉ có icon warning + số lượng) %>
      <div class="unsigned-collapsed d-none flex-column align-items-center justify-content-center py-3 px-1 cursor-pointer"
           data-collapsible-target="collapsed"
           data-action="click->collapsible#toggle"
           title="<%= t("form.tenant.without_contract") %> (<%= @unsigned_tenants.size %>) - <%= t("click_expand") %> ">
        <span class="material-symbols-outlined warning-pulse fs-4">warning</span>
        <span class="badge bg-danger rounded-pill my-2" style="font-size: 0.75rem;"><%= @unsigned_tenants.size %></span>
        <span class="material-symbols-outlined text-secondary fs-5">chevron_right</span>
      </div>
    </div>
  <% end %>

  <%# 2. Main Contracts Section %>
  <% unless @has_contracts %>
    <div class="align-self-center mx-auto">
      <p class="fs-5 fw-semibold text-center">
        <%= t("form.contract.let_sign") %>
      </p>
      <%= image_tag 'agreement.gif', alt: "Contract gif", width: "170px", class: "d-block mx-auto" %>
    </div>
  <% else %>
    <div class="flex-grow-1 main-table-zone">
      <%# Search & Filter Form %>
      <%= form_with url: filtered_landlord_house_contracts_path(@house),
          method: :get,
          class: "d-flex align-items-center flex-wrap gap-4 mt-4 mb-5 align-items-center",
          data: { 
            controller: "search",
            turbo_frame: "contract_table",
            turbo_action: "advance"
          } do |f| %>

        <%# Search bar: Name %>
        <div class="input-group search-bar w-40 flex-grow-1">
          <span class="input-group-text">
            <span class="material-symbols-outlined">search</span>
          </span>

          <%= f.search_field :query,
              value: params[:query],
              placeholder: "#{t("form.tenant.name_input", default: "Nhập tên khách thuê")}...",
              class: "form-control shadow-sm",
              data: {
                search_target: "input",
                action: "input->search#debounce"
              } %>
        </div>

        <%# Contract State Filter %>
        <div class="d-flex gap-2 align-items-center">
          <%= f.label :state, t("form.contract.contract_state"), class: "fw-semibold" %>
          <%= f.select :state,
                [[t("all"), ""],
                 [t("form.contract.active", default: "Còn hiệu lực"), "active"],
                 [t("form.contract.nearly_due", default: "Sắp hết hạn"), "nearly-due"],
                 [t("form.contract.overdue", default: "Quá hạn"), "overdue"],
                 [t("form.contract.finished", default: "Đã kết thúc"), "finished"]],
                { selected: params[:state] },
                class: "form-select w-auto shadow-sm",
                onchange: "this.form.requestSubmit()" %>
        </div>
      <% end %>

      <h2 class="fs-5 mb-3"><%= t("form.contract.list") %></h2>

      <%= turbo_frame_tag "contract_table",
            src: filtered_landlord_house_contracts_path(@house, params.permit(:page, :state, :query)),
            loading: :lazy,
            data: {
              controller: "pagination-sync",
              pagination_sync_canonical_url_value: landlord_house_contracts_path(@house),
              pagination_sync_default_params_value: { state: "all" }.to_json,
              pagination_sync_query_params_value: ["state", "query"].to_json,
              pagination_sync_total_pages_selector_value: "[data-pagination-total-pages]",
              action: "turbo:frame-load->pagination-sync#updateUrl"
            } do %>
        <%= loading_spinner %>
      <% end %>
    </div>
  <% end %>
</div>

<%= turbo_frame_tag "contract_detail_modal" %>
<%= turbo_frame_tag "close_cf_modal" %>
<%= turbo_frame_tag "extend_modal" %>
