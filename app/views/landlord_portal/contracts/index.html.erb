<!-- Variables: @unsigned_tenants -->


<% content_for :title, t("page_titles.contract_mng") %>

<% provide :container_width, "h-100 w-95" %>

<h1 class="text-center mb-5"> <%= t("page_titles.contract_mng") %></h1>

<div class="d-flex gap-5">

  <% unless @unsigned_tenants.empty? %>
    <div class="unsigned alert alert-warning card p-0">
      <h2 class="card-header py-3">
        <span class="material-symbols-outlined warning-pulse">warning</span>
        <%= t("form.tenant.without_contract") %>!
      </h2>

      <div class="card-body overflow-y-auto d-flex flex-column gap-2 align-items-center">
        <!-- Show the list of unsigned tenants -->
        <% @unsigned_tenants.each do |tenant| %>
          <div class="unsigned-card py-1 px-2 rounded w-100">
            <!-- Name + Actions -->
            <div class="d-flex align-items-center gap-2 ">
              <p class="flex-grow-1 text-wrap fw-semibold"><%= vn_name(tenant.user.fullname) %> </p>

              <div class="d-flex gap-1 align-items-center w-auto">
                <%= link_to new_landlord_house_tenant_contract_path(@house, tenant),
                    class: "d-block",
                    title: t("form.contract.sign") do %>
                  <span class="material-symbols-filled">ink_pen</span>
                <% end %>
              </div>
            </div>

            <!-- Staying info -->
            <p class="text-muted fst-italic staying-info"><%= tenant.current_staying_info %> </p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @contracts.empty? %>
    <div class="align-self-center mx-auto">
      <p class="fs-5 fw-semibold">
        <%= t("form.contract.let_sign") %>&nbsp;
        <span class="material-symbols-outlined" <%= tooltip("top", :"form.contract.create_instruction", html: true) %>>
          help
        </span>
      </p>
      <%= image_tag 'agreement.gif', alt: "Contract gif", width: "170px", class: "d-block mx-auto" %>
    </div>
  <% end %>
</div>
