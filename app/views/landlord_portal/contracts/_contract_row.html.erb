<%# Local variables: house, contract %>

<tr id="<%= dom_id(contract) %>">
  <td><%= contract.id %></td>
  <td><%= contract.tenant.user.fullname %></td>
  <td><%= contract.due_date.strftime('%d/%m/%Y') %></td>
  <td><%= contract.model %></td>
  <td><%= contract.purchased_at %></td>
  <td class="text-muted fst-italic" <%= contract.note.to_s.length > 70 ? tooltip('top', contract.note, html: true) : '' %>>
    <%= truncate(contract.note, length: 70) %>
  </td>
  <td>
    <div class="d-flex align-items-center justify-content-center gap-1">
      <%= link_to edit_landlord_house_contract_path(house, contract),
                data: { turbo_frame: "edit_contract_modal" },
                title: t("edit"),
                class: "table-action" do %>
        <span class="material-symbols-filled">edit</span>
      <% end %>

      <%= link_to landlord_house_contract_repair_history_index_path(house, contract),
                data: { turbo_frame: "_top" },
                title: t("form.repair_history.view"),
                class: "table-action" do %>
        <span class="material-symbols-outlined">manage_history</span>
      <% end %>

      <%= button_to landlord_house_contract_path(house, contract), method: :delete,
                title: t("delete"),
                data: { turbo_confirm: [t("form.contract.delete_cf"), t("not_redo")].join("\n\n") },
                class: "table-action" do %>
        <span class="material-symbols-filled">delete</span>
      <% end %>
    </div>
  </td>
</tr>
