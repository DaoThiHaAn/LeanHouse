
<% content_for :title, t("form.contract.info") %>

<% provide :container_width, "w-75 px-0" %>

<div class="d-flex mb-3 px-3">
  <%= link_to :back, class: "align-self-start d-flex align-items-center gap-1 turn-back link" do %>
            <span class="material-symbols-outlined ms-2">arrow_left_alt</span>
            <%= t('turn_back') %>
  <% end %>

  <div class="flex-grow-1 mb-4 d-flex flex-column align-items-center gap-3">
    <h1 class="text-center"><%= t("form.contract.info") %></h1>
    <div class="d-flex gap-2">
      <%= link_to edit_landlord_house_contract_path(@house, @contract),
                data: { turbo_frame: "edit_contract_modal" },
                title: t("edit"),
                class: "table-action" do %>
        <span class="material-symbols-filled fs-3">edit</span>
      <% end %>

      <%= link_to close_landlord_house_contract_path(@house, @contract),
                title: t("form.contract.close"),
                data: { turbo_frame: "close_cf_modal" },
                class: "table-action" do %>
        <span class="material-symbols-filled text-danger-emphasis fs-3">contract_delete</span>
      <% end %>
    </div>
  </div>
</div>

<%= render 'detail', contract: @contract, house: @house, tenant_stay: @tenant_stay %>

<%= turbo_frame_tag "close_cf_modal" %>
