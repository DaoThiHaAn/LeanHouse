<%# Local variables: house, contracts %>

<%= turbo_frame_tag "contract_table" do %>
  <!-- Dùng cho Stimulus pagination-sync cập nhật url -->
  <span hidden data-pagination-total-pages="<%= contracts.total_pages %>"></span>

  <div class="table-responsive border rounded mt-2">
    <table class="table table-bordered table-hover align-middle mb-0">
      <thead class="table-light sticky-top">
        <tr>
          <th>
            <%= t("form.contract.id") %>
            <span class="material-symbols-outlined fs-6"
              <%= tooltip("top", :"form.contract.id_note", html: true) %>>
              info
            </span>
          </th>
          <th><%= t("form.contract.name") %></th>
          <th><%= t("form.tenant.self") %> </th>
          <th><%= t("form.contract.due_date") %></th>
          <th>
            <%= t("form.contract.contract_state") %>
             <span class="material-symbols-outlined fs-6"
              <%= tooltip("top", :"form.contract.state_note", html: true) %>>
              info
            </span>
          </th>
          <th>
            <%= t("form.contract.end") %>
            <span class="material-symbols-outlined fs-6"
              <%= tooltip("top", :"form.contract.end_note", html: true) %>>
              info
            </span>
          </th>
          <th><%= t("note") %></th>
          <th class="text-center"><%= t("actions") %></th>
        </tr>
      </thead>

      <tbody>
         <% if contracts.empty? %>
          <tr>
            <td colspan="8" class="text-center py-4 text-muted">
              <%= t("form.contract.unfound") %>
            </td>
          </tr>
        <% else %>
          <% contracts.each do |contract| %>
            <%= render "landlord_portal/contracts/contract_row", house: house, contract: contract %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-3">
    <%= paginate contracts, params: { state: params[:state], query: params[:query] } %>
  </div>
<% end %>
