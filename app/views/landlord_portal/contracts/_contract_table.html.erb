<%# Local variables: house, contracts %>

<%= turbo_frame_tag "contract_table" do %>
  <!-- Dùng cho Stimulus pagination-sync cập nhật url -->
  <span hidden data-pagination-total-pages="<%= contracts.total_pages %>"></span>

  <div class="asset table-responsive border rounded mt-2">
    <table class="table table-bordered table-hover align-middle mb-0">
      <thead class="table-light sticky-top">
        <tr>
          <th><%= t("form.contract.id") %></th>
          <th><%= t("form.contract.name") %></th>
          <th><%= t("form.tennant.self") %> </th>
          <th><%= t("form.contract.end") %></th>
          <th><%= t("form.contract.contract_state") %></th>
          <th><%= t("form.asset.purchase_date") %></th>
          <th><%= t("note") %></th>
          <th class="text-center"><%= t("actions") %></th>
        </tr>
      </thead>

      <tbody>
        <% contracts.each do |contract| %>
            <%= render "landlord_portal/contracts/contract_row", house: house, contract: contract %>          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-3">
    <%= paginate assets, params: { category: params[:category] } %>
  </div>
<% end %>
