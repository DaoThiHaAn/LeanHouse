<%# Variables: @contract, @user, @house %>

<% content_for :title, t("page_titles.edit_contract", default: "Chỉnh sửa hợp đồng") %>

<% provide :container_width, "contract-container w-50" %>

<div class="d-flex align-items-center mb-5">
  <%= link_to :back, class: "d-flex align-items-center gap-1 turn-back link" do %>
    <span class="material-symbols-outlined ms-2">arrow_left_alt</span>
    <%= t('turn_back') %>
  <% end %>
  <h1 class="text-center flex-grow-1"><%= t('page_titles.edit_contract', default: "Chỉnh sửa hợp đồng") %></h1>
</div>

<%= render "tenant_info_card", user: @user %>

<%= render "form",
           contract: @contract,
           url: landlord_house_contract_path(@house, @contract),
           submit_text: t("save_changes", default: "Lưu thay đổi"),
           is_edit: true %>
