<div class="main-container d-flex w-75 flex-column gap-3 align-items-center justify-content-center">
    <p class="no-house-text fs-4 fw-bold">
        <%= t('form.house.none') %>
    </p>

    <p class="no-house-text">
        <%= t('form.house.let_add') %>
    </p>

    <!-- Add House Button -->
    <%= link_to new_landlord_house_path, class:"shadow-sm main-btn d-flex align-items-center gap-2 px-2 py-1" do %>
        <span class="material-symbols-filled">add_circle</span>
        <%= t('form.house.add') %>
    <% end %>
    <%= image_tag 'house-website.gif', alt: "House website icon", width: "200px",
        class: "d-blokck mx-auto" %>
</div>
