<%# Local variables: request %>
<tr id="request_row_<%= request.id %>">
  <!-- Request ID -->
  <td class="px-3 fw-semibold text-muted">
    #<%= request.id %>
  </td>

  <!-- Request Type (Clickable to open detail modal) -->
  <td class="px-3">
    <%= link_to landlord_request_path(request),
          class: "text-decoration-none fw-semibold text-primary d-inline-flex align-items-center gap-1",
          data: { turbo_frame: "request_detail_modal" },
          title: t("request.detail_title", default: "Xem chi tiết yêu cầu") do %>
      <%= request.human_request_type %>
    <% end %>
  </td>

  <!-- House Name -->
  <td class="px-3">
    <%= request.house.name %>
  </td>

  <!-- Sender (Tenant name + phone) -->
  <td class="px-3">
    <div class="fw-semibold text-dark"><%= vn_name(request.tenant.user.fullname) %></div>
    <div class="text-muted small"><%= request.tenant.user.tel %></div>
  </td>

  <!-- Status -->
  <td class="px-3 text-center">
    <div class="d-flex flex-column align-items-center justify-content-center">
      <%= request_status_badge(request.status) %>
      <%= request_expiry_badge(request) %>
    </div>
  </td>

  <!-- Sent Time -->
  <td class="px-3 text-center text-muted small">
    <%= request.created_at.strftime("%H:%M - %d/%m/%Y") %>
  </td>

  <!-- Updated Time -->
  <td class="px-3 text-center text-muted small">
    <%= request.updated_at.strftime("%H:%M - %d/%m/%Y") %>
  </td>

  <!-- Action: View/Handle button -->
  <td class="px-3 text-center">
    <%= link_to landlord_request_path(request),
          class: "table-action #{request.actionable? ? 'text-primary' : 'text-secondary'}",
          data: { turbo_frame: "request_detail_modal" },
          title: request.actionable? ? t("request.handle") : t("request.detail_title") do %>
      <span class="material-symbols-filled fs-4"><%= request.actionable? ? "rate_review" : "visibility" %></span>
    <% end %>
  </td>
</tr>
