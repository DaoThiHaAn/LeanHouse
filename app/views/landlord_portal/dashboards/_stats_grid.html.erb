<%
  stats = local_assigns[:stats] || @stats
  selected_house = local_assigns.key?(:selected_house) ? local_assigns[:selected_house] : @selected_house
%>
<%= turbo_frame_tag "dashboard_stats" do %>
  <div class="row g-4">
    <!-- Card 1: Khách mới & Trả phòng (Grouped) -->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
      <div class="dashboard-stat-card card-purple p-3 shadow-sm d-flex flex-column justify-content-between ">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-4 align-items-center">
            <%= image_tag 'tenants.png', alt: "People icon", width: "45px" %>
            <div>
              <h2 class="stat-card-title"><%= t('dashboard.landlord.tenant_flow_title') %></h2>
              <div class="text-success-emphasis">
                <span class="stat-value">+ <%= stats[:tenants_flow][:new_tenants] %></span>&nbsp;
                <%= t('dashboard.landlord.new_tenants_count') %>
              </div>
              <div class="text-secondary-emphasis">
                <span class="stat-value">- <%= stats[:tenants_flow][:leaved_tenants] %></span>&nbsp;
                <%= t('dashboard.landlord.leaved_tenants_count') %>
              </div>
            </div>
          </div>
          <% if selected_house %>
            <%= link_to landlord_house_tenants_path(selected_house), class: "action-arrow-btn", title: t('dashboard.landlord.view_tenants'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= t('dashboard.landlord.tenant_flow_desc') %>
        </div>
      </div>
    </div>
    <!-- Card 2: Tỉ lệ lấp chỗ trống -->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
      <div class="dashboard-stat-card card-green p-3 shadow-sm d-flex flex-column justify-content-between ">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-3 align-items-center">
            <%= image_tag 'occupied.png', alt: "Occupied icon", width: "45px" %>
            <div>
              <div class="stat-card-title"><%= t('dashboard.landlord.occupied_rate') %></div>
              <div class="stat-value text-success mb-1"><%= stats[:occupancy][:rate] %>%</div>
              <div class="stat-subtext">
                <%= t('dashboard.landlord.slots_format', occupied: stats[:occupancy][:occupied], total: stats[:occupancy][:total]) %>
              </div>
            </div>
          </div>
          <% if selected_house %>
            <%= link_to landlord_house_rooms_path(selected_house, state: 'not_empty'), class: "action-arrow-btn", title: t('dashboard.landlord.view_rooms'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% else %>
            <%= link_to landlord_houses_path(state: 'not_empty'), class: "action-arrow-btn", title: t('dashboard.landlord.view_rooms'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= selected_house ? selected_house.name : t('dashboard.landlord.all_houses') %>
        </div>
      </div>
    </div>
    <!-- Card 3: Yêu cầu chưa xử lý -->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
      <div class="dashboard-stat-card card-orange p-3 shadow-sm d-flex flex-column justify-content-between ">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-3 align-items-center">
            <span class="material-symbols-filled stat-icon">pending_actions</span>
            <div>
              <div class="stat-card-title"><%= t('dashboard.landlord.pending_requests') %></div>
              <div class="stat-value text-danger mb-1"><%= stats[:pending_requests_count] %></div>
              <div class="stat-subtext">
                <% if (vr = stats.dig(:pending_requests, :soonest_vehicle_request)) %>
                  <% if vr[:remaining_days] > 0 %>
                    <span class="<%= vr[:is_urgent] ? 'text-danger fw-bold' : 'text-warning-emphasis fw-semibold' %>">
                      <%= t('dashboard.landlord.vehicle_request_due_in_days', days: vr[:remaining_days]) %>
                    </span>
                  <% elsif vr[:remaining_hours] > 0 %>
                    <span class="text-danger fw-bold">
                      <%= t('dashboard.landlord.vehicle_request_due_in_hours', hours: vr[:remaining_hours]) %>
                    </span>
                  <% else %>
                    <span class="text-danger fw-bold">
                      <%= t('dashboard.landlord.vehicle_request_due_today') %>
                    </span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
          <%= link_to landlord_requests_path(house_id: selected_house&.id || 'all', status: 'pending'), class: "action-arrow-btn", title: t('dashboard.landlord.view_requests'), data: { turbo_frame: "_top" } do %>
            <span class="material-symbols-outlined">arrow_forward</span>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= selected_house ? selected_house.name : t('dashboard.landlord.all_houses') %>
        </div>
      </div>
    </div>
    <!-- Card 4: Hợp đồng sắp hết hạn & Quá hạn -->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
      <div class="dashboard-stat-card card-blue p-3 shadow-sm d-flex flex-column justify-content-between ">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-3 align-items-center">
            <span class="material-symbols-filled stat-icon">assignment_late</span>
            <div>
              <div class="stat-card-title"><%= t('dashboard.landlord.contracts_alert') %></div>
              <div class="stat-value text-primary mb-1"><%= stats[:contracts][:total] %></div>
              <div class="stat-subtext">
                <span class="text-danger fw-bold"><%= t('dashboard.landlord.contracts_overdue', count: stats[:contracts][:overdue]) %></span>
                <span> · </span>
                <span class="text-warning-emphasis fw-semibold"><%= t('dashboard.landlord.contracts_nearly_due', count: stats[:contracts][:nearly_due]) %></span>
              </div>
            </div>
          </div>
          <% if selected_house %>
            <%= link_to landlord_house_contracts_path(selected_house, state: 'nearly-due'), class: "action-arrow-btn", title: t('dashboard.landlord.view_contracts'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= selected_house ? selected_house.name : t('dashboard.landlord.all_houses') %>
        </div>
      </div>
    </div>
    <!-- Card 5: Quản lý Hóa đơn & Thu tiền -->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
      <div class="dashboard-stat-card card-teal p-3 shadow-sm d-flex flex-column justify-content-between">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-3 align-items-center">
            <span class="material-symbols-filled stat-icon">receipt_long</span>
            <div>
              <div class="stat-card-title"><%= t('dashboard.landlord.invoices_title') %></div>
              <div class="stat-subtext text-secondary mb-1"><%= t('dashboard.landlord.invoices_period_subtitle', month: Date.current.strftime("%m/%Y")) %></div>
              <div class="stat-value mb-1">
                <% if stats[:invoices][:overdue].positive? %>
                  <span class="text-danger"><%= stats[:invoices][:overdue] %></span>
                  <span class="fs-6 text-danger fw-normal"><%= t('dashboard.landlord.invoices_overdue_short') %></span>
                <% else %>
                  <span class="text-primary"><%= stats[:invoices][:pending] %></span>
                  <span class="fs-6 text-secondary fw-normal"><%= t('dashboard.landlord.invoices_pending_short') %></span>
                <% end %>
              </div>
              <div class="stat-subtext">
                <% if stats[:invoices][:total].positive? %>
                  <span class="text-success fw-bold"><%= stats[:invoices][:collection_rate] %>% <%= t('dashboard.landlord.invoices_collected_rate') %></span>
                  <span> · </span>
                  <span><%= t('dashboard.landlord.invoices_total_count', count: stats[:invoices][:total]) %></span>
                <% else %>
                  <span class="text-secondary"><%= t('dashboard.landlord.invoices_none_month') %></span>
                <% end %>
              </div>
            </div>
          </div>
          <% if selected_house %>
            <%= link_to landlord_house_invoices_path(selected_house, month: Date.current.strftime("%Y-%m")), class: "action-arrow-btn", title: t('dashboard.landlord.view_invoices'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% else %>
            <%= link_to landlord_houses_path, class: "action-arrow-btn", title: t('dashboard.landlord.view_invoices'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= selected_house ? selected_house.name : t('dashboard.landlord.all_houses') %>
        </div>
      </div>
    </div>
  </div>
<% end %>
