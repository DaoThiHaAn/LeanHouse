<%= turbo_frame_tag "dashboard_stats" do %>
  <div class="row g-4">
    <!-- Card 1: Khách mới & Trả phòng (Grouped) -->
    <div class="col-12 col-md-6 col-lg-3">
      <div class="dashboard-stat-card card-purple p-3 shadow-sm d-flex flex-column justify-content-between h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-3 align-items-center">
            <span class="material-symbols-outlined stat-icon">group_add</span>
            <div>
              <div class="stat-card-title"><%= t('dashboard.landlord.tenant_flow_title') %></div>
              <div class="fw-bold text-success fs-5">
                <%= t('dashboard.landlord.new_tenants_count', count: @stats[:tenants_flow][:new_tenants]) %>
              </div>
              <div class="fw-semibold text-secondary small">
                <%= t('dashboard.landlord.leaved_tenants_count', count: @stats[:tenants_flow][:leaved_tenants]) %>
              </div>
            </div>
          </div>
          <% if @selected_house %>
            <%= link_to landlord_house_tenants_path(@selected_house), class: "action-arrow-btn", title: t('dashboard.landlord.view_tenants'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% else %>
            <%= link_to landlord_houses_path, class: "action-arrow-btn", title: t('dashboard.landlord.view_tenants'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= t('dashboard.landlord.tenant_flow_desc') %>
        </div>
      </div>
    </div>

    <!-- Card 2: Tỉ lệ lấp chỗ trống -->
    <div class="col-12 col-md-6 col-lg-3">
      <div class="dashboard-stat-card card-green p-3 shadow-sm d-flex flex-column justify-content-between h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-3 align-items-center">
            <span class="material-symbols-outlined stat-icon">meeting_room</span>
            <div>
              <div class="stat-card-title"><%= t('dashboard.landlord.occupied_rate') %></div>
              <div class="stat-value text-dark"><%= @stats[:occupancy][:rate] %>%</div>
              <div class="stat-subtext">
                <%= t('dashboard.landlord.slots_format', occupied: @stats[:occupancy][:occupied], total: @stats[:occupancy][:total]) %>
              </div>
            </div>
          </div>
          <% if @selected_house %>
            <%= link_to landlord_house_rooms_path(@selected_house), class: "action-arrow-btn", title: t('dashboard.landlord.view_rooms'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% else %>
            <%= link_to landlord_houses_path, class: "action-arrow-btn", title: t('dashboard.landlord.view_rooms'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= @selected_house ? @selected_house.name : t('dashboard.landlord.all_houses') %>
        </div>
      </div>
    </div>

    <!-- Card 3: Yêu cầu chưa xử lý -->
    <div class="col-12 col-md-6 col-lg-3">
      <div class="dashboard-stat-card card-orange p-3 shadow-sm d-flex flex-column justify-content-between h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-3 align-items-center">
            <span class="material-symbols-outlined stat-icon">pending_actions</span>
            <div>
              <div class="stat-card-title"><%= t('dashboard.landlord.pending_requests') %></div>
              <div class="stat-value text-danger"><%= @stats[:pending_requests_count] %></div>
              <div class="stat-subtext text-muted"><%= t('dashboard.landlord.pending_requests') %></div>
            </div>
          </div>
          <%= link_to landlord_requests_path(house_id: @selected_house&.id || 'all', status: 'pending'), class: "action-arrow-btn", title: t('dashboard.landlord.view_requests'), data: { turbo_frame: "_top" } do %>
            <span class="material-symbols-outlined">arrow_forward</span>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= @selected_house ? @selected_house.name : t('dashboard.landlord.all_houses') %>
        </div>
      </div>
    </div>

    <!-- Card 4: Hợp đồng sắp hết hạn & Quá hạn -->
    <div class="col-12 col-md-6 col-lg-3">
      <div class="dashboard-stat-card card-blue p-3 shadow-sm d-flex flex-column justify-content-between h-100">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-3 align-items-center">
            <span class="material-symbols-outlined stat-icon">assignment_late</span>
            <div>
              <div class="stat-card-title"><%= t('dashboard.landlord.contracts_alert') %></div>
              <div class="stat-value text-primary"><%= @stats[:contracts][:total] %></div>
              <div class="stat-subtext">
                <span class="text-danger fw-bold"><%= t('dashboard.landlord.contracts_overdue', count: @stats[:contracts][:overdue]) %></span>
                <span> · </span>
                <span class="text-warning-emphasis fw-semibold"><%= t('dashboard.landlord.contracts_nearly_due', count: @stats[:contracts][:nearly_due]) %></span>
              </div>
            </div>
          </div>
          <% if @selected_house %>
            <%= link_to landlord_house_contracts_path(@selected_house, state: 'nearly-due'), class: "action-arrow-btn", title: t('dashboard.landlord.view_contracts'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% else %>
            <%= link_to landlord_houses_path, class: "action-arrow-btn", title: t('dashboard.landlord.view_contracts'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= @selected_house ? @selected_house.name : t('dashboard.landlord.all_houses') %>
        </div>
      </div>
    </div>
  </div>
<% end %>
