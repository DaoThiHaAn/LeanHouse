<%
  stats = local_assigns[:stats] || @stats
  selected_house = local_assigns.key?(:selected_house) ? local_assigns[:selected_house] : @selected_house
%>
<%= turbo_frame_tag "dashboard_stats" do %>
  <div class="row g-4">
    <!-- Card 1: Khách mới & Trả phòng (Grouped) -->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
      <div class="dashboard-stat-card card-purple p-3 shadow-sm d-flex flex-column justify-content-between ">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-4 align-items-center">
            <%= image_tag 'tenants.png', alt: "People icon", width: "45px" %>
            <div>
              <h2 class="stat-card-title"><%= t('dashboard.landlord.tenant_flow_title') %></h2>
              <div class="text-success-emphasis">
                <span class="stat-value">+ <%= stats[:tenants_flow][:new_tenants] %></span>&nbsp;
                <%= t('dashboard.landlord.new_tenants_count') %>
              </div>
              <div class="text-secondary-emphasis">
                <span class="stat-value">- <%= stats[:tenants_flow][:leaved_tenants] %></span>&nbsp;
                <%= t('dashboard.landlord.leaved_tenants_count') %>
              </div>
            </div>
          </div>
          <% if selected_house %>
            <%= link_to landlord_house_tenants_path(selected_house), class: "action-arrow-btn", title: t('dashboard.landlord.view_tenants'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= t('dashboard.landlord.tenant_flow_desc') %>
        </div>
      </div>
    </div>

    <!-- Card 2: Tỉ lệ lấp chỗ trống -->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
      <div class="dashboard-stat-card card-green p-3 shadow-sm d-flex flex-column justify-content-between ">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-3 align-items-center">
            <%= image_tag 'occupied.png', alt: "Occupied icon", width: "45px" %>
            <div>
              <div class="stat-card-title"><%= t('dashboard.landlord.occupied_rate') %></div>
              <div class="stat-value text-success mb-1"><%= stats[:occupancy][:rate] %>%</div>
              <div class="stat-subtext">
                <%= t('dashboard.landlord.slots_format', occupied: stats[:occupancy][:occupied], total: stats[:occupancy][:total]) %>
              </div>
            </div>
          </div>
          <% if selected_house %>
            <%= link_to landlord_house_rooms_path(selected_house, state: 'not_empty'), class: "action-arrow-btn", title: t('dashboard.landlord.view_rooms'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% else %>
            <%= link_to landlord_houses_path(state: 'not_empty'), class: "action-arrow-btn", title: t('dashboard.landlord.view_rooms'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= selected_house ? selected_house.name : t('dashboard.landlord.all_houses') %>
        </div>
      </div>
    </div>

    <!-- Card 3: Yêu cầu chưa xử lý -->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
      <div class="dashboard-stat-card card-orange p-3 shadow-sm d-flex flex-column justify-content-between ">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-3 align-items-center">
            <span class="material-symbols-filled stat-icon">pending_actions</span>
            <div>
              <div class="stat-card-title"><%= t('dashboard.landlord.pending_requests') %></div>
              <div class="stat-value text-danger mb-1"><%= stats[:pending_requests_count] %></div>
              <div class="stat-subtext">
                <% if (vr = stats.dig(:pending_requests, :soonest_vehicle_request)) %>
                  <% if vr[:remaining_days] > 0 %>
                    <span class="<%= vr[:is_urgent] ? 'text-danger fw-bold' : 'text-warning-emphasis fw-semibold' %>">
                      <%= t('dashboard.landlord.vehicle_request_due_in_days', days: vr[:remaining_days]) %>
                    </span>
                  <% elsif vr[:remaining_hours] > 0 %>
                    <span class="text-danger fw-bold">
                      <%= t('dashboard.landlord.vehicle_request_due_in_hours', hours: vr[:remaining_hours]) %>
                    </span>
                  <% else %>
                    <span class="text-danger fw-bold">
                      <%= t('dashboard.landlord.vehicle_request_due_today') %>
                    </span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
          <%= link_to landlord_requests_path(house_id: selected_house&.id || 'all', status: 'pending'), class: "action-arrow-btn", title: t('dashboard.landlord.view_requests'), data: { turbo_frame: "_top" } do %>
            <span class="material-symbols-outlined">arrow_forward</span>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= selected_house ? selected_house.name : t('dashboard.landlord.all_houses') %>
        </div>
      </div>
    </div>

    <!-- Card 4: Hợp đồng sắp hết hạn & Quá hạn -->
    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
      <div class="dashboard-stat-card card-blue p-3 shadow-sm d-flex flex-column justify-content-between ">
        <div class="d-flex align-items-start justify-content-between">
          <div class="d-flex gap-3 align-items-center">
            <span class="material-symbols-filled stat-icon">assignment_late</span>
            <div>
              <div class="stat-card-title"><%= t('dashboard.landlord.contracts_alert') %></div>
              <div class="stat-value text-primary mb-1"><%= stats[:contracts][:total] %></div>
              <div class="stat-subtext">
                <span class="text-danger fw-bold"><%= t('dashboard.landlord.contracts_overdue', count: stats[:contracts][:overdue]) %></span>
                <span> · </span>
                <span class="text-warning-emphasis fw-semibold"><%= t('dashboard.landlord.contracts_nearly_due', count: stats[:contracts][:nearly_due]) %></span>
              </div>
            </div>
          </div>
          <% if selected_house %>
            <%= link_to landlord_house_contracts_path(selected_house, state: 'nearly-due'), class: "action-arrow-btn", title: t('dashboard.landlord.view_contracts'), data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined">arrow_forward</span>
            <% end %>
          <% end %>
        </div>
        <div class="stat-subtext mt-2 pt-2 border-top border-light-subtle">
          <%= selected_house ? selected_house.name : t('dashboard.landlord.all_houses') %>
        </div>
      </div>
    </div>

    <!-- Card 5: Quản lý Hóa đơn & Thu tiền (Rộng 6 cột) -->
    <div class="col-12 col-xl-6">
      <div class="dashboard-stat-card dashboard-financial-card card-teal p-3 shadow-sm d-flex flex-column justify-content-between">
        <div>
          <div class="d-flex align-items-start justify-content-between mb-3">
            <div class="d-flex gap-3 align-items-center">
              <span class="material-symbols-filled stat-icon">receipt_long</span>
              <div>
                <div class="stat-card-title mb-0"><%= t('dashboard.landlord.invoices_title') %></div>
                <div class="stat-subtext text-secondary"><%= t('dashboard.landlord.invoices_period_subtitle', month: Date.current.strftime("%m/%Y")) %></div>
              </div>
            </div>
            <% if selected_house %>
              <%= link_to landlord_house_invoices_path(selected_house, month: Date.current.strftime("%Y-%m")), class: "action-arrow-btn", title: t('dashboard.landlord.view_invoices'), data: { turbo_frame: "_top" } do %>
                <span class="material-symbols-outlined">arrow_forward</span>
              <% end %>
            <% else %>
              <%= link_to landlord_houses_path, class: "action-arrow-btn", title: t('dashboard.landlord.view_invoices'), data: { turbo_frame: "_top" } do %>
                <span class="material-symbols-outlined">arrow_forward</span>
              <% end %>
            <% end %>
          </div>

          <div class="row g-3 align-items-center">
            <!-- Cột trái: Chi tiết tình trạng thu -->
            <div class="col-12 col-sm-6 border-end-sm">
              <div class="d-flex flex-column gap-1 pe-sm-2">
                <div class="d-flex align-items-baseline justify-content-between">
                  <span class="stat-subtext text-success-emphasis fw-semibold">
                    <%= t('dashboard.landlord.invoices_paid_short').capitalize %>:
                  </span>
                  <span class="fw-bold text-success font-monospace">
                    <%= stats[:invoices][:paid] %>
                    <%= t('dashboard.landlord.invoices_unit') %>
                    (<%= format_money(stats[:invoices][:paid_amount]) %>)
                  </span>
                </div>
                <div class="d-flex align-items-baseline justify-content-between">
                  <span class="stat-subtext text-warning-emphasis fw-semibold">
                    <%= t('dashboard.landlord.invoices_pending_short').capitalize %>:
                  </span>
                  <span class="fw-bold text-warning-emphasis font-monospace">
                    <%= stats[:invoices][:pending] %>
                    <%= t('dashboard.landlord.invoices_unit') %>
                    (<%= format_money(stats[:invoices][:pending_amount]) %>)
                  </span>
                </div>
                <% if stats[:invoices][:overdue].positive? %>
                  <div class="d-flex align-items-baseline justify-content-between">
                    <span class="stat-subtext text-danger fw-bold">
                      <%= t('dashboard.landlord.invoices_overdue_short').capitalize %>:
                    </span>
                    <span class="fw-bold text-danger font-monospace">
                      <%= stats[:invoices][:overdue] %>
                      <%= t('dashboard.landlord.invoices_unit') %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Cột phải: Tiến độ thu & Tổng hóa đơn -->
            <div class="col-12 col-sm-6 ps-sm-2">
              <div class="d-flex justify-content-between align-items-baseline mb-1">
                <span class="stat-subtext text-secondary fw-semibold"><%= t('dashboard.landlord.invoices_collected_rate') %></span>
                <span class="fw-bold fs-5 text-teal-accent font-monospace"><%= stats[:invoices][:collection_rate] %>%</span>
              </div>
              <div class="financial-progress-container mb-2">
                <svg class="financial-progress-svg rounded-pill" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
                  <rect x="0" y="0" width="100" height="8" class="progress-bg" />
                  <rect x="0" y="0" width="<%= [stats[:invoices][:collection_rate], 100.0].min %>" height="8" class="progress-fill-teal" />
                </svg>
              </div>
              <div class="d-flex justify-content-between align-items-center stat-subtext">
                <span class="text-secondary"><%= t('dashboard.landlord.invoices_total_label') %>:</span>
                <span class="fw-bold text-dark"><%= t('dashboard.landlord.invoices_total_count', count: stats[:invoices][:total]) %> · <%= format_money(stats[:invoices][:total_amount]) %></span>
              </div>
            </div>
          </div>
        </div>

        <div class="stat-subtext mt-3 pt-2 border-top border-light-subtle d-flex justify-content-between align-items-center">
          <span><%= selected_house ? selected_house.name : t('dashboard.landlord.all_houses') %></span>
          <span class="badge bg-white text-secondary border font-monospace"><%= t('dashboard.landlord.invoices_badge') %></span>
        </div>
      </div>
    </div>

    <!-- Card 6: Doanh thu & Phân bổ nguồn thu (6 cột) -->
    <div class="col-12 col-xl-6">
      <div class="dashboard-stat-card dashboard-financial-card card-indigo p-3 shadow-sm d-flex flex-column justify-content-between">
        <div>
          <div class="d-flex align-items-start justify-content-between mb-3">
            <div class="d-flex gap-3 align-items-center">
              <span class="material-symbols-filled stat-icon">payments</span>
              <div>
                <div class="stat-card-title mb-0"><%= t('dashboard.landlord.revenue_title') %></div>
                <div class="stat-subtext text-secondary"><%= t('dashboard.landlord.revenue_period_subtitle', month: Date.current.strftime("%m/%Y")) %></div>
              </div>
            </div>
            <% if selected_house %>
              <%= link_to landlord_house_invoices_path(selected_house, month: Date.current.strftime("%Y-%m")), class: "action-arrow-btn", title: t('dashboard.landlord.view_revenue'), data: { turbo_frame: "_top" } do %>
                <span class="material-symbols-outlined">arrow_forward</span>
              <% end %>
            <% else %>
              <%= link_to landlord_houses_path, class: "action-arrow-btn", title: t('dashboard.landlord.view_revenue'), data: { turbo_frame: "_top" } do %>
                <span class="material-symbols-outlined">arrow_forward</span>
              <% end %>
            <% end %>
          </div>

          <!-- Primary Numbers: Thực thu vs Tổng dự kiến -->
          <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-2">
            <div>
              <span class="stat-subtext text-secondary d-block"><%= t('dashboard.landlord.collected_revenue') %></span>
              <span class="stat-value text-indigo-accent font-monospace"><%= format_money(stats.dig(:revenue, :paid_revenue) || 0) %></span>
            </div>
            <div class="text-sm-end">
              <span class="stat-subtext text-secondary d-block"><%= t('dashboard.landlord.expected_revenue') %></span>
              <span class="fs-6 fw-bold text-secondary font-monospace"><%= format_money(stats.dig(:revenue, :total_revenue) || 0) %></span>
            </div>
          </div>

          <!-- Breakdown / Portions -->
          <% if selected_house %>
            <!-- Single House: Rent vs Services -->
            <div class="financial-progress-container mb-2">
              <svg class="financial-progress-svg rounded-pill" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
                <rect x="0" y="0" width="100" height="8" class="progress-bg" />
                <rect x="0" y="0" width="<%= stats.dig(:revenue, :rent_percentage) || 0 %>" height="8" class="portion-rent" />
                <rect x="<%= stats.dig(:revenue, :rent_percentage) || 0 %>" y="0" width="<%= stats.dig(:revenue, :service_percentage) || 0 %>" height="8" class="portion-service" />
              </svg>
            </div>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 stat-subtext">
              <div class="d-flex align-items-center gap-1">
                <span class="portion-dot dot-rent"></span>
                <span class="text-secondary"><%= t('dashboard.landlord.rent_portion') %>:</span>
                <span class="fw-bold text-dark font-monospace"><%= stats.dig(:revenue, :rent_percentage) || 0 %>% (<%= format_money(stats.dig(:revenue, :rent_revenue) || 0) %>)</span>
              </div>
              <div class="d-flex align-items-center gap-1">
                <span class="portion-dot dot-service"></span>
                <span class="text-secondary"><%= t('dashboard.landlord.service_portion') %>:</span>
                <span class="fw-bold text-dark font-monospace"><%= stats.dig(:revenue, :service_percentage) || 0 %>% (<%= format_money(stats.dig(:revenue, :service_revenue) || 0) %>)</span>
              </div>
            </div>
          <% else %>
            <!-- All Houses: Stacked House Portions -->
            <% if stats.dig(:revenue, :house_portions).present? && (stats.dig(:revenue, :paid_revenue) || 0).positive? %>
              <div class="financial-progress-container mb-2">
                <svg class="financial-progress-svg rounded-pill" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
                  <rect x="0" y="0" width="100" height="8" class="progress-bg" />
                  <% offset = 0.0 %>
                  <% stats[:revenue][:house_portions].each do |portion| %>
                    <% if portion[:percentage].positive? %>
                      <rect x="<%= offset %>" y="0" width="<%= portion[:percentage] %>" height="8" class="portion-house-<%= portion[:color_index] %>" />
                      <% offset += portion[:percentage] %>
                    <% end %>
                  <% end %>
                </svg>
              </div>
              <div class="d-flex flex-wrap gap-2 stat-subtext">
                <% stats[:revenue][:house_portions].each do |portion| %>
                  <div class="d-flex align-items-center gap-1 house-portion-chip">
                    <span class="portion-dot bg-house-<%= portion[:color_index] %>"></span>
                    <span class="text-dark fw-medium"><%= portion[:name] %>:</span>
                    <span class="fw-bold font-monospace text-secondary"><%= portion[:percentage] %>%</span>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="stat-subtext text-secondary fst-italic py-1">
                <%= t('dashboard.landlord.no_revenue_data') %>
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="stat-subtext mt-3 pt-2 border-top border-light-subtle d-flex justify-content-between align-items-center">
          <span>
            <% if selected_house %>
              <%= t('dashboard.landlord.portfolio_share', pct: stats.dig(:revenue, :portfolio_share) || 100.0) %>
            <% else %>
              <%= t('dashboard.landlord.house_portion_title') %>
            <% end %>
          </span>
          <span class="badge bg-white text-secondary border font-monospace"><%= t('dashboard.landlord.revenue_badge') %></span>
        </div>
      </div>
    </div>
  </div>
<% end %>
