<%# Local variables: contracts, query, house_id %>

<span hidden data-pagination-total-pages="<%= contracts.respond_to?(:total_pages) ? contracts.total_pages : 1 %>"></span>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0 fs-5">
    <span class="material-symbols-filled align-middle fs-4">inventory_2</span>
    <%= t("form.contract.list") %>
  </h2>

  <span class="badge bg-light text-dark border p-2 fs-6">
    <%= t("admin.contracts.total", count: contracts.total_count) rescue "#{t('total')}: #{contracts.size}" %>
  </span>
</div>

<div class="table-responsive bg-white rounded-3 shadow-sm border">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th class="ps-3"><%= t("form.contract.id") %></th>
        <th><%= t("form.contract.name") %></th>
        <th><%= t("form.house.self") %></th>
        <th><%= t("form.tenant.self") %></th>
        <th><%= t("form.contract.period") %></th>
        <th><%= t("form.contract.end") %></th>
        <th class="text-center pe-3"><%= t("actions") %></th>
      </tr>
    </thead>
    <tbody>
      <% if contracts.any? %>
        <% contracts.each do |contract| %>
          <tr id="<%= dom_id(contract) %>" class="<%= 'contract-archive-deleted-row' if contract.house&.is_deleted? %>">
            <td class="ps-3 fw-medium text-secondary">#<%= contract.id %></td>
            <td>
              <%= link_to contract.title_name, landlord_archived_contract_path(contract), class: "text-dark text-decoration-none fw-semibold hover-underline", data: { turbo_frame: "_top" } %>
            </td>
            <td>
              <% if contract.house&.is_deleted? %>
                <span class="text-decoration-line-through text-secondary"><%= contract.house.name %></span>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1 small"><%= t("form.house.status_deleted") %></span>
              <% else %>
                <%= contract.house&.name || t("none") %>
              <% end %>
            </td>
            <td>
              <div class="fw-semibold"><%= contract.tenant.user.fullname %></div>
              <small class="text-secondary"><%= contract.tenant.user.tel %></small>
            </td>
            <td><%= contract.formatted_period %></td>
            <td><%= contract.formatted_end_date %></td>
            <td class="text-center pe-3">
              <%= link_to landlord_archived_contract_path(contract),
                          class: "table-action",
                          title: t("view_detail"),
                          data: { turbo_frame: "_top" } do %>
                <span class="material-symbols-filled fs-5">visibility</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td colspan="7" class="text-center text-secondary py-5">
            <span class="material-symbols-outlined fs-1 d-block mb-2 text-secondary">inventory_2</span>
            <%= t("form.contract.no_contracts_in_archive") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if contracts.respond_to?(:total_pages) && contracts.total_pages > 1 %>
  <div class="mt-4 d-flex justify-content-center">
    <%= paginate contracts, params: { q: query.presence, house_id: house_id.presence }.compact %>
  </div>
<% end %>
