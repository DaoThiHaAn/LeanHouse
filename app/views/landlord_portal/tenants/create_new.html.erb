<!-- Variables: -->

<% content_for :title,  t('form.tenant.create_and_link') %>

<div class="mx-auto d-flex flex-column align-items-center shadow create-new-form-container">
<div class="d-flex align-items-center mb-5">
  <%= back_link_to %>
  <h1 class="text-center w-75"><%= t('form.tenant.create_and_link') %></h1>
</div>

<%= form_with model: @user, local: true, 
      class:"px-5 d-flex flex-column gap-4" do |form| %>

  <h2 class="fs-5 my-0">
    <span class="material-symbols-filled fs-2">user_attributes</span>&nbsp;
    <%= t("form.tenant.acc_info") %>
  </h2>

  <!-- Role -->
  <%= form.hidden_field :role, value: "tenant" %>

  <!-- Tel -->
  <div class="form-group" data-controller="form">
    <%= form.label :tel , class: "form-label d-flex justify-content-between" do %>
      <div>
        <%= t('form.profile.tel') +  ": " %>
        <span class="asterisk">*</span>
      </div>

      <small class="counter-text">
        <span data-form-target="charCount">0</span>
      </small>
    <% end %>

    <div class="field-info mb-2 d-flex align-items-center gap-1">
      <span class="material-symbols-outlined fs-6">info</span>
      <small><%= t('form.profile.zalo') %></small>
    </div>

    <%= form.telephone_field :tel, minlength: 10, maxlength: 10, class: "mb-1 form-control #{invalid_class(@user, :tel)}", 
        placeholder: t('form.profile.tel_placeholder'), required: true, autofocus: true,
        data: {
            form_target: "input",
            action: "input->form#update"
        } %>
    <%= field_error(@user, :tel) %>
  </div>

  <!-- Password -->
  <div class="form-group" data-controller="form">
    <%= form.label :password, class: "form-label d-flex justify-content-between" do %>
      <div>
        <%= t('form.profile.password') +  ": " %>
        <span class="asterisk">*</span>
      </div>

      <small class="counter-text">
        <span data-form-target="charCount">0</span>
      </small>
    <% end %>

    <div class="position-relative">
      <%= form.password_field :password, minlength: 8, maxlength: 72, required: true,
          class: "form-control pe-5 #{invalid_class(@user, :password)}",
          placeholder: t('form.profile.pw_placeholder'),
          data: {
              form_target: "input",
              action: "input->form#update"
          } %>

      <span class="eye position-absolute me-2 top-50 end-0 translate-middle-y material-symbols-outlined password-toggle" 
              data-action="click->form#togglePasswordVisibility">
          visibility
      </span>
    </div>

    <%= field_error(@user, :password) %>

    <div class="field-info m-2 d-flex align-items-center gap-1">
      <span class="material-symbols-outlined fs-6">info</span>
      <p><%= t('form.profile.required_pw') %></p>
    </div>

    <ul class="field-info d-flex flex-column gap-1 mb-1">
      <li><%= t('form.profile.pw_length') %></li>
      <li><%= t('form.profile.pw_letters') %></li>
      <li><%= t('form.profile.pw_numbers') %></li>
    </ul>
  </div>

  <!-- Fullname -->
  <div class="form-group" data-controller="form">
    <%= form.label :fullname, class: "form-label d-flex justify-content-between" do %>
        <div>
            <%= t('form.profile.fullname') +  ": " %>
            <span class="asterisk">*</span>
        </div>

        <small class="counter-text">
            <span data-form-target="charCount">0</span>
        </small>
    <% end %>

    <%= form.text_field :fullname, maxlength: 50, class: "form-control #{invalid_class(@user, :fullname)}", 
        placeholder: t('form.profile.fullname_placeholder'), required: true,
        data: {
            form_target: "input",
            action: "input->form#update"
        } 
    %>

    <%= field_error(@user, :fullname) %>
  </div>

  <!-- Address -->
  <div class="form-group" data-controller="form">
    <%= form.label :address, class: "form-label d-flex justify-content-between" do %>
      <div>
        <%= t('form.profile.address') +  ": " %>
        <span class="asterisk">*</span>
      </div>

      <small class="counter-text">
        <span data-form-target="charCount">0</span>
      </small>
    <% end %>

    <%= form.text_field :address, maxlength: 100, class: "form-control", 
        placeholder: t('form.profile.address_placeholder'), required: true,
        data: {
            form_target: "input",
            action: "input->form#update"
        } %>
  </div>

  <!-- Sex -->
  <div class="form-group d-flex gap-2">
    <%= form.label :sex, class: "form-label flex-shrink-0" do %>
      <%= t("form.profile.sex") %>:
      <span class="asterisk">*</span>
    <% end %>

    <div class="form-check form-check-inline">
      <%= form.radio_button :sex, User.sexes[:female], class: "form-check-input", required: true %>
      <%= form.label :sex_f, t("form.profile.female"), class: "form-check-label" %>
    </div>

    <div class="form-check form-check-inline">
      <%= form.radio_button :sex, User.sexes[:male], class: "form-check-input" %>
      <%= form.label :sex_m, t("form.profile.male"), class: "form-check-label" %>
    </div>
  </div>

  <!-- Birthday -->
  <div class="form-group d-flex align-items-center gap-3">
    <%= form.label :bday, class: "form-label flex-shrink-0" do %>
            <%= t('form.profile.bday') +  ": " %>
            <span class="asterisk">*</span>
    <% end %>
    <%= form.date_field :bday, max: 15.years.ago.to_date, class: "date form-control", required: true %>
  </div>

  <h2 class="fs-5 mb-1 mx-auto">
    <span class="material-symbols-filled fs-2">person_pin_circle</span>&nbsp;
    <%= t("form.tenant.select_unit") %>
  </h2>
  
  <div class="w-75 mx-auto"
        data-controller="dependent-rental-unit"
        data-dependent-rental-unit-rooms-value="<%= @available_slots.room_options.to_json %>"
        data-dependent-rental-unit-beds-value="<%= @available_slots.bed_options.to_json %>"
        data-dependent-rental-unit-bed-mode-value="<%= @house.bed? %>">
    <%= hidden_field_tag :rental_unit_id, nil, data: { dependent_rental_unit_target: "rentalUnit" } %>
    <%= render 'rental_unit_fields', house: @house, floors: @available_slots.floors %>
  </div>

  <%= form.button :submit, 
      class: "mx-auto mb-3 custom-primary-btn  main-form d-flex align-items-center justify-content-center gap-2",
      data: { loading_target: "button" } do %>
      <span data-loading-target="text"><%= t("save") %></span>

      <span class="material-symbols-outlined spin d-none"
        data-loading-target="spinner">
        progress_activity
      </span>
  <% end %>
<% end %>

<%= render "layouts/shared_components/new_tel_owner" %>
</div>
