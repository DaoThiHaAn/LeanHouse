<%# Variables: @house, @rental_units, @tenant %>

<%# Extended new tenant modal when a telephone is valid %>
<%= turbo_frame_tag "tenant_form" do %>
  <div class="p-3 pt-4 tenant-info-container shadow-sm d-inline-flex flex-column align-items-center border position-relative">
    <div class="d-flex gap-2 flex-wrap jusitify-content-center">
      <p class="fw-bold flex-shrink-0"><%= t("form.tenant.self") %>: </p>
      <p> <%= @tenant.tel %> - <%= @tenant.fullname %></p>
    </div>

    <div class="ready-info">
      <span class="material-symbols-filled">check_circle</span>
      <%= t("form.tenant.ready") %>
    </div>

    <%# Cancel the selected tenant %>
      <%= link_to new_landlord_house_tenant_path,
      class:"close-btn rounded-circle position-absolute",
      data: { turbo_frame: "new_tenant_modal" },
      title: t("select_another") do %>
      <span class="material-symbols-outlined">close_small</span>
    <% end %>
  </div>

  <div>
    <h2 class="fs-5 mt-4 mb-3 text-center"><%= t("form.tenant.select_unit") %></h2>
    <div class="info-container px-3 py-2 mb-4 mx-auto">
      <%= field_info(
        [ t("form.tenant.select_unit_info") ],
        extra_classes: "gap-2")  %>
    </div>
  </div>

  <%= form_with url: landlord_house_tenants_path(@house), method: :post,
        class:"px-3 py-2 mx-auto mb-2" ,
        data: { 
          turbo_frame: "_top",
          controller: "loading",
          loading_text_value: t("adding") + "...",
          action: "submit->loading#submit"
        } do |f| %>

    <%= hidden_field_tag :tenant_id, @tenant.id %>
    <div data-controller="dependent-rental-unit"
        data-dependent-rental-unit-rooms-value="<%= @room_options.to_json %>"
        data-dependent-rental-unit-beds-value="<%= @bed_options.to_json %>"
        data-dependent-rental-unit-bed-mode-value="<%= @house.bed? %>">
      <%= hidden_field_tag :rental_unit_id, nil, data: { dependent_rental_unit_target: "rentalUnit" } %>

      <%= render 'rental_unit_fields', house: @house, floors: @floors %>
    </div>

    <%= f.button :submit, 
          class: "mt-2 custom-primary-btn mx-auto main-form d-flex align-items-center justify-content-center gap-2",
          data: { loading_target: "button" } do %>
          <span data-loading-target="text"><%= t("add") %></span>

          <span class="material-symbols-outlined spin d-none"
            data-loading-target="spinner">
            progress_activity
          </span>
    <% end %>
  <% end %>
<% end %>
