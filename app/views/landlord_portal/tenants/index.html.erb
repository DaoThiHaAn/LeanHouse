<%# Variables: @signed_tenants, @unsigned_tenants, @house, @stats %>

<% content_for :title, t("page_titles.tenant_mng") %>


<h1 class="text-center mb-3"><%= t("page_titles.tenant_mng") %></h1>
<p class="text-muted text-center border-bottom pb-2 mb-5"><%= t("form.tenant.mng_note")%></p>

<%# 1. KPI Summary Cards %>
<%= render "stats_cards", stats: @stats, house: @house %>

<%# 2. Collapsible Unsigned Tenants Strip (displayed only when unsigned tenants exist) %>
<%= render "unsigned_banner", unsigned_tenants: @unsigned_tenants, house: @house %>

<%# 3. Unified Action & Filter Toolbar Card %>
<div class="card border rounded-3 p-4 mb-4 bg-light">
  <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
    <%# Search & Filters %>
    <%= form_with url: filtered_landlord_house_tenants_path(@house),
                  method: :get,
                  class: "d-flex flex-column gap-3 flex-grow-1",
                  data: { 
                    controller: "search", turbo_frame: "tenant_table", turbo_action: "advance"
                  } do |f| %>

      <%# Search bar %>
      <div class="input-group input-group-sm search-bar">
        <span class="input-group-text bg-white text-muted">
          <span class="material-symbols-outlined fs-6">search</span>
        </span>
        <%= f.search_field :query,
            value: params[:query],
            placeholder: "#{t("form.tenant.name_input")}...",
            class: "form-control shadow-sm",
            data: {
              search_target: "input",
              action: "input->search#debounce"
            } %>
      </div>

      <div class="d-flex align-items-center flex-wrap gap-3">
        <%# Contract State %>
        <div class="d-flex align-items-center gap-2">
          <%= f.label :contract_state, t("form.contract.contract_state"), class: "small fw-semibold text-secondary m-0 text-nowrap" %>
          <%= f.select :contract_state,
                [[t("all"), ""],
                  [t("form.contract.overdue"), "overdue"],
                  [t("form.contract.nearly_due"), "nearly-due"]],
                { selected: params[:contract_state] },
                class: "form-select form-select-sm w-auto shadow-sm",
                onchange: "this.form.requestSubmit()" %>
        </div>

        <%# Temporary residence State %>
        <div class="d-flex align-items-center gap-2">
          <%= f.label :residence_state, t("form.contract.resid_register_due"), class: "small fw-semibold text-secondary m-0 text-nowrap" %>
          <%= f.select :residence_state,
              [[t("all"), ""],
                [t("form.contract.no_register"), "none"],
                [t("form.contract.overdue"), "overdue"],
                [t("form.contract.nearly_due"), "nearly-due"]],
              { selected: params[:residence_state] },
              class: "form-select form-select-sm w-auto shadow-sm",
              onchange: "this.form.requestSubmit()" %>
        </div>
      </div>
    <% end %>

    <%# Action Buttons Inline %>
    <div class="d-flex flex-column align-items-end gap-3">
      <%= link_to new_landlord_house_tenant_path(@house),
                  class: "custom-primary-btn d-inline-flex align-items-center gap-1 shadow",
                  data: { turbo_frame: "new_tenant_modal" } do %>
        <span class="material-symbols-filled fs-5">link</span>
        <span><%= t('form.tenant.link') %></span>
      <% end %>

      <%= link_to landlord_house_create_new_tenant_path(@house),
                  class: "main-btn d-inline-flex align-items-center gap-1 shadow-xs",
                  data: { **tooltip("top", :"form.tenant.create_link_info") } do %>
        <span class="material-symbols-filled fs-6">person_add</span>
        <span class="fs-6"><%= t('form.tenant.create_and_link') %></span>
      <% end %>
    </div>
  </div>
</div>

<%# 4. Main Table Zone %>
<div class="main-table-zone">
  <%= turbo_frame_tag "tenant_table",
        src: filtered_landlord_house_tenants_path(@house, params.permit(:page, :contract_state, :query, :residence_state)),
        loading: :lazy,
        data: {
          controller: "pagination-sync",
          pagination_sync_canonical_url_value: landlord_house_tenants_path(@house),
          pagination_sync_default_params_value: { contract_state: "all", residence_state: "all" }.to_json,
          pagination_sync_query_params_value: ["contract_state", "residence_state", "query"].to_json,
          pagination_sync_total_pages_selector_value: "[data-pagination-total-pages]",
          action: "turbo:frame-load->pagination-sync#updateUrl"
        } do %>
    <%= loading_spinner %>
  <% end %>
</div>

<%= turbo_frame_tag "new_tenant_modal" %>
<%= turbo_frame_tag "tenant_detail_modal" %>
<%= turbo_frame_tag "move_tenant_modal" %>
