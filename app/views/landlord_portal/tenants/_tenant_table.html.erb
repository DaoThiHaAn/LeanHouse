<%# Local variables: signed_tenants %>

<%= turbo_frame_tag "tenant_table" do %>

<h2 class="table-caption"><%= t("form.tenant.list") %></h2>

<div class="mb-3 d-flex align-items-center gap-2">
  <span class="material-symbols-outlined">list_arrow</span>
  <%= t("form.floor.order") %>
</div>

<div class="table-responsive border rounded w-85 m-auto">
  <table class="table table-bordered table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th><%= t("form.profile.fullname") %></th>
        <th><%= t("form.profile.tel") %> (đ)</th>
        <th><%= t("form.tenant.rental_unit") %></th>
        <th><%= t("form.contract.deposit_paid") %> (đ)</th>
        <th><%= t("form.contract.resid_register_due") %> </th>
        <th><%= t("form.contract.due_date") %> </th>
        <th class="text-center"><%= t("actions") %></th>
      </tr>
    </thead>

    <tbody>
      <% signed_tenants.each do |tenant| 
        latest_contract = tenant.latest_contract
      %>
        <tr>
          <td><%= vn_name(tenant.user.fullname) %></td>
          <td><%= tenant.user.tel %></td>
          <td><%= tenant.current_staying_info %></td>
          <td>
            <% if latest_contract.deposited_paid %>
              <span class="material-symbols-filled">check_circle</span>
            <% else %>
              -
            <% end %>
          </td>
          <td class="d-flex gap-1 align-items-center">
            <% if latest_contract.temp_resid_registered? %>
              <%= latest_contract.temp_resid_due_date.strftime("%d/%m/%Y") %>
              <%= due_status_label(latest_contract.temp_resid_due_status) %>
            <% else %>
              -
            <% end %>
          </td>
          <td class="d-flex gap-1 align-items-center">
            <%= latest_contract.due_date.strftime("%d/%m/%Y") %>
            <%= due_status_label(latest_contract.due_status) %>
          </td>

          <%# Actions %>
          <td>
            <div class="d-flex align-items-center justify-content-center gap-2">
              <%= link_to landlord_house_tenant_path(house, tenant),
                        class: "table-action px-1 py-0",
                        data: { turbo_frame: "room_detail_modal" },
                        title: t("view_detail") do %>
                <span class="material-symbols-filled">visibility</span>
              <% end %>

              <%= link_to landlord_house_tenant_path(house, tenant), method: :delete,
                        data: { 
                          turbo_confirm: [
                            t("form.tenant.remove_cf"),
                            t("form.tenant.remove_warning")
                          ].join("\n\n") 
                        },
                        title: t("form.tenant.remove"),
                        class: "table-action" do %>
                <span class="material-symbols-filled">person_remove</span>
              <% end %>

              <%= button_to move_landlord_house_tenant_path(house, tenant),
                        title: t("delete"),
                        class: "table-action" do %>
                <span class="material-symbols-filled">move_location</span>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-3">
  <%= paginate tenants, params: {state: params[:state]} %>
</div>
<% end %>
