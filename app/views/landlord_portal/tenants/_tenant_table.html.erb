<%# Local variables: signed_tenants, house %>

<%= turbo_frame_tag "tenant_table" do %>

<!-- Used by stimulus to update url -->
<span hidden data-pagination-total-pages="<%= signed_tenants.total_pages %>"></span>

<h2 class="table-caption my-4"><%= t("form.tenant.contract_signed_list") %></h2>

<div class="table-responsive border rounded m-auto">
  <table class="table table-bordered table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th><%= t("form.profile.fullname") %></th>
        <th><%= t("form.profile.tel") %> </th>
        <th><%= t("form.tenant.rental_unit") %></th>
        <th><%= t("form.contract.deposit_paid") %> </th>
        <th><%= t("form.contract.resid_register_due") %> </th>
        <th><%= t("form.contract.due_date") %> </th>
        <th class="text-center"><%= t("actions") %></th>
      </tr>
    </thead>

    <tbody id="tenant_table_body">
      <%= render partial: "landlord_portal/tenants/tenant_row", collection: signed_tenants, as: :tenant, locals: { house: house } %>
    </tbody>
  </table>
</div>

<div class="mt-3">
  <%= paginate signed_tenants,
      params: {
        contract_state: params[:contract_state],
        residence_state:  params[:residence_state],
        query: params[:query] } %>
</div>
<% end %>
