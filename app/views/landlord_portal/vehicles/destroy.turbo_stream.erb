<%= turbo_stream.remove "vehicle_row_#{@vehicle.id}" %>

<%= turbo_stream.replace "vehicle_stats_card" do %>
  <%= render "landlord_portal/vehicles/stats_card", stats: @stats, house: @house %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "layouts/shared_components/flash_message" %>
<% end %>

