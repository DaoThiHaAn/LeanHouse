<%# Modals for Landlord Portal Invoice Show %>
<%= render "landlord_portal/invoices/zoom_qr_modal",
           invoice: (local_assigns[:invoice] || @invoice),
           bank_account: (local_assigns[:bank_account] || @bank_account) %>

<%= render "landlord_portal/invoices/service_instructions_modal" %>

<%= render "landlord_portal/invoices/invoice_info_modal",
           invoice: (local_assigns[:invoice] || @invoice) %>

<%= render "landlord_portal/invoices/edit_dates_modal",
           house: (local_assigns[:house] || @house),
           invoice: (local_assigns[:invoice] || @invoice),
           landlord: (local_assigns[:landlord] || @landlord) %>

<%= render "landlord_portal/invoices/mark_paid_modal",
           house: (local_assigns[:house] || @house),
           invoice: (local_assigns[:invoice] || @invoice) %>

<%= render "landlord_portal/invoices/undo_paid_modal",
           house: (local_assigns[:house] || @house),
           invoice: (local_assigns[:invoice] || @invoice) %>

<%= render "landlord_portal/invoices/payment_proof_modal",
           invoice: (local_assigns[:invoice] || @invoice) %>
