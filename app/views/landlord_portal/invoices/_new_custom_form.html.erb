<% content_for :title, "#{t('invoice.custom_invoice_title')} - #{@house.name}" %>
<% provide :container_width, "h-100" %>

<% unit_options = ServiceVariant.display_unit_options %>

<div class="container pb-4 invoice-wrapper">
  <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom">
    <%= back_link_to landlord_house_invoices_path(@house, month: (@billing_month || Date.current).strftime("%Y-%m")), t('invoice.actions.back_to_list') %>

    <div class="text-center text-md-start">
      <h1 class="fw-bold mb-1 d-flex align-items-center justify-content-center justify-content-md-start gap-2">
        <span class="material-symbols-outlined text-success fs-2">tune</span>
        <span><%= t('invoice.custom_invoice_title') %></span>
      </h1>
      <p class="text-secondary small mb-0"><%= t('invoice.custom_invoice_subtitle') %></p>
    </div>

    <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm px-3 py-1 fw-semibold" data-bs-toggle="modal" data-bs-target="#invoiceCreationGuideModal">
      <span class="material-symbols-outlined fs-6">help</span>
      <%= t('invoice.guide.btn_title', default: 'Hướng dẫn lập hóa đơn') %>
    </button>
  </div>

  <%= form_with url: landlord_house_invoices_path(@house, mode: "custom"), method: :post, local: true,
                data: {
                  controller: "loading",
                  loading_text_value: t('invoice.issuing', default: 'Đang xuất hóa đơn...'),
                  action: "submit->loading#submit"
                } do |f| %>
    <%= hidden_field_tag :mode, "custom" %>

    <!-- Card 1: Thông tin chung của hóa đơn -->
    <div class="card invoice-card mb-4 shadow-sm bg-white">
      <div class="card-header bg-body-secondary py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h2 class="mb-2 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined">page_info</span>
            <span><%= t('general_info', default: 'Thông tin chung') %></span>
          </h2>
          <p class="text-info-emphasis ms-4 mb-0"><%= t('invoice.general_info_note') %></p>
        </div>
        <span class="text-secondary small">
          <span class="text-danger">*</span> <%= t('common.required_fields', default: 'Thông tin bắt buộc') %>
        </span>
      </div>

      <div class="card-body p-4">
        <!-- Tiêu đề & Kỳ thanh toán -->
        <div class="row g-3 mb-4">
          <div class="col-12 col-lg-6" data-controller="character-counter" data-character-counter-max-value="100">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <%= f.label "invoice[title]", class: "form-label fw-semibold mb-0" do %>
                <%= t('invoice.reason', default: 'Tiêu đề / Lý do thu tiền') %> <span class="text-danger">*</span>
              <% end %>
              <span class="small text-secondary" data-character-counter-target="count">0/100</span>
            </div>
            <%= f.text_field "invoice[title]",
                  value: t('invoice.default_custom_title'),
                  class: "form-control shadow-sm",
                  placeholder: t('invoice.custom_title_placeholder'),
                  required: true,
                  maxlength: 100,
                  data: {
                    character_counter_target: "input",
                    action: "input->character-counter#update"
                  } %>
          </div>

          <div class="col-6 col-lg-3">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <%= f.label "invoice[billing_month]", class: "form-label fw-semibold mb-0" do %>
                <%= t('invoice.billing_month') %> <span class="text-danger">*</span>
              <% end %>
              <span class="material-symbols-outlined fs-6 text-secondary cursor-pointer"
                    tabindex="0"
                    role="button"
                    aria-label="<%= t('invoice.billing_month') %>"
                    <%= tooltip("top", :"invoice.billing_month_tooltip", html: true) %>>
                info
              </span>
            </div>
            <%= f.month_field "invoice[billing_month]", value: @billing_month.strftime("%Y-%m"), class: "form-control shadow-sm", required: true %>
          </div>

          <div class="col-6 col-lg-3">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <%= f.label "invoice[due_date]", class: "form-label fw-semibold mb-0" do %>
                <%= t('invoice.due_date') %> <span class="text-danger">*</span>
              <% end %>
            </div>
            <%= f.date_field "invoice[due_date]", value: Date.current + 5.days, class: "form-control shadow-sm", required: true %>
          </div>
        </div>

        <!-- Thông tin thanh toán & Ghi chú -->
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <%= f.label "invoice[bank_account_id]", t('invoice.bank_account_receive'), class: "form-label fw-semibold mb-1" %>
            <% if @bank_accounts.any? %>
              <select name="invoice[bank_account_id]" class="form-select shadow-sm">
                <% @bank_accounts.each do |acc| %>
                  <option value="<%= acc.id %>" <%= 'selected' if acc.is_default? %>>
                    <%= acc.display_label %> <%= '(Mặc định)' if acc.is_default? %>
                  </option>
                <% end %>
              </select>
            <% else %>
              <div class="d-flex align-items-center gap-2 mt-1">
                <span class="text-danger small"><%= t('invoice.no_bank_account_landlord') %></span>
                <%= link_to t('invoice.add_bank_account'), landlord_bank_accounts_path, class: "btn btn-sm btn-outline-primary" %>
              </div>
            <% end %>
          </div>

          <div class="col-12 col-md-6" data-controller="character-counter" data-character-counter-max-value="500">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <%= f.label "invoice[note]", t('invoice.note'), class: "form-label fw-semibold mb-0" %>
              <span class="small text-secondary" data-character-counter-target="count">0/500</span>
            </div>
            <%= f.text_field "invoice[note]",
                  placeholder: t('invoice.note_placeholder'),
                  class: "form-control shadow-sm",
                  maxlength: 500,
                  data: {
                    character_counter_target: "input",
                    action: "input->character-counter#update"
                  } %>
          </div>
        </div>

        <div class="mt-3">
          <%= render "landlord_portal/invoices/transfer_note_fields", id_prefix: "custom_inv" %>
        </div>
      </div>
    </div>

    <!-- Card 2: Danh sách người thuê áp dụng -->
    <div class="card invoice-card mb-4 shadow-sm bg-white" data-controller="tenant-selection">
      <div class="card-header bg-body-secondary py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h2 class="mb-2 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined">group</span>
            <span><%= t('invoice.target_tenants_title') %></span>
          </h2>
          <p class="text-info-emphasis ms-4 mb-0"><%= t('invoice.target_tenants_subtitle') %></p>
        </div>
        <span class="text-secondary small">
          <span class="text-danger">*</span> <%= t('common.required_fields', default: 'Thông tin bắt buộc') %>
        </span>
      </div>

      <div class="card-body p-4">
        <!-- Prominent instruction banner -->
        <div class="alert alert-info border-0 rounded-3 mb-3 d-flex align-items-start gap-2">
          <span class="material-symbols-outlined text-info-emphasis fs-4 mt-1">info</span>
          <div>
            <strong class="d-block text-info-emphasis mb-1"><%= t('invoice.types.custom_title') %></strong>
            <span><%= t('invoice.custom_tenants_instruction') %></span>
          </div>
        </div>

        <% if @staying_tenants.empty? %>
          <div class="alert alert-warning border-0 rounded-3 mb-0 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined text-warning-emphasis fs-4">warning</span>
            <span><%= t('invoice.no_staying_tenants_warning') %></span>
          </div>
        <% else %>
          <!-- Tenant List Action Toolbar -->
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 pb-2 border-bottom">
            <div class="d-flex align-items-center gap-2">
              <button type="button" class="btn btn-sm btn-outline-primary shadow-sm fw-semibold" data-action="click->tenant-selection#selectAll">
                <span class="material-symbols-outlined fs-6 align-middle">select_all</span> <%= t('invoice.select_all_tenants') %>
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary shadow-sm" data-action="click->tenant-selection#deselectAll">
                <span class="material-symbols-outlined fs-6 align-middle">deselect</span> <%= t('invoice.deselect_all_tenants') %>
              </button>
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 ms-2">
                <span class="material-symbols-outlined fs-6 align-middle">how_to_reg</span>
                <span class="fw-semibold ms-1"><%= t('invoice.selected_tenants_count', count: '<span data-tenant-selection-target="countDisplay">0</span>').html_safe %></span>
              </span>
            </div>

            <div class="input-group input-group-sm w-auto">
              <span class="input-group-text bg-white"><span class="material-symbols-outlined fs-6 text-secondary">search</span></span>
              <input type="text" class="form-control" placeholder="<%= t('invoice.search_tenant_placeholder') %>" data-tenant-selection-target="searchInput" data-action="input->tenant-selection#filter" />
            </div>
          </div>

          <!-- Tenants Checkboxes Container -->
          <div class="custom-tenant-list-container p-3">
            <div class="row g-2">
              <% @staying_tenants.each do |item| %>
                <% search_data = "#{item[:user]&.fullname} #{item[:room]&.name} #{item[:bed]&.name} #{item[:user]&.tel} #{item[:location]}".downcase %>
                <div class="col-12 col-md-6 col-lg-4" data-tenant-selection-target="tenantItem" data-search-text="<%= search_data %>">
                  <label class="custom-tenant-item d-flex align-items-center justify-content-between h-100 mb-0 shadow-sm" for="tenant_<%= item[:tenant].id %>">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                      <input type="checkbox" name="invoice[tenant_ids][]" value="<%= item[:tenant].id %>" id="tenant_<%= item[:tenant].id %>" class="form-check-input tenant-checkbox flex-shrink-0" data-tenant-selection-target="checkbox" data-action="change->tenant-selection#toggle" />
                      <div class="text-truncate">
                        <div class="fw-bold text-dark text-truncate"><%= item[:user]&.fullname %></div>
                        <div class="tenant-phone-text text-truncate"><%= item[:user]&.tel %></div>
                      </div>
                    </div>
                    <span class="tenant-room-badge flex-shrink-0 ms-2"><%= item[:location] %></span>
                  </label>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Card 3: Chi tiết các khoản thu / giảm trừ tùy chọn -->
    <div class="card invoice-card mb-4 shadow-sm bg-white"
         data-controller="invoice-items"
         data-invoice-items-addition-placeholder-value="<%= t('invoice.addition_placeholder') %>"
         data-invoice-items-discount-placeholder-value="<%= t('invoice.discount_placeholder') %>"
         data-invoice-items-delete-text-value="<%= t('invoice.actions.delete', default: 'Xóa dòng') %>"
         data-invoice-items-unit-options-value="<%= ServiceVariant.human_units.to_json %>">
      <div class="card-header bg-body-secondary py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h2 class="mb-2 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined">receipt_long</span>
            <span><%= t('invoice.custom_items_title') %></span>
          </h2>
          <p class="text-info-emphasis ms-4 mb-0"><%= t('invoice.custom_items_subtitle') %></p>
        </div>
        <span class="invoice-badge invoice-badge-pending flex-shrink-0"><%= t('invoice.types.custom_title') %></span>
      </div>

      <div class="table-responsive">
        <table class="table invoice-table align-middle mb-0" id="custom_invoice_items_table" data-invoice-items-target="table">
          <thead>
            <tr>
              <th class="ps-3 text-center th-check"><%= t('invoice.actions.done', default: 'Áp dụng') %></th>
              <th><%= t('invoice.item_or_service') %></th>
              <th class="th-unit"><%= t('invoice.unit') %></th>
              <th class="th-price"><%= t('invoice.unit_price') %></th>
              <th class="th-reading"><%= t('invoice.quantity') %></th>
              <th class="text-end th-amount"><%= t('invoice.amount') %></th>
              <th class="text-center pe-3 th-action"><%= t('invoice.actions.delete', default: 'Xóa') %></th>
            </tr>
          </thead>

          <!-- 1. Section: Phụ phí & Khoản cộng thêm (+) -->
          <tbody>
            <tr class="addition-section-header">
              <td colspan="7" class="py-2 px-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div class="fw-bold text-primary d-flex align-items-center gap-1">
                    <span class="material-symbols-outlined fs-5">add_circle</span>
                    <span><%= t('invoice.addition_section_title', default: 'Phụ phí & Khoản cộng thêm (+)') %></span>
                  </div>
                  <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1 shadow-sm px-2 py-1 fw-semibold" data-action="click->invoice-items#addAddition">
                    <span class="material-symbols-outlined fs-6">add</span>
                    <%= t('invoice.actions.add_addition', default: '+ Thêm khoản thu') %>
                  </button>
                </div>
              </td>
            </tr>
          </tbody>
          <tbody id="custom_addition_items_container" data-invoice-items-target="additionContainer">
            <tr class="item-row addition-row align-middle" data-item-type="addition">
              <td class="ps-3 text-center">
                <input type="hidden" name="invoice[items][add_0][selected]" value="0" />
                <input type="checkbox" name="invoice[items][add_0][selected]" value="1" checked class="form-check-input item-select-check" data-action="change->invoice-items#recalculate" />
                <input type="hidden" name="invoice[items][add_0][item_type]" value="addition" class="item-type-val" />
              </td>
              <td>
                <input type="text" name="invoice[items][add_0][name]" placeholder="<%= t('invoice.addition_placeholder') %>" class="form-control form-control-sm item-name" required />
              </td>
              <td>
                <select name="invoice[items][add_0][unit]" class="form-select form-select-sm text-center item-unit">
                  <% unit_options.each do |label, val| %>
                    <option value="<%= val %>" <%= 'selected' if val.to_s.downcase.include?('lần') %>><%= label %></option>
                  <% end %>
                </select>
              </td>
              <td>
                <input type="number" min="0" step="1000" name="invoice[items][add_0][unit_price]" value="0" class="form-control form-control-sm font-monospace text-end item-price invoice-input-price" data-action="input->invoice-items#calculateRow" />
              </td>
              <td>
                <input type="number" min="0" step="0.1" name="invoice[items][add_0][quantity]" value="1" class="form-control form-control-sm font-monospace text-center item-qty invoice-input-qty" data-action="input->invoice-items#calculateRow" />
              </td>
              <td class="text-end">
                <div class="d-flex justify-content-end">
                  <input type="hidden" name="invoice[items][add_0][amount]" value="0" class="item-amount" />
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1 fw-bold item-amount-display">
                    0 đ
                  </span>
                </div>
              </td>
              <td class="text-center pe-3">
                <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row p-1 d-inline-flex align-items-center justify-content-center" data-action="click->invoice-items#removeRowClick" title="<%= t('invoice.actions.delete', default: 'Xóa dòng') %>">
                  <span class="material-symbols-outlined fs-6">delete</span>
                </button>
              </td>
            </tr>
          </tbody>

          <!-- 2. Section: Giảm trừ & Chiết khấu (-) -->
          <tbody>
            <tr class="discount-section-header">
              <td colspan="7" class="py-2 px-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div class="fw-bold text-danger d-flex align-items-center gap-1">
                    <span class="material-symbols-outlined fs-5">remove_circle</span>
                    <span><%= t('invoice.discount_section_title', default: 'Giảm trừ & Khuyến mãi (-)') %></span>
                  </div>
                  <button type="button" class="btn btn-sm btn-danger d-inline-flex align-items-center gap-1 shadow-sm px-2 py-1 fw-semibold" data-action="click->invoice-items#addDiscount">
                    <span class="material-symbols-outlined fs-6">add</span>
                    <%= t('invoice.actions.add_discount', default: '+ Thêm khoản giảm trừ') %>
                  </button>
                </div>
              </td>
            </tr>
          </tbody>
          <tbody id="custom_discount_items_container" data-invoice-items-target="discountContainer">
            <!-- Dynamic rows will be inserted here -->
          </tbody>
        </table>
      </div>

      <!-- Live Total Summary Card -->
      <div class="card-footer bg-light p-3 border-top">
        <div class="row g-3 align-items-center justify-content-between">
          <div class="col-md-7">
            <div class="d-flex flex-column gap-1 small">
              <div class="d-flex justify-content-between text-primary invoice-summary-row">
                <span><%= t('invoice.total_addition_summary', default: 'Tổng phụ phí (+)') %>:</span>
                <span id="summary_addition" data-invoice-items-target="additionSummary" class="font-monospace fw-semibold">+ 0 đ</span>
              </div>
              <div class="d-flex justify-content-between text-danger invoice-summary-row">
                <span><%= t('invoice.total_discount_summary', default: 'Tổng giảm trừ (-)') %>:</span>
                <span id="summary_discount" data-invoice-items-target="discountSummary" class="font-monospace fw-semibold">- 0 đ</span>
              </div>
            </div>
          </div>

          <div class="col-md-5 text-md-end">
            <div class="text-secondary small mb-1"><%= t('invoice.each_tenant_pays', default: 'TỔNG TIỀN MỖI NGƯỜI CẦN THANH TOÁN') %>:</div>
            <div class="d-inline-flex align-items-center gap-2">
              <span id="summary_total" data-invoice-items-target="totalSummary" class="fs-4 fw-bolder px-3 py-1 rounded-3 font-monospace invoice-badge invoice-badge-pending">
                0 đ
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Submit Toolbar -->
    <div class="d-flex justify-content-between align-items-center mt-4">
      <div class="text-secondary small">
        <span class="material-symbols-outlined fs-6 align-middle">lock</span>
        <%= t('invoice.immutability_notice') %>
      </div>
      <%= f.button :submit,
            class: "custom-primary-btn shadow-sm d-inline-flex align-items-center justify-content-center gap-2",
            data: { loading_target: "button" } do %>
        <span data-loading-target="text"><%= t('invoice.custom_issue_button') %></span>
        <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">progress_activity</span>
      <% end %>
    </div>
  <% end %>
</div>

<%= render "creation_guide_modal" %>
