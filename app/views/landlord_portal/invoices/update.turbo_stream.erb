<%= turbo_stream.replace dom_id(@invoice) do %>
  <%= render "landlord_portal/invoices/invoice_row", house: @house, inv: @invoice %>
<% end %>

<% if @stats.present? %>
  <%= turbo_stream.replace "invoice_stats_grid" do %>
    <%= render "landlord_portal/invoices/stats_cards", stats: @stats, billing_month: @billing_month %>
  <% end %>
<% end %>

<%= turbo_stream.append "events" do %>
  <%= render "layouts/shared_components/event", event: "close-modal" %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "layouts/shared_components/flash_message" %>
<% end %>
