<% content_for :title, "#{t('invoice.new_invoice')} - #{@house.name}" %>
<% provide :container_width, "h-100" %>

<div class="container py-3" style="max-width: 960px;">
  <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
    <h3 class="fw-bold mb-0 d-flex align-items-center gap-2">
      <span class="material-symbols-outlined text-primary">post_add</span>
      <%= t('invoice.create_invoice_title') %>
    </h3>
    <%= link_to t('invoice.actions.back_to_list'), landlord_house_invoices_path(@house, month: @billing_month.strftime("%Y-%m")), class: "btn btn-sm btn-outline-secondary" %>
  </div>

  <% if flash[:alert] %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= flash[:alert] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <%= form_with url: landlord_house_invoices_path(@house), method: :post, local: true do |f| %>
    <!-- Thông tin chung của hóa đơn -->
    <div class="card shadow-sm border-0 rounded-3 p-4 mb-4 bg-light">
      <div class="row g-3">
        <div class="col-md-3">
          <%= f.label "invoice[billing_month]", t('common.month', default: 'Tháng tính toán'), class: "form-label fw-bold" %>
          <%= f.month_field "invoice[billing_month]", value: @billing_month.strftime("%Y-%m"), class: "form-control shadow-sm", required: true, onchange: "updateDraftPreview()" %>
        </div>

        <div class="col-md-3">
          <%= f.label "invoice[room_id]", t('invoice.room'), class: "form-label fw-bold" %>
          <select name="invoice[room_id]" id="room_select" class="form-select shadow-sm" required onchange="updateDraftPreview()">
            <% @house.rooms.active.sorted.each do |r| %>
              <option value="<%= r.id %>" <%= 'selected' if @room&.id == r.id %> data-tenants-count="<%= r.tenants_count %>">
                <%= r.title_name %> (<%= r.tenants_count %> <%= t('invoice.quantity').downcase %>)
              </option>
            <% end %>
          </select>
        </div>

        <div class="col-md-3">
          <%= f.label "invoice[invoice_type]", t('invoice.target_mode'), class: "form-label fw-bold" %>
          <select name="invoice[invoice_type]" id="invoice_type_select" class="form-select shadow-sm" onchange="updateDraftPreview()">
            <option value="room" <%= 'selected' if @invoice_type == 'room' %>><%= t('invoice.mode_room_desc') %></option>
            <option value="individual" <%= 'selected' if @invoice_type == 'individual' %>><%= t('invoice.mode_individual_desc') %></option>
          </select>
        </div>

        <div class="col-md-3">
          <%= f.label "invoice[due_date]", t('invoice.due_date'), class: "form-label fw-bold" %>
          <%= f.date_field "invoice[due_date]", value: Date.current + 5.days, class: "form-control shadow-sm", required: true %>
        </div>

        <div class="col-md-6">
          <%= f.label "invoice[bank_account_id]", t('invoice.bank_account_receive'), class: "form-label fw-bold" %>
          <% if @bank_accounts.any? %>
            <select name="invoice[bank_account_id]" class="form-select shadow-sm">
              <% @bank_accounts.each do |acc| %>
                <option value="<%= acc.id %>" <%= 'selected' if acc.is_default? %>>
                  <%= acc.display_label %> <%= '(Mặc định)' if acc.is_default? %>
                </option>
              <% end %>
            </select>
          <% else %>
            <div class="d-flex align-items-center gap-2">
              <span class="text-danger small"><%= t('invoice.no_bank_account_landlord') %></span>
              <%= link_to t('invoice.add_bank_account'), landlord_bank_accounts_path, class: "btn btn-sm btn-outline-primary" %>
            </div>
          <% end %>
        </div>

        <div class="col-md-6">
          <%= f.label "invoice[note]", t('invoice.note'), class: "form-label fw-bold" %>
          <%= f.text_field "invoice[note]", placeholder: t('invoice.note_placeholder'), class: "form-control shadow-sm" %>
        </div>
      </div>
    </div>

    <!-- Danh sách chi tiết các khoản thu (Draft Items) -->
    <%= render "draft_items_form", room: @room, billing_month: @billing_month, invoice_type: @invoice_type, tenant: @tenant, draft_items: @draft_items %>

    <div class="d-flex justify-content-between align-items-center mt-4">
      <div class="text-muted small">
        <span class="material-symbols-outlined fs-6 align-middle">lock</span>
        <%= t('invoice.immutability_notice') %>
      </div>
      <%= f.submit t('invoice.issue_button'), class: "btn btn-primary btn-lg px-5 fw-bold shadow-sm" %>
    </div>
  <% end %>
</div>

<script>
  function updateDraftPreview() {
    const month = document.querySelector("input[name='invoice[billing_month]']").value;
    const roomId = document.getElementById("room_select").value;
    const invoiceType = document.getElementById("invoice_type_select").value;
    const url = `<%= preview_landlord_house_invoices_path(@house) %>?room_id=${roomId}&month=${month}&invoice_type=${invoiceType}`;

    fetch(url, { headers: { "Accept": "text/vnd.turbo-stream.html, text/html" } })
      .then(res => res.text())
      .then(html => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, "text/html");
        const newFrame = doc.querySelector("turbo-frame#draft_items_form");
        const currentFrame = document.querySelector("turbo-frame#draft_items_form");
        if (newFrame && currentFrame) {
          currentFrame.replaceWith(newFrame);
        }
      });
  }
</script>
