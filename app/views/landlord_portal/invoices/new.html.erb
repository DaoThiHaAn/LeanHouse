<% content_for :title, "#{t('invoice.new_invoice')} - #{@house.name}" %>
<% provide :container_width, "h-100" %>

<div class="container pb-4 invoice-wrapper">
  <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom">
    <%= back_link_to landlord_house_invoices_path(@house, month: (@billing_month || Date.current).strftime("%Y-%m")), t('invoice.actions.back_to_list') %>

    <h1 class="fw-bold mb-0 d-flex align-items-center gap-2">
      <%= t('invoice.create_invoice_title') %>
    </h1>

    <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm px-3 py-1 fw-semibold" data-bs-toggle="modal" data-bs-target="#invoiceCreationGuideModal">
      <span class="material-symbols-outlined fs-6">menu_book</span>
      <%= t('invoice.guide.btn_title', default: 'Hướng dẫn lập hóa đơn') %>
    </button>
  </div>

  <%= form_with url: landlord_house_invoices_path(@house), method: :post, local: true,
                data: {
                  controller: "invoice-form loading",
                  invoice_form_preview_url_value: preview_landlord_house_invoices_path(@house),
                  invoice_form_rooms_value: @rooms_json_data.to_json,
                  invoice_form_select_room_prompt_value: t('invoice.select_room_prompt'),
                  invoice_form_select_tenant_prompt_value: t('invoice.select_tenant_prompt'),
                  loading_text_value: t('invoice.issuing', default: 'Đang xuất hóa đơn...'),
                  action: "submit->loading#submit"
                } do |f| %>
    <!-- Card 1: Thông tin chung của hóa đơn -->
    <div class="card invoice-card mb-4 shadow-sm bg-white">
      <div class="card-header bg-body-secondary py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h2 class="mb-2 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined">page_info</span>
            <span><%= t('general_info', default: 'Thông tin chung') %></span>
          </h2>
          <p class="text-info-emphasis ms-4 mb-0"><%= t('invoice.general_info_note') %></p>
        </div>
        <span class="text-secondary small">
          <span class="text-danger">*</span> <%= t('common.required_fields', default: 'Thông tin bắt buộc') %>
        </span>
      </div>

      <div class="card-body p-4">
        <!-- Tiêu đề & Kỳ thanh toán -->
        <div class="row g-3 mb-4">
          <div class="col-12 col-lg-6" data-controller="character-counter" data-character-counter-max-value="100">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <%= f.label "invoice[title]", class: "form-label fw-semibold mb-0" do %>
                <%= t('invoice.reason', default: 'Tiêu đề / Lý do thu tiền') %> <span class="text-danger">*</span>
              <% end %>
              <span class="small text-secondary" data-character-counter-target="count">0/100</span>
            </div>
            <%= f.text_field "invoice[title]",
                  value: t('invoice.default_title'),
                  class: "form-control shadow-sm",
                  placeholder: t('invoice.title_placeholder'),
                  required: true,
                  maxlength: 100,
                  data: {
                    character_counter_target: "input",
                    action: "input->character-counter#update"
                  } %>
          </div>

          <div class="col-6 col-lg-3">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <%= f.label "invoice[billing_month]", class: "form-label fw-semibold mb-0" do %>
                <%= t('invoice.billing_month') %> <span class="text-danger">*</span>
              <% end %>
              <span class="material-symbols-outlined fs-6 text-secondary cursor-pointer"
                    tabindex="0"
                    role="button"
                    aria-label="<%= t('invoice.billing_month') %>"
                    <%= tooltip("top", :"invoice.billing_month_tooltip", html: true) %>>
                info
              </span>
            </div>
            <%= f.month_field "invoice[billing_month]", value: @billing_month.strftime("%Y-%m"), class: "form-control shadow-sm", required: true,
                              data: {
                                invoice_form_target: "monthInput",
                                action: "change->invoice-form#monthChanged"
                              } %>
          </div>

          <div class="col-6 col-lg-3">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <%= f.label "invoice[due_date]", class: "form-label fw-semibold mb-0" do %>
                <%= t('invoice.due_date') %> <span class="text-danger">*</span>
              <% end %>
            </div>
            <%= f.date_field "invoice[due_date]", value: Date.current + 5.days, class: "form-control shadow-sm", required: true %>
          </div>
        </div>

        <!-- Thông tin thanh toán & Ghi chú -->
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <%= f.label "invoice[bank_account_id]", t('invoice.bank_account_receive'), class: "form-label fw-semibold mb-1" %>
            <% if @bank_accounts.any? %>
              <select name="invoice[bank_account_id]" class="form-select shadow-sm">
                <% @bank_accounts.each do |acc| %>
                  <option value="<%= acc.id %>" <%= 'selected' if acc.is_default? %>>
                    <%= acc.display_label %> <%= '(Mặc định)' if acc.is_default? %>
                  </option>
                <% end %>
              </select>
            <% else %>
              <div class="d-flex align-items-center gap-2 mt-1">
                <span class="text-danger small"><%= t('invoice.no_bank_account_landlord') %></span>
                <%= link_to t('invoice.add_bank_account'), landlord_bank_accounts_path, class: "btn btn-sm btn-outline-primary" %>
              </div>
            <% end %>
          </div>

          <div class="col-12 col-md-6" data-controller="character-counter" data-character-counter-max-value="500">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <%= f.label "invoice[note]", t('invoice.note'), class: "form-label fw-semibold mb-0" %>
              <span class="small text-secondary" data-character-counter-target="count">0/500</span>
            </div>
            <%= f.text_field "invoice[note]",
                  placeholder: t('invoice.note_placeholder'),
                  class: "form-control shadow-sm",
                  maxlength: 500,
                  data: {
                    character_counter_target: "input",
                    action: "input->character-counter#update"
                  } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: Đối tượng áp dụng -->
    <div class="card invoice-card mb-4 shadow-sm bg-white">
      <div class="card-header bg-body-secondary py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h2 class="mb-2 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined">tune</span>
            <span><%= t('invoice.target_scope') %></span>
          </h2>
          <p class="text-info-emphasis ms-4 mb-0"><%= t('invoice.target_scope_note') %></p>
        </div>
        <span class="text-secondary small">
          <span class="text-danger">*</span> <%= t('common.required_fields', default: 'Thông tin bắt buộc') %>
        </span>
      </div>

      <div class="card-body p-4">
        <% if @occupied_rooms.empty? %>
          <div class="alert alert-warning border-0 rounded-3 mb-0 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined text-warning-emphasis fs-4">warning</span>
            <span><%= t('invoice.no_occupied_rooms_warning') %></span>
          </div>
        <% else %>
          <div class="row g-3">
            <!-- Tầng -->
            <div class="col-12 col-md-3">
              <%= f.label "floor_id", class: "form-label fw-semibold mb-1" do %>
                <%= t('invoice.floor') %>
              <% end %>
              <select id="floor_select" class="form-select shadow-sm"
                      data-invoice-form-target="floorSelect"
                      data-action="change->invoice-form#floorChanged">
                <option value=""><%= t('invoice.all_floors_option') %></option>
                <% @floors.each do |fl| %>
                  <option value="<%= fl.id %>" <%= 'selected' if @room&.floor_id == fl.id %>><%= fl.title_name %></option>
                <% end %>
              </select>
            </div>

            <!-- Phòng -->
            <div class="col-12 col-md-3">
              <%= f.label "invoice[room_id]", class: "form-label fw-semibold mb-1" do %>
                <%= t('invoice.room') %> <span class="text-danger">*</span>
              <% end %>
              <select name="invoice[room_id]" id="room_select" class="form-select shadow-sm" required
                      data-invoice-form-target="roomSelect"
                      data-action="change->invoice-form#roomChanged">
                <option value=""><%= t('invoice.select_room_prompt') %></option>
                <% rooms_to_render = @room ? @occupied_rooms.select { |r| r.floor_id == @room.floor_id } : @occupied_rooms %>
                <% rooms_to_render.each do |r| %>
                  <option value="<%= r.id %>" <%= 'selected' if @room&.id == r.id %>>
                    <%= @room ? r.title_name : "#{r.title_name} (#{r.floor.title_name})" %>
                  </option>
                <% end %>
              </select>
            </div>

            <!-- Chế độ lập hóa đơn -->
            <div class="col-12 col-md-3">
              <%= f.label "invoice[invoice_type]", class: "form-label fw-semibold mb-1" do %>
                <%= t('invoice.target_mode') %> <span class="text-danger">*</span>
              <% end %>
              <select name="invoice[invoice_type]" id="invoice_type_select" class="form-select shadow-sm" required
                      data-invoice-form-target="invoiceTypeSelect"
                      data-action="change->invoice-form#invoiceTypeChanged">
                <option value="room" <%= 'selected' if @invoice_type == 'room' %>><%= t('invoice.mode_room_desc') %></option>
                <option value="individual" <%= 'selected' if @invoice_type == 'individual' %>><%= t('invoice.mode_individual_desc') %></option>
              </select>
            </div>

            <!-- Người thuê / Giường (chỉ hiện khi lập theo cá nhân) -->
            <div class="col-12 col-md-3 <%= 'd-none' unless @invoice_type == 'individual' %>" id="tenant_select_wrapper"
                 data-invoice-form-target="tenantWrapper">
              <%= f.label "invoice[tenant_id]", class: "form-label fw-semibold mb-1" do %>
                <%= t('invoice.tenant', default: 'Người thuê / Giường') %> <span class="text-danger">*</span>
              <% end %>
              <select name="invoice[tenant_id]" id="tenant_select" class="form-select shadow-sm"
                      data-invoice-form-target="tenantSelect"
                      data-action="change->invoice-form#tenantChanged">
                <% if @room %>
                  <% if @house.bed? %>
                    <% @room.all_staying_bed_tenants.each do |item| %>
                      <option value="<%= item[:tenant].id %>" <%= 'selected' if @tenant&.id == item[:tenant].id %>>
                        <%= item[:tenant].user.fullname %> (<%= t('invoice.bed') %> <%= item[:bed].name %>)
                      </option>
                    <% end %>
                  <% else %>
                    <% @room.all_staying_tenants.each do |t| %>
                      <option value="<%= t.id %>" <%= 'selected' if @tenant&.id == t.id %>>
                        <%= t.user.fullname %>
                      </option>
                    <% end %>
                  <% end %>
                <% end %>
              </select>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Danh sách chi tiết các khoản thu (Draft Items) -->
    <%= render "draft_items_form", room: @room, billing_month: @billing_month, invoice_type: @invoice_type, tenant: @tenant, draft_items: @draft_items %>

    <div class="d-flex justify-content-between align-items-center mt-4">
      <div class="text-secondary small">
        <span class="material-symbols-outlined fs-6 align-middle">lock</span>
        <%= t('invoice.immutability_notice') %>
      </div>
      <%= f.button :submit,
            class: "custom-primary-btn shadow-sm d-inline-flex align-items-center justify-content-center gap-2",
            data: { loading_target: "button" } do %>
        <span data-loading-target="text"><%= t('invoice.issue_button') %></span>
        <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">progress_activity</span>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Modal Hướng dẫn Toàn diện (Được tách thành partial riêng) -->
<%= render "creation_guide_modal" %>
