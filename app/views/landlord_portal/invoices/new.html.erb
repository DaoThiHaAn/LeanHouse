<% content_for :title, "#{t('invoice.new_invoice')} - #{@house.name}" %>

<div class="pb-4 invoice-wrapper">
  <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom gap-2">
    <%= back_link_to landlord_house_invoices_path(@house, month: (@billing_month || Date.current).strftime("%Y-%m")), t('invoice.actions.back_to_list') %>

    <h1 class="text-center d-flex align-items-center gap-2">
      <%= t('invoice.create_invoice_title') %>
    </h1>

    <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm px-3 py-1 fw-semibold" data-bs-toggle="modal" data-bs-target="#invoiceCreationGuideModal">
      <span class="material-symbols-outlined fs-6">help</span>
      <%= t('invoice.guide.btn_title') %>
    </button>
  </div>

  <%= form_with url: landlord_house_invoices_path(@house), method: :post, local: true,
                data: {
                  controller: "invoice-form loading",
                  invoice_form_preview_url_value: preview_landlord_house_invoices_path(@house),
                  invoice_form_rooms_value: @rooms_json_data.to_json,
                  invoice_form_select_room_prompt_value: t('invoice.select_room_prompt'),
                  invoice_form_select_tenant_prompt_value: t('invoice.select_tenant_prompt'),
                  invoice_form_preview_error_text_value: t('invoice.preview_error'),
                  invoice_form_retry_text_value: t('invoice.retry'),
                  invoice_form_is_bed_mode_value: @house.bed?,
                  invoice_form_bed_notice_text_value: t('invoice.bed_mode_individual_form_notice', default: 'Đối với nhà thuê theo giường: Tiền thuê tính theo giá giường thực tế của từng khách thuê. Các khoản phí dịch vụ chung được chia đều theo số người đang ở (%{count} người), và xuất hóa đơn riêng cho từng người.'),
                  invoice_form_bed_room_notice_text_value: t('invoice.bed_mode_room_notice_desc'),
                  invoice_form_room_notice_text_value: t('invoice.individual_split_note', default: 'Hệ thống sẽ tự động chia đều tiền phòng và các dịch vụ chung theo số người đang ở trong phòng (%{count} người), và xuất hóa đơn riêng cho từng người thuê.'),
                  invoice_form_mode_room_title_value: t('invoice.mode_room_desc'),
                  invoice_form_mode_individual_title_value: t('invoice.mode_individual_desc'),
                  loading_text_value: t('invoice.issuing'),
                  action: "submit->loading#submit"
                } do |f| %>
    <!-- Card 1: Thông tin chung của hóa đơn -->
    <%= render "general_info_card", f: f, billing_month: @billing_month, bank_accounts: @bank_accounts, mode: :room, id_prefix: "new_inv" %>

    <!-- Card 2: Đối tượng áp dụng -->
    <div class="card invoice-card mb-4 shadow-sm bg-white">
      <div class="card-header bg-body-secondary py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
          <h2 class="mb-2 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined">tune</span>
            <span><%= t('invoice.target_scope') %></span>
          </h2>
          <p class="text-info-emphasis ms-4"><%= t('invoice.target_scope_note') %></p>
        </div>
        <span class="text-secondary small">
          <span class="text-danger">*</span> <%= t('required_fields') %>
        </span>
      </div>

      <div class="card-body p-4">
        <% if @occupied_rooms.empty? %>
          <div class="alert alert-warning border-0 rounded-3 mb-0 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined text-warning-emphasis fs-4">warning</span>
            <span><%= t('invoice.no_occupied_rooms_warning') %></span>
          </div>
        <% else %>
          <div class="row g-3">
            <!-- Tầng -->
            <div class="col-12 col-md-4">
              <%= f.label "floor_id", class: "form-label fw-semibold mb-1" do %>
                <%= t('invoice.floor') %>
              <% end %>
              <%= select_tag "floor_select",
                    options_for_select([[t('invoice.all_floors_option'), ""]] + @floors.map { |fl| [fl.title_name, fl.id] }, @room&.floor_id),
                    id: "floor_select",
                    class: "form-select shadow-sm",
                    data: {
                      invoice_form_target: "floorSelect",
                      action: "change->invoice-form#floorChanged"
                    } %>
            </div>

            <!-- Phòng -->
            <div class="col-12 col-md-4">
              <%= f.label "invoice[room_id]", class: "form-label fw-semibold mb-1" do %>
                <%= t('invoice.room') %> <span class="text-danger">*</span>
              <% end %>
              <% rooms_to_render = @room ? @occupied_rooms.select { |r| r.floor_id == @room.floor_id } : @occupied_rooms %>
              <%= select_tag "invoice[room_id]",
                    options_for_select([[t('invoice.select_room_prompt'), ""]] + rooms_to_render.map { |r| [@room ? r.title_name : "#{r.title_name} (#{r.floor.title_name})", r.id] }, @room&.id),
                    id: "room_select",
                    class: "form-select shadow-sm",
                    required: true,
                    data: {
                      invoice_form_target: "roomSelect",
                      action: "change->invoice-form#roomChanged"
                    } %>
            </div>

            <!-- Kiểu thanh toán -->
            <div class="col-12 col-md-4">
              <%= f.label "invoice[invoice_type]", class: "form-label fw-semibold mb-1" do %>
                <%= t('invoice.payment_mode') %> <span class="text-danger">*</span>
              <% end %>
              <%= select_tag "invoice[invoice_type]",
                    options_for_select([[t('invoice.mode_room_desc'), "room"], [t('invoice.mode_individual_desc'), "individual"]], @invoice_type),
                    id: "invoice_type_select",
                    class: "form-select shadow-sm",
                    required: true,
                    data: {
                      invoice_form_target: "invoiceTypeSelect",
                      action: "change->invoice-form#invoiceTypeChanged"
                    } %>
            </div>

            <!-- Thông báo chế độ thanh toán -->
            <div class="col-12 <%= 'd-none' unless (@invoice_type == 'individual' || @house.bed?) %>"
                 id="individual_split_notice"
                 data-invoice-form-target="individualNotice">
              <div class="alert alert-info border-0 rounded-3 mb-0 d-flex align-items-start gap-2 shadow-sm">
                <span class="material-symbols-outlined text-info-emphasis fs-5 mt-1" data-invoice-form-target="individualNoticeIcon">
                  <%= @invoice_type == 'individual' ? 'call_split' : 'meeting_room' %>
                </span>
                <div>
                  <strong class="d-block text-info-emphasis mb-1" data-invoice-form-target="individualNoticeTitle">
                    <%= @invoice_type == 'individual' ? t('invoice.mode_individual_desc') : t('invoice.mode_room_desc') %>
                  </strong>
                  <span data-invoice-form-target="individualNoticeText">
                    <% if @invoice_type == 'individual' %>
                      <%= @house.bed? ? t('invoice.bed_mode_individual_notice_desc') : t('invoice.individual_split_note_no_count') %>
                    <% else %>
                      <%= t('invoice.bed_mode_room_notice_desc') %>
                    <% end %>
                  </span>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Danh sách chi tiết các khoản thu (Draft Items) -->
    <%= render "draft_items_form", room: @room, billing_month: @billing_month, invoice_type: @invoice_type, draft_items: @draft_items %>

    <div class="d-flex justify-content-between align-items-center mt-4">
      <p class="text-danger-emphasis  d-flex align-items-center gap-2">
        <span class="material-symbols-filled fs-5">lock</span>
        <%= t('invoice.immutability_notice') %>
      </p>

      <%= f.button :submit,
            class: "custom-primary-btn shadow-sm d-inline-flex align-items-center justify-content-center gap-2",
            data: { loading_target: "button" } do %>
        <span data-loading-target="text"><%= t('invoice.issue_button') %></span>
        <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">progress_activity</span>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Modal Hướng dẫn Toàn diện -->
<%= render "creation_guide_modal" %>

<%= turbo_frame_tag "usage_log_detail_modal" %>
