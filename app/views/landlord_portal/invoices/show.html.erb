<% content_for :title, "#{t('invoice.title')} #{@invoice.code} - #{@house.name}" %>
<% provide :container_width, "h-100" %>

<%
  rent_items = @items.select(&:rent?)
  service_items = @items.select { |i| i.metered_service? || i.fixed_service? }
  discount_items = @items.select(&:discount?)
  addition_items = @items.select(&:addition?)

  rent_total = rent_items.sum(&:amount)
  services_total = service_items.sum(&:amount)
  discounts_total = discount_items.sum { |i| i.amount.abs }
  additions_total = addition_items.sum(&:amount)

  start_date_str = (@invoice.start_date || @invoice.billing_month.beginning_of_month).strftime("%d/%m/%Y")
  end_date_str = (@invoice.end_date || @invoice.billing_month.end_of_month).strftime("%d/%m/%Y")
  due_date_str = @invoice.due_date.strftime("%d/%m/%Y")

  qr_url = if @bank_account
             VietqrService.generate_url(
               bank_account: @bank_account,
               amount: @invoice.total_amount,
               description: @invoice.transfer_note
             )
           end
%>

<div class="container py-4 invoice-detail-wrapper">
  <!-- Navigation Top Bar -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom d-print-none">
    <%= link_to landlord_house_invoices_path(@house, month: @invoice.billing_month.strftime("%Y-%m")), class: "btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 shadow-sm" do %>
      <span class="material-symbols-outlined fs-6">arrow_back</span> <%= t('invoice.actions.back_to_list') %>
    <% end %>

    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-dark btn-sm d-flex align-items-center gap-1 shadow-sm">
        <span class="material-symbols-outlined fs-6">print</span> <%= t('invoice.actions.print') %>
      </button>
      <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#editInvoiceDatesModal">
        <span class="material-symbols-outlined fs-6">edit_calendar</span> <%= t('invoice.edit_dates_and_info', default: 'Sửa ngày & ghi chú') %>
      </button>
      <% if @invoice.pending? %>
        <%= button_to cancel_landlord_house_invoice_path(@house, @invoice), method: :patch, data: { turbo_confirm: t('invoice.actions.cancel_confirm') }, class: "btn btn-outline-danger btn-sm d-flex align-items-center gap-1 shadow-sm" do %>
          <span class="material-symbols-outlined fs-6">cancel</span> <%= t('invoice.actions.cancel') %>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Main Invoice Card -->
  <div id="invoice-printable" class="card invoice-card p-4 p-md-5 bg-white mb-4">
    <!-- Header: Title & Badges -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4 pb-3 border-bottom">
      <div>
        <h2 class="fw-bolder mb-1 text-danger">
          <%= t('invoice.month_invoice', month: @invoice.billing_month.strftime("%m")) %>
        </h2>
        <div class="text-secondary small font-monospace">
          <%= t('invoice.code') %>: <span class="fw-bold invoice-code-tag">#<%= @invoice.code %></span> (<%= t('invoice.id') %>: <%= @invoice.id %>)
        </div>
      </div>

      <div class="d-flex gap-2 align-items-center flex-wrap">
        <% if @invoice.overdue? %>
          <span class="invoice-badge invoice-badge-overdue"><%= t('invoice.status.overdue') %></span>
        <% else %>
          <span class="invoice-badge invoice-badge-paid"><%= t('invoice.status.in_term') %></span>
        <% end %>

        <% case @invoice.status %>
        <% when "paid" %>
          <span class="invoice-badge invoice-badge-paid">
            <span class="material-symbols-outlined fs-6">check_circle</span> <%= t('invoice.status.paid') %>
          </span>
        <% when "pending" %>
          <span class="invoice-badge invoice-badge-pending">
            <span class="material-symbols-outlined fs-6">hourglass_top</span> <%= t('invoice.status.pending') %>
          </span>
        <% when "cancelled" %>
          <span class="invoice-badge invoice-badge-cancelled">
            <span class="material-symbols-outlined fs-6">cancel</span> <%= t('invoice.status.cancelled') %>
          </span>
        <% end %>
      </div>
    </div>

    <!-- Meta Information Section -->
    <div class="mb-4">
      <div class="d-flex align-items-center gap-2 mb-3">
        <% if @invoice.room? %>
          <span class="material-symbols-outlined text-secondary fs-5">apartment</span>
          <span class="fw-bold text-dark"><%= t('invoice.mode_room') %>:</span>
          <span class="text-primary fw-semibold"><%= @invoice.room.title_name %> (<%= @invoice.room.floor.name %>, <%= @house.name %>)</span>
        <% else %>
          <span class="material-symbols-outlined text-secondary fs-5">person</span>
          <span class="fw-bold text-dark"><%= t('invoice.mode_individual') %>:</span>
          <span class="text-primary fw-semibold"><%= @invoice.tenant&.user&.fullname %> (<%= t('invoice.phone_abbr') %>: <%= @invoice.tenant&.user&.tel %>)</span>
          <span class="text-secondary small">- <%= t('invoice.room') %>: <%= @invoice.room.title_name %>, <%= @invoice.room.floor.name %> (<%= @house.name %>)</span>
        <% end %>
      </div>

      <div class="row g-2 text-dark small">
        <div class="col-sm-6">
          <span class="text-secondary"><%= t('invoice.created_time') %>:</span>
          <span class="fw-semibold"><%= @invoice.created_at.strftime("%H:%M:%S %d/%m/%Y") %></span>
        </div>
        <div class="col-sm-6">
          <span class="text-secondary"><%= t('invoice.payment_term') %>:</span>
          <span class="fw-semibold"><%= start_date_str %> - <%= due_date_str %></span>
        </div>
      </div>

      <div class="d-flex align-items-center gap-2 mt-3">
        <span class="fw-bold fs-6"><%= t('invoice.total') %>:</span>
        <span class="badge fs-5 px-3 py-2 font-monospace invoice-total-badge">
          <%= number_to_currency(@invoice.total_amount, unit: "đ", format: "%n %u") %>
        </span>
        <button type="button" class="btn btn-link btn-sm p-0 text-secondary d-print-none" data-bs-toggle="modal" data-bs-target="#invoiceInfoModal" title="<%= t('invoice.view_details') %>">
          <span class="material-symbols-outlined fs-6 align-middle">info</span>
        </button>
      </div>
    </div>

    <!-- Toggle Collapse Detail -->
    <div class="mb-4">
      <a class="text-decoration-none fw-bold d-inline-flex align-items-center gap-1 invoice-collapse-toggle d-print-none" data-bs-toggle="collapse" href="#invoiceDetailCollapse" role="button" aria-expanded="true" aria-controls="invoiceDetailCollapse">
        <span><%= t('invoice.view_details') %></span>
        <span class="material-symbols-outlined fs-6">expand_circle_up</span>
      </a>
    </div>

    <div class="collapse show" id="invoiceDetailCollapse">
      <!-- Lý do thu tiền -->
      <div class="mb-3">
        <span class="fw-bold"><%= t('invoice.reason') %>:</span>
        <span class="text-secondary"><%= @invoice.title.presence || t('invoice.default_title') %></span>
      </div>

      <!-- Diễn giải -->
      <div class="mb-4">
        <div class="fw-bold mb-2"><%= t('invoice.breakdown') %>:</div>

        <!-- 1. Tiền thuê nhà -->
        <% if rent_total > 0 %>
          <div class="mb-3 ps-2">
            <span class="text-primary fw-bold"><%= t('invoice.rent_fee') %>:</span>
            <span class="font-monospace fw-bold"><%= number_to_currency(rent_total, unit: "đ", format: "%n %u") %></span>
            <span class="text-secondary small">(<%= start_date_str %> - <%= end_date_str %>)</span>
          </div>
        <% end %>

        <!-- 2. Phí sử dụng dịch vụ -->
        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-primary fw-bold"><%= t('invoice.service_fee') %>:</span>
            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-secondary small d-inline-flex align-items-center gap-1 d-print-none" data-bs-toggle="modal" data-bs-target="#serviceInstructionsModal">
              <span class="material-symbols-outlined fs-6">help</span> <%= t('invoice.service_instructions') %>
            </button>
          </div>

          <div class="table-responsive rounded-3 border">
            <table class="table table-bordered align-middle mb-0 text-center invoice-items-table">
              <thead class="table-light">
                <tr>
                  <th class="text-start ps-3"><%= t('invoice.service_name') %></th>
                  <th><%= t('invoice.start_date') %></th>
                  <th><%= t('invoice.end_date') %></th>
                  <th><%= t('invoice.unit') %></th>
                  <th class="text-end"><%= t('invoice.unit_price') %></th>
                  <th><%= t('invoice.prev_reading') %></th>
                  <th><%= t('invoice.latest_reading') %></th>
                  <th><%= t('invoice.usage_quantity') %></th>
                  <th class="text-end pe-3"><%= t('invoice.amount') %></th>
                </tr>
              </thead>
              <tbody>
                <% service_items.each do |item| %>
                  <%
                    item_start = (item.start_date || @invoice.start_date || @invoice.billing_month.beginning_of_month).strftime("%d/%m/%Y")
                    item_end = (item.end_date || @invoice.end_date || @invoice.billing_month.end_of_month).strftime("%d/%m/%Y")
                  %>
                  <tr>
                    <td class="text-start ps-3 fw-semibold text-dark"><%= item.name %></td>
                    <td class="text-secondary"><%= item_start %></td>
                    <td class="text-secondary"><%= item_end %></td>
                    <td class="text-secondary"><%= item.unit %></td>
                    <td class="text-end font-monospace"><%= number_to_currency(item.unit_price, unit: "", precision: 0) %></td>
                    <td class="font-monospace text-secondary"><%= item.prev_reading.present? ? item.prev_reading : "-" %></td>
                    <td class="font-monospace fw-bold text-primary"><%= item.latest_reading.present? ? item.latest_reading : "-" %></td>
                    <td class="font-monospace fw-bold text-success"><%= item.quantity %></td>
                    <td class="text-end pe-3 font-monospace fw-bold text-dark">
                      <%= number_to_currency(item.amount, unit: "", precision: 0) %>
                    </td>
                  </tr>
                <% end %>
                <% if service_items.empty? %>
                  <tr>
                    <td colspan="9" class="text-secondary py-3"><%= t('invoice.no_services') %></td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot class="table-group-divider bg-light">
                <tr class="fw-bold">
                  <td colspan="8" class="text-start ps-3"><%= t('invoice.total_services') %>:</td>
                  <td class="text-end pe-3 font-monospace fs-6 text-dark">
                    <%= number_to_currency(services_total, unit: "", precision: 0) %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

        <!-- 3. Khoản được giảm (nếu có) -->
        <% if discount_items.any? %>
          <div class="mb-4">
            <span class="text-danger fw-bold d-block mb-2"><%= t('invoice.discount_items') %>:</span>
            <div class="table-responsive rounded-3 border invoice-subtable-wrapper">
              <table class="table table-bordered align-middle mb-0 invoice-items-table">
                <thead class="table-light">
                  <tr>
                    <th class="ps-3"><%= t('invoice.discount_reason') %></th>
                    <th class="text-end pe-3 th-subtable-amount"><%= t('invoice.discount_amount') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% discount_items.each do |item| %>
                    <tr>
                      <td class="ps-3 text-dark"><%= item.name %></td>
                      <td class="text-end pe-3 font-monospace text-danger fw-semibold">
                        <%= number_to_currency(item.amount.abs, unit: "", precision: 0) %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot class="table-group-divider bg-light">
                  <tr class="fw-bold">
                    <td class="ps-3"><%= t('invoice.total_services') %>:</td>
                    <td class="text-end pe-3 font-monospace text-danger">
                      <%= number_to_currency(discounts_total, unit: "", precision: 0) %>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        <% end %>

        <!-- 4. Khoản cộng thêm (nếu có) -->
        <% if addition_items.any? %>
          <div class="mb-4">
            <span class="text-primary fw-bold d-block mb-2"><%= t('invoice.addition_items') %>:</span>
            <div class="table-responsive rounded-3 border invoice-subtable-wrapper">
              <table class="table table-bordered align-middle mb-0 invoice-items-table">
                <thead class="table-light">
                  <tr>
                    <th class="ps-3"><%= t('invoice.addition_reason') %></th>
                    <th class="text-end pe-3 th-subtable-amount"><%= t('invoice.addition_amount') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% addition_items.each do |item| %>
                    <tr>
                      <td class="ps-3 text-dark"><%= item.name %></td>
                      <td class="text-end pe-3 font-monospace text-primary fw-semibold">
                        <%= number_to_currency(item.amount, unit: "", precision: 0) %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot class="table-group-divider bg-light">
                  <tr class="fw-bold">
                    <td class="ps-3"><%= t('invoice.total_services') %>:</td>
                    <td class="text-end pe-3 font-monospace text-primary">
                      <%= number_to_currency(additions_total, unit: "", precision: 0) %>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        <% end %>

        <!-- 5. Ghi chú -->
        <% if @invoice.note.present? %>
          <div class="text-secondary small mt-3">
            <strong><%= t('invoice.note') %>:</strong> <%= @invoice.note %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Thông tin Chuyển khoản VietQR -->
    <div class="pt-4 border-top">
      <h6 class="fw-bold text-dark mb-3"><%= t('invoice.bank_transfer_info') %>:</h6>
      <div class="row align-items-center g-4">
        <div class="col-md-4 text-center text-md-start">
          <% if @bank_account && qr_url %>
            <div class="d-inline-block bg-white p-2 border rounded-3 shadow-sm text-center position-relative cursor-pointer" data-bs-toggle="modal" data-bs-target="#zoomQrModal" title="<%= t('invoice.vietqr.click_to_zoom') %>">
              <div class="small fw-bold text-danger mb-1 font-monospace d-flex justify-content-between align-items-center px-1">
                <span>VIETQR</span>
                <span class="material-symbols-outlined text-secondary fs-6 d-print-none">zoom_in</span>
              </div>
              <img src="<%= qr_url %>" alt="<%= t('invoice.vietqr.qr_alt') %>" class="rounded vietqr-thumb-img">
              <div class="small text-secondary mt-1 font-monospace vietqr-account-subtext">
                <%= @bank_account.bank.code %> - <%= @bank_account.account_number %>
              </div>
            </div>
          <% else %>
            <div class="p-3 bg-light rounded text-secondary small"><%= t('invoice.no_bank_account_landlord') %></div>
          <% end %>
        </div>

        <div class="col-md-8">
          <div class="ps-md-2 invoice-warning-text">
            <% if @invoice.undo_reason.present? && !@invoice.paid? %>
              <div class="undo-reason-banner mb-3">
                <div class="d-flex align-items-center gap-2 undo-reason-title mb-1">
                  <span class="material-symbols-outlined fs-5 text-danger">warning</span>
                  <span><%= t('invoice.previous_undo_alert') %></span>
                  <% if @invoice.undone_at.present? %>
                    <span class="text-secondary fw-normal small">(<%= @invoice.undone_at.strftime("%H:%M %d/%m/%Y") %>)</span>
                  <% end %>
                </div>
                <p class="undo-reason-text"><strong><%= t('invoice.undo_reason_view') %>:</strong> <%= @invoice.undo_reason %></p>
              </div>
            <% end %>

            <p class="text-danger mb-2"><%= t('invoice.warning_check') %></p>
            <p class="text-danger mb-2"><%= t('invoice.warning_report') %></p>
            <p class="text-danger mb-4"><%= t('invoice.warning_proof') %></p>

            <div class="d-flex gap-2 flex-wrap align-items-center d-print-none">
              <% if @invoice.paid? %>
                <span class="badge bg-success px-3 py-2 fs-6"><%= t('invoice.paid_completed') %></span>
                <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                  <%= t('invoice.payment_method_label') %>: <%= @invoice.cash? ? t('invoice.payment_methods.cash') : t('invoice.payment_methods.transfer') %>
                </span>
                <% if @invoice.paid_at.present? %>
                  <span class="text-secondary small"><%= @invoice.paid_at.strftime("%H:%M %d/%m/%Y") %></span>
                <% end %>
                <% if @invoice.paid_by.present? %>
                  <span class="badge bg-light text-primary border px-2 py-1 small">
                    <%= t('invoice.paid_by_label') %>: <%= @invoice.paid_by.fullname %> (<%= @invoice.paid_by_role == 'landlord' ? t('invoice.paid_by_landlord') : t('invoice.paid_by_tenant') %>)
                  </span>
                <% end %>

                <button type="button" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3 py-2 fw-semibold ms-auto" data-bs-toggle="modal" data-bs-target="#undoPaidModal" title="<%= t('invoice.undo_paid_tooltip') %>">
                  <span class="material-symbols-outlined fs-5">undo</span>
                  <%= t('invoice.undo_paid_action') %>
                </button>
              <% else %>
                <button type="button" class="btn btn-mark-paid-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#markPaidModal">
                  <span class="material-symbols-outlined fs-5">check_circle</span>
                  <%= t('invoice.mark_as_paid') %>
                </button>
              <% end %>
            </div>

            <% if @invoice.paid? %>
              <div class="mt-3 pt-3 border-top">
                <label class="form-label fw-bold text-dark mb-1 d-block"><%= t('invoice.payment_proof') %>:</label>
                <% if @invoice.payment_proof.attached? %>
                  <div class="payment-proof-thumb-wrapper" data-bs-toggle="modal" data-bs-target="#viewPaymentProofModal" title="<%= t('invoice.payment_proof_zoom') %>">
                    <%= image_tag @invoice.payment_proof, class: "payment-proof-thumb", alt: t('invoice.payment_proof') %>
                    <div class="payment-proof-zoom-icon">
                      <span class="material-symbols-outlined fs-6">zoom_in</span>
                    </div>
                  </div>
                <% else %>
                  <span class="text-secondary small fst-italic"><%= t('invoice.no_payment_proof') %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Phóng to Mã QR VietQR -->
<% if @bank_account && qr_url %>
  <div class="modal fade" id="zoomQrModal" tabindex="-1" aria-labelledby="zoomQrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-vietqr-dialog">
      <div class="modal-content rounded-4 shadow border-0">
        <div class="modal-header border-bottom bg-light">
          <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-1" id="zoomQrModalLabel">
            <span class="material-symbols-outlined text-danger">qr_code_2</span>
            <%= t('invoice.vietqr.title') %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center p-4">
          <div class="p-2 border rounded-3 bg-white shadow-sm d-inline-block mb-3">
            <img src="<%= qr_url %>" alt="<%= t('invoice.vietqr.qr_zoomed_alt') %>" class="rounded vietqr-modal-img">
          </div>

          <div class="bg-light p-3 rounded-3 text-start mb-3 border font-monospace small">
            <div class="mb-1"><strong><%= t('invoice.bank_name') %>:</strong> <%= @bank_account.bank.short_name %> (<%= @bank_account.bank.code %>)</div>
            <div class="mb-1"><strong><%= t('invoice.account_number') %>:</strong> <span class="text-primary fw-bold fs-6"><%= @bank_account.account_number %></span></div>
            <div class="mb-1"><strong><%= t('invoice.account_holder') %>:</strong> <%= @bank_account.account_holder %></div>
            <div class="mb-1"><strong><%= t('invoice.vietqr.amount') %>:</strong> <span class="text-danger fw-bold fs-6"><%= number_to_currency(@invoice.total_amount, unit: "đ", format: "%n %u") %></span></div>
            <div class="mb-0" data-controller="clipboard"
                 data-clipboard-copied-text-value="<%= t('invoice.vietqr.copied') %>"
                 data-clipboard-original-text-value="<%= t('invoice.vietqr.copy') %>">
              <strong><%= t('invoice.transfer_note') %>:</strong>
              <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded border mt-1">
                <span class="fw-bold text-dark" data-clipboard-target="source"><%= @invoice.transfer_note %></span>
                <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 py-1 px-2" data-action="click->clipboard#copy" data-clipboard-target="button">
                  <%= t('invoice.vietqr.copy') %>
                </button>
              </div>
            </div>
          </div>
          <p class="text-secondary small mb-0"><%= t('invoice.vietqr.scan_app_instruction') %></p>
        </div>
        <div class="modal-footer border-top">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('invoice.actions.close') %></button>
        </div>
      </div>
    </div>
  </div>
<% end %>

<!-- Modal Hướng dẫn Dịch vụ Real-time / Đo đạc -->
<div class="modal fade" id="serviceInstructionsModal" tabindex="-1" aria-labelledby="serviceInstructionsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold" id="serviceInstructionsModalLabel">
          <span class="material-symbols-outlined text-primary align-middle">info</span>
          <%= t('invoice.service_instructions_title') %>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <h6 class="fw-bold text-dark"><%= t('invoice.realtime_usage_title') %></h6>
        <p class="text-secondary small mb-3">
          <%= t('invoice.realtime_usage_desc') %>
          <br>
          <code class="text-primary font-monospace fw-bold"><%= t('invoice.usage_quantity') %> = <%= t('invoice.latest_reading') %> - <%= t('invoice.prev_reading') %></code>
        </p>

        <h6 class="fw-bold text-dark"><%= t('invoice.fixed_usage_title') %></h6>
        <p class="text-secondary small mb-3">
          <%= simple_format(t('invoice.fixed_usage_desc')) %>
        </p>

        <h6 class="fw-bold text-dark"><%= t('invoice.individual_split_title') %></h6>
        <p class="text-secondary small mb-0">
          <%= t('invoice.individual_split_desc') %>
        </p>
      </div>
      <div class="modal-footer border-top">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('invoice.understood') %></button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Chi tiết Tổng tiền -->
<div class="modal fade" id="invoiceInfoModal" tabindex="-1" aria-labelledby="invoiceInfoModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content rounded-4 shadow">
      <div class="modal-header border-bottom">
        <h6 class="modal-title fw-bold"><%= t('invoice.calculate_formula_title') %></h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body small">
        <p class="mb-1"><strong><%= t('invoice.rent_fee') %>:</strong> <%= number_to_currency(rent_total, unit: "đ", format: "%n %u") %></p>
        <p class="mb-1"><strong><%= t('invoice.service_fee') %>:</strong> +<%= number_to_currency(services_total, unit: "đ", format: "%n %u") %></p>
        <% if additions_total > 0 %>
          <p class="mb-1 text-primary"><strong><%= t('invoice.addition_items') %>:</strong> +<%= number_to_currency(additions_total, unit: "đ", format: "%n %u") %></p>
        <% end %>
        <% if discounts_total > 0 %>
          <p class="mb-1 text-danger"><strong><%= t('invoice.discount_items') %>:</strong> -<%= number_to_currency(discounts_total, unit: "đ", format: "%n %u") %></p>
        <% end %>
        <hr>
        <p class="mb-0 fw-bold fs-6"><%= t('invoice.total_payment') %>: <%= number_to_currency(@invoice.total_amount, unit: "đ", format: "%n %u") %></p>
      </div>
    </div>
  </div>
</div>

<!-- Modal Chỉnh sửa Thời gian, Kỳ thanh toán & Ghi chú -->
<div class="modal fade" id="editInvoiceDatesModal" tabindex="-1" aria-labelledby="editInvoiceDatesModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 shadow">
      <%= form_with model: @invoice, url: landlord_house_invoice_path(@house, @invoice), method: :patch, local: true do |f| %>
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold" id="editInvoiceDatesModalLabel">
            <span class="material-symbols-outlined text-primary align-middle">edit_calendar</span>
            <%= t('invoice.edit_dates_and_info', default: 'Chỉnh sửa Thời gian & Ghi chú') %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <%= f.label :title, t('invoice.reason'), class: "form-label fw-semibold" %>
            <%= f.text_field :title, value: (@invoice.title.presence || t('invoice.default_title')), class: "form-control shadow-sm", placeholder: t('invoice.default_title') %>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <%= f.label :start_date, t('invoice.start_date'), class: "form-label fw-semibold" %>
              <%= f.date_field :start_date, value: (@invoice.start_date || @invoice.billing_month.beginning_of_month), class: "form-control shadow-sm" %>
            </div>
            <div class="col-6">
              <%= f.label :end_date, t('invoice.end_date'), class: "form-label fw-semibold" %>
              <%= f.date_field :end_date, value: (@invoice.end_date || @invoice.billing_month.end_of_month), class: "form-control shadow-sm" %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :due_date, t('invoice.due_date'), class: "form-label fw-semibold" %>
            <%= f.date_field :due_date, value: (@invoice.due_date || (Date.current + 5.days)), class: "form-control shadow-sm" %>
          </div>

          <div class="mb-3">
            <%= f.label :bank_account_id, t('invoice.bank_account_receive'), class: "form-label fw-semibold" %>
            <%= f.select :bank_account_id, @landlord.bank_accounts.includes(:bank).default_first.map { |a| [a.display_label, a.id] }, { include_blank: t('invoice.vietqr.no_vietqr') }, class: "form-select shadow-sm" %>
          </div>

          <div class="mb-0">
            <%= f.label :note, t('invoice.note'), class: "form-label fw-semibold" %>
            <%= f.text_area :note, rows: 2, class: "form-control shadow-sm", placeholder: t('invoice.note_placeholder') %>
          </div>
        </div>
        <div class="modal-footer border-top">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('invoice.actions.close') %></button>
          <%= f.submit t('common.save'), class: "btn btn-primary btn-sm fw-semibold px-3" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Modal Xác nhận thanh toán hóa đơn (Chủ trọ) -->
<div class="modal fade" id="markPaidModal" tabindex="-1" aria-labelledby="markPaidModalLabel" aria-hidden="true" data-controller="file-preview">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 shadow">
      <%= form_with url: mark_paid_landlord_house_invoice_path(@house, @invoice), method: :patch, multipart: true, local: true do |f| %>
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold" id="markPaidModalLabel">
            <span class="material-symbols-outlined text-success align-middle">check_circle</span>
            <%= t('invoice.confirm_paid_title', code: @invoice.code) %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-secondary small mb-3"><%= t('invoice.confirm_paid_desc') %></p>

          <div class="bg-light p-3 rounded-3 mb-3 border">
            <div class="d-flex justify-content-between mb-1">
              <span class="text-secondary small"><%= t('invoice.room') %>:</span>
              <span class="fw-semibold text-dark"><%= @invoice.room.title_name %></span>
            </div>
            <div class="d-flex justify-content-between mb-1">
              <span class="text-secondary small"><%= t('invoice.payment_term') %>:</span>
              <span class="fw-semibold text-dark"><%= @invoice.billing_month.strftime("%m/%Y") %></span>
            </div>
            <div class="d-flex justify-content-between">
              <span class="text-secondary small"><%= t('invoice.total') %>:</span>
              <span class="fw-bold fs-6 text-primary font-monospace"><%= @invoice.formatted_total_amount %></span>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold"><%= t('invoice.payment_method_label') %></label>
            <div class="d-flex gap-4">
              <div class="form-check">
                <%= f.radio_button :payment_method, "transfer", checked: true, class: "form-check-input", id: "landlord_pm_transfer" %>
                <%= f.label :payment_method_transfer, t('invoice.payment_methods.transfer'), for: "landlord_pm_transfer", class: "form-check-label" %>
              </div>
              <div class="form-check">
                <%= f.radio_button :payment_method, "cash", class: "form-check-input", id: "landlord_pm_cash" %>
                <%= f.label :payment_method_cash, t('invoice.payment_methods.cash'), for: "landlord_pm_cash", class: "form-check-label" %>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold"><%= t('invoice.payment_proof') %></label>
            <span class="text-secondary small d-block mb-1"><%= t('invoice.payment_proof_hint') %></span>
            <%= f.file_field :payment_proof, accept: "image/*", class: "form-control shadow-sm", data: { file_preview_target: "input", action: "change->file-preview#preview" } %>

            <div class="payment-proof-preview-wrapper mt-2 d-none" data-file-preview-target="container">
              <img src="" alt="Proof Preview" class="payment-proof-preview-img" data-file-preview-target="preview">
              <button type="button" class="btn btn-danger btn-sm payment-proof-clear-btn" data-action="click->file-preview#clear" title="Xóa ảnh">
                <span class="material-symbols-outlined fs-6">close</span>
              </button>
            </div>
          </div>

          <div class="mb-0">
            <%= f.label :note, t('invoice.payment_note'), class: "form-label fw-semibold" %>
            <%= f.text_area :note, rows: 2, class: "form-control shadow-sm", placeholder: t('invoice.payment_note_placeholder') %>
          </div>
        </div>
        <div class="modal-footer border-top">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('invoice.actions.close') %></button>
          <%= f.submit t('invoice.submit_payment_confirmation'), class: "btn btn-success btn-sm fw-semibold px-3" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Modal Hủy xác nhận thanh toán (Chủ trọ) -->
<div class="modal fade" id="undoPaidModal" tabindex="-1" aria-labelledby="undoPaidModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 shadow">
      <%= form_with url: undo_paid_landlord_house_invoice_path(@house, @invoice), method: :patch, local: true do |f| %>
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold text-danger" id="undoPaidModalLabel">
            <span class="material-symbols-outlined text-danger align-middle">undo</span>
            <%= t('invoice.undo_paid_title', code: @invoice.code) %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-secondary small mb-3"><%= t('invoice.undo_paid_desc') %></p>

          <div class="mb-3">
            <label for="undo_explanation" class="form-label fw-semibold text-dark">
              <%= t('invoice.undo_reason_label') %> <span class="text-danger">*</span>
            </label>
            <%= f.text_area :explanation, id: "undo_explanation", rows: 3, class: "form-control shadow-sm", placeholder: t('invoice.undo_reason_placeholder'), required: true %>
            <div class="form-text text-muted small"><%= t('invoice.undo_reason_warning') %></div>
          </div>
        </div>
        <div class="modal-footer border-top">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('invoice.actions.close') %></button>
          <%= f.submit t('invoice.undo_paid_btn'), class: "btn btn-danger btn-sm fw-semibold px-3" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Modal Phóng to ảnh minh chứng thanh toán -->
<% if @invoice.payment_proof.attached? %>
  <div class="modal fade" id="viewPaymentProofModal" tabindex="-1" aria-labelledby="viewPaymentProofModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content rounded-4 shadow">
        <div class="modal-header border-bottom">
          <h5 class="modal-title fw-bold" id="viewPaymentProofModalLabel">
            <span class="material-symbols-outlined text-primary align-middle">image</span>
            <%= t('invoice.payment_proof_zoom') %> - #<%= @invoice.code %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center p-3">
          <%= image_tag @invoice.payment_proof, class: "payment-proof-modal-img shadow-sm", alt: t('invoice.payment_proof') %>
        </div>
        <div class="modal-footer border-top">
          <a href="<%= url_for(@invoice.payment_proof) %>" target="_blank" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-6">open_in_new</span>
            <%= t('invoice.payment_proof_view') %>
          </a>
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('invoice.actions.close') %></button>
        </div>
      </div>
    </div>
  </div>
<% end %>
