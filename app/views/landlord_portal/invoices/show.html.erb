<% content_for :title, "#{t('invoice.self')} #{@invoice.code} - #{@house.name}" %>
<%= turbo_stream_from @invoice, :payment %>

<div class="container py-4 invoice-detail-wrapper">
  <!-- Navigation Top Bar -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom d-print-none flex-wrap gap-2">
    <%= back_link_to landlord_house_invoices_path(@house, month: @invoice.billing_month.strftime("%Y-%m")), t('invoice.actions.back_to_list') %>

    <h1><%= t('invoice.detail') %></h1>

    <div class="d-flex gap-2 align-items-center flex-wrap">
      <button onclick="window.print()" class="btn btn-outline-dark btn-sm d-flex align-items-center gap-1 shadow-sm px-3 rounded-pill">
        <span class="material-symbols-outlined fs-6">print</span> <%= t('invoice.actions.print') %>
      </button>
      <% if @invoice.pending? || @invoice.overdue? %>
        <%= link_to edit_landlord_house_invoice_path(@house, @invoice, return_to: "show"),
                    class: "btn btn-outline-primary btn-sm d-flex align-items-center gap-1 shadow-sm px-3 rounded-pill",
                    data: { turbo_frame: "edit_invoice_modal" } do %>
          <span class="material-symbols-outlined fs-6">edit_calendar</span> <%= t('invoice.edit_dates_and_info', default: 'Sửa ngày & ghi chú') %>
        <% end %>
      <% end %>
      <% if @invoice.pending? %>
        <%= button_to cancel_landlord_house_invoice_path(@house, @invoice), method: :patch, data: { turbo_confirm: t('invoice.actions.cancel_confirm') }, class: "btn btn-outline-danger btn-sm d-flex align-items-center gap-1 shadow-sm px-3 rounded-pill" do %>
          <span class="material-symbols-outlined fs-6">cancel</span> <%= t('invoice.actions.cancel') %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div id="invoice_detail_card_<%= @invoice.id %>">
    <%= render "layouts/shared_components/invoice_detail_card", invoice: @invoice, bank_account: @bank_account do %>
      <%= render "layouts/shared_components/invoices/payment_actions", invoice: @invoice, portal: :landlord %>
    <% end %>
  </div>
</div>

<%= turbo_frame_tag "edit_invoice_modal" %>

<%= render "layouts/shared_components/invoices/zoom_qr_modal", invoice: @invoice, bank_account: @bank_account %>
<%= render "layouts/shared_components/invoices/service_instructions_modal" %>
<%= render "layouts/shared_components/invoices/invoice_info_modal", invoice: @invoice %>
<%= render "layouts/shared_components/invoices/payment_modal", house: @house, invoice: @invoice %>
<%= render "landlord_portal/invoices/undo_paid_modal", house: @house, invoice: @invoice %>
<%= render "layouts/shared_components/invoices/payment_proof_modal", invoice: @invoice, modal_id: "viewPaymentProofModal" %>
