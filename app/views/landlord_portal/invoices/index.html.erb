<% content_for :title, "#{t('invoice.management')} - #{@house.name}" %>
<div class="d-flex flex-column flex-lg-row justify-content-center justify-content-lg-between align-items-center mb-4 pb-2 border-bottom gap-3">
  <div class="text-center text-lg-start">
    <h1 class="mb-3"><%= t('invoice.management') %></h1>
    <p class="text-secondary"><%= t('invoice.management_subtitle') %></p>
  </div>
  <div class="d-flex gap-2">
    <button type="button" class="manual-btn d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#invoiceCreationGuideModal">
      <span class="material-symbols-outlined fs-6">menu_book</span> <%= t('invoice.guide.btn_title') %>
    </button>
    <%= link_to landlord_house_service_usage_logs_path(@house, month: @billing_month.strftime("%Y-%m")), class: "btn btn-outline-secondary d-flex align-items-center gap-1 shadow-sm" do %>
      <span class="material-symbols-outlined fs-6">electric_meter</span> <%= t('invoice.meter_logs') %>
    <% end %>
    <div class="dropdown">
      <button class="main-btn shadow-sm px-3 py-2 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <span class="material-symbols-outlined">add_notes</span> <%= t('invoice.new_invoice') %>
      </button>
      <ul class="dropdown-menu dropdown-menu-end shadow-sm custom-invoice-dropdown-menu">
        <li>
          <%= link_to new_landlord_house_invoice_path(@house, month: @billing_month.strftime("%Y-%m")),
              class: "dropdown-item d-flex align-items-center gap-2" do %>
            <span class="material-symbols-outlined text-primary fs-5">receipt_long</span>
            <div>
              <div class="fw-semibold"><%= t('invoice.types.room_service_title') %></div>
              <small class="text-secondary"><%= t('invoice.types.room_service_desc') %></small>
            </div>
          <% end %>
        </li>
        <li><hr class="dropdown-divider my-1"></li>
        <li>
          <%= link_to new_landlord_house_invoice_path(@house, month: @billing_month.strftime("%Y-%m"), mode: "custom"),
              class: "dropdown-item d-flex align-items-center gap-2" do %>
            <span class="material-symbols-outlined text-success fs-5">tune</span>
            <div>
              <div class="fw-semibold"><%= t('invoice.types.custom_title') %></div>
              <small class="text-secondary"><%= t('invoice.types.custom_desc') %></small>
            </div>
          <% end %>
        </li>
      </ul>
    </div>
  </div>
</div>

<%= render "invoices_content", house: @house, invoices: @invoices, stats: @stats, billing_month: @billing_month, current_tenants_only: @current_tenants_only %>
<%= render "creation_guide_modal" %>
<%= turbo_frame_tag "edit_invoice_modal" %>
