<%= turbo_frame_tag "row_modals_#{inv.id}" do %>
  <%# Row-level Mark Paid Modal %>
  <% if inv.pending? || inv.overdue? %>
    <div class="modal fade text-start" id="rowMarkPaidModal_<%= inv.id %>" tabindex="-1" aria-labelledby="rowMarkPaidModalLabel_<%= inv.id %>" aria-hidden="true" data-controller="file-preview">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
          <%= form_with url: mark_paid_landlord_house_invoice_path(house, inv), method: :patch, multipart: true do |f| %>
            <div class="modal-header border-bottom">
              <h5 class="modal-title fw-bold" id="rowMarkPaidModalLabel_<%= inv.id %>">
                <span class="material-symbols-outlined text-success align-middle">check_circle</span>
                <%= t('invoice.confirm_paid_title', code: inv.code) %>
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <div class="bg-light p-3 rounded-3 mb-3 border">
                <div class="d-flex justify-content-between mb-1">
                  <span class="text-secondary small"><%= t('invoice.room') %>:</span>
                  <span class="fw-semibold text-dark"><%= inv.room.title_name %></span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                  <span class="text-secondary small"><%= t('invoice.payment_term') %>:</span>
                  <span class="fw-semibold text-dark"><%= inv.billing_month.strftime("%m/%Y") %></span>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="text-secondary small"><%= t('invoice.total') %>:</span>
                  <span class="fw-bold fs-6 text-primary font-monospace"><%= inv.formatted_total_amount %></span>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold"><%= t('invoice.payment_method_label') %></label>
                <div class="d-flex gap-4">
                  <div class="form-check">
                    <%= f.radio_button :payment_method, "transfer", checked: true, class: "form-check-input", id: "row_pm_transfer_#{inv.id}" %>
                    <%= f.label :payment_method_transfer, t('invoice.payment_methods.transfer'), for: "row_pm_transfer_#{inv.id}", class: "form-check-label" %>
                  </div>
                  <div class="form-check">
                    <%= f.radio_button :payment_method, "cash", class: "form-check-input", id: "row_pm_cash_#{inv.id}" %>
                    <%= f.label :payment_method_cash, t('invoice.payment_methods.cash'), for: "row_pm_cash_#{inv.id}", class: "form-check-label" %>
                  </div>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold"><%= t('invoice.payment_proof') %></label>
                <span class="text-secondary small d-block mb-1"><%= t('invoice.payment_proof_hint') %></span>
                <%= f.file_field :payment_proof, accept: "image/*", class: "form-control shadow-sm", data: { file_preview_target: "input", action: "change->file-preview#preview" } %>

                <div class="payment-proof-preview-wrapper mt-2 d-none" data-file-preview-target="container">
                  <img src="" alt="Proof Preview" class="payment-proof-preview-img" data-file-preview-target="preview">
                  <button type="button" class="btn btn-danger btn-sm payment-proof-clear-btn" data-action="click->file-preview#clear" title="Xóa ảnh">
                    <span class="material-symbols-outlined fs-6">close</span>
                  </button>
                </div>
              </div>

              <div class="mb-0">
                <%= f.label :note, t('invoice.payment_note'), class: "form-label fw-semibold" %>
                <%= f.text_area :note, rows: 2, class: "form-control shadow-sm", placeholder: t('invoice.payment_note_placeholder') %>
              </div>
            </div>
            <div class="modal-footer border-top">
              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('invoice.actions.close') %></button>
              <%= f.submit t('invoice.submit_payment_confirmation'), class: "btn btn-success btn-sm fw-semibold px-3" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Row-level Undo Paid Modal %>
  <% if inv.paid? %>
    <div class="modal fade text-start" id="rowUndoPaidModal_<%= inv.id %>" tabindex="-1" aria-labelledby="rowUndoPaidModalLabel_<%= inv.id %>" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
          <%= form_with url: undo_paid_landlord_house_invoice_path(house, inv), method: :patch do |f| %>
            <div class="modal-header border-bottom">
              <h5 class="modal-title fw-bold text-danger" id="rowUndoPaidModalLabel_<%= inv.id %>">
                <span class="material-symbols-outlined text-danger align-middle">undo</span>
                <%= t('invoice.undo_paid_title', code: inv.code) %>
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <p class="text-secondary small mb-3"><%= t('invoice.undo_paid_desc') %></p>

              <div class="mb-3">
                <label for="undo_explanation_<%= inv.id %>" class="form-label fw-semibold text-dark">
                  <%= t('invoice.undo_reason_label') %> <span class="text-danger">*</span>
                </label>
                <%= f.text_area :explanation, id: "undo_explanation_#{inv.id}", rows: 3, class: "form-control shadow-sm", placeholder: t('invoice.undo_reason_placeholder'), required: true %>
                <div class="form-text text-muted small"><%= t('invoice.undo_reason_warning') %></div>
              </div>
            </div>
            <div class="modal-footer border-top">
              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><%= t('invoice.actions.close') %></button>
              <%= f.submit t('invoice.undo_paid_btn'), class: "btn btn-danger btn-sm fw-semibold px-3" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
