<%= turbo_frame_tag "row_modals_#{inv.id}" do %>
  <%# Row-level Mark Paid Modal %>
  <% if inv.pending? || inv.overdue? %>
    <%= render "landlord_portal/invoices/mark_paid_modal",
               house: house,
               invoice: inv,
               modal_id: "rowMarkPaidModal_#{inv.id}" %>
  <% end %>

  <%# Row-level Undo Paid Modal %>
  <% if inv.paid? %>
    <%= render "landlord_portal/invoices/undo_paid_modal",
               house: house,
               invoice: inv,
               modal_id: "rowUndoPaidModal_#{inv.id}" %>
  <% end %>
<% end %>
