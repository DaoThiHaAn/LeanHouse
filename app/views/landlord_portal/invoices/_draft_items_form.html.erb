<%= turbo_frame_tag "draft_items_form" do %>
  <% if local_assigns[:room].nil? %>
    <div class="card invoice-card mb-4 shadow-sm border-0 bg-white">
      <div class="card-body p-5 text-center">
        <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-primary-subtle text-primary mb-3">
          <span class="material-symbols-outlined fs-1">meeting_room</span>
        </div>
        <h5 class="fw-bold text-dark mb-2"><%= t('invoice.select_room_first_title') %></h5>
        <p class="text-secondary mb-0"><%= t('invoice.select_room_first_desc') %></p>
      </div>
    </div>

  <% else %>
    <div class="card invoice-card mb-4"
         data-controller="invoice-items"
         data-invoice-items-addition-placeholder-value="<%= t('invoice.addition_placeholder') %>"
         data-invoice-items-discount-placeholder-value="<%= t('invoice.discount_placeholder') %>"
         data-invoice-items-delete-text-value="<%= t('invoice.actions.delete', default: 'Xóa dòng') %>"
         data-invoice-items-unit-options-value="<%= ServiceVariant.human_units.to_json %>">
      <div class="card-header bg-body-secondary py-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
          <h2 class="mb-2 d-flex align-items-center gap-2">
            <span class="material-symbols-filled fs-3">table</span>
            <span><%= t('invoice.item_or_service') %> (<%= t('common.month', default: 'Tháng') %> <%= billing_month.strftime("%m/%Y") %> - <%= room.title_name %>)</span>
          </h2>
          <p class="w-75 text-info-emphasis ms-4"><%= t('invoice.service_note') %></p>
        </div>
        <% if local_assigns[:invoice_type] == "individual" %>
          <span class="invoice-badge invoice-badge-pending flex-shrink-0 d-inline-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-6">call_split</span>
            <%= t('invoice.mode_individual_desc') %> (<%= t('invoice.divided_per_tenant', count: [room.tenants_count, 1].max) %>)
          </span>
        <% else %>
          <span class="invoice-badge invoice-badge-room flex-shrink-0"><%= t('invoice.auto_calculated_badge', default: 'Tự động tính từ phòng & chỉ số') %></span>
        <% end %>
      </div>

      <div class="table-responsive">
        <table class="table invoice-table align-middle mb-0" id="invoice_items_table" data-invoice-items-target="table">
          <thead>
            <tr>
              <th class="ps-3 text-center th-check"><%= t('invoice.actions.done') %></th>
              <th><%= t('invoice.item_or_service') %></th>
              <th class="th-unit"><%= t('invoice.unit') %></th>
              <th class="th-price"><%= t('invoice.unit_price') %></th>
              <th class="th-reading"><%= t('invoice.reading_or_qty') %></th>
              <th class="text-end th-amount"><%= t('invoice.amount') %></th>
              <th class="text-center pe-3 th-action"><%= t('delete') %></th>
            </tr>
          </thead>

          <!-- 1. Tiền phòng & Dịch vụ tiêu chuẩn -->
          <tbody id="standard_items_tbody">
            <% draft_items.each_with_index do |item, idx| %>
              <tr class="item-row standard-row" data-item-type="<%= item[:item_type] %>">
                <td class="ps-3 text-center">
                  <%= hidden_field_tag "invoice[items][#{idx}][selected]", "0", id: nil %>
                  <%= check_box_tag "invoice[items][#{idx}][selected]", "1", (item[:selected] != false),
                                    id: "invoice_items_#{idx}_selected",
                                    class: "form-check-input item-select-check",
                                    data: { action: "change->invoice-items#recalculate" } %>
                  <%= hidden_field_tag "invoice[items][#{idx}][item_type]", item[:item_type], id: nil, class: "item-type-val" %>
                  <%= hidden_field_tag "invoice[items][#{idx}][service_variant_id]", item[:service_variant_id], id: nil %>
                  <%= hidden_field_tag "invoice[items][#{idx}][service_usage_log_id]", item[:service_usage_log_id], id: nil %>
                  <%= hidden_field_tag "invoice[items][#{idx}][start_date]", item[:start_date], id: nil %>
                  <%= hidden_field_tag "invoice[items][#{idx}][end_date]", item[:end_date], id: nil %>
                </td>

                <td>
                  <%= text_field_tag "invoice[items][#{idx}][name]", item[:name],
                                     id: "invoice_items_#{idx}_name",
                                     readonly: true,
                                     autocomplete: "off",
                                     class: "form-control form-control-sm fw-semibold item-name bg-light-subtle" %>
                </td>

                <td>
                  <div class="d-flex justify-content-center">
                    <%= hidden_field_tag "invoice[items][#{idx}][unit]", item[:unit], id: nil, class: "item-unit" %>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border px-2 py-1">
                      <%= item[:item_type].to_sym == :rent ? t('invoice.rent_unit_month') : item[:unit] %>
                    </span>
                  </div>
                </td>

                <td>
                  <div class="d-flex justify-content-end">
                    <%= hidden_field_tag "invoice[items][#{idx}][unit_price]", item[:unit_price],
                                         id: nil,
                                         readonly: true,
                                         class: "item-price" %>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border font-monospace px-2 py-1 item-price-badge">
                      <%= format_money(item[:unit_price]) %>
                    </span>
                  </div>
                </td>

                <td>
                  <% if item[:item_type].to_sym == :rent %>
                    <%= number_field_tag "invoice[items][#{idx}][quantity]", (item[:quantity].presence || 1),
                                          id: "invoice_items_#{idx}_quantity",
                                          min: 1,
                                          autocomplete: "off",
                                          class: "form-control form-control-sm font-monospace text-center item-qty invoice-input-qty",
                                          data: { action: "input->invoice-items#calculateRow" } %>

                  <% elsif item[:item_type].to_sym == :metered_service %>
                    <div class="d-flex flex-column gap-1">
                      <div class="input-group input-group-sm">
                        <span class="input-group-text py-0 text-secondary invoice-reading-label"><%= t('invoice.prev_reading') %></span>
                        <%= number_field_tag "invoice[items][#{idx}][prev_reading]", item[:prev_reading],
                                              id: "invoice_items_#{idx}_prev_reading",
                                              min: 0,
                                              autocomplete: "off",
                                              class: "form-control font-monospace item-prev-reading",
                                              placeholder: t('invoice.prev_reading'),
                                              data: { action: "input->invoice-items#calculateRow" } %>
                      </div>

                      <div class="input-group input-group-sm">
                        <span class="input-group-text py-0 text-primary fw-bold invoice-reading-label">
                          <%= t('invoice.latest_reading') %>
                        </span>
                        <%= number_field_tag "invoice[items][#{idx}][latest_reading]", item[:latest_reading],
                                              id: "invoice_items_#{idx}_latest_reading",
                                              min: 0,
                                              autocomplete: "off",
                                              class: "form-control font-monospace text-primary item-latest-reading",
                                              placeholder: t('invoice.latest_reading'),
                                              data: { action: "input->invoice-items#calculateRow" } %>
                      </div>
                    </div>
                    <%= hidden_field_tag "invoice[items][#{idx}][quantity]", item[:quantity], id: nil, class: "item-qty" %>

                  <% else %>
                    <%= number_field_tag "invoice[items][#{idx}][quantity]", item[:quantity],
                                          id: "invoice_items_#{idx}_quantity",
                                          min: 0,
                                          step: 0.1,
                                          autocomplete: "off",
                                          class: "form-control form-control-sm font-monospace text-center item-qty invoice-input-qty",
                                          data: { action: "input->invoice-items#calculateRow" } %>
                  <% end %>
                </td>

                <td class="text-end">
                  <div class="d-flex justify-content-end">
                    <%= hidden_field_tag "invoice[items][#{idx}][amount]", item[:amount], id: nil, class: "item-amount" %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1 fw-bold item-amount-display">
                      <%= format_money(item[:amount]) %>
                    </span>
                  </div>
                </td>

                <td class="text-center pe-3 text-secondary">
                  -
                </td>
              </tr>
            <% end %>
          </tbody>

        <%= render "fee_adjustment_sections" %>
      </table>
    </div>

    <!-- Live Total Summary Card -->
    <div class="card-footer bg-light p-3 border-top">
      <div class="row g-3 align-items-center justify-content-between">
        <div class="col-md-7">
          <div class="d-flex flex-column gap-1 small">
            <div class="d-flex justify-content-between text-secondary invoice-summary-row">
              <span><%= t('invoice.subtotal_room_services', default: 'Tiền phòng & Dịch vụ') %>:</span>
              <span id="summary_subtotal" data-invoice-items-target="subtotalSummary" class="font-monospace fw-semibold text-dark">0 đ</span>
            </div>
            <div class="d-flex justify-content-between text-primary invoice-summary-row">
              <span><%= t('invoice.total_addition_summary', default: 'Tổng phụ phí (+)') %>:</span>
              <span id="summary_addition" data-invoice-items-target="additionSummary" class="font-monospace fw-semibold">+ 0 đ</span>
            </div>
            <div class="d-flex justify-content-between text-danger invoice-summary-row">
              <span><%= t('invoice.total_discount_summary', default: 'Tổng giảm trừ (-)') %>:</span>
              <span id="summary_discount" data-invoice-items-target="discountSummary" class="font-monospace fw-semibold">- 0 đ</span>
            </div>
          </div>
        </div>

        <div class="col-md-5 text-md-end">
          <div class="text-secondary small mb-1">
            <%= (local_assigns[:invoice_type] == "individual") ? t('invoice.each_tenant_pays') : t('invoice.total_need_payment', default: 'TỔNG TIỀN CẦN THANH TOÁN') %>:
          </div>
          <div class="d-inline-flex align-items-center gap-2">
            <span id="summary_total" data-invoice-items-target="totalSummary" class="fs-4 fw-bolder px-3 py-1 rounded-3 font-monospace invoice-badge invoice-badge-pending">
              0 đ
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% end %>
<% end %>
