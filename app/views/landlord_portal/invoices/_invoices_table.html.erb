<span hidden data-pagination-total-pages="<%= invoices.respond_to?(:total_pages) ? invoices.total_pages : 1 %>"></span>

<% if invoices.empty? %>
  <div class="invoice-empty-state mx-auto">
    <span class="material-symbols-outlined invoice-empty-icon">receipt</span>
    <p class="fs-5 fw-bold mb-1"><%= t('invoice.no_invoices', month: billing_month.strftime("%m/%Y")) %></p>
    <p class="text-secondary small mb-0"><%= t('invoice.no_invoices_hint') %></p>
  </div>
<% else %>
  <div class="table-responsive bg-white rounded-3 shadow-sm border">
    <table class="table invoice-table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th class="ps-3"><%= t('invoice.code') %></th>
          <th><%= t('invoice.room_or_target') %></th>
          <th><%= t('invoice.month') %></th>
          <th><%= t('invoice.due_date') %></th>
          <th><%= t('invoice.total') %></th>
          <th><%= t('invoice.status_label') %></th>
          <th class="text-center"><%= t("actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% invoices.each do |inv| %>
          <%= render "landlord_portal/invoices/invoice_row", house: house, inv: inv %>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if invoices.respond_to?(:total_pages) && invoices.total_pages > 1 %>
    <div class="mt-4 d-flex justify-content-center">
      <%= paginate invoices,
                   params: {
                     month: billing_month.strftime("%Y-%m"),
                     floor_id: params[:floor_id].presence,
                     room_id: params[:room_id].presence,
                     invoice_type: params[:invoice_type].presence,
                     status: params[:status].presence,
                     current_tenants_only: (local_assigns[:current_tenants_only] == false || params[:current_tenants_only] == "0" ? "0" : "1")
                   } %>
    </div>
  <% end %>
<% end %>
