<tr id="<%= dom_id(inv) %>" class="<%= 'opacity-50 text-decoration-line-through' if inv.cancelled? %>">
  <td class="ps-3">
    <p class="invoice-code-tag mb-1"><%= inv.code %></p>
    <p class="fw-semibold"><%= inv.title %></p>
  </td>
  <td>
    <p class="d-flex align-items-center gap-1 mb-0">
      <%= inv.room.title_name %>, <%= inv.room.floor.title_name %>
    </p>
    <% if inv.tenant&.user&.tel.present? %>
      <small class="text-secondary font-monospace d-block"><%= inv.tenant.user.tel %></small>
    <% end %>
    <div class="mt-1"><%= invoice_type_badge(inv) %></div>
  </td>
  <td><%= format_month(inv.billing_month) %></td>
  <td>
    <p class="<%= 'text-danger small fw-bold' if inv.overdue? %>">
      <%= format_date(inv.due_date) %>
    </p>
  </td>
  <td>
    <span class="fw-bold">
      <%= format_money(inv.total_amount) %>
    </span>
  </td>
  <td>
    <%= invoice_status_badge(inv) %>
  </td>
  <%# Actions %>
  <td>
    <div class="d-flex align-items-center justify-content-center gap-2">
      <%= link_to landlord_house_invoice_path(house, inv),
                class: "table-action px-1 py-0",
                data: { turbo_frame: "_top" },
                title: t("view_detail"),
                aria: { label: t("view_detail") } do %>
        <span class="material-symbols-filled" aria-hidden="true">visibility</span>
      <% end %>

      <% if inv.pending? || inv.overdue? %>
        <%= link_to edit_landlord_house_invoice_path(house, inv),
                  data: { turbo_frame: "edit_invoice_modal" },
                  title: t("edit"),
                  aria: { label: t("edit") } do %>
          <span class="material-symbols-filled" aria-hidden="true">edit</span>
        <% end %>

        <button type="button"
                class="table-action text-success border-0 bg-transparent p-0"
                data-bs-toggle="modal"
                data-bs-target="#rowMarkPaidModal_<%= inv.id %>"
                title="<%= t('invoice.actions.done') %>"
                aria-label="<%= t('invoice.actions.done') %>">
          <span class="material-symbols-filled" aria-hidden="true">paid</span>
        </button>

        <%= button_to cancel_landlord_house_invoice_path(house, inv),
                  method: :patch,
                  title: t("invoice.actions.cancel"),
                  aria: { label: t("invoice.actions.cancel") },
                  data: { turbo_confirm: t("invoice.actions.cancel_confirm"), turbo_frame: "_top" },
                  class: "table-action text-danger-emphasis" do %>
          <span class="material-symbols-filled" aria-hidden="true">cancel</span>
        <% end %>
      <% elsif inv.paid? %>
        <button type="button"
                class="table-action text-danger border-0 bg-transparent p-0"
                data-bs-toggle="modal"
                data-bs-target="#rowUndoPaidModal_<%= inv.id %>"
                title="<%= t('invoice.undo_paid_tooltip') %>"
                aria-label="<%= t('invoice.undo_paid_tooltip') %>">
          <span class="material-symbols-filled" aria-hidden="true">undo</span>
        </button>
      <% end %>
    </div>

    <%= render "landlord_portal/invoices/row_modals", house: house, inv: inv %>
  </td>
</tr>
