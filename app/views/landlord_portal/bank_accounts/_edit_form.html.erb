<%= turbo_frame_tag dom_id(bank_account) do %>
  <% is_supported = bank_account.payos_supported_bank? %>
  <% has_bank = bank_account.bank_id.present? %>
  <% supported_bank_ids = banks.select(&:payos_supported?).map(&:id) %>

  <div class="bank card shadow-sm border rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h2 class="fs-5 mb-0 d-flex align-items-center gap-2">
        <span class="material-symbols-outlined fs-4">edit</span>
        <%= t("bank_account.edit_title") %>
      </h2>
    </div>
    <div class="card-body p-3">
      <%= form_with model: [:landlord, bank_account], local: true,
            data: {
              turbo_frame: "_top",
              controller: "loading bank-account-form",
              bank_account_form_supported_bank_ids_value: supported_bank_ids.to_json,
              loading_text_value: t("saving") + "...",
              action: "submit->loading#submit"
            } do |f| %>
        <% if bank_account.errors.any? %>
          <div class="alert alert-danger py-2 px-3 small mb-3">
            <ul class="mb-0 ps-3">
              <% bank_account.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="row g-2">
          <div class="col-12">
            <%= f.label :bank_id, t("bank_account.select_bank"), class: "form-label small fw-semibold" %>
            <div class="form-control form-control-sm bg-light text-secondary d-flex align-items-center justify-content-between shadow-sm py-2">
              <div class="d-flex align-items-center gap-2">
                <% if bank_account.bank&.logo_url.present? %>
                  <%= image_tag bank_account.bank.logo_url, alt: bank_account.bank.short_name, class: "bank-account-card-logo-sm" %>
                <% end %>
                <span class="fw-bold text-dark"><%= bank_account.bank&.display_name %></span>
              </div>
              <span class="badge bg-secondary text-white small px-2 py-1"><%= t("bank_account.fixed_bank_badge") %></span>
            </div>
            <div class="form-text text-muted d-flex align-items-center gap-1 mt-1 small">
              <span class="material-symbols-outlined fs-6 text-secondary">lock</span>
              <span><%= t("bank_account.fixed_bank_help") %></span>
            </div>
          </div>

          <div class="col-12 mt-1 <%= 'd-none' unless has_bank && !is_supported %>" data-bank-account-form-target="unsupportedNotice">
            <div class="alert alert-light border py-1 px-2 mb-1 small text-secondary d-flex align-items-center gap-2 notice-box-sm">
              <span class="material-symbols-outlined fs-6 text-muted">info</span>
              <span><%= t("bank_account.unsupported_bank_notice") %></span>
            </div>
          </div>

          <div class="col-12">
            <%= f.label :account_number, t("bank_account.account_number"), class: "form-label small fw-semibold" %>
            <%= f.text_field :account_number, class: "form-control form-control-sm shadow-sm font-monospace", required: true %>
          </div>

          <div class="col-12">
            <%= f.label :account_holder, t("bank_account.account_holder_help"), class: "form-label small fw-semibold" %>
            <%= f.text_field :account_holder, class: "form-control form-control-sm shadow-sm text-uppercase", required: true %>
          </div>

          <div class="col-12">
            <div class="form-check my-1">
              <%= f.check_box :is_default, class: "form-check-input", id: "edit_is_default_#{bank_account.id}" %>
              <%= f.label :is_default, t("bank_account.set_as_default_checkbox"), class: "form-check-label small", for: "edit_is_default_#{bank_account.id}" %>
            </div>
          </div>

          <!-- Khối Cấu hình Tự động gạch nợ payOS -->
          <div class="col-12 mt-2 <%= 'd-none' unless is_supported %>" data-bank-account-form-target="payosContainer">
            <div class="card border rounded-3 overflow-hidden bg-light shadow-sm">
              <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                  <%= f.check_box :payos_enabled, class: "form-check-input", id: "edit_payos_enabled_toggle_#{bank_account.id}",
                        data: {
                          bs_toggle: "collapse",
                          bs_target: "#edit_payos_config_collapse_#{bank_account.id}",
                          bank_account_form_target: "payosToggle"
                        } %>
                  <%= f.label :payos_enabled, class: "form-check-label fw-bold text-dark d-flex align-items-center gap-1 cursor-pointer small", for: "edit_payos_enabled_toggle_#{bank_account.id}" do %>
                    <span class="material-symbols-outlined text-success fs-5">bolt</span>
                    <span><%= t("bank_account.payos_toggle_label") %></span>
                  <% end %>
                </div>
                <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 d-flex align-items-center gap-1 small" data-bs-toggle="modal" data-bs-target="#payosSetupGuideModal">
                  <span class="material-symbols-outlined fs-6">help</span>
                  <span><%= t("bank_account.payos_guide_link") %></span>
                </button>
              </div>

              <div class="collapse <%= 'show' if bank_account.payos_enabled? %>" id="edit_payos_config_collapse_<%= bank_account.id %>" data-bank-account-form-target="payosCollapse">
                <div class="card-body p-3 bg-white border-top">
                  <div class="alert alert-info py-1 px-2 mb-2 small d-flex align-items-center gap-1 webhook-info-box">
                    <span class="material-symbols-outlined fs-6 text-info-emphasis">info</span>
                    <span><%= t("bank_account.payos_supported_hint") %></span>
                  </div>

                  <div class="row g-2">
                    <div class="col-12">
                      <%= f.label :payos_client_id, "Client ID", class: "form-label small fw-semibold mb-1" %>
                      <%= f.text_field :payos_client_id, class: "form-control form-control-sm font-monospace", placeholder: "Ví dụ: 9a8b7c6d-..." %>
                    </div>
                    <div class="col-12">
                      <%= f.label :payos_api_key, "API Key", class: "form-label small fw-semibold mb-1" %>
                      <%= f.text_field :payos_api_key, class: "form-control form-control-sm font-monospace", placeholder: "Ví dụ: 1234abcd-..." %>
                    </div>
                    <div class="col-12">
                      <%= f.label :payos_checksum_key, "Checksum Key", class: "form-label small fw-semibold mb-1" %>
                      <%= f.text_field :payos_checksum_key, class: "form-control form-control-sm font-monospace", placeholder: "Khóa bí mật checksum" %>
                    </div>
                  </div>

                  <div class="mt-2 p-2 bg-light rounded-2 small text-secondary webhook-info-box"
                       data-controller="clipboard"
                       data-clipboard-copied-text-value="<%= t('bank_account.copied_btn') %>"
                       data-clipboard-original-text-value="<%= t('bank_account.copy_btn') %>">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                      <div>
                        <strong class="text-dark"><%= t("bank_account.payos_webhook_short") %></strong>
                        <code class="ms-1 text-primary fw-bold" data-clipboard-target="source"><%= payos_webhook_url %></code>
                      </div>
                      <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" data-action="click->clipboard#copy" data-clipboard-target="button">
                        <%= t("bank_account.copy_btn") %>
                      </button>
                    </div>

                    <div class="mt-1 pt-1 border-top text-secondary lh-sm env-notice-text">
                      <span class="material-symbols-outlined fs-6 align-middle text-success">check_circle</span>
                      <%= t("bank_account.payos_webhook_hint") %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
            <%= link_to t("bank_account.cancel"), landlord_bank_accounts_path, class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center" %>
            <%= f.button type: :submit,
                  class: "custom-primary-btn d-inline-flex align-items-center justify-content-center gap-2",
                  data: { loading_target: "button" } do %>
              <span data-loading-target="text"><%= t("bank_account.update_button") %></span>
              <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">
                progress_activity
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
