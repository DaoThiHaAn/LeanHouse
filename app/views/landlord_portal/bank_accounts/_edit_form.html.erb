<%= turbo_frame_tag dom_id(bank_account) do %>
  <div class="bank card h-100 shadow-sm border rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h2 class="fs-5 mb-0 d-flex align-items-center gap-2">
        <span class="material-symbols-outlined fs-4">edit</span>
        <%= t("bank_account.edit_title") %>
      </h2>
    </div>
    <div class="card-body p-3">
      <%= form_with model: [:landlord, bank_account], local: true,
            data: {
              turbo_frame: "_top",
              controller: "loading",
              loading_text_value: t("saving") + "...",
              action: "submit->loading#submit"
            } do |f| %>
        <% if bank_account.errors.any? %>
          <div class="alert alert-danger py-2 px-3 small mb-3">
            <ul class="mb-0 ps-3">
              <% bank_account.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="row g-2">
          <div class="col-12">
            <%= f.label :bank_id, t("bank_account.select_bank"), class: "form-label small fw-semibold" %>
            <%= f.collection_select :bank_id, banks, :id, :display_name, { prompt: t("bank_account.select_bank_prompt") }, class: "form-select form-select-sm shadow-sm", required: true %>
          </div>

          <div class="col-12">
            <%= f.label :account_number, t("bank_account.account_number"), class: "form-label small fw-semibold" %>
            <%= f.text_field :account_number, class: "form-control form-control-sm shadow-sm font-monospace", required: true %>
          </div>

          <div class="col-12">
            <%= f.label :account_holder, t("bank_account.account_holder_help"), class: "form-label small fw-semibold" %>
            <%= f.text_field :account_holder, class: "form-control form-control-sm shadow-sm text-uppercase", required: true %>
          </div>

          <div class="col-12">
            <div class="form-check my-1">
              <%= f.check_box :is_default, class: "form-check-input", id: "edit_is_default_#{bank_account.id}" %>
              <%= f.label :is_default, t("bank_account.set_as_default_checkbox"), class: "form-check-label small", for: "edit_is_default_#{bank_account.id}" %>
            </div>
          </div>

          <div class="col-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
            <%= link_to t("bank_account.cancel"), landlord_bank_accounts_path, class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center" %>
            <%= f.button type: :submit,
                  class: "btn btn-sm custom-primary-btn d-inline-flex align-items-center justify-content-center gap-2",
                  data: { loading_target: "button" } do %>
              <span data-loading-target="text"><%= t("bank_account.update_button") %></span>
              <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">
                progress_activity
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
