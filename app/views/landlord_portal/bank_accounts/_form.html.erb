<% if bank_accounts_count >= BankAccount::MAX_ACCOUNTS %>
  <div class="card bg-light border-0 text-center py-4 rounded-4 shadow-sm">
    <p class="text-secondary mb-0">
      <span class="material-symbols-outlined align-middle me-1">info</span>
      <%= t("bank_account.limit_reached_hint", max: BankAccount::MAX_ACCOUNTS) %>
    </p>
  </div>

<% else %>
  <div class="card shadow-sm">
    <div class="bank card-header py-3 border-bottom">
      <h2 class="d-flex align-items-center gap-2 mb-0">
        <span class="material-symbols-outlined fs-4">add_card</span>
        <%= t("bank_account.new_account_title") %>
      </h2>
    </div>
    <div class="bank card-body p-4">
      <p class="text-danger mb-3 ms-4 fw-semibold fst-italic"><%= t("bank_account.note") %></p>

<% is_supported = bank_account.payos_supported_bank? %>
<% has_bank = bank_account.bank_id.present? %>
<% supported_bank_ids = banks.select(&:payos_supported?).map(&:id) %>

      <%= form_with model: [:landlord, bank_account], id: "new_bank_account_form", local: true,
            data: {
              controller: "loading bank-account-form",
              bank_account_form_supported_bank_ids_value: supported_bank_ids.to_json,
              loading_text_value: t("saving") + "...",
              action: "submit->loading#submit"
            } do |f| %>
        <% if bank_account.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% bank_account.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="row g-3 px-3">
          <div class="col-md-6">
            <%= f.label :bank_id, t("bank_account.select_bank"), class: "form-label fw-semibold" %>
            <%= f.collection_select :bank_id, banks, :id, :display_name,
                  { prompt: t("bank_account.select_bank_prompt") },
                  class: "form-select shadow-sm",
                  required: true,
                  data: {
                    bank_account_form_target: "bankSelect",
                    action: "change->bank-account-form#bankChanged"
                  } %>
          </div>

          <div class="col-12 mt-2 <%= 'd-none' unless has_bank && !is_supported %>" data-bank-account-form-target="unsupportedNotice">
            <div class="alert alert-light border py-2 px-3 mb-0 small text-secondary d-flex align-items-center gap-2">
              <span class="material-symbols-outlined fs-5 text-muted">info</span>
              <span><%= t("bank_account.unsupported_bank_notice") %></span>
            </div>
          </div>

          <div class="col-md-6">
            <%= f.label :account_number, t("bank_account.account_number"), class: "form-label fw-semibold" %>
            <%= f.text_field :account_number, class: "form-control shadow-sm font-monospace", placeholder: t("bank_account.account_number_placeholder"), required: true %>
          </div>

          <div class="col-md-6">
            <%= f.label :account_holder, t("bank_account.account_holder_help"), class: "form-label fw-semibold" %>
            <%= f.text_field :account_holder, class: "form-control shadow-sm text-uppercase", placeholder: t("bank_account.account_holder_placeholder"), required: true %>
          </div>

          <div class="col-md-6 d-flex align-items-end">
            <div class="form-check mb-2">
              <%= f.check_box :is_default, class: "form-check-input", id: "is_default_check" %>
              <%= f.label :is_default, t("bank_account.set_as_default_checkbox"), class: "form-check-label", for: "is_default_check" %>
            </div>
          </div>

          <!-- Khối Cấu hình Tự động gạch nợ payOS -->
          <div class="col-12 mt-3 <%= 'd-none' unless is_supported %>" data-bank-account-form-target="payosContainer">
            <div class="card border rounded-3 overflow-hidden bg-light shadow-sm">
              <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                  <%= f.check_box :payos_enabled, class: "form-check-input", id: "payos_enabled_toggle",
                        data: {
                          bs_toggle: "collapse",
                          bs_target: "#payos_config_collapse",
                          bank_account_form_target: "payosToggle"
                        } %>
                  <%= f.label :payos_enabled, class: "form-check-label fw-bold text-dark d-flex align-items-center gap-1 cursor-pointer", for: "payos_enabled_toggle" do %>
                    <span class="material-symbols-outlined text-success fs-5">bolt</span>
                    <span><%= t("bank_account.payos_toggle_label") %></span>
                  <% end %>
                </div>
                <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#payosSetupGuideModal">
                  <span class="material-symbols-outlined fs-6">help</span>
                  <span><%= t("bank_account.payos_guide_link") %></span>
                </button>
              </div>

              <div class="collapse <%= 'show' if bank_account.payos_enabled? %>" id="payos_config_collapse" data-bank-account-form-target="payosCollapse">
                <div class="card-body p-3 bg-white border-top">
                  <div class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined fs-5 text-info-emphasis">info</span>
                    <span><%= t("bank_account.payos_supported_hint") %></span>
                  </div>

                  <div class="row g-2">
                    <div class="col-md-4">
                      <%= f.label :payos_client_id, "Client ID", class: "form-label small fw-semibold" %>
                      <%= f.text_field :payos_client_id, class: "form-control form-control-sm font-monospace", placeholder: "Ví dụ: 9a8b7c6d-..." %>
                    </div>
                    <div class="col-md-4">
                      <%= f.label :payos_api_key, "API Key", class: "form-label small fw-semibold" %>
                      <%= f.text_field :payos_api_key, class: "form-control form-control-sm font-monospace", placeholder: "Ví dụ: 1234abcd-..." %>
                    </div>
                    <div class="col-md-4">
                      <%= f.label :payos_checksum_key, "Checksum Key", class: "form-label small fw-semibold" %>
                      <%= f.text_field :payos_checksum_key, class: "form-control form-control-sm font-monospace", placeholder: "Khóa bí mật checksum" %>
                    </div>
                  </div>

                  <div class="mt-3 p-2 bg-light rounded-2 small text-secondary"
                       data-controller="clipboard"
                       data-clipboard-copied-text-value="<%= t('bank_account.copied_btn') %>"
                       data-clipboard-original-text-value="<%= t('bank_account.copy_btn') %>">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                      <div>
                        <strong class="text-dark"><%= t("bank_account.payos_webhook_label") %></strong>
                        <code class="ms-1 text-primary fw-bold" data-clipboard-target="source"><%= payos_webhook_url %></code>
                      </div>
                      <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" data-action="click->clipboard#copy" data-clipboard-target="button">
                        <%= t("bank_account.copy_btn") %>
                      </button>
                    </div>

                    <% if payos_local_env? %>
                      <div class="mt-2 pt-2 border-top text-warning-emphasis lh-sm notice-box-sm">
                        <span class="material-symbols-outlined fs-6 align-middle me-1 text-warning">warning</span>
                        <%= t("bank_account.payos_dev_env_notice_html") %>
                      </div>
                    <% else %>
                      <div class="mt-1 text-success lh-sm notice-box-sm">
                        <span class="material-symbols-outlined fs-6 align-middle me-1">check_circle</span>
                        <%= t("bank_account.payos_prod_env_ready") %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-10 mt-4 mx-auto">
            <div class="form-check text-info-emphasis bg-info-subtle fw-medium d-flex gap-2 py-2 pe-2">
              <%= f.check_box :consent_accepted, class: "form-check-input ms-1", id: "consent_check", required: true %>
              <%= f.label :consent_accepted, t("bank_account.consent_checkbox_html"), class: "form-check-label small", for: "consent_check" %>
            </div>
          </div>

          <div class="col-12 mt-4 text-end">
            <%= f.button type: :submit,
                  class: "custom-primary-btn d-inline-flex align-items-center justify-content-center gap-2",
                  data: { loading_target: "button" } do %>
              <span data-loading-target="text"><%= t("bank_account.save_button") %></span>
              <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">
                progress_activity
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
