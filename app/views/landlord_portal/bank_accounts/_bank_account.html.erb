<div class="col-md-6" id="bank_account_col_<%= acc.id %>">
  <%= turbo_frame_tag dom_id(acc) do %>
    <div class="bank card shadow-sm border <%= 'default' if acc.is_default? %> rounded-3">
      <div class="card-body d-flex flex-column justify-content-between">
        <div>
          <div class="d-flex justify-content-between align-items-start mb-2">
            <div class="d-flex align-items-center gap-2">
              <% if acc.bank&.logo_url.present? %>
                <%= image_tag acc.bank.logo_url, alt: acc.bank.short_name, class: "bank-account-card-logo" %>
              <% else %>
                <span class="badge bg-secondary"><%= acc.bank&.code %></span>
              <% end %>
              <span class="fw-bold fs-5"><%= acc.bank&.short_name %></span>
            </div>
            <div class="d-flex align-items-center gap-1">
              <% if acc.payos_configured? %>
                <span class="badge bg-success text-white px-2 py-1 d-inline-flex align-items-center gap-1 shadow-sm" title="<%= t('bank_account.payos_badge_title') %>">
                  <span class="material-symbols-filled fs-6">bolt</span>
                  <span>payOS Realtime</span>
                </span>
              <% end %>
              <% if acc.is_default? %>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                  <%= t("bank_account.default_badge") %>
                </span>
              <% end %>
            </div>
          </div>

          <div class="mt-3">
            <div class="text-secondary small"><%= t("bank_account.account_number_label") %></div>
            <div class="fs-5 font-monospace fw-bold text-primary"><%= acc.account_number %></div>
          </div>

          <div class="mt-2">
            <div class="text-secondary small"><%= t("bank_account.account_holder_label") %></div>
            <div class="fw-semibold"><%= acc.account_holder %></div>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top gap-2 flex-wrap">
          <div>
            <% unless acc.is_default? %>
              <%= button_to t("bank_account.set_as_default"),
                    set_default_landlord_bank_account_path(acc),
                    method: :patch,
                    form: { data: { turbo_frame: "_top" } },
                    class: "btn btn-sm btn-outline-primary" %>
            <% else %>
              <span class="text-secondary small"><%= t("bank_account.auto_selected_hint") %></span>
            <% end %>
          </div>

          <div class="d-flex align-items-center gap-2">
            <%= link_to edit_landlord_bank_account_path(acc), class: "btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" do %>
              <span class="material-symbols-outlined fs-6">edit</span>
              <span><%= t("bank_account.edit") %></span>
            <% end %>

            <%= button_to landlord_bank_account_path(acc),
                  method: :delete,
                  data: { turbo_confirm: t("bank_account.delete_confirm") },
                  form: { data: { turbo_frame: "_top" } },
                  class: "btn btn-sm btn-outline-danger d-flex align-items-center gap-1" do %>
              <span class="material-symbols-outlined fs-6">delete</span>
              <span><%= t("bank_account.delete") %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
