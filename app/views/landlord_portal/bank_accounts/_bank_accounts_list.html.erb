<div class="row g-3 mb-5" id="bank_accounts_list">
  <% bank_accounts.each do |acc| %>
    <%= render "landlord_portal/bank_accounts/bank_account", acc: acc %>
  <% end %>

  <% if bank_accounts.empty? %>
    <div class="col-12" id="empty_bank_accounts_notice">
      <div class="card bg-light border-0 text-center py-4 rounded-3">
        <p class="text-secondary mb-0"><%= t("bank_account.no_accounts_hint") %></p>
      </div>
    </div>
  <% end %>
</div>
