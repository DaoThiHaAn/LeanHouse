<% content_for :title, t("bank_account.page_title") %>

<div class="container py-4 bank-account-container">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h1 class="mb-2 d-flex align-items-center gap-2">
        <span class="material-symbols-filled fs-2">account_balance</span>
        <%= t("bank_account.title") %>
      </h1>
      <p><%= t("bank_account.subtitle") %></p>
    </div>
    <span class="badge custom-primary-btn fs-6 px-3 py-2 rounded-pill" id="bank_accounts_count">
      <%= t("bank_account.accounts_count", count: @bank_accounts.size, max: BankAccount::MAX_ACCOUNTS) %>
    </span>
  </div>

  <!-- Danh sách tài khoản đã thêm -->
  <div id="bank_accounts_list_container">
    <%= render "bank_accounts_list", bank_accounts: @bank_accounts %>
  </div>

  <!-- Form thêm tài khoản mới -->
  <div id="bank_account_form_container">
    <%= render "form", bank_account: @bank_account, banks: @banks, bank_accounts_count: @bank_accounts.size %>
  </div>
</div>
