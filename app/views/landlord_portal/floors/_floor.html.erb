<%# Local variables: floor, house, index  %>

<%= turbo_frame_tag dom_id(floor) do %>
<div class="border rounded p-3 mb-3 d-flex align-items-center gap-3 floor-row"
  data-id="<%= floor.id %>">

  <!-- Position -->
  <div class="fw-bold text-secondary" style="width:40px;">
    <%= index + 1 %>.
  </div>

  <!-- Drag handle -->
  <span class="material-symbols-outlined drag-handle" title="<%=t("form.floor.drag")%>">drag_indicator</span>

  <!-- Floor name -->
    <%= form_with model: floor,
                  url: landlord_house_floor_path(house, floor),
                  method: :patch,
                  class: " d-flex align-items-center gap-3 flex-grow-1" do |f| %>
      <%= f.text_field :name, class: "form-control", placeholder: t("form.floor.name_placeholder"),
            maxlength: 50, required: true,
            id: "floor_#{floor.id}_name" %>

      <%= f.button type: :submit, class: "floor-bar-save p-1",
                  title: t("save")  do %>
        <span class="material-symbols-filled fs-4">save</span>
      <%end%>
    <% end %>

  <!-- Delete Floor -->
  <%= link_to check_delete_landlord_house_floor_path(house, floor),
              data: { turbo_frame: "floor_delete_modal" },
              title: t("delete"),
              class: "p-1" do %>
    <span class="material-symbols-filled text-danger fs-4">delete</span>
  <% end %>

</div>
<% end %>
