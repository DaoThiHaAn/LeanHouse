<%# Local variables: house, bed %>
<% rental_unit = bed.rental_unit %>
<tr id="<%= dom_id(bed) %>">
  <td><%= t("form.bed.self") %> <%= bed.name %></td>
  <td>
    <% fullname = bed.staying_tenant&.user&.fullname %>
    <% if fullname.present? %>
      <%= fullname %>
    <% else %>
      <p class="text-center mb-0">-</p>
    <% end %>
  </td>
  <td><%= number_with_delimiter(rental_unit&.rent || 0) %></td>
  <td><%= number_with_delimiter(rental_unit&.deposit || 0) %></td>

  <%# Actions %>
  <td>
    <div class="d-flex align-items-center justify-content-center gap-2">
      <%= link_to edit_landlord_house_bed_path(house, bed),
                data: { turbo_frame: "edit_bed_modal" },
                title: t("edit"),
                class: "table-action" do %>
        <span class="material-symbols-filled">edit</span>
      <% end %>

      <% if bed.can_delete? %>
        <%= button_to landlord_house_bed_path(house, bed),
                      method: :delete,
                      title: t("delete"),
                      class: "table-action",
                      data: {
                        turbo_confirm: t("form.bed.confirm_delete", name: bed.name)
                      } do %>
          <span class="material-symbols-filled">delete</span>
        <% end %>
      <% else %>
        <button type="button"
                class="table-action border-0 bg-transparent"
                title="<%= t("delete") %>"
                onclick="alert('<%= j t("form.bed.cannot_delete_has_tenants") %>')">
          <span class="material-symbols-filled text-secondary">delete</span>
        </button>
      <% end %>
    </div>
  </td>
</tr>
