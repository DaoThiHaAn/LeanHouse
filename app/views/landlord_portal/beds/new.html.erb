

<%= turbo_frame_tag "new_bed_modal" do %>
  <div class="modal fade" id="newBedModal" tabindex="-1" aria-hidden="true"
        data-controller="modal" data-modal-auto-open-value="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content px-2">
        <div class="modal-header py-2">
          <h1 class="modal-title fs-5 w-100 text-center" id="newBedModalLabel"><%= t("form.bed.add") %></h1>
          <button type="button" class="m-0 btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
        </div>
      </div>
    </div>
  </div>
<% end %>