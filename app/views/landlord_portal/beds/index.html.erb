<%# Variables: @beds %>

<% content_for :title, t("page_titles.bed_mng") %>


<%= turbo_frame_tag "beds_index" do %>
  <div class="d-flex justify-content-between align-items-center mb-5">
    <%# query: state=? %>
    <%= form_with url: filtered_landlord_house_beds_path(@house),
                  method: :get,
                  data: {turbo_frame: "bed_table"} do |f| %>
      <div class="d-flex align-items-center gap-2">
        <%= f.label :state, t("form.bed.state"), class:"fw-bold" %>

        <%= f.select :state,
            [[t("all"), ""],
              [t("form.room.available"), "available"],
              [t("form.room.full"), "full"]],
            { selected: params[:state] },
            class: "shadow-sm form-select w-auto",
            onchange: "this.form.requestSubmit()" %>
      </div>
    <% end %>

    <!-- Add Bed Button -->
    <%= link_to new_landlord_house_bed_path(@house), 
        class:"shadow-sm main-btn d-flex align-items-center gap-2 px-2 py-1",
        data: {turbo_frame: "new_bed_modal"} do %>
      <span class="material-symbols-filled">add_circle</span>
      <%= t('form.bed.add') %>
    <% end %>
  </div>

  <%= turbo_frame_tag "bed_table",
        src: filtered_landlord_house_beds_path(
          @house, 
          params.permit(:page, :state)
        ),
        loading: :lazy,
        data: {
          controller: "pagination-sync",
          pagination_sync_canonical_url_value: landlord_house_beds_path(@house),
          pagination_sync_default_params_value: { state: "all" }.to_json,
          pagination_sync_query_params_value: ["state"].to_json,
          pagination_sync_total_pages_selector_value: "[data-pagination-total-pages",
          action: "turbo:frame-load->pagination-sync#updateUrl"
        } do %>
      <!-- Loading icon -->
    <%= loading_spinner %>
  <% end %>
<% end %>
