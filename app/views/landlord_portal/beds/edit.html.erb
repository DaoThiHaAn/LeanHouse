<%# Variables: @bed, @house, @rental_unit %>

<%= turbo_frame_tag "edit_bed_modal" do %>
  <div class="modal fade" id="editBedModal" tabindex="-1" aria-hidden="true"
        data-controller="modal" data-modal-auto-open-value="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content px-2">
        <div class="modal-header py-2">
          <div class="w-100">
            <h1 class="modal-title fs-5 text-center mb-2" id="editBedModalLabel"><%= t("form.bed.edit") %></h1>
            <p class="fs-5 fw-semibold text-center">
              <%= t("form.bed.self") %> <%= @bed.name_was %> - <%= @bed.room.title_name %> - <%= @bed.room.floor.title_name %>
            </p>
          </div>
          <button type="button" class="m-0 btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="info-container px-3 py-2 mb-4 mx-auto">
            <%= field_info(
              [ t("form.bed.edit_info_1") ],
              extra_classes: "gap-2") %>
          </div>

          <%= form_with model: @bed, url: landlord_house_bed_path(@house, @bed), method: :patch,
              class: "d-flex flex-column gap-4 px-3 mx-auto",
              data: { 
                controller: "loading",
                loading_text_value: t("saving") + "...",
                action: "submit->loading#submit"
              } do |f| %>

            <%# Bed name %>
            <div class="form-group">
              <div class="d-flex align-items-center gap-3" data-controller="form">
                <%= f.label :name, class: "form-label flex-shrink-0" do %>
                  <%= t("form.bed.name") + ": " %>
                  <span class="asterisk">*</span>
                <% end %>

                <%= f.text_field :name, minlength: 1, maxlength: 50,
                    class: "mb-1 form-control w-50 #{invalid_class(@bed, :name)}",
                    placeholder: t("form.bed.input"), required: true, autofocus: true,
                    data: {
                      form_target: "input",
                      action: "input->form#update"
                    } %>

                <small class="counter-text">
                  <span data-form-target="charCount">0</span>
                </small>
              </div>

              <%= field_error(@bed, :name, classes: "ms-2 mt-2") %>
            </div>

            <%# Rental info (Rent & Deposit) %>
            <div class="form-group d-flex flex-column gap-3">
              <div class="form-label flex-shrink-0 d-flex gap-1">
                <%= t("form.house.detailed_room") + ": " %>
                <span class="asterisk">*</span>
              </div>

              <div class="ms-4 input-group w-65">
                <span class="input-group-text">
                  <%= t("form.room.rent") %> (đ)
                </span>
                <%= f.text_field :rent,
                      value: @rental_unit&.rent,
                      class: "form-control #{invalid_class(@rental_unit, :rent) if @rental_unit}",
                      data: { controller: "currency" },
                      required: true %>
                <span class="input-group-text"><%= t("form.room.per_bed") %></span>
              </div>
              <% if @rental_unit %>
                <%= field_error(@rental_unit, :rent, classes: "ms-4 mt-1") %>
              <% end %>

              <div class="ms-4 input-group w-65">
                <span class="input-group-text">
                  <%= t("form.room.deposit") %> (đ)
                </span>
                <%= f.text_field :deposit,
                      value: @rental_unit&.deposit,
                      class: "form-control #{invalid_class(@rental_unit, :deposit) if @rental_unit}",
                      data: { controller: "currency" },
                      required: true %>
                <span class="input-group-text"><%= t("form.room.per_bed") %></span>
              </div>
              <% if @rental_unit %>
                <%= field_error(@rental_unit, :deposit, classes: "ms-4 mt-1") %>
              <% end %>
            </div>

            <%= f.button :submit,
              class: "custom-primary-btn mx-auto main-form d-flex align-items-center justify-content-center gap-2",
              data: { loading_target: "button" } do %>
              <span class="material-symbols-outlined fs-5">save</span>
              <span data-loading-target="text"><%= t("save") %></span>

              <span class="material-symbols-outlined spin d-none"
                data-loading-target="spinner">
                progress_activity
              </span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
