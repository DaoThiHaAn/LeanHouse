<%# Local variables: house, rooms %>

<%= turbo_frame_tag "room_table_bed" do %>

<span hidden data-pagination-total-pages="<%= rooms.total_pages %>"></span>

<h2 class="table-caption"><%= t("form.room.list") %></h2>

<div class="mb-3 d-flex align-items-center gap-2">
	<span class="material-symbols-outlined">list_arrow</span>
	<%= t("form.floor.order") %>
</div>

<div class="custom table-responsive border rounded w-75 m-auto">
  <table class="table table-bordered table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th><%=t("form.room.name")%></th>
        <th><%=t("form.room.tenants_count")%></th>
        <th class="text-center"><%=t("actions")%></th>
      </tr>
    </thead>

    <tbody>
      <% rooms.group_by(&:floor).each do |floor, floor_rooms| %>
        <tr class="colspan">
          <td colspan="100" >
            <%= "#{t("form.floor.self")} #{floor.name}" %>
          </td>
        </tr>

        <% floor_rooms.each do |room| %>
          <tr>
            <td><%= "#{t("form.room.self")} #{room.name}" %></td>
            <td>
              <%= room.tenants_count %> / <%= room.max_slots %>
            </td>

            <%# Actions %>
            <td>
              <div class="d-flex align-items-center justify-content-center gap-2">
                <%= link_to landlord_house_room_path(house, room),
                          class: "table-action px-1 py-0",
                          data: { turbo_frame: "room_detail_modal" },
                          title: t("view_detail") do %>
                  <span class="material-symbols-filled">visibility</span>
                <% end %>

                <%= link_to edit_landlord_house_room_path(house, room),
                          data: { turbo_frame: "edit_room_modal" },
                          title: t("edit"),
                          class: "table-action" do %>
                  <span class="material-symbols-filled">edit</span>
                <% end %>

                <%= button_to landlord_house_room_path(house, room), method: :delete,
                          title: t("delete"),
                          class: "table-action" do %>
                  <span class="material-symbols-filled">delete</span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-3">
  <%= paginate rooms, params: {state: params[:state]} %>
</div>
<% end %>
