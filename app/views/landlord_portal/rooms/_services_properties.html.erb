<%# Service and propertie component in the modal %>
<%# Local variables: room_services, assets %>

<%# Services %>
<div class="mt-3 pt-3 border-top">
  <h6 class="fw-bold m-0"><%= t("form.service.self") + ":" %></h6>
    <%# Table of applied services %>
    <% if room_services.empty? %>
      <p class="mt-1"><%= t("none") %></p>
    <% else %>
      <div class="floor table-responsive border rounded mt-2">
        <table class="table table-bordered table-hover align-middle mb-0">
          <thead class="table-light sticky-top">
            <tr>
              <th><%= t("form.service.price") %></th>
              <th><%= t("form.service.unit") %></th>
              <th class="text-center"><%= t("form.service.real_time_short") %></th>
            </tr>
          </thead>

          <tbody>
            <% room_services.each do |r_service, index| 
              variant = r_service.service_variant
              service = variant.service
            %>
              <tr class="colspan">
                <td colspan="100" >
                    <p class="fw-semibold"><%= service.name %></p>
                    <% if service.note.present? %>
                      <%= image_tag "note.png", alt: "Note icon", class: "note-icon" %>
                      <span class="text-secondary fw-light"><%=service.note%></span>
                    <%end%>
                </td>
              </tr>

              <tr>
                <td><%= number_with_delimiter(variant.fee, delimiter: ",") %></td>
                <td><%= t("enums.room_service.unit.#{variant.unit}") %></td>
                <td class="text-center align-middle">
                  <% if variant.is_real_time %>
                  <span class="material-symbols-outlined d-inline-flex">check_circle</span>
                  <%end%>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <%end%>
</div>

<%# TODO: Properties %>
<div class="mt-3 pt-3 border-top">
  <div class="d-flex gap-2 align-items-center">
    <h6 class="fw-bold m-0"><%= t("form.property.title") + ":" %></h6>
    
    <% if @assets.empty? %>
      <p class="text-muted ms-3"><%= t("none")%></p>
    <% else %>
      <div class="floor table-responsive border rounded mt-2">
        <table class="table table-bordered table-hover align-middle mb-0">
          <thead class="table-light sticky-top">
            <tr>
              <th><%= t("form.asset.cat") %></th>
              <th><%= t("form.asset.price") %></th>
              <th><%= t("form.asset.brand") %></th>
              <th><%= t("form.asset.model") %></th>
              <th><%= t("form.asset.purchase_date") %></th>
              <th><%= t("note") %></th>
            </tr>
          </thead>

          <tbody>
            <% @assets.each do |asset| %>
              <tr>
                <td><%= asset_category_label(asset.category) %></td>
                <td><%= number_with_delimiter(asset.price) %></td>
                <td><%= asset.brand %></td>
                <td><%= asset.model %></td>
                <td><%= asset.purchased_at %></td>
                <td><%= asset.note %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
     <% end %>
  </div>
  
</div>