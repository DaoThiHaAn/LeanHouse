<%# Service and propertie component in the modal %>
<%# Local variables: room_services, properties %>

<%# Services %>
<div class="mt-3 pt-3 border-top">
  <h6 class="fw-bold m-0"><%= t("form.service.self") + ":" %></h6>
    <%# Table of applied services %>
    <div class="floor table-responsive border rounded mt-2">
      <table class="table table-bordered table-hover align-middle mb-0">
        <thead class="table-light sticky-top">
          <tr>
            <th><%= t("form.service.price") %></th>
            <th><%= t("form.service.unit") %></th>
            <th class="text-center"><%= t("form.service.real_time_short") %></th>
          </tr>
        </thead>

        <tbody>
          <% room_services.each do |r_service| 
            h_service = r_service.service
          %>
            <tr class="colspan">
              <td colspan="100" >
                  <p class="fw-semibold"><%= h_service.name %></p>
                  <% if h_service.note.present? %>
                    <%= image_tag "note.png", alt: "Note icon", class: "note-icon" %>
                    <span class="text-secondary fw-light"><%=h_service.note%></span>
                  <%end%>
              </td>
            </tr>

            <tr>
              <td><%= number_with_delimiter(r_service.fee, delimiter: ",") %></td>
              <td><%= t("enums.room_service.unit.#{r_service.unit}") %></td>
              <td class="text-center align-middle">
                <% if r_service.is_real_time %>
                <span class="material-symbols-outlined d-inline-flex">check_circle</span>
                <%end%>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
</div>

<%# TODO: Properties %>
<div class="mt-3 pt-3 border-top">
  <div class="d-flex gap-2 align-items-center">
    <h6 class="fw-bold m-0"><%= t("form.property.title") + ":" %></h6>

    
  </div>
  
</div>