<%# Local variables: house, rooms %>

<%= turbo_frame_tag "room_table" do %>

<!-- Used by stimulus to update url -->
<span hidden data-pagination-total-pages="<%= rooms.total_pages %>"></span>

<h2 class="table-caption"><%= t("form.room.list") %></h2>

<div class="mb-3 d-flex align-items-center gap-2">
  <span class="material-symbols-outlined">list_arrow</span>
  <%= t("form.floor.order") %>
</div>

<div class="table-responsive border rounded w-85 m-auto">
  <table class="table table-bordered table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th><%= t("form.room.name") %></th>
        <th><%= t("form.room.tenants_count") %></th>
        <th><%= t("form.room.rent") %> (đ)</th>
        <th><%= t("form.room.deposit") %> (đ)</th>
        <th class="text-center"><%= t("actions") %></th>
      </tr>
    </thead>

    <tbody>
      <% if rooms.empty? %>
        <tr>
          <td colspan="100" class="text-center py-4 text-muted">
            <%= t("form.room.unfound") %>
          </td>
        </tr>
      <% else %>
        <% rooms.group_by(&:floor).each do |floor, floor_rooms| %>
          <tr class="colspan">
            <td colspan="100">
              <%= floor.title_name %>
            </td>
          </tr>

          <% floor_rooms.each do |room| %>
            <%= render "room_row", house: house, room: room %>
          <% end %>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-3">
  <%= paginate rooms, params: {state: params[:state]} %>
</div>
<% end %>
