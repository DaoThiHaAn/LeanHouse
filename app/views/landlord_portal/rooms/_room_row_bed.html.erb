<%# Local variables: house, room %>
<tr id="<%= dom_id(room) %>">
  <td><%= t("form.room.self") %> <%= room.name %></td>
  <td>
    <%= room.tenants_count %> / <%= room.max_slots %>
  </td>

  <%# Actions %>
  <td>
    <div class="d-flex align-items-center justify-content-center gap-2">
      <%= link_to landlord_house_room_path(house, room),
                class: "table-action px-1 py-0",
                data: { turbo_frame: "room_detail_modal" },
                title: t("view_detail") do %>
        <span class="material-symbols-filled">visibility</span>
      <% end %>

      <%= link_to edit_landlord_house_room_path(house, room),
                data: { turbo_frame: "edit_room_modal" },
                title: t("edit"),
                class: "table-action" do %>
        <span class="material-symbols-filled">edit</span>
      <% end %>

      <% if room.can_delete? %>
        <%= button_to landlord_house_room_path(house, room),
                      method: :delete,
                      title: t("delete"),
                      class: "table-action",
                      data: {
                        turbo_confirm: t("form.room.confirm_delete", name: room.name)
                      } do %>
          <span class="material-symbols-filled text-danger-emphasis">delete</span>
        <% end %>
      <% else %>
        <button type="button"
                class="table-action border-0 bg-transparent"
                title="<%= t("delete") %>"
                onclick="alert('<%= j t("form.room.cannot_delete_has_tenants") %>')">
          <span class="material-symbols-filled text-secondary">delete</span>
        </button>
      <% end %>
    </div>
  </td>
</tr>
