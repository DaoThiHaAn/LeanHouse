<%# Variables: house %>

<div class="d-flex justify-content-end">
	<!-- Add Room Button -->
	<%=link_to new_landlord_house_room_path(house), class:"main-btn d-flex align-items-center gap-2 px-2 py-1" do%>
		<span class="material-symbols-filled">add_circle</span>
		<%=t('form.room.add')%>
	<%end%>
</div>

<%# query: state=? %>
<%= form_with url: table_bed_landlord_house_rooms_path(house),
              method: :get,
              data: {turbo_frame: "room_table_bed"} do |f| %>
	<div class="d-flex align-items-center gap-2 mb-5">
		<%= f.label :state, t("form.room.state"), class:"fw-semibold" %>

		<%= f.select :state,
				[[t("all"), ""],
					[t("form.room.available"), "available"],
					[t("form.room.full"), "full"]],
				{},
				class: "form-select w-auto",
				onchange: "this.form.requestSubmit()" %>
	</div>
<% end %>

<%= turbo_frame_tag "room_table_bed",
      src: table_bed_landlord_house_rooms_path(house),
      loading: :lazy do %>
		<!-- Loading icon -->
    <div class="d-flex justify-content-center align-items-center p-5">
			<div class="spinner-border text-primary" role="status">
				<span class="visually-hidden"><%=t("loading")%>...</span>
			</div>
  </div>
<% end %>
