<%# Variables: house %>

<div class="d-flex justify-content-end">
	<!-- Add Room Button -->
	<%=link_to new_landlord_house_room_path(house), class:"main-btn d-flex align-items-center gap-2 px-2 py-1" do%>
		<span class="material-symbols-filled">add_circle</span>
		<%=t('form.room.add')%>
	<%end%>
</div>

<%# query: state=? %>
<%= form_with url: filtered_table_landlord_house_rooms_path(house),
              method: :get,
              data: {turbo_frame: "room_table_bed"} do |f| %>
	<div class="d-flex align-items-center gap-2 mb-5">
		<%= f.label :state, t("form.room.state"), class:"fw-semibold" %>

		<%= f.select :state,
				[[t("all"), ""],
					[t("form.room.available"), "available"],
					[t("form.room.full"), "full"]],
				{ selected: params[:state] },
				class: "form-select w-auto",
				onchange: "this.form.requestSubmit()" %>
	</div>
<% end %>

<%= turbo_frame_tag "room_table_bed",
      src: filtered_table_landlord_house_rooms_path(house, params.permit(:page, :state)),
      loading: :lazy,
      data: {
        controller: "pagination-sync",
        pagination_sync_canonical_url_value: landlord_house_rooms_path(house),
        pagination_sync_default_params_value: { state: "all" }.to_json,
        pagination_sync_query_params_value: ["state"].to_json,
        pagination_sync_total_pages_selector_value: "[data-pagination-total-pages]",
        action: "turbo:frame-load->pagination-sync#updateUrl"
      } do %>
		<!-- Loading icon -->
	<div class="d-flex justify-content-center align-items-center p-5">
		<div class="spinner-border text-primary" role="status">
			<span class="visually-hidden"><%=t("loading")%>...</span>
		</div>
  </div>
<% end %>
