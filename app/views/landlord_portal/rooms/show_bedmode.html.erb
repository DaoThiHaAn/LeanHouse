<%# Variables: @room, @floor, @room_services %>

<%= turbo_frame_tag "room_detail_modal" do %>
  <div class="modal fade" id="roomDetailModal" tabindex="-1" aria-hidden="true" data-controller="modal">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header py-0">
          <div class="d-flex align-items-center justify-content-start gap-1 mx-auto">
            <span class="icon material-symbols-filled">living</span>
            <h1 class="modal-title fs-5" id="houseDetailModalLabel">
              <%= "#{t("form.room.self")} #{@room.name.capitalize} - #{t("form.floor.self")} #{@floor.name.capitalize}" %>
            </h1>
          </div>
          <button type="button" class="m-0 btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <%# General Info %>
          <div class="info-zone p-3 d-flex align-items-center justify-content-around">
            <div class="d-flex align-items-center gap-2">
              <p class="fw-bold m-0"><%= t("form.room.area") + ":"%></p>
              <p class="m-0"><%= "#{@room.area} m²"%></p>
            </div>
            <div class="d-flex align-items-center gap-2">
              <p class="fw-bold m-0"><%= t("form.room.beds_count") + ":"%></p>
              <p class="m-0"><%= @room.max_slots %></p>
            </div>
          </div>

          <%# TODO: Tenants %>
          <div class="pt-3">
            <h6 class="fw-bold m-0"><%= t("form.tenant.self") + ":"%></h6>
            <% if @room.tenants_count == 0 %>
              <p class="mt-1"><%= t("none") %></p>
            <% else %>

            <% end %>
          </div>

          <%= render "services_properties", room_services: @room_services %>
        </div>

        <div class="modal-footer d-flex justify-content-between align-items-center">
          <%# Edit button %>
          <%= link_to edit_landlord_house_room_path(@house, @room), 
                data: { turbo_frame: "_top" }, # force Rails to direct to a new page
                class: "main-btn d-flex align-items-center justify-content-center gap-1" do %>
            <span class="material-symbols-filled">edit</span>
            <%=t("edit")%>
          <% end %>

          <p class="text-secondary fst-italic mb-0"><%= "#{t("last_updated")}: #{l(@room.updated_at, format: :default)}" %></p>
        </div>
      </div>
    </div>
  </div>
<% end %>
