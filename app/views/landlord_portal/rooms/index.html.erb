<%# Variables: @house, @active_tab (bed mode) %>

<% content_for :title, t("page_titles.room_mng") %>

<div class="main-info-zone p-4 rounded-4 position-relative overflow-hidden mb-4">
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 position-relative" style="z-index: 1;">
    <div class="d-flex align-items-start align-items-sm-center gap-3">
      <div class="house-icon-wrapper rounded-3 d-flex align-items-center justify-content-center flex-shrink-0">
        <span class="material-symbols-filled fs-1">roofing</span>
      </div>
      <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
          <h1 class="zone-house-name mb-0 fs-3"><%= @house.name %></h1>
          <span class="zone-status-badge d-inline-flex align-items-center gap-1" title="<%= t('form.house.mode', default: 'Hình thức cho thuê') %>">
            <span class="status-dot"></span>
            <span class="material-symbols-filled fs-6"><%= house_mode_icon(@house) %></span>
            <span><%= house_mode(@house).tr("()", "") %></span>
          </span>
        </div>
        <% if @house.full_address.present? %>
          <div class="zone-address d-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-5">location_on</span>
            <span><%= @house.full_address %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-wrap flex-md-column align-items-start align-items-md-end gap-2 ms-0 ms-md-auto pt-2 pt-md-0">
      <div class="zone-room-badge d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill"
           title="<%= t('form.house.total_floors') %>">
        <span class="material-symbols-outlined fs-5">layers</span>
        <span>
          <%= t("form.house.total_floors") %>: <strong><%= @house.floors_count %></strong>
        </span>
      </div>
      <div class="zone-checkin-badge d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill"
           title="<%= t('form.house.total_rooms') %>">
        <span class="material-symbols-outlined fs-5"><%= @house.room? ? "meeting_room" : "bed" %></span>
        <span>
          <%= t("form.house.total_rooms") %>: <strong><%= @house.total_rooms %></strong>
          <% if @house.bed? %>
            (<%= @house.total_slots %> <%= t("form.bed.self").downcase %>)
          <% end %>
        </span>
      </div>
    </div>
  </div>

  <%# Decorative background icon %>
  <div class="zone-bg-decoration" aria-hidden="true">
    <span class="material-symbols-outlined"><%= @house.room? ? "apartment" : "bed" %></span>
  </div>
</div>

<%# Main section %>
<div class="w-100 px-1 px-md-3 px-lg-5 pt-4">
	<% if @house.room?%>
		<%= render "room_section", house: @house  %>
	<%else%>
		<%# 2 tabs: Rooms (active by default), Beds %>
		<% active_tab = local_assigns[:active_tab] || @active_tab || :rooms %>

		<ul class="nav nav-tabs nav-justified" id="houseTabs" role="tablist">
			<li class="nav-item">
				<button type="button" class="nav-link <%= 'active' if active_tab == :rooms %> fs-5 fw-bold"
								data-bs-toggle="tab" data-bs-target="#rooms-pane"
								onclick="history.pushState({}, '', '<%= landlord_house_rooms_path(@house) %>')">
					<%= t("form.room.self") %>
				</button>
			</li>

			<li class="nav-item">
				<button type="button" class="nav-link <%= 'active' if active_tab == :beds %> fs-5 fw-bold"
								data-bs-toggle="tab" data-bs-target="#beds-pane">
					<%= t("form.bed.self") %>
				</button>
			</li>
		</ul>

		<div class="tab-content">
			<div class="room tab-pane fade <%= 'show active' if active_tab == :rooms %> pt-5 pb-4 px-4" id="rooms-pane">
				<%= render "landlord_portal/rooms/room_section_bed", house: @house %>
			</div>

			<div class="room tab-pane fade <%= 'show active' if active_tab == :beds %> pt-5 pb-4 px-4" id="beds-pane">
				<%= turbo_frame_tag "beds_index",
							src: landlord_house_beds_path(@house),
							loading: :lazy,
							data: { turbo_action: "advance" } do %>
					<%= loading_spinner %>
				<% end %>
			</div>
		</div>
	<% end %>
</div>

<%= turbo_frame_tag "room_detail_modal" %>
<%= turbo_frame_tag "edit_room_modal" %>
<%= turbo_frame_tag "new_bed_modal" %>
<%= turbo_frame_tag "edit_bed_modal" %>
