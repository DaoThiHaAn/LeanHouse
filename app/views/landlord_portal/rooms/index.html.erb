<%# Variables: @house, @active_tab (bed mode) %>

<% content_for :title, t("page_titles.room_mng") %>

<div class="w-100 py-3 short-house-info">
	<h1 class="w-50 text-center text-clamp-2 mx-auto my-2"><%=@house.name%></h1>
	<div class="w-50 mx-auto d-flex align-items-center justify-content-center gap-2 fw-semibold">
		<span class="material-symbols-filled fs-1"><%=house_mode_icon(@house)%></span>
		<span class="fs-5"><%=house_mode(@house)%></span>
	</div>
	<p class="w-50 text-center text-clamp-2 mx-auto fs-5 fw-semibold">
		<%="#{t("form.house.total_floors")}: #{@house.floors_count}"%>
		<%="- #{t("form.house.total_rooms")}: #{@house.total_rooms}"%>
	</p>
</div>

<%# Main section %>
<div class="w-100 px-1 px-md-3 px-lg-5 pt-4">
	<% if @house.room?%>
		<%= render "room_section", house: @house  %>
	<%else%>
		<%# 2 tabs: Rooms (active by default), Beds %>
		<% active_tab = local_assigns[:active_tab] || @active_tab || :rooms %>

		<ul class="nav nav-tabs nav-justified" id="houseTabs" role="tablist">
			<li class="nav-item">
				<button type="button" class="nav-link <%= 'active' if active_tab == :rooms %> fs-5 fw-bold"
								data-bs-toggle="tab" data-bs-target="#rooms-pane"
								onclick="history.pushState({}, '', '<%= landlord_house_rooms_path(@house) %>')">
					<%= t("form.room.self") %>
				</button>
			</li>

			<li class="nav-item">
				<button type="button" class="nav-link <%= 'active' if active_tab == :beds %> fs-5 fw-bold"
								data-bs-toggle="tab" data-bs-target="#beds-pane">
					<%= t("form.bed.self") %>
				</button>
			</li>
		</ul>

		<div class="tab-content">
			<div class="room tab-pane fade <%= 'show active' if active_tab == :rooms %> pt-5 pb-4 px-4" id="rooms-pane">
				<%= render "landlord_portal/rooms/room_section_bed", house: @house %>
			</div>

			<div class="room tab-pane fade <%= 'show active' if active_tab == :beds %> pt-5 pb-4 px-4" id="beds-pane">
				<%= turbo_frame_tag "beds_index",
							src: landlord_house_beds_path(@house),
							loading: :lazy,
							data: { turbo_action: "advance" } do %>
					<%= loading_spinner %>
				<% end %>
			</div>
		</div>
	<% end %>
</div>

<%= turbo_frame_tag "room_detail_modal" %>
<%= turbo_frame_tag "edit_room_modal" %>
<%= turbo_frame_tag "new_bed_modal" %>
<%= turbo_frame_tag "edit_bed_modal" %>
