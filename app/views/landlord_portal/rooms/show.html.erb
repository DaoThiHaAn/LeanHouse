<%# Variables: @room, @floor, @room_services %>

<%= turbo_frame_tag "room_detail_modal" do %>
  <div class="modal fade" id="roomDetailModal" tabindex="-1" aria-hidden="true" data-controller="modal">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header py-0">
          <div class="d-flex align-items-center justify-content-start gap-1">
            <span class="icon material-symbols-filled">living</span>
            <h1 class="modal-title fs-5" id="houseDetailModalLabel">
              <%= "#{t("form.room.self")} #{@room.name.capitalize} - #{t("form.floor.self")} #{@floor.name.capitalize}" %>
            </h1>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <%# Tenants %>
          <div class="mt-1">
            <h6 class="fw-bold m-0"><%= t("form.tenant.self") + ":"%></h6>
          </div>


          <%# Services %>
          <div class="mt-3 pt-3 border-top">
            <h6 class="fw-bold m-0"><%= t("form.service.self") + ":" %></h6>
              <%# Table of applied services %>
              <div class="floor table-responsive border rounded mt-2">
                <table class="table table-bordered table-hover align-middle mb-0">
                  <thead class="table-light sticky-top">
                    <tr>
                      <th><%= t("form.service.price") %></th>
                      <th><%= t("form.service.unit") %></th>
                      <th class="text-center"><%= t("form.service.real_time_short") %></th>
                    </tr>
                  </thead>

                  <tbody>
                    <% @room_services.each do |r_service| 
                      h_service = r_service.service
                    %>
                      <tr class="colspan">
                        <td colspan="100" >
                            <p class="fw-semibold"><%= h_service.name %></p>
                            <% if h_service.note.present? %>
                              <%= image_tag "note.png", alt: "Note icon", class: "note-icon" %>
                              <span class="text-secondary fw-light"><%=h_service.note%></span>
                            <%end%>
                        </td>
                      </tr>

                      <tr>
                        <td><%= r_service.fee %></td>
                        <td><%= t("enums.room_service.unit.#{r_service.unit}") %></td>
                        <td class="text-center align-middle">
                          <% if r_service.is_real_time %>
                          <span class="material-symbols-outlined d-inline-flex">check_circle</span>
                          <%end%>
                        </td>
                      </tr>
                  </tbody>
                </table>
              </div>

            <% end %>
          </div>

          <%# TODO: Properties %>
          <div class="mt-3 pt-3 border-top">
            <div class="d-flex gap-2 align-items-center">
              <h6 class="fw-bold m-0"><%= t("form.property.title") + ":" %></h6>

              
            </div>
            
          </div>
        </div>


        <div class="modal-footer d-flex justify-content-between align-items-center">
          <%# Edit button %>
          <%= link_to edit_landlord_house_room_path(@house, @room), 
                data: { turbo_frame: "_top" }, # force Rails to direct to a new page
                class: "main-btn d-flex align-items-center justify-content-center gap-1" do %>
            <span class="material-symbols-filled">edit</span>
            <%=t("edit")%>
          <% end %>

          <p class="text-secondary fst-italic mb-0"><%= "#{t("last_updated")}: #{l(@room.updated_at, format: :default)}" %></p>
        </div>
      </div>
    </div>
  </div>
<% end %>