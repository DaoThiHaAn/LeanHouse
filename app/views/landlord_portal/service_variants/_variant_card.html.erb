<%# Locals: variant, house, service, total_rooms %>
<% service ||= variant.service %>
<% house ||= service.house %>
<% total_rooms ||= house.rooms.active.count %>
<% applied_count = variant.rooms.size %>

<%= turbo_frame_tag dom_id(variant) do %>
  <div class="card variant-card h-100 shadow-sm border p-3 d-flex flex-column justify-content-between">
    <%# Card Top: Price & Real-time status %>
    <div>
      <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
        <div>
          <span class="fs-4 fee fw-bold ">
            <%= number_with_delimiter(variant.fee, delimiter: ",") %>
          </span>
          <span class="text-secondary fw-semibold">đ / </span>
          <span class="text-dark fw-bold"><%= variant.human_unit %></span>
        </div>

        <% if variant.is_real_time? %>
          <span class="badge bg-info bg-opacity-10 text-info-emphasis border border-info-subtle d-inline-flex align-items-center gap-1 py-1 px-2">
            <span class="material-symbols-outlined fs-6">speed</span>
            <small class="fw-semibold"><%= t("form.service.variant.real_time_badge") %></small>
          </span>
        <% else %>
          <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle d-inline-flex align-items-center gap-1 py-1 px-2">
            <span class="material-symbols-outlined fs-6">lock</span>
            <small class="fw-semibold"><%= t("form.service.variant.fixed") %></small>
          </span>
        <% end %>
      </div>

      <%# Applied Rooms Badge %>
      <div class="applied-rooms-container my-3 p-2 rounded">
        <small class="fw-semibold mb-1">
          <%= t("form.service.variant.applied_rate", applied: applied_count, total: total_rooms) %>
        </small>
      </div>
    </div>

    <%# Card Bottom: 3 Actions %>
    <div class="variant-actions d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
      <%# Action 1: Meta Edit %>
      <%= link_to edit_landlord_house_service_service_variant_path(house, service, variant),
                  class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1",
                  data: { turbo_frame: "service_variant_modal" } do %>
        <span class="material-symbols-outlined fs-6">tune</span>
        <span class="d-none d-sm-inline small"><%= t("form.service.variant.edit_meta") %></span>
      <% end %>

      <%# Action 2: Application Edit %>
      <%= link_to edit_application_landlord_house_service_service_variant_path(house, service, variant),
                  class: "btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1",
                  data: { turbo_frame: "service_variant_modal" } do %>
        <span class="material-symbols-outlined fs-6">checklist</span>
        <span class="d-none d-sm-inline small"><%= t("form.service.variant.edit_application") %></span>
      <% end %>

      <%# Action 3: Delete %>
      <%= button_to landlord_house_service_service_variant_path(house, service, variant),
                    method: :delete,
                    class: "btn btn-sm btn-outline-danger d-inline-flex align-items-center p-1",
                    title: t("form.service.variant.delete"),
                    data: {
                      turbo_confirm: [
                        t("form.service.variant.delete_cf", fee: number_with_delimiter(variant.fee), unit: variant.human_unit),
                        t("form.service.variant.delete_warning")
                      ].join("\n\n")
                    } do %>
        <span class="material-symbols-outlined fs-6">delete</span>
      <% end %>
    </div>
  </div>
<% end %>
