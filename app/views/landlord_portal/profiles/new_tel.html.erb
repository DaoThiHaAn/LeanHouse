<% content_for :title, t('form.profile.new_tel') %>

<div class="custom card py-4 my-5 mx-auto w-50">
  <div class="card-body d-flex flex-column gap-3">
    <div class="d-flex align-items-center mb-4 gap-3">
      <%= back_link_to landlord_profile_path %>
      <h1 class="text-center flex-grow-1"><%= t('form.profile.new_tel') %></h1>
    </div>

    <%= form_with url: change_tel_landlord_profile_path, method: :post, local: true,
          class: "px-5 d-flex align-items-center flex-column gap-4" do |f| %>

      <!-- Tel -->
      <div class="form-group w-75" data-controller="form">
        <%= f.label :tel, class: "form-label d-flex justify-content-between" do %>
          <div>
            <%= t("form.profile.new_tel") %>:<span class="asterisk">*</span>
          </div>

          <small class="counter-text">
            <span data-form-target="charCount">0</span>
          </small>
        <% end %>

        <%= f.telephone_field :tel,
            value: params[:tel],
            minlength: 10,
            maxlength: 10,
            required: true,
            autofocus: true,
            class: "form-control #{invalid_class(@user, :tel)}",
            placeholder: t("form.profile.tel_placeholder"),
            data: {
              form_target: "input",
              action: "input->form#update"
            } %>
        <%= field_error(@user, :tel) %>
      </div>

      <%= f.submit t("form.profile.send_otp"), class: "mx-auto custom-primary-btn" %>
    <% end %>

    <div class="mt-3">
      <%= render 'layouts/shared_components/new_tel_owner' %>
    </div>
  </div>
</div>
