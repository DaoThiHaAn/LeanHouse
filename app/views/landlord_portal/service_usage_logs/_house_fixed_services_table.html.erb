<%# locals: (house:, summary:) %>
<%= turbo_frame_tag "house_fixed_services_table",
      data: {
        controller: "pagination-sync",
        pagination_sync_canonical_url_value: (@selected_service ? landlord_house_service_service_usage_logs_path(house, @selected_service) : landlord_house_service_usage_logs_path(house)),
        pagination_sync_default_params_value: { tab: "fixed" }.to_json,
        pagination_sync_query_params_value: ["tab", "month", "occupancy", "floor_id", "room_id", "service_id", "service_variant_id", "status"].to_json,
        pagination_sync_total_pages_selector_value: "[data-pagination-total-pages]",
        action: "turbo:frame-load->pagination-sync#updateUrl"
      } do %>
  <span hidden data-pagination-total-pages="<%= summary.paginated_items.respond_to?(:total_pages) ? summary.paginated_items.total_pages : 1 %>"></span>

  <!-- 1 Unified Stat Card -->
  <div class="card stat-card stat-card-blue shadow-sm p-3 mb-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
      <!-- Left: Total Amount -->
      <div class="d-flex align-items-center gap-3">
        <div class="stat-icon-wrap rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
          <span class="material-symbols-filled fs-2 text-primary">payments</span>
        </div>
        <div>
          <span class="stat-card-title fw-bold small d-block">
            <%= t("service_usage_logs.total_monthly_est") %>
          </span>
          <div class="d-flex align-items-baseline gap-1">
            <span class="fs-3 fw-bold text-primary stat-card-value">
              <%= number_with_delimiter(summary.total_amount) %>
            </span>
            <span class="fw-semibold stat-card-subtext small">đ</span>
          </div>
          <span class="text-secondary small d-block mt-1">
            <%= t("service_usage_logs.total_monthly_est_hint") %>
          </span>
        </div>
      </div>

      <!-- Divider on desktop -->
      <div class="vr d-none d-md-block opacity-25 my-1"></div>

      <!-- Right: Context pills -->
      <div class="d-flex align-items-center flex-wrap gap-2 gap-md-3">
        <!-- Period Badge -->
        <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-white shadow-xs">
          <span class="material-symbols-outlined text-secondary fs-5">calendar_month</span>
          <span class="small fw-semibold text-secondary"><%= t("service_usage_logs.billing_cycle") %>:</span>
          <span class="fw-bold"><%= summary.billing_month.strftime("%m/%Y") %></span>
        </div>

        <!-- Applied Rooms Badge -->
        <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-white shadow-xs">
          <span class="material-symbols-outlined text-primary fs-5">meeting_room</span>
          <span class="small fw-semibold text-secondary"><%= t("service_usage_logs.applied_rooms_count") %>:</span>
          <span class="badge bg-primary text-white rounded-pill px-2 py-1">
            <%= summary.total_rooms_count %>
          </span>
        </div>

        <!-- Billing Fulfillment Rate Badge -->
        <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-white shadow-xs">
          <span class="material-symbols-outlined text-success fs-5">verified</span>
          <span class="small fw-semibold text-secondary"><%= t("service_usage_logs.status_billed") %>:</span>
          <span class="badge bg-success text-white rounded-pill px-2 py-1">
            <%= summary.billed_count %> / <%= summary.total_items_count %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <h2 class="mb-3 ms-1 fs-5 fw-bold text-dark"><%= t("service_usage_logs.house_fixed_summary_title") %></h2>

  <% if summary.items.empty? %>
    <div class="empty card bg-light text-center py-5 rounded-4 mx-auto">
      <span class="material-symbols-outlined text-secondary fs-1 mb-2">fact_check</span>
      <p class="fs-5 fw-bold mb-1">
        <%= summary.empty_filter? ? t("service_usage_logs.no_empty_rooms_with_fixed_services") : t("service_usage_logs.no_fixed_services_house") %>
      </p>
      <p class="text-secondary small"><%= t("service_usage_logs.no_fixed_services_house_hint") %></p>
    </div>

  <% else %>
    <div class="table-responsive bg-white rounded-3 shadow-sm border mb-4">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3 py-3"><%= t("invoice.room") %></th>
            <th class="py-3"><%= t("service_usage_logs.service_and_note") %></th>
            <th class="py-3"><%= t("service_usage_logs.unit_and_price") %></th>
            <th class="py-3 text-center"><%= t("service_usage_logs.applied_quantity") %></th>
            <th class="text-end py-3"><%= t("service_usage_logs.monthly_estimate") %></th>
            <th class="text-center pe-3 py-3"><%= t("status") %></th>
          </tr>
        </thead>

        <tbody>
          <% summary.paginated_items.group_by { |item| item.room&.floor }.each do |floor, floor_items| %>
            <tr class="colspan">
              <td colspan="100" class="ps-3 py-2">
                <div class="d-flex align-items-center gap-2">
                  <span class="material-symbols-outlined fs-5">layers</span>
                  <span><%= floor&.title_name || t("service_usage_logs.unknown_floor") %></span>
                  <span class="badge bg-white text-secondary border rounded-pill fw-normal small">
                    <%= t("service_usage_logs.records_count", count: floor_items.size) %>
                  </span>
                </div>
              </td>
            </tr>

            <% room_groups = floor_items.group_by(&:room) %>
            <% room_groups.each_with_index do |(room, room_items), room_idx| %>
              <% has_next_room = room_idx < (room_groups.size - 1) %>
              <% room_items.each_with_index do |item, idx| %>
                <% is_last_in_room = idx == (room_items.size - 1) %>
                <tr class="<%= 'room-group-last-row' if is_last_in_room && has_next_room %>">
                  <% if idx.zero? %>
                    <td rowspan="<%= room_items.size %>" class="ps-3 py-3 align-middle border-end bg-light bg-opacity-25 <%= 'room-group-cell-divider' if has_next_room %>">
                      <%= link_to landlord_house_room_service_usage_logs_path(house, room, tab: "fixed", month: summary.billing_month_str),
                                  class: "text-decoration-none text-dark fw-bold d-inline-flex align-items-center gap-1",
                                  data: { turbo_frame: "_top" },
                                  title: t("service_usage_logs.view_room_logs") do %>
                        <span><%= room.title_name %></span>
                        <span class="material-symbols-outlined fs-6 text-primary">open_in_new</span>
                      <% end %>
                    </td>
                  <% end %>

                  <td class="py-3">
                    <p class="fw-medium"><%= item.name %></p>
                    <% if item.service&.note.present? %>
                      <p class="text-secondary small fst-italic mt-1"><%= item.service.note %></p>
                    <% end %>
                  </td>

                  <td class="py-3">
                    <p class="fw-medium">
                      <%= format_money(item.unit_price) %>
                      / <%= item.unit %>
                    </p>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill small mt-1">
                      <%= t("service_usage_logs.fixed_badge") %>
                    </span>
                  </td>

                  <td class="py-3 text-center">
                    <%= item.quantity_formatted %>
                  </td>

                  <td class="text-end py-3">
                    <p class="fw-bold custom-text-primary">
                      <%= format_money(item.amount) %>
                    </p>
                  </td>

                  <td class="text-center pe-3 py-3">
                    <% if item.billed? %>
                      <% if item.multiple_invoices? %>
                        <div class="d-flex flex-column align-items-center gap-1">
                          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                            <%= t("service_usage_logs.status_billed") %> (<%= t("service_usage_logs.multiple_invoices_badge", count: item.invoices.size) %>)
                          </span>
                          <div class="d-flex flex-column gap-1 mt-1 text-start">
                            <% item.invoice_details.each do |detail| %>
                              <div class="small d-flex align-items-center gap-1">
                                <%= link_to landlord_house_invoice_path(house, detail.invoice),
                                            class: "font-monospace fw-medium text-primary hover-underline",
                                            title: [detail.title.presence, detail.note.presence].compact.join(" - ").presence || detail.invoice.code,
                                            data: { turbo_frame: "_top" } do %>
                                  <%= detail.invoice.code %>
                                <% end %>
                                <span class="text-secondary small">(SL: <%= detail.quantity_formatted %>)</span>
                              </div>
                            <% end %>
                          </div>
                        </div>

                      <% else %>
                        <div class="d-flex flex-column align-items-center gap-2">
                          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                            <%= t("service_usage_logs.status_billed") %>
                          </span>
                          <% if item.invoice.present? %>
                            <%= link_to landlord_house_invoice_path(house, item.invoice),
                                        class: "small font-monospace fw-medium text-primary hover-underline",
                                        title: [item.invoice.title.presence, item.invoice.note.presence].compact.join(" - ").presence || item.invoice.code,
                                        data: { turbo_frame: "_top" } do %>
                              <%= item.invoice.code %>
                            <% end %>
                          <% end %>
                        </div>
                      <% end %>

                    <% elsif item.waived? %>
                      <span class="badge bg-light text-secondary border rounded-pill px-2 py-1">
                        <%= t("service_usage_logs.status_waived") %>
                      </span>

                    <% else %>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                        <%= t("service_usage_logs.status_draft") %>
                      </span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if summary.paginated_items.respond_to?(:total_pages) && summary.paginated_items.total_pages > 1 %>
      <div class="d-flex justify-content-center mt-3">
        <%= paginate summary.paginated_items %>
      </div>
    <% end %>
  <% end %>
<% end %>
