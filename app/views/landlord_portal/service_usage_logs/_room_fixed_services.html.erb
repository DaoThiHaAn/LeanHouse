<%# Locals: house, room, summary %>
<span hidden data-pagination-total-pages="<%= summary.paginated_items.respond_to?(:total_pages) ? summary.paginated_items.total_pages : 1 %>"></span>

<!-- Filter Toolbar by Billing Month & Actions -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <%= form_with url: landlord_house_room_service_usage_logs_path(house, room),
                method: :get,
                class: "d-flex gap-3 align-items-center flex-wrap",
                data: { turbo_frame: "room_service_logs_section", turbo_action: "advance" } do |f| %>
    <%= f.hidden_field :tab, value: "fixed" %>

    <div class="d-flex align-items-center gap-2">
      <%= f.label :month, "#{t('service_usage_logs.billing_cycle')}:", class: "fw-bold text-nowrap" %>
      <%= f.month_field :month,
                        value: summary.billing_month_str,
                        class: "form-control shadow-sm w-auto",
                        onchange: "this.form.requestSubmit()" %>
    </div>

    <% if params[:month].present? && params[:month] != Date.current.strftime("%Y-%m") %>
      <div>
        <%= link_to landlord_house_room_service_usage_logs_path(house, room, tab: "fixed"),
                    class: "btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" do %>
          <span class="material-symbols-filled fs-6">event_repeat</span>
          <span><%= t("service_usage_logs.reset_to_current_month") %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="d-flex align-items-center gap-2 ms-auto">
    <% if summary.has_active_invoice? %>
      <%= link_to landlord_house_invoice_path(house, summary.active_invoice),
                  class: "btn btn-outline-primary d-flex align-items-center gap-1 shadow-sm",
                  data: { turbo_frame: "_top" } do %>
        <span class="material-symbols-outlined fs-6">receipt_long</span>
        <span><%= t("service_usage_logs.view_invoice") %></span>
      <% end %>
    <% else %>
      <%= link_to new_landlord_house_invoice_path(house, room_id: room.id, billing_month: summary.billing_month_str),
                  class: "main-btn gap-2 shadow-sm",
                  data: { turbo_frame: "_top" } do %>
        <span class="material-symbols-outlined fs-4">add_notes</span>
        <span class="fs-6"><%= t("service_usage_logs.create_invoice_for_cycle") %></span>
      <% end %>
    <% end %>
  </div>
</div>

<!-- Cancelled Invoice Warning Notice (if applicable) -->
<% if summary.has_cancelled_invoices? && !summary.has_active_invoice? %>
  <div class="alert alert-warning py-2 px-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2 small rounded-3">
    <div class="d-flex align-items-center gap-2">
      <span class="material-symbols-outlined fs-5 text-warning-emphasis">warning</span>
      <span>
        <% if summary.single_cancelled_invoice? %>
          <%= t("service_usage_logs.cancelled_invoice_notice", code: summary.cancelled_invoices.first.code) %>
        <% else %>
          <%= t("service_usage_logs.cancelled_invoices_notice", count: summary.cancelled_invoices_count, codes: summary.cancelled_invoice_codes) %>
        <% end %>
      </span>
    </div>
    <% if summary.single_cancelled_invoice? %>
      <%= link_to landlord_house_invoice_path(house, summary.cancelled_invoices.first),
                  class: "btn btn-sm btn-outline-warning text-dark text-nowrap",
                  data: { turbo_frame: "_top" } do %>
        <%= t("service_usage_logs.view_cancelled_invoice") %>
      <% end %>
    <% else %>
      <%= link_to landlord_house_invoices_path(house, room_id: room.id, month: summary.billing_month_str, status: "cancelled"),
                  class: "btn btn-sm btn-outline-warning text-dark text-nowrap",
                  data: { turbo_frame: "_top" } do %>
        <%= t("service_usage_logs.view_cancelled_invoices_list") %>
      <% end %>
    <% end %>
  </div>
<% end %>

<!-- 1 Unified Colorful Stat Card (Consistent with vehicles & dashboard views) -->
<div class="card stat-card stat-card-blue shadow-sm p-3 mb-4">
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
    <!-- Left: Total Amount -->
    <div class="d-flex align-items-center gap-3">
      <div class="stat-icon-wrap rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
        <span class="material-symbols-filled fs-2 text-primary">payments</span>
      </div>
      <div>
        <span class="stat-card-title fw-bold small d-block">
          <%= summary.has_active_invoice? ? t("service_usage_logs.total_billed_in_period") : t("service_usage_logs.total_monthly_est") %>
        </span>
        <div class="d-flex align-items-baseline gap-1">
          <span class="fs-3 fw-bold text-primary stat-card-value">
            <%= number_with_delimiter(summary.total_amount) %>
          </span>
          <span class="fw-semibold stat-card-subtext small">đ</span>
        </div>
      </div>
    </div>

    <!-- Divider on desktop -->
    <div class="vr d-none d-md-block opacity-25 my-1"></div>

    <!-- Right: Context pills -->
    <div class="d-flex align-items-center flex-wrap gap-2 gap-md-3">
      <!-- Period Badge -->
      <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-white shadow-xs">
        <span class="material-symbols-outlined text-primary fs-5">calendar_month</span>
        <span class="small fw-semibold text-secondary"><%= t("service_usage_logs.billing_cycle") %>:</span>
        <span class="fw-bold text-dark"><%= summary.billing_month.strftime("%m/%Y") %></span>
      </div>

      <!-- Service Count Badge -->
      <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-white shadow-xs">
        <span class="material-symbols-outlined text-primary fs-5">room_service</span>
        <span class="small fw-semibold text-secondary"><%= t("service_usage_logs.applied_services") %>:</span>
        <span class="badge bg-primary text-white rounded-pill px-2 py-1">
          <%= summary.items.size %>
        </span>
      </div>

      <!-- Invoice Status Badge -->
      <% if summary.has_active_invoice? %>
        <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-white shadow-xs">
          <span class="material-symbols-outlined text-success fs-5">verified</span>
          <span class="small fw-semibold text-success"><%= t("service_usage_logs.invoice_code", code: summary.active_invoice.code) %></span>
        </div>
      <% elsif summary.has_cancelled_invoices? %>
        <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-white shadow-xs">
          <span class="material-symbols-outlined text-warning fs-5">warning</span>
          <span class="small fw-semibold text-warning-emphasis">
            <% if summary.single_cancelled_invoice? %>
              <%= t("service_usage_logs.cancelled_invoice_badge", code: summary.cancelled_invoices.first.code) %>
            <% else %>
              <%= t("service_usage_logs.cancelled_invoices_count_badge", count: summary.cancelled_invoices_count) %>
            <% end %>
          </span>
        </div>
      <% else %>
        <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-white shadow-xs">
          <span class="material-symbols-outlined text-secondary fs-5">schedule</span>
          <span class="small fw-semibold text-secondary"><%= t("service_usage_logs.unbilled_badge") %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if summary.items.empty? %>
  <!-- Empty State -->
  <div class="empty card shadow-sm rounded-4 p-5 text-center bg-light">
    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm p-3 mb-3 mx-auto">
      <span class="material-symbols-outlined fs-1 text-secondary">block</span>
    </div>
    <h5 class="fw-bold mb-2"><%= t("service_usage_logs.no_fixed_services_in_cycle") %></h5>
  </div>

<% else %>
  <!-- Table -->
  <div class="table-responsive bg-white rounded-2 shadow-sm border mb-4">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th class="ps-4 py-3"><%= t("service_usage_logs.service_and_note") %></th>
          <th class="py-3"><%= t("service_usage_logs.unit_and_price") %></th>
          <th class="py-3 text-center"><%= t("service_usage_logs.applied_quantity") %></th>
          <th class="text-end py-3"><%= t("service_usage_logs.monthly_estimate") %></th>
          <th class="text-center py-3"><%= t("status") %></th>
        </tr>
      </thead>

      <tbody>
        <% summary.paginated_items.each do |item| %>
          <tr>
            <td class="ps-4 py-3">
              <div class="fw-bold"><%= item.name %></div>
              <% if item.service&.note.present? %>
                <p class="text-secondary small fst-italic mt-1">
                  <%= item.service.note %>
                </p>
              <% end %>
            </td>

            <td class="py-3">
              <p>
                <%= format_money(item.unit_price) %>
                / <%= item.unit %>
              </p>
              <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill small mt-1">
                <%= t("service_usage_logs.fixed_badge") %>
              </span>
            </td>

            <td class="py-3 text-center">
              <span class="fw-semibold text-dark"><%= item.quantity %></span>
            </td>

            <td class="text-end py-3">
              <span class="fw-bold text-dark fs-6">
                <%= number_with_delimiter(item.amount) %> đ
              </span>
            </td>

            <td class="text-center py-3">
              <% if item.billed? %>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                  <%= t("service_usage_logs.billed_in_invoice_badge") %>
                </span>
              <% elsif item.waived? %>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                  <%= t("service_usage_logs.not_billed_in_invoice_badge") %>
                </span>
              <% else %>
                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1">
                  <%= t("service_usage_logs.estimated_badge") %>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>

      <% if !summary.paginated_items.respond_to?(:last_page?) || summary.paginated_items.last_page? %>
        <tfoot class="sum-footer">
          <tr>
            <td colspan="3" class="ps-4 py-3">
              <div class="d-inline-flex align-items-center gap-2">
                <div class="sum-icon-badge d-inline-flex align-items-center justify-content-center rounded-2">
                  <span class="material-symbols-outlined fs-5">functions</span>
                </div>
                <span class="fw-bold text-dark"><%= t("service_usage_logs.total_in_cycle") %></span>
              </div>
            </td>

            <td class="text-end py-3">
              <span class="fw-bold custom-text-primary fs-5 font-monospace">
                <%= number_with_delimiter(summary.total_amount) %> đ
              </span>
            </td>

            <td colspan="2" class="pe-4"></td>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>

  <% if summary.paginated_items.respond_to?(:total_pages) && summary.paginated_items.total_pages > 1 %>
    <div class="mt-4 d-flex justify-content-center">
      <%= paginate summary.paginated_items,
                   params: {
                     tab: "fixed",
                     month: summary.billing_month_str
                   } %>
    </div>
  <% end %>
<% end %>
