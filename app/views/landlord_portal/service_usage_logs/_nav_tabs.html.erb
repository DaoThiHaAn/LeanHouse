<%# locals: (current_tab:, real_time_url:, fixed_url:, unconfirmed_count:, fixed_count:, new_log_url: nil, real_time_title: nil, fixed_title: nil) %>
<% real_time_title ||= t("service_usage_logs.tab_real_time") %>
<% fixed_title ||= t("service_usage_logs.tab_fixed") %>
<div class="d-flex align-items-center gap-3 flex-wrap w-100">
  <!-- 2 Tabs: Real-time and Fixed -->
  <div class="d-inline-flex bg-light p-1 rounded-pill border gap-1 shadow-sm fs-5">
    <%= link_to real_time_url,
                class: "log-tab d-flex align-items-center gap-1 px-3 py-1 rounded-pill small text-decoration-none fw-semibold transition #{usage_logs_tab_class('real_time', current_tab)}",
                data: { turbo_action: "advance" } do %>
      <span class="material-symbols-filled fs-5">speed</span>
      <span><%= real_time_title %></span>
      <%= render "unconfirmed_badge", id: "house_unconfirmed_badge", count: unconfirmed_count %>
    <% end %>

    <%= link_to fixed_url,
                class: "log-tab d-flex align-items-center gap-1 px-3 py-1 rounded-pill small text-decoration-none fw-semibold transition #{usage_logs_tab_class('fixed', current_tab)}",
                data: { turbo_action: "advance" } do %>
      <span class="material-symbols-filled fs-5">lock</span>
      <span><%= fixed_title %></span>
      <% if fixed_count.to_i > 0 %>
        <span class="badge rounded-pill ms-1"><%= fixed_count %></span>
      <% end %>
    <% end %>
  </div>

  <button type="button"
          class="manual-btn d-flex align-items-center gap-1 ms-auto"
          data-bs-toggle="modal" data-bs-target="#serviceGuideModal">
    <span class="material-symbols-outlined fs-6">help_outline</span>
    <span><%= t("service.guide.btn_title") %></span>
  </button>

  <% if real_time_tab?(current_tab) && new_log_url.present? %>
    <%= link_to new_log_url,
        class: "main-btn shadow-sm gap-2" do %>
      <span class="material-symbols-outlined fs-3">variable_add</span>
      <span class="fs-5"><%= t("invoice.new_meter_log") %></span>
    <% end %>
  <% end %>
</div>
