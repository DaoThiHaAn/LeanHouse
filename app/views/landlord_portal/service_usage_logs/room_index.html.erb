<% content_for :title, "#{t('service_usage_logs.room_logs_title', room: @room.name)} - #{@house.name}" %>
<% provide :container_width, "h-100" %>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item">
      <%= link_to landlord_house_rooms_path(@house), class: "text-decoration-none d-inline-flex align-items-center gap-1" do %>
        <span class="material-symbols-outlined fs-6">arrow_back</span>
        <span><%= t("service_usage_logs.back_to_rooms") %></span>
      <% end %>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
      <%= t("form.room.self") %> <%= @room.name %>
    </li>
  </ol>
</nav>

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
  <div>
    <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
      <span class="material-symbols-outlined text-primary">electric_meter</span>
      <span><%= t("service_usage_logs.room_logs_title", room: @room.name) %></span>
    </h2>
    <p class="text-secondary mb-0"><%= t("service_usage_logs.room_logs_subtitle") %></p>
  </div>

  <div class="d-flex align-items-center gap-2">
    <% if @unconfirmed_count > 0 %>
      <%= button_to confirm_all_landlord_house_room_service_usage_logs_path(@house, @room),
                    method: :patch,
                    data: { turbo_confirm: t("service_usage_logs.confirm_all_room_prompt", count: @unconfirmed_count, room: @room.name) },
                    class: "btn btn-success d-flex align-items-center gap-1 shadow-sm" do %>
        <span class="material-symbols-outlined fs-6">done_all</span>
        <span><%= t("service_usage_logs.confirm_all_room_btn", count: @unconfirmed_count) %></span>
      <% end %>
    <% end %>

    <%= link_to new_landlord_house_service_usage_log_path(@house, room_id: @room.id, from_room: true),
                class: "btn btn-primary d-flex align-items-center gap-1 shadow-sm" do %>
      <span class="material-symbols-outlined fs-6">add</span>
      <span><%= t("service_usage_logs.record_reading") %></span>
    <% end %>
  </div>
</div>

<!-- Filter Toolbar -->
<div class="card bg-light border-0 rounded-3 p-3 mb-4">
  <%= form_with url: filtered_landlord_house_service_usage_logs_path(@house),
                method: :get,
                class: "d-flex gap-3 align-items-center flex-wrap",
                data: { turbo_frame: "room_logs_table" } do |f| %>
    <%= f.hidden_field :room_id, value: @room.id %>

    <!-- Filter Month -->
    <div class="d-flex align-items-center gap-2">
      <%= f.label :month, "#{t('common.month')}:", class: "fw-bold text-nowrap" %>
      <%= f.month_field :month,
                        value: params[:month],
                        class: "form-control shadow-sm w-auto",
                        onchange: "this.form.requestSubmit()" %>
    </div>

    <!-- Filter Service -->
    <div class="d-flex align-items-center gap-2">
      <%= f.label :service_id, "#{t('form.service.self')}:", class: "fw-bold text-nowrap" %>
      <%= f.select :service_id,
                   [[t("service_usage_logs.all_services"), ""]] + @services.map { |s| [s.name, s.id] },
                   { selected: params[:service_id] },
                   class: "form-select shadow-sm w-auto",
                   onchange: "this.form.requestSubmit()" %>
    </div>

    <!-- Filter Status -->
    <div class="d-flex align-items-center gap-2">
      <%= f.label :status, "#{t('common.status')}:", class: "fw-bold text-nowrap" %>
      <%= f.select :status,
                   [
                     [t("all"), ""],
                     [t("invoice.status_unconfirmed"), "unconfirmed"],
                     [t("invoice.status_confirmed"), "confirmed"],
                     [t("invoice.status_billed"), "billed"]
                   ],
                   { selected: params[:status] },
                   class: "form-select shadow-sm w-auto",
                   onchange: "this.form.requestSubmit()" %>
    </div>

    <!-- Reset filter button if filtered -->
    <% if params[:month].present? || params[:service_id].present? || params[:status].present? %>
      <div>
        <%= link_to landlord_house_room_service_usage_logs_path(@house, @room),
                    class: "btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" do %>
          <span class="material-symbols-outlined fs-6">restart_alt</span>
          <span><%= t("service_usage_logs.reset_filter") %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<!-- Logs Table Partial -->
<%= render "room_logs_table", house: @house, room: @room, logs: @logs %>
