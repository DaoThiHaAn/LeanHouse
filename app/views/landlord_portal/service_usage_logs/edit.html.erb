<% content_for :title, "#{t('invoice.edit_meter_log')} - #{@house.name}" %>

<div class="container py-3 usage-log-form-wrapper">
  <div class="card shadow-sm">
    <div class="card-header py-4 border-bottom d-flex justify-content-between align-items-center">
      <h1>
        <%= t("invoice.edit_meter_log_title", service: @log.service_name, room: @log.room.title_name) %>
      </h1>
      <%= link_to t("invoice.actions.back"), (params[:from_room] == "true" ? landlord_house_room_service_usage_logs_path(@house, @log.room) : landlord_house_service_usage_logs_path(@house, month: @log.billing_month.strftime("%Y-%m"))), class: "btn btn-sm btn-outline-secondary" %>
    </div>
    <div class="card-body p-4">
      <%= form_with model: [:landlord, @house, @log], local: true,
                    data: {
                      controller: "loading service-log-form",
                      loading_text_value: "#{t('saving')}...",
                      action: "submit->loading#submit"
                    } do |f| %>
        <%= hidden_field_tag :from_room, "true" if params[:from_room] == "true" %>
        <% if @log.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @log.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :prev_reading, t("invoice.prev_reading_label", unit: @log.unit), class: "form-label fw-semibold" %>
            <%= f.number_field :prev_reading, class: "form-control shadow-sm", required: true, min: 0,
                               data: { service_log_form_target: "prevReadingInput", action: "input->service-log-form#updateMinReading" } %>
          </div>

          <div class="col-md-6">
            <%= f.label :latest_reading, t("invoice.latest_reading_label", unit: @log.unit), class: "form-label fw-semibold text-primary" %>
            <%= f.number_field :latest_reading, class: "form-control shadow-sm fw-bold", required: true, min: @log.prev_reading,
                               data: { service_log_form_target: "latestReadingInput" } %>
          </div>

          <div class="col-md-12">
            <%= f.label :reading_photo, t("invoice.meter_photo_update_hint"), class: "form-label fw-semibold" %>
            <%= f.file_field :reading_photo, accept: "image/*", class: "form-control shadow-sm" %>
            <% if @log.reading_photo.attached? %>
              <div class="mt-3 ms-3">
                <span class="text-secondary small"><%= t("invoice.current_photo") %></span><br>
                <%= image_tag @log.reading_photo, alt: t("invoice.meter_photo"),
                    width: "400px",
                    class: "rounded border shadow-sm mt-1" %>
              </div>
            <% end %>
          </div>

          <div class="col-12 mt-3">
            <div class="form-check">
              <%= f.check_box :is_confirmed, class: "form-check-input", id: "is_confirmed_check" %>
              <%= f.label :is_confirmed, t("invoice.confirm_and_close"), class: "form-check-label fw-semibold", for: "is_confirmed_check" %>
            </div>
          </div>

          <div class="col-12 mt-4 text-end">
            <%= f.button type: :submit,
                         class: "custom-primary-btn px-4 shadow-sm d-inline-flex align-items-center justify-content-center gap-2",
                         data: { loading_target: "button" } do %>
              <span data-loading-target="text"><%= t("invoice.update_meter_log_btn") %></span>
              <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">
                progress_activity
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
