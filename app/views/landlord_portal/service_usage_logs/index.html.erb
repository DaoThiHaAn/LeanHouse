<% content_for :title, "#{@selected_service ? t('service_usage_logs.service_title', service: @selected_service.name) : t('invoice.meter_logs')} - #{@house.name}" %>
<% provide :container_width, "h-100" %>

<% if @selected_service %>
  <!-- Breadcrumb back to Services -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item">
        <%= link_to landlord_house_services_path(@house), class: "text-decoration-none d-inline-flex align-items-center gap-1" do %>
          <span class="material-symbols-outlined fs-6">arrow_back</span>
          <span><%= t("form.service.list") %></span>
        <% end %>
      </li>
      <li class="breadcrumb-item active" aria-current="page">
        <%= @selected_service.name %>
      </li>
    </ol>
  </nav>
<% end %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 pb-2 border-bottom">
  <div>
    <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
      <span class="material-symbols-outlined text-primary">electric_meter</span>
      <span><%= @selected_service ? t("service_usage_logs.service_title", service: @selected_service.name) : t("invoice.meter_logs_title") %></span>
    </h2>
    <p class="text-secondary mb-0">
      <%= @selected_service ? t("service_usage_logs.service_subtitle", service: @selected_service.name) : t("invoice.meter_logs_subtitle") %>
    </p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <%= link_to new_landlord_house_service_usage_log_path(@house, month: @billing_month.strftime("%Y-%m")), class: "btn btn-primary d-flex align-items-center gap-1 shadow-sm" do %>
      <span class="material-symbols-outlined fs-6">add</span>
      <span><%= t("invoice.new_meter_log") %></span>
    <% end %>
  </div>
</div>

  <!-- Toolbar lọc tháng, phòng, biến thể và trạng thái -->
  <div class="card bg-light border-0 rounded-3 p-3 mb-4">
    <%= form_with url: filtered_landlord_house_service_usage_logs_path(@house),
                  method: :get,
                  class: "d-flex gap-3 align-items-center flex-wrap",
                  data: { turbo_frame: "logs_table", turbo_action: "advance" } do |f| %>

      <% if @selected_service %>
        <%= f.hidden_field :service_id, value: @selected_service.id %>
      <% end %>

      <!-- Chọn tháng -->
      <div class="d-flex align-items-center gap-2">
        <%= f.label :month, "#{t('common.month')}:", class: "fw-bold text-nowrap" %>
        <%= f.month_field :month, value: @billing_month.strftime("%Y-%m"), class: "form-control shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
      </div>

      <!-- Chọn phòng -->
      <div class="d-flex align-items-center gap-2">
        <%= f.label :room_id, "#{t('invoice.room')}:", class: "fw-bold text-nowrap" %>
        <%= f.select :room_id, [[t("invoice.all_rooms"), ""]] + @house.rooms.active.sorted.map { |r| [r.title_name, r.id] }, { selected: params[:room_id] }, class: "form-select shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
      </div>

      <!-- Nếu có chọn dịch vụ cụ thể, cho lọc theo biến thể của dịch vụ đó -->
      <% if @selected_service && @service_variants.any? %>
        <div class="d-flex align-items-center gap-2">
          <%= f.label :service_variant_id, "#{t('service_usage_logs.variant')}:", class: "fw-bold text-nowrap" %>
          <%= f.select :service_variant_id, [[t("service_usage_logs.all_variants"), ""]] + @service_variants.map { |v| ["#{v.human_unit} - #{number_with_delimiter(v.fee)}đ", v.id] }, { selected: params[:service_variant_id] }, class: "form-select shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
        </div>
      <% end %>

      <!-- Trạng thái duyệt -->
      <div class="d-flex align-items-center gap-2">
        <%= f.label :status, "#{t('common.status')}:", class: "fw-bold text-nowrap" %>
        <%= f.select :status, [
              [t("all"), ""],
              [t("invoice.status_unconfirmed"), "unconfirmed"],
              [t("invoice.status_confirmed"), "confirmed"],
              [t("invoice.status_billed"), "billed"]
            ], { selected: params[:status] }, class: "form-select shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
      </div>

      <% if @unconfirmed_count > 0 %>
        <div class="ms-auto">
          <%= button_to confirm_all_landlord_house_service_usage_logs_path(@house, month: @billing_month.strftime("%Y-%m")), method: :patch, data: { turbo_confirm: t("invoice.confirm_all_prompt", count: @unconfirmed_count) }, class: "btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm" do %>
            <span class="material-symbols-outlined fs-6">done_all</span> <%= t("invoice.confirm_all", count: @unconfirmed_count) %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= render "logs_table", house: @house, logs: @logs, billing_month: @billing_month %>
