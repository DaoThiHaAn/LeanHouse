<% content_for :title, "#{@selected_service ? t('service_usage_logs.service_title', service: @selected_service.name) : (@current_tab == 'fixed' ? t('service_usage_logs.tab_fixed') : t('invoice.meter_logs'))} - #{@house.name}" %>

<% if @selected_service %>
  <!-- Breadcrumb back to Services -->
  <nav aria-label="Breadcrumb navigation" class="mb-4">
    <ol class="breadcrumb mb-0">
      <li class="breadcrumb-item">
        <%= back_link_to landlord_house_services_path(@house), t("service_usage_logs.back_to_list") %>
      </li>
      <li class="breadcrumb-item active align-self-center" aria-current="page">
        <%= @selected_service.name %>
      </li>
    </ol>
  </nav>
<% end %>

<%= turbo_frame_tag "house_service_logs_section",
      data: {
        controller: "pagination-sync",
        pagination_sync_canonical_url_value: landlord_house_service_usage_logs_path(@house),
        pagination_sync_default_params_value: (@selected_service ? { service_id: @selected_service.id.to_s, tab: @current_tab, month: @billing_month.strftime("%Y-%m") } : { tab: @current_tab, month: @billing_month.strftime("%Y-%m") }).to_json,
        pagination_sync_query_params_value: ["tab", "month", "floor_id", "room_id", "service_id", "service_variant_id", "status"].to_json,
        pagination_sync_total_pages_selector_value: "[data-pagination-total-pages]",
        action: "turbo:frame-load->pagination-sync#updateUrl"
      } do %>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 pb-2 border-bottom">
    <div>
      <h1 class="mb-2 d-flex align-items-center gap-2">
        <span class="material-symbols-filled fs-3"><%= @current_tab == 'fixed' ? 'lock' : 'electric_meter' %></span>
        <span><%= @selected_service ? t("service_usage_logs.service_title", service: @selected_service.name) : (@current_tab == 'fixed' ? t("service_usage_logs.house_fixed_summary_title") : t("invoice.meter_logs_title")) %></span>
      </h1>
      <p class="text-secondary mb-0">
        <%= @selected_service ? t("service_usage_logs.service_subtitle", service: @selected_service.name) : (@current_tab == 'fixed' ? t("service_usage_logs.house_fixed_summary_subtitle") : t("invoice.meter_logs_subtitle")) %>
      </p>
    </div>

    <div class="d-flex align-items-center gap-3 flex-wrap">
      <!-- 2 Tabs: Real-time and Fixed -->
      <div class="d-inline-flex bg-light p-1 rounded-pill border gap-1 shadow-sm fs-5">
        <%= link_to landlord_house_service_usage_logs_path(@house, tab: "real_time", month: @billing_month.strftime("%Y-%m"), service_id: @selected_service&.id),
                    class: "log-tab d-flex align-items-center gap-1 px-3 py-1 rounded-pill small text-decoration-none fw-semibold transition #{@current_tab == 'real_time' ? 'active shadow-sm' : 'text-secondary'}",
                    data: { turbo_action: "advance" } do %>
          <span class="material-symbols-filled fs-5">speed</span>
          <span><%= t("service_usage_logs.tab_real_time") %></span>
          <%= render "unconfirmed_badge", id: "house_unconfirmed_badge", count: @unconfirmed_count %>
        <% end %>

        <%= link_to landlord_house_service_usage_logs_path(@house, tab: "fixed", month: @billing_month.strftime("%Y-%m"), service_id: @selected_service&.id),
                    class: "log-tab d-flex align-items-center gap-1 px-3 py-1 rounded-pill small text-decoration-none fw-semibold transition #{@current_tab == 'fixed' ? 'active shadow-sm' : 'text-secondary'}",
                    data: { turbo_action: "advance" } do %>
          <span class="material-symbols-filled fs-5">lock</span>
          <span><%= t("service_usage_logs.tab_fixed") %></span>
          <% if @fixed_services_count.to_i > 0 %>
            <span class="badge rounded-pill ms-1"><%= @fixed_services_count %></span>
          <% end %>
        <% end %>
      </div>

      <button type="button"
              class="manual-btn d-flex align-items-center gap-1"
              data-bs-toggle="modal" data-bs-target="#serviceGuideModal">
        <span class="material-symbols-outlined fs-6">help_outline</span>
        <span><%= t("service.guide.btn_title") %></span>
      </button>

      <% if @current_tab == "real_time" %>
        <%= link_to new_landlord_house_service_usage_log_path(@house, month: @billing_month.strftime("%Y-%m")),
            class: "main-btn shadow-sm gap-2" do %>
          <span class="material-symbols-outlined fs-4">add</span>
          <span class="fs-5"><%= t("invoice.new_meter_log") %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @current_tab == "fixed" %>
    <%= render "house_fixed_services",
               house: @house,
               summary: @fixed_services_summary,
               fixed_services: @fixed_services,
               fixed_variants: @fixed_variants,
               selected_service: @selected_service %>
  <% else %>
    <!-- Toolbar lọc tháng, tầng, phòng, biến thể và trạng thái -->
    <div class="card bg-light border-0 rounded-3 p-3 mb-5">
      <%
        active_rooms = @house.rooms.active.sorted
        available_rooms = if params[:floor_id].present?
          active_rooms.select { |r| r.floor_id.to_s == params[:floor_id].to_s }
        else
          active_rooms
        end
      %>
      <%= form_with url: filtered_landlord_house_service_usage_logs_path(@house),
                    method: :get,
                    class: "d-flex gap-3 align-items-center flex-wrap",
                    data: {
                      controller: "filter-floor-room",
                      filter_floor_room_rooms_value: active_rooms.map { |r| { id: r.id.to_s, name: r.title_name, floor_id: r.floor_id.to_s } }.to_json,
                      filter_floor_room_all_rooms_label_value: t("invoice.all_rooms"),
                      turbo_frame: "logs_table",
                      turbo_action: "advance"
                    } do |f| %>

        <%= f.hidden_field :tab, value: "real_time" %>

        <% if @selected_service %>
          <%= f.hidden_field :service_id, value: @selected_service.id %>
        <% end %>

        <!-- Chọn tháng -->
        <div class="d-flex align-items-center gap-2">
          <%= f.label :month, "#{t('month')}:", class: "fw-bold text-nowrap" %>
          <%= f.month_field :month, value: @billing_month.strftime("%Y-%m"), class: "form-control shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
        </div>

        <!-- Chọn tầng -->
        <div class="d-flex align-items-center gap-2">
          <%= f.label :floor_id, "#{t('service_usage_logs.floor')}:", class: "fw-bold text-nowrap" %>
          <%= f.select :floor_id,
                       [[t("service_usage_logs.all_floors"), ""]] + @house.floors.pos_order.map { |fl| [fl.title_name, fl.id] },
                       { selected: params[:floor_id] },
                       class: "form-select shadow-sm w-auto",
                       data: {
                         filter_floor_room_target: "floor",
                         action: "change->filter-floor-room#floorChanged"
                       } %>
        </div>

        <!-- Chọn phòng -->
        <div class="d-flex align-items-center gap-2">
          <%= f.label :room_id, "#{t('invoice.room')}:", class: "fw-bold text-nowrap" %>
          <%= f.select :room_id,
                       [[t("invoice.all_rooms"), ""]] + available_rooms.map { |r| [r.title_name, r.id] },
                       { selected: params[:room_id] },
                       class: "form-select shadow-sm w-auto",
                       data: {
                         filter_floor_room_target: "room",
                         action: "change->filter-floor-room#roomChanged"
                       } %>
        </div>

        <!-- Nếu có chọn dịch vụ cụ thể, cho lọc theo biến thể của dịch vụ đó -->
        <% if @selected_service && @service_variants.any? %>
          <div class="d-flex align-items-center gap-2">
            <%= f.label :service_variant_id, "#{t('service_usage_logs.variant')}:", class: "fw-bold text-nowrap" %>
            <%= f.select :service_variant_id, [[t("service_usage_logs.all_variants"), ""]] + @service_variants.map { |v| ["#{v.human_unit} - #{number_with_delimiter(v.fee)}đ", v.id] }, { selected: params[:service_variant_id] }, class: "form-select shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
          </div>
        <% end %>

        <!-- Trạng thái duyệt -->
        <div class="d-flex align-items-center gap-2">
          <%= f.label :status, "#{t('status')}:", class: "fw-bold text-nowrap" %>
          <%= f.select :status, [
                [t("all"), ""],
                [t("invoice.status_unconfirmed"), "unconfirmed"],
                [t("invoice.status_confirmed"), "confirmed"],
                [t("invoice.status_billed"), "billed"]
              ], { selected: params[:status] }, class: "form-select shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
        </div>

        <%= render "house_confirm_all_btn", house: @house, billing_month: @billing_month, selected_service: @selected_service, count: @unconfirmed_count %>
      <% end %>
    </div>

    <h2 class="mb-3 ms-3"><%= t("service_usage_logs.list") %></h2>

    <%= render "logs_table", house: @house, logs: @logs, billing_month: @billing_month %>
  <% end %>

<% end %>

<%= turbo_frame_tag "usage_log_detail_modal" %>
<%= render "landlord_portal/services/guide_modal" %>
