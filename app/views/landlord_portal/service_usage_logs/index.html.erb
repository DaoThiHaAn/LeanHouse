<% content_for :title, "Chỉ số Điện & Nước - #{@house.name}" %>
<% provide :container_width, "h-100" %>

<div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
  <div>
    <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
      <span class="material-symbols-outlined text-primary">electric_meter</span>
      Ghi nhận Chỉ số Điện & Nước
    </h2>
    <p class="text-muted mb-0">Quản lý và phê duyệt chỉ số công tơ do khách gửi hoặc chủ trọ ghi nhận hàng tháng.</p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to new_landlord_house_service_usage_log_path(@house, month: @billing_month.strftime("%Y-%m")), class: "btn btn-primary d-flex align-items-center gap-1 shadow-sm" do %>
      <span class="material-symbols-outlined fs-6">add</span> Ghi chỉ số mới
    <% end %>
  </div>
</div>

<!-- Toolbar lọc tháng, phòng và trạng thái -->
<div class="card bg-light border-0 rounded-3 p-3 mb-4">
  <%= form_with url: filtered_landlord_house_service_usage_logs_path(@house),
                method: :get,
                class: "d-flex gap-3 align-items-center flex-wrap",
                data: { turbo_frame: "logs_table" } do |f| %>
    
    <!-- Chọn tháng -->
    <div class="d-flex align-items-center gap-2">
      <%= f.label :month, "Tháng:", class: "fw-bold text-nowrap" %>
      <%= f.month_field :month, value: @billing_month.strftime("%Y-%m"), class: "form-control shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
    </div>

    <!-- Chọn phòng -->
    <div class="d-flex align-items-center gap-2">
      <%= f.label :room_id, "Phòng:", class: "fw-bold text-nowrap" %>
      <%= f.select :room_id, [["Tất cả các phòng", ""]] + @house.rooms.active.sorted.map { |r| [r.title_name, r.id] }, { selected: params[:room_id] }, class: "form-select shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
    </div>

    <!-- Trạng thái duyệt -->
    <div class="d-flex align-items-center gap-2">
      <%= f.label :status, "Trạng thái:", class: "fw-bold text-nowrap" %>
      <%= f.select :status, [["Tất cả", ""], ["Chờ xác nhận", "unconfirmed"], ["Đã xác nhận", "confirmed"]], { selected: params[:status] }, class: "form-select shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
    </div>

    <% unconfirmed_count = @house.service_usage_logs.for_month(@billing_month).unconfirmed.count %>
    <% if unconfirmed_count > 0 %>
      <div class="ms-auto">
        <%= button_to confirm_all_landlord_house_service_usage_logs_path(@house, month: @billing_month.strftime("%Y-%m")), method: :patch, data: { turbo_confirm: "Xác nhận toàn bộ #{unconfirmed_count} chỉ số trong tháng này?" }, class: "btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm" do %>
          <span class="material-symbols-outlined fs-6">done_all</span> Duyệt nhanh tất cả (<%= unconfirmed_count %>)
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

<%= render "logs_table", house: @house, logs: @logs, billing_month: @billing_month %>

