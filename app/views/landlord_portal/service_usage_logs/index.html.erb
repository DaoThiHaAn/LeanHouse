<!-- Service usage log of the whole house page -->
<% tab_meta = house_usage_logs_tab_meta(@current_tab) %>
<% content_for :title, "#{tab_meta[:page_title]} - #{@house.name}" %>

<%= turbo_frame_tag "house_service_logs_section",
      data: {
        controller: "pagination-sync",
        pagination_sync_canonical_url_value: landlord_house_service_usage_logs_path(@house),
        pagination_sync_default_params_value: { tab: @current_tab, month: @billing_month.strftime("%Y-%m") }.to_json,
        pagination_sync_query_params_value: ["tab", "month", "floor_id", "room_id", "status"].to_json,
        pagination_sync_total_pages_selector_value: "[data-pagination-total-pages]",
        action: "turbo:frame-load->pagination-sync#updateUrl"
      } do %>

  <div class="d-flex flex-column gap-4 mb-3 pb-3 border-bottom">
    <div class="d-flex flex-column flex-md-row gap-2 justify-content-between align-items-center">
      <div>
        <h1 class="mb-2"><%= tab_meta[:title] %></h1>
        <p class="text-secondary">
          <%= tab_meta[:subtitle] %>
        </p>
      </div>

      <%= back_link_to landlord_house_service_usage_logs_path(@house), t("service.back") %>
    </div>

    <%= render "nav_tabs",
               current_tab: @current_tab,
               real_time_url: landlord_house_service_usage_logs_path(@house, tab: "real_time", month: @billing_month.strftime("%Y-%m")),
               fixed_url: landlord_house_service_usage_logs_path(@house, tab: "fixed", month: @billing_month.strftime("%Y-%m")),
               unconfirmed_count: @unconfirmed_count,
               fixed_count: @fixed_services_count,
               new_log_url: new_landlord_house_service_usage_log_path(@house, month: @billing_month.strftime("%Y-%m")) %>
  </div>

  <% if fixed_tab? %>
    <%= render "house_fixed_services",
               house: @house,
               summary: @fixed_services_summary,
               fixed_services: @fixed_services,
               fixed_variants: @fixed_variants,
               selected_service: nil %>

  <% else %>
    <!-- Toolbar lọc tháng, tầng, phòng và trạng thái toàn nhà -->
    <div class="card bg-light border-0 rounded-3 p-3 mb-5">
      <%= form_with url: filtered_landlord_house_service_usage_logs_path(@house),
                    method: :get,
                    class: "d-flex gap-3 align-items-center flex-wrap",
                    data: {
                      controller: "filter-floor-room",
                      filter_floor_room_rooms_value: @house.rooms.active.sorted.map { |r| { id: r.id.to_s, name: r.title_name, floor_id: r.floor_id.to_s } }.to_json,
                      filter_floor_room_all_rooms_label_value: t("invoice.all_rooms"),
                      turbo_frame: "logs_table",
                      turbo_action: "advance"
                    } do |f| %>

        <%= f.hidden_field :tab, value: "real_time" %>

        <!-- Chọn tháng -->
        <div class="d-flex align-items-center gap-2">
          <%= f.label :month, "#{t('month')}:", class: "fw-bold text-nowrap" %>
          <%= f.month_field :month, value: @billing_month.strftime("%Y-%m"), class: "form-control shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
        </div>

        <!-- Chọn tầng & phòng -->
        <%= render "floor_room_selects", f: f, house: @house %>

        <!-- Trạng thái duyệt -->
        <div class="d-flex align-items-center gap-2">
          <%= f.label :status, "#{t('status')}:", class: "fw-bold text-nowrap" %>
          <%= f.select :status, [
                [t("all"), ""],
                [t("invoice.status_unconfirmed"), "unconfirmed"],
                [t("invoice.status_confirmed"), "confirmed"],
                [t("invoice.status_billed"), "billed"]
              ], { selected: params[:status] }, class: "form-select shadow-sm w-auto", onchange: "this.form.requestSubmit()" %>
        </div>

        <%= render "house_confirm_all_btn", house: @house, billing_month: @billing_month, selected_service: nil, count: @unconfirmed_count %>
      <% end %>
    </div>

    <h2 class="mb-3 ms-3"><%= t("service_usage_logs.list") %></h2>

    <%= render "logs_table", house: @house, logs: @logs, billing_month: @billing_month %>
  <% end %>

<% end %>

<%= turbo_frame_tag "usage_log_detail_modal" %>
<%= render "landlord_portal/services/guide_modal" %>
