<% content_for :title, "Ghi nhận Chỉ số mới - #{@house.name}" %>
<% provide :container_width, "h-100" %>

<div class="container py-3" style="max-width: 700px;">
  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h4 class="card-title fw-bold mb-0 d-flex align-items-center gap-2">
        <span class="material-symbols-outlined text-primary">electric_meter</span>
        Ghi nhận Chỉ số Điện & Nước
      </h4>
      <%= link_to "Quay lại", landlord_house_service_usage_logs_path(@house, month: @billing_month.strftime("%Y-%m")), class: "btn btn-sm btn-outline-secondary" %>
    </div>
    <div class="card-body p-4">
      <%= form_with model: [:landlord, @house, @log], local: true do |f| %>
        <% if @log.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @log.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= f.hidden_field :service_id %>
        <%= f.hidden_field :service_variant_id %>
        <%= f.hidden_field :service_name %>
        <%= f.hidden_field :unit %>
        <%= f.hidden_field :unit_price %>

        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :billing_month, "Tháng tính toán", class: "form-label fw-semibold" %>
            <%= f.month_field :billing_month, value: @billing_month.strftime("%Y-%m"), class: "form-control shadow-sm", required: true %>
          </div>

          <div class="col-md-6">
            <%= f.label :room_id, "Phòng áp dụng", class: "form-label fw-semibold" %>
            <%= f.collection_select :room_id, @house.rooms.active.sorted, :id, :title_name, { selected: @room&.id }, class: "form-select shadow-sm", required: true %>
          </div>

          <div class="col-md-6">
            <%= f.label :service_variant_id, "Dịch vụ đo đạc", class: "form-label fw-semibold" %>
            <select name="service_usage_log[service_variant_id]" class="form-select shadow-sm" onchange="this.form.submit()">
              <% @house.service_variants.where(is_real_time: true).each do |v| %>
                <option value="<%= v.id %>" <%= 'selected' if @log.service_variant_id == v.id %>>
                  <%= v.service.name %> (<%= v.human_unit %> - <%= number_to_currency(v.fee, unit: 'đ', precision: 0) %>)
                </option>
              <% end %>
            </select>
          </div>

          <div class="col-md-6">
            <%= f.label :prev_reading, "Chỉ số kỳ trước (#{ @log.unit })", class: "form-label fw-semibold" %>
            <%= f.number_field :prev_reading, class: "form-control shadow-sm font-monospace", required: true %>
          </div>

          <div class="col-md-6">
            <%= f.label :latest_reading, "Chỉ số kỳ này (#{ @log.unit })", class: "form-label fw-semibold text-primary" %>
            <%= f.number_field :latest_reading, class: "form-control shadow-sm font-monospace fw-bold", placeholder: "Nhập số trên đồng hồ", required: true %>
          </div>

          <div class="col-md-6">
            <%= f.label :reading_photo, "Ảnh chụp đồng hồ công tơ", class: "form-label fw-semibold" %>
            <%= f.file_field :reading_photo, accept: "image/*", class: "form-control shadow-sm" %>
          </div>

          <div class="col-md-6">
            <%= f.label :start_date, "Ngày bắt đầu kỳ", class: "form-label fw-semibold" %>
            <%= f.date_field :start_date, value: @log.start_date || @billing_month.beginning_of_month, class: "form-control shadow-sm" %>
          </div>

          <div class="col-md-6">
            <%= f.label :end_date, "Ngày kết thúc kỳ", class: "form-label fw-semibold" %>
            <%= f.date_field :end_date, value: @log.end_date || @billing_month.end_of_month, class: "form-control shadow-sm" %>
          </div>

          <div class="col-12 mt-3">
            <div class="form-check">
              <%= f.check_box :is_confirmed, checked: true, class: "form-check-input", id: "is_confirmed_check" %>
              <%= f.label :is_confirmed, "Xác nhận và chốt số ngay lập tức", class: "form-check-label fw-semibold", for: "is_confirmed_check" %>
            </div>
          </div>

          <div class="col-12 mt-4 text-end">
            <%= f.submit "Lưu Chỉ Số", class: "btn btn-primary px-4 py-2 fw-semibold" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

