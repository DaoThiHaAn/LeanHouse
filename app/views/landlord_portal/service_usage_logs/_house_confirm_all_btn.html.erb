<%# locals: (house:, billing_month:, selected_service: nil, count:) %>
<div id="house_confirm_all_btn" class="ms-auto">
  <% if count.to_i > 0 %>
    <%= button_to confirm_all_landlord_house_service_usage_logs_path(house, month: billing_month.strftime("%Y-%m"), service_id: selected_service&.id),
                  method: :patch,
                  form: {
                    data: {
                      controller: "loading",
                      loading_text_value: "#{t('saving', default: 'Đang lưu...')}...",
                      action: "submit->loading#submit"
                    }
                  },
                  data: {
                    loading_target: "button",
                    turbo_confirm: t("invoice.confirm_all_prompt", count: count)
                  },
                  class: "btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm" do %>
      <span class="material-symbols-outlined fs-6" data-loading-target="icon">done_all</span>
      <span class="material-symbols-outlined spin d-none fs-6" data-loading-target="spinner">progress_activity</span>
      <span data-loading-target="text"><%= t("invoice.confirm_all", count: count) %></span>
    <% end %>
  <% end %>
</div>
