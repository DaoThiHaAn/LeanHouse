<%= turbo_frame_tag "logs_table",
      data: {
        controller: "pagination-sync",
        pagination_sync_canonical_url_value: landlord_house_service_usage_logs_path(house),
        pagination_sync_default_params_value: (params[:service_id].present? ? { service_id: params[:service_id].to_s } : {}).to_json,
        pagination_sync_query_params_value: ["month", "room_id", "service_id", "service_variant_id", "status"].to_json,
        pagination_sync_total_pages_selector_value: "[data-pagination-total-pages]",
        action: "turbo:frame-load->pagination-sync#updateUrl"
      } do %>
  <span hidden data-pagination-total-pages="<%= logs.respond_to?(:total_pages) ? logs.total_pages : 1 %>"></span>

  <% if logs.empty? %>
  <div class="card bg-light border-0 text-center py-5 rounded-4 mx-auto">
    <span class="material-symbols-outlined text-secondary fs-1 mb-2">fact_check</span>
    <p class="fs-5 fw-bold mb-1"><%= t("invoice.no_logs", month: billing_month.strftime("%m/%Y")) %></p>
    <p class="text-secondary small"><%= t("invoice.no_logs_hint") %></p>
  </div>
<% else %>
  <div class="table-responsive bg-white rounded-3 shadow-sm border">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th class="ps-3"><%= t("invoice.room") %></th>
          <th><%= t("form.service.self") %></th>
          <th><%= t("invoice.prev_reading") %></th>
          <th><%= t("invoice.latest_reading") %></th>
          <th><%= t("invoice.consumption") %></th>
          <th><%= t("invoice.amount") %></th>
          <th><%= t("invoice.meter_photo") %></th>
          <th><%= t("invoice.submitter") %></th>
          <th><%= t("common.status") %></th>
          <th class="text-center pe-3"><%= t("actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% logs.each do |log| %>
          <tr id="<%= dom_id(log) %>">
            <td class="ps-3 fw-bold text-dark">
              <%= link_to landlord_house_room_service_usage_logs_path(house, log.room), class: "text-decoration-none text-dark d-inline-flex align-items-center gap-1", data: { turbo_frame: "_top" }, title: t("service_usage_logs.view_room_logs") do %>
                <span><%= log.room.title_name %></span>
                <span class="material-symbols-outlined fs-6 text-primary">open_in_new</span>
              <% end %>
            </td>
            <td>
              <span class="badge bg-secondary-subtle text-secondary border">
                <%= log.service_name %> (<%= log.unit %>)
              </span>
            </td>
            <td class="text-secondary">
              <%= log.real_time? ? log.prev_reading : "-" %>
            </td>
            <td class="fw-bold text-primary">
              <% if log.real_time? %>
                <%= log.latest_reading.present? ? log.latest_reading : "-" %>
              <% else %>
                <span class="text-secondary">-</span>
              <% end %>
            </td>
            <td>
              <% if log.usage_quantity.present? %>
                <span class="fw-bold text-success">+<%= log.usage_quantity %> <%= log.unit %></span>
              <% else %>
                <span class="text-secondary">-</span>
              <% end %>
            </td>
            <td class="fw-semibold text-dark">
              <%= number_with_delimiter(log.total_amount) %> đ
            </td>
            <td>
              <% if log.reading_photo.attached? %>
                <a href="<%= url_for(log.reading_photo) %>" target="_blank" rel="noopener" class="d-inline-block position-relative" title="<%= t('service_usage_logs.view_full_photo') %>">
                  <%= image_tag log.reading_photo.variant(resize_to_limit: [50, 50]), class: "rounded border shadow-sm", alt: t("invoice.meter_photo") %>
                </a>
              <% else %>
                <span class="text-secondary small fst-italic"><%= t("invoice.no_photo") %></span>
              <% end %>
            </td>
            <td class="small">
              <% if log.submitted_by.is_a?(User) %>
                <span class="fw-semibold"><%= log.submitted_by.fullname %></span>
                <span class="text-secondary d-block small">(<%= log.submitted_by.tenant? ? t("invoice.submitted_by_tenant") : t("invoice.submitted_by_landlord") %>)</span>
              <% else %>
                <span class="text-secondary"><%= t("invoice.landlord_label") %></span>
              <% end %>
            </td>
            <td>
              <% if log.is_confirmed? %>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 d-inline-flex align-items-center gap-1">
                  <span class="material-symbols-outlined fs-6">check_circle</span> <%= t("invoice.status_confirmed") %>
                </span>
              <% else %>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 d-inline-flex align-items-center gap-1">
                  <span class="material-symbols-outlined fs-6">schedule</span> <%= t("invoice.status_unconfirmed") %>
                </span>
              <% end %>

              <% if log.billed? %>
                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1 ms-1">
                  <%= t("invoice.status_billed") %>
                </span>
              <% end %>
            </td>
            <td class="text-center pe-3">
              <div class="d-flex align-items-center justify-content-center gap-2">
                <% unless log.is_confirmed? %>
                  <%= button_to confirm_landlord_house_service_usage_log_path(house, log),
                                method: :patch,
                                class: "table-action text-success border-0 bg-transparent p-0",
                                title: t("invoice.confirm_log_title") do %>
                    <span class="material-symbols-filled">check_circle</span>
                  <% end %>
                <% end %>

                <% unless log.billed? %>
                  <%= link_to edit_landlord_house_service_usage_log_path(house, log),
                              class: "table-action",
                              data: { turbo_frame: "_top" },
                              title: t("edit") do %>
                    <span class="material-symbols-filled">edit</span>
                  <% end %>

                  <%= button_to landlord_house_service_usage_log_path(house, log),
                                method: :delete,
                                data: { turbo_confirm: t("invoice.delete_log_confirm") },
                                class: "table-action text-danger-emphasis border-0 bg-transparent p-0",
                                title: t("delete") do %>
                    <span class="material-symbols-filled">delete</span>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if logs.respond_to?(:total_pages) && logs.total_pages > 1 %>
    <div class="mt-4 d-flex justify-content-center">
      <%= paginate logs,
                   params: {
                     month: billing_month.strftime("%Y-%m"),
                     room_id: params[:room_id].presence,
                     service_id: params[:service_id].presence,
                     service_variant_id: params[:service_variant_id].presence,
                     status: params[:status].presence
                   } %>
    </div>
  <% end %>
<% end %>
<% end %>
