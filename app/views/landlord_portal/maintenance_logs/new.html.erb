<!-- Variables: @asset, @log -->

<%= turbo_frame_tag "new_log_modal" do %>
  <div class="modal fade" id="newLogModal" tabindex="-1" aria-hidden="true"
        data-controller="modal" data-modal-auto-open-value="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">

      <div class="modal-content px-2">
        <div class="modal-header">
          <h1 class="modal-title fs-4 flex-grow-1 text-center" id="newLogModalLabel"><%= t("form.maintenance_log.add_extend") %></h1>
          <button type="button" class="m-0 btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body d-flex flex-column align-items-center">
          <%= render "form",
                house: @house,
                asset: @asset,
                log: @log,
                url: landlord_house_asset_maintenance_logs_path(@house, @asset),
                method: :post,
                turbo_frame: "_top",
                submit_text: t("add"),
                loading_text: t("adding") + "..." %>
        </div>
      </div>
    </div>
  </div>
<% end %>
