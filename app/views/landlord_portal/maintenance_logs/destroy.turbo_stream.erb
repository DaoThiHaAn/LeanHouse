<%= turbo_stream.remove ActionView::RecordIdentifier.dom_id(@log) %>

<%= turbo_stream.update "maintenance_total_cost_badge" do %>
  <%= t("admin.assets.total_maintenance_cost") %>: <strong class="fs-6"><%= format_money(@total_cost || 0) %></strong>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "layouts/shared_components/flash_message" %>
<% end %>
