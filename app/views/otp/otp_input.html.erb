<% active_demo_otp = local_assigns[:demo_otp].presence || flash[:development_otp].presence || (current_pending_user&.otp_code if show_demo_otp?) %>

<% if show_demo_otp? && active_demo_otp.present? %>
  <div class="alert alert-danger position-fixed top-0 end-0 m-3 shadow development-otp" role="status">
    <strong>Demo OTP:</strong> <%= active_demo_otp %>
  </div>
<% end %>

<div class="custom card my-5 mx-auto px-5 py-4">
    <div class="card-body d-flex align-items-center flex-column gap-3"
         data-controller="otp"
         data-otp-length-value="6">
        <h1 class="card-title text-center"><%= t('form.profile.otp_title').upcase %></h1>
        <p class="card-text"><%= t('form.profile.check_tel') %></p>
        <p class="card-text"><%= t('form.profile.check_tel_html', tel: tel) %></p>
        <p class="card-text otp-valid"><%= t('form.profile.otp_valid') %></p>

        <% if show_demo_otp? && active_demo_otp.present? %>
          <div class="alert alert-warning border-warning d-flex flex-column gap-2 w-100 rounded-3 shadow-sm p-3 my-2 text-start" role="region" aria-label="<%= t('form.profile.otp_demo_title') %>">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-warning fs-5">science</span>
                <strong class="text-dark"><%= t('form.profile.otp_demo_title') %>:</strong>
                <span class="badge bg-warning text-dark fs-6 font-monospace px-2 py-1"><%= active_demo_otp %></span>
              </div>
              <div class="d-flex align-items-center gap-2">
                <button type="button"
                        class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1"
                        data-action="click->otp#fillDemo"
                        data-otp-code="<%= active_demo_otp %>">
                  <span class="material-symbols-outlined fs-6">input</span>
                  <span><%= t('form.profile.otp_demo_quick_fill') %></span>
                </button>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1"
                        data-action="click->otp#copyDemo"
                        data-otp-code="<%= active_demo_otp %>"
                        data-copied-text="<%= t('form.profile.otp_demo_copied') %>">
                  <span class="material-symbols-outlined fs-6">content_copy</span>
                  <span data-otp-target="copyLabel"><%= t('form.profile.otp_demo_copy') %></span>
                </button>
              </div>
            </div>
            <div class="small text-muted">
              <%= t('form.profile.otp_demo_hint_html') %>
            </div>

          </div>
        <% end %>

        <% target_expires_at = local_assigns[:expires_at] || (Time.current + 5.minutes) %>
        <!-- Timer -->
        <div class="text-center fw-bold timer"
            data-controller="otp-timer"
            data-otp-timer-expires-at-value="<%= (target_expires_at.to_f * 1000).to_i %>">

            <span data-otp-timer-target="time"></span>
        </div>

        <!-- Input boxes-->
        <div class="d-flex gap-2 justify-content-center otp-inputs">

            <%= form_with url: verify_otp_path, method: :post, local: false,
                            data: {
                              otp_target: "form",
                              controller: "loading",
                              loading_text_value: "#{t('form.profile.verifying_otp', default: 'Đang xác thực...')}...",
                              action: "submit->loading#submit"
                            },
                            class: "d-flex flex-column gap-3 mb-5 align-items-center" do |f| %>

                <%# The hidden field that will hold the combined 6 digits %>
                <%= f.hidden_field :otp, data: { otp_target: "hidden" } %>

                <div class="d-flex gap-2">
                <% 6.times do |i| %>
                    <input
                    type="text"
                    inputmode="numeric"
                    maxlength="1"
                    autocomplete="one-time-code" <%# Helps mobile browsers suggest the SMS code %>
                    class="otp-box form-control"
                    data-otp-target="digit"
                    data-action="input->otp#input keydown->otp#keydown paste->otp#paste"
                    <%= "autofocus" if i == 0 %>
                    >
                <% end %>
                </div>

                <%= f.button type: :submit,
                      class: "custom-primary-btn d-inline-flex align-items-center justify-content-center gap-2",
                      data: { loading_target: "button" } do %>
                  <span data-loading-target="text"><%= t('form.profile.verify') %></span>
                  <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">progress_activity</span>
                <% end %>
            <% end %>
        </div>


        <div class="field-info mb-2 d-flex align-items-center gap-1">
            <span class="material-symbols-outlined fs-5">info</span>
            <small><%= t('form.profile.otp_note') %></small>
        </div>

        <%= button_to t('form.profile.resend_otp'), resend_otp_path, data: { turbo: false }, class:"custom-secondary-btn" %>
        <%= back_link_to :back, class: "mx-auto mt-3" %>
    </div>
</div>
