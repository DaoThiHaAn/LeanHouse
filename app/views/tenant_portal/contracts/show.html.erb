<%# Variables: @tenant_stay %>

<% content_for :title, t("page_titles.my_contract") %>

<div class="contract-detail-wrapper main-container px-0 border rounded-2">
  <div class="px-4 pt-3 pb-2 mb-4">
    <h1 class="text-center mb-3">
      <%= t("page_titles.my_contract") %>
      <span class="material-symbols-outlined fs-5"
             <%= tooltip("top", :"form.contract.my_contract_note_html", html:true)%>>
        help
      </span>
    </h1>
    <%= link_to tenant_all_contracts_path, class: "text-secondary d-flex align-items-center justify-content-center gap-1 text-decoration-none" do %>
      <span class="material-symbols-outlined fs-4">history</span>
      <span><%= t("form.contract.all_contracts") %></span>
    <% end %>
  </div>

  <%= render 'layouts/shared_components/contracts/detail',
             contract: @contract,
             house: @house,
             tenant_stay: (@tenant_stay&.rental_unit&.house&.id == @contract.house_id ? @tenant_stay : nil) %>
</div>
