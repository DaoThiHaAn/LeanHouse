<div class="main-container w-65 d-flex flex-column gap-3 align-items-center justify-content-center">
    <h1 class="text-center mb-4">
        <%= t('form.tenant.no_house') %>
    </h1>

    <p class="no-house-text">
        <%= t('form.tenant.let_link') %>
    </p>

    <%= image_tag "house-key.gif", alt: "House key GIF", width: "200px" %>

    <% if current_user.tenant&.contracts&.any? %>
      <div class="mt-2">
        <%= link_to tenant_all_contracts_path, class: "btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm px-3 py-2" do %>
          <span class="material-symbols-outlined fs-5">history</span>
          <span><%= t("form.contract.all_contracts") %></span>
        <% end %>
      </div>
    <% end %>
</div>
