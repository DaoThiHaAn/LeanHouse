<%# Variables: house, tenant_stay %>

<div class="main-info-zone p-4 rounded-4 position-relative overflow-hidden">
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 position-relative" style="z-index: 1;">
    <div class="d-flex align-items-start align-items-sm-center gap-3">
      <div class="house-icon-wrapper rounded-3 d-flex align-items-center justify-content-center flex-shrink-0">
        <span class="material-symbols-filled fs-1">roofing</span>
      </div>
      <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
          <h2 class="zone-house-name mb-0"><%= house.name %></h2>
          <span class="zone-status-badge">
            <span class="status-dot"></span>
            <%= t("staying") %>
          </span>
        </div>
        <div class="zone-address d-flex align-items-center gap-1">
          <span class="material-symbols-outlined fs-5">location_on</span>
          <span><%= house.full_address %></span>
        </div>
      </div>
    </div>

    <div class="d-flex flex-wrap flex-md-column align-items-start align-items-md-end gap-3 ms-0 ms-md-auto pt-2 pt-md-0">
      <div class="zone-room-badge d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill"
            title="<%= t("form.tenant.rental_unit") %>">
        <span class="material-symbols-outlined fs-5">person_pin</span>
        <span class="fw-bold"><%= tenant_stay.rental_unit.location_info %></span>
      </div>
      <div class="zone-checkin-badge d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill">
        <span class="material-symbols-outlined fs-6">event</span>
        <span>
          <%= t("form.tenant.checkin_at") %>:
          <strong><%= tenant_stay.checkin_at.strftime("%d/%m/%Y") %></strong>
        </span>
      </div>
    </div>
  </div>

  <%# Decorative background icon %>
  <div class="zone-bg-decoration" aria-hidden="true">
    <span class="material-symbols-outlined">hotel</span>
  </div>
</div>
