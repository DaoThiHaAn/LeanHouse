<%= turbo_stream.replace "profile_avatar" do %>
  <%= render "avatar", user: @user %>
<% end %>

<% if @user.valid? %>
  <%= turbo_stream.update "navbar_avatar" do %>
    <%= render "layouts/shared_components/navbar_avatar" %>
  <% end %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "layouts/shared_components/flash_message" %>
<% end %>
