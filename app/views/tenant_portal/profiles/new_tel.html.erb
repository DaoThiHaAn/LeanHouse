<% content_for :title, t('form.profile.new_tel') %>

<div class="otp card px-5 py-4 m-5 mx-auto">
  <div class="card-body d-flex flex-column gap-3">
    <div class="d-flex align-items-center mb-4 gap-3">
      <%= back_link_to tenant_profile_path %>
      <h1 class="text-center flex-grow-1"><%= t('form.profile.new_tel') %></h1>
    </div>

    <%= form_with url: change_tel_tenant_profile_path, method: :post, local: true,
          class: "d-flex align-items-center flex-column gap-4",
          data: {
            controller: "loading",
            loading_text_value: "#{t('sending', default: 'Đang gửi')}...",
            action: "submit->loading#submit"
          } do |f| %>

      <!-- Tel -->
      <div class="form-group w-100" data-controller="form">
        <%= f.label :tel, class: "form-label d-flex justify-content-between" do %>
          <div>
            <%= t("form.profile.new_tel") %>:<span class="asterisk">*</span>
          </div>

          <small class="counter-text">
            <span data-form-target="charCount">0</span>
          </small>
        <% end %>

        <%= f.telephone_field :tel,
            value: params[:tel],
            minlength: 10,
            maxlength: 10,
            required: true,
            autofocus: true,
            class: "form-control #{invalid_class(@user, :tel)}",
            placeholder: t("form.profile.tel_placeholder"),
            data: {
              form_target: "input",
              action: "input->form#update"
            } %>
        <%= field_error(@user, :tel) %>
      </div>

      <%= f.button type: :submit,
            class: "mx-auto custom-primary-btn d-inline-flex align-items-center justify-content-center gap-2",
            data: { loading_target: "button" } do %>
        <span data-loading-target="text"><%= t("form.profile.send_otp") %></span>
        <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">progress_activity</span>
      <% end %>
    <% end %>

    <div class="mt-3">
      <%= render 'layouts/shared_components/new_tel_owner' %>
    </div>
  </div>
</div>
