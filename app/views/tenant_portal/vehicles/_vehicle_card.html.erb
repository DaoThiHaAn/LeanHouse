<%# Local variables: vehicle %>

<div class="col-12 col-md-6 col-lg-4" id="<%= dom_id(vehicle, :vehicle_card) %>">
  <div class="card h-100 border rounded-4 shadow-sm overflow-hidden bg-white">
    <!-- Vehicle Photo or Placeholder Header -->
    <div class="position-relative bg-light text-center border-bottom d-flex align-items-center justify-content-center" style="height: 180px;">
      <% if vehicle.vehicle_photo.attached? %>
        <%= image_tag vehicle.vehicle_photo, class: "w-100 h-100 object-fit-cover", alt: vehicle.license_plate %>
        <button type="button"
                class="btn btn-sm btn-light bg-white border rounded-circle position-absolute top-0 end-0 m-2 shadow-sm p-1 d-flex align-items-center justify-content-center"
                data-bs-toggle="modal"
                data-bs-target="#tenantVehiclePhotoModal_<%= vehicle.id %>"
                title="<%= t("vehicle.view_photo") %>">
          <span class="material-symbols-outlined fs-6">zoom_in</span>
        </button>
      <% else %>
        <div class="text-secondary text-center py-4">
          <span class="material-symbols-outlined" style="font-size: 3.5rem;"><%= vehicle.type_icon %></span>
        </div>
      <% end %>

      <!-- Vehicle Type Pill (Top Left) -->
      <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 start-0 m-2 d-inline-flex align-items-center gap-1 px-2.5 py-1 rounded-pill">
        <span class="material-symbols-outlined fs-6"><%= vehicle.type_icon %></span>
        <span><%= vehicle.human_type %></span>
      </span>
    </div>

    <!-- Vehicle Details Body -->
    <div class="card-body p-3 d-flex flex-column justify-content-between">
      <div>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="fs-5 fw-bold font-monospace text-primary bg-primary bg-opacity-10 px-2.5 py-1 rounded-2 border border-primary border-opacity-25">
            <%= vehicle.license_plate %>
          </span>
          <span class="small text-secondary">
            <%= vehicle.created_at.strftime("%d/%m/%Y") %>
          </span>
        </div>

        <div class="mb-3">
          <div class="fw-semibold text-dark fs-6">
            <%= vehicle.brand.presence || "-" %> <%= vehicle.model.presence || "" %>
          </div>
          <div class="small text-secondary">
            <%= t("request.status") %>: <span class="badge bg-success text-white fw-normal px-2 py-0.5 rounded-pill"><%= t("enums.request.status.approved") %></span>
          </div>
        </div>
      </div>

      <!-- Delete Button (triggers modal) -->
      <div class="border-top pt-2 mt-auto d-flex justify-content-end">
        <button type="button"
                class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 px-3 py-1.5 rounded-3"
                data-bs-toggle="modal"
                data-bs-target="#tenantDeleteVehicleModal_<%= vehicle.id %>">
          <span class="material-symbols-filled fs-6">delete</span>
          <span><%= t("vehicle.delete") %></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Photo Modal for Tenant -->
  <% if vehicle.vehicle_photo.attached? %>
    <div class="modal fade" id="tenantVehiclePhotoModal_<%= vehicle.id %>" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
          <div class="modal-header">
            <h2 class="modal-title fs-6 fw-bold">
              <%= vehicle.license_plate %> - <%= vehicle.brand %> <%= vehicle.model %>
            </h2>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body text-center p-3">
            <%= image_tag vehicle.vehicle_photo, class: "img-fluid rounded-3 shadow-sm", style: "max-height: 450px; object-fit: contain;" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Delete Modal for Tenant -->
  <div class="modal fade" id="tenantDeleteVehicleModal_<%= vehicle.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content text-start">
        <div class="modal-header">
          <h2 class="modal-title fs-5 fw-bold text-danger d-flex align-items-center gap-2">
            <span class="material-symbols-outlined text-danger">warning</span>
            <%= t("vehicle.delete_confirm_title") %>
          </h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <%= form_with url: tenant_vehicle_path(vehicle), method: :delete do |f| %>
          <div class="modal-body p-3">
            <div class="alert alert-light border rounded-3 p-2 mb-3">
              <div class="fw-semibold"><%= vehicle.human_type %> - <%= vehicle.license_plate %></div>
              <div class="small text-secondary"><%= vehicle.brand %> <%= vehicle.model %></div>
            </div>

            <div class="mb-3">
              <%= f.label :reason, class: "form-label fw-medium" do %>
                <%= t("vehicle.delete_reason") %> <span class="text-danger">*</span>
              <% end %>
              <%= f.text_area :reason,
                    rows: 3,
                    required: true,
                    class: "form-control",
                    placeholder: t("vehicle.delete_reason_placeholder") %>
            </div>

            <p class="small text-secondary mb-0">
              <%= t("vehicle.delete_notice") %>
            </p>
          </div>

          <div class="modal-footer justify-content-end gap-2">
            <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">
              <%= t("cancel") %>
            </button>
            <%= f.submit t("vehicle.delete"),
                  class: "btn btn-danger px-3",
                  data: { bs_dismiss: "modal" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
