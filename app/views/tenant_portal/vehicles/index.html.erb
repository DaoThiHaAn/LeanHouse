<% content_for :title, t("page_titles.my_vehicles") %>

<div class="main-container w-75">
  <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-2">
    <div>
      <h1 class="mb-3">
        <%= t("page_titles.my_vehicles") %>
      </h1>
      <p class="text-secondary">
        <%= @house.name %> • <%= @house.full_address %>
      </p>
    </div>

    <%= link_to new_tenant_vehicle_request_path,
          class: "main-btn px-3 py-2 shadow-sm",
          data: { turbo_frame: "new_vehicle_modal" } do %>
      <div class="d-flex align-items-center gap-2">
        <span class="material-symbols-filled fs-5">add_circle</span>
        <%= t("vehicle.register_btn") %>
      </div>
    <% end %>
  </div>

  <% if @vehicles.empty? %>
    <div class="card border-0 bg-light rounded-4 text-center py-5 px-3">
      <div class="mb-3">
        <span class="material-symbols-outlined vehicle-icon text-secondary">two_wheeler</span>
      </div>
      <p class="fs-5 fw-bold mb-3"><%= t("vehicle.no_vehicles_tenant") %></p>
      <p class="text-secondary mb-4">
        <%= t("vehicle.register_prompt") %>
      </p>
    </div>
  <% else %>
    <div class="row g-4" id="tenant_vehicles_grid">
      <% @vehicles.each do |vehicle| %>
        <%= render "tenant_portal/vehicles/vehicle_card", vehicle: vehicle %>
      <% end %>
    </div>
  <% end %>
</div>

<%= turbo_frame_tag "new_vehicle_modal" %>
