<!-- Modal Hướng dẫn Dành cho Khách thuê: Chu kỳ, Kiểu thanh toán & VietQR -->
<div class="modal fade" id="tenantInvoiceGuideModal" tabindex="-1" aria-labelledby="tenantInvoiceGuideModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
      <!-- Header -->
      <div class="modal-header bg-primary py-3 px-4 border-0 d-flex justify-content-between align-items-center">
        <div>
          <h2 class="modal-title text-white d-flex align-items-center gap-2 mb-2" id="tenantInvoiceGuideModalLabel">
            <span class="material-symbols-outlined fs-3">menu_book</span>
            <%= t('invoice.tenant_guide.modal_title') %>
          </h2>
          <p class="badge fs-6 bg-white text-primary fw-semibold p-2 shadow-sm mb-0">
            <%= t('invoice.tenant_guide.badge_subtitle') %>
          </p>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Navigation Tabs -->
      <div class="bg-light px-4 py-3 border-bottom">
        <ul class="nav nav-pills gap-2" id="tenantInvoiceGuideTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold d-inline-flex align-items-center gap-1 py-2 px-3 rounded-pill" id="tenant-guide-timing-tab" data-bs-toggle="pill" data-bs-target="#tenant-guide-timing" type="button" role="tab" aria-controls="tenant-guide-timing" aria-selected="true">
              <span class="material-symbols-outlined fs-5">schedule</span>
              <span><%= t('invoice.tenant_guide.tab_timing') %></span>
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold d-inline-flex align-items-center gap-1 py-2 px-3 rounded-pill" id="tenant-guide-modes-tab" data-bs-toggle="pill" data-bs-target="#tenant-guide-modes" type="button" role="tab" aria-controls="tenant-guide-modes" aria-selected="false">
              <span class="material-symbols-outlined fs-5">category</span>
              <span><%= t('invoice.tenant_guide.tab_modes') %></span>
            </button>
          </li>

          <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold d-inline-flex align-items-center gap-1 py-2 px-3 rounded-pill" id="tenant-guide-vietqr-tab" data-bs-toggle="pill" data-bs-target="#tenant-guide-vietqr" type="button" role="tab" aria-controls="tenant-guide-vietqr" aria-selected="false">
              <span class="material-symbols-outlined fs-5">qr_code_scanner</span>
              <span><%= t('invoice.tenant_guide.tab_vietqr') %></span>
            </button>
          </li>
        </ul>
      </div>

      <!-- Modal Body (Content Tabs) -->
      <div class="modal-body p-4">
        <div class="tab-content" id="tenantInvoiceGuideTabContent">

          <!-- TAB 1: TIMING & CYCLE -->
          <div class="tab-pane fade show active" id="tenant-guide-timing" role="tabpanel" aria-labelledby="tenant-guide-timing-tab">
            <div class="card border-0 bg-light rounded-4 p-4 mb-3">
              <h5 class="fw-bold text-dark d-flex align-items-center gap-2 mb-3">
                <span class="material-symbols-outlined fs-4 text-primary">schedule</span>
                <%= t('invoice.tenant_guide.timing_title') %>
              </h5>
              <p class="text-secondary mb-4"><%= t('invoice.tenant_guide.timing_p1') %></p>

              <div class="row g-3 mb-4">
                <!-- Tiền phòng trả trước -->
                <div class="col-md-6">
                  <div class="p-3 bg-white rounded-3 shadow-sm border border-primary-subtle h-100">
                    <div class="fw-bold text-primary d-flex align-items-center gap-2 mb-2">
                      <span class="material-symbols-filled fs-5">hotel</span>
                      <span><%= t('invoice.tenant_guide.timing_rent_title') %></span>
                    </div>
                    <p class="small text-secondary mb-0">
                      <%= t('invoice.tenant_guide.timing_rent_desc') %>
                    </p>
                  </div>
                </div>

                <!-- Điện nước trả sau -->
                <div class="col-md-6">
                  <div class="p-3 bg-white rounded-3 shadow-sm border border-success-subtle h-100">
                    <div class="fw-bold text-success d-flex align-items-center gap-2 mb-2">
                      <span class="material-symbols-filled fs-5">electric_bolt</span>
                      <span><%= t('invoice.tenant_guide.timing_utility_title') %></span>
                    </div>
                    <p class="small text-secondary mb-0">
                      <%= t('invoice.tenant_guide.timing_utility_desc') %>
                    </p>
                  </div>
                </div>
              </div>

              <!-- Minh bạch chỉ số công tơ -->
              <div class="p-3 bg-white rounded-3 shadow-sm border border-info-subtle">
                <div class="fw-bold text-info-emphasis d-flex align-items-center gap-2 mb-2">
                  <span class="material-symbols-filled fs-5">speed</span>
                  <span><%= t('invoice.tenant_guide.timing_meter_title') %></span>
                </div>
                <div class="small text-secondary mb-3">
                  <%= sanitize(t('invoice.tenant_guide.timing_meter_desc')) %>
                </div>

                <div class="p-3 rounded-3 bg-light border border-light-subtle d-inline-block">
                  <span class="small text-muted d-block mb-1 fw-medium"><%= t('invoice.example', default: 'Ví dụ minh họa trên hóa đơn:') %></span>
                  <div class="meter-reading-breakdown">
                    <div class="meter-row">
                      <span class="meter-label"><%= t('invoice.prev_reading', default: 'Chỉ số cũ') %>:</span>
                      <span class="meter-value">1250</span>
                    </div>
                    <div class="meter-row">
                      <span class="meter-label"><%= t('invoice.latest_reading', default: 'Chỉ số mới') %>:</span>
                      <span class="meter-value">1380</span>
                    </div>
                    <div class="meter-row meter-usage-row">
                      <span class="meter-label text-primary fw-semibold"><%= t('invoice.used_amount', default: 'Tiêu thụ') %>:</span>
                      <span class="meter-usage-value">130.0 kWh</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 2: INVOICE TYPES & PAYMENT MODES -->
          <div class="tab-pane fade" id="tenant-guide-modes" role="tabpanel" aria-labelledby="tenant-guide-modes-tab">
            <div class="card border-0 bg-light rounded-4 p-4 mb-3">
              <h5 class="fw-bold text-dark d-flex align-items-center gap-2 mb-3">
                <span class="material-symbols-outlined fs-4 text-primary">category</span>
                <%= t('invoice.tenant_guide.modes_title') %>
              </h5>

              <!-- Section 1: Hóa đơn theo phòng -->
              <div class="card bg-white border-0 shadow-sm rounded-3 p-3 mb-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2 pb-2 border-bottom">
                  <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary text-white p-2 rounded-circle">
                      <span class="material-symbols-filled fs-5">meeting_room</span>
                    </span>
                    <div>
                      <h6 class="fw-bold text-dark mb-0"><%= t('invoice.tenant_guide.type_room_title') %></h6>
                      <span class="small text-secondary"><%= t('invoice.tenant_guide.type_room_desc') %></span>
                    </div>
                  </div>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle small fw-semibold">
                    <%= t('invoice.guide.has_2_payment_modes') %>
                  </span>
                </div>

                <div class="row g-3 mt-1">
                  <!-- Mode 1: Đại diện phòng -->
                  <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-info-subtle h-100">
                      <div class="fw-bold text-info-emphasis d-flex align-items-center gap-1 mb-2">
                        <span class="material-symbols-filled fs-5">co_present</span>
                        <span><%= t('invoice.tenant_guide.mode_representative_title') %></span>
                      </div>
                      <p class="small text-secondary mb-0"><%= t('invoice.tenant_guide.mode_representative_desc') %></p>
                    </div>
                  </div>

                  <!-- Mode 2: Tự thanh toán -->
                  <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border border-success-subtle h-100">
                      <div class="fw-bold text-success d-flex align-items-center gap-1 mb-2">
                        <span class="material-symbols-filled fs-5">person</span>
                        <span><%= t('invoice.tenant_guide.mode_self_pay_title') %></span>
                      </div>
                      <p class="small text-secondary mb-0"><%= t('invoice.tenant_guide.mode_self_pay_desc') %></p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Section 2: Hóa đơn tùy chọn -->
              <div class="card bg-white border-0 shadow-sm rounded-3 p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2 pb-2 border-bottom">
                  <div class="d-flex align-items-center gap-2">
                    <span class="badge text-white p-2 rounded-circle" style="background-color: #9333ea;">
                      <span class="material-symbols-filled fs-5">tune</span>
                    </span>
                    <div>
                      <h6 class="fw-bold text-dark mb-0"><%= t('invoice.tenant_guide.type_custom_title') %></h6>
                      <span class="small text-secondary"><%= t('invoice.tenant_guide.type_custom_desc') %></span>
                    </div>
                  </div>
                  <span class="badge border small fw-semibold" style="color: #6b21a8; background-color: #faf5ff; border-color: #e9d5ff !important;">
                    <%= t('invoice.guide.custom_pays_individually') %>
                  </span>
                </div>

                <div class="p-3 rounded-3 mt-2" style="background-color: #faf5ff; border: 1px solid #e9d5ff;">
                  <div class="fw-bold d-flex align-items-center gap-1 mb-2" style="color: #6b21a8;">
                    <span class="material-symbols-filled fs-5">person_check</span>
                    <span><%= t('invoice.guide.custom_mode_heading') %></span>
                  </div>
                  <p class="small text-secondary mb-0"><%= t('invoice.tenant_guide.custom_mode_desc') %></p>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 3: VIETQR PAYMENT & CONFIRMATION -->
          <div class="tab-pane fade" id="tenant-guide-vietqr" role="tabpanel" aria-labelledby="tenant-guide-vietqr-tab">
            <div class="card border-0 bg-light rounded-4 p-4 mb-3">
              <h5 class="fw-bold text-dark d-flex align-items-center gap-2 mb-3">
                <span class="material-symbols-outlined fs-4 text-primary">qr_code_scanner</span>
                <%= t('invoice.tenant_guide.vietqr_title') %>
              </h5>

              <div class="row g-3">
                <!-- Step 1 -->
                <div class="col-md-6">
                  <div class="p-3 bg-white rounded-3 shadow-sm border border-primary-subtle h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <span class="badge bg-primary text-white rounded-circle p-2">1</span>
                      <h6 class="fw-bold text-primary mb-0"><%= t('invoice.tenant_guide.vietqr_step1_title') %></h6>
                    </div>
                    <div class="small text-secondary">
                      <%= sanitize(simple_format(t('invoice.tenant_guide.vietqr_step1_desc'))) %>
                    </div>
                  </div>
                </div>

                <!-- Step 2 -->
                <div class="col-md-6">
                  <div class="p-3 bg-white rounded-3 shadow-sm border border-success-subtle h-100">
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <span class="badge bg-success text-white rounded-circle p-2">2</span>
                      <h6 class="fw-bold text-success mb-0"><%= t('invoice.tenant_guide.vietqr_step2_title') %></h6>
                    </div>
                    <div class="small text-secondary">
                      <%= sanitize(simple_format(t('invoice.tenant_guide.vietqr_step2_desc'))) %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Footer -->
      <div class="modal-footer bg-light px-4 py-3 border-top">
        <button type="button" class="btn btn-primary px-4 fw-semibold shadow-sm" data-bs-dismiss="modal">
          <%= t('invoice.tenant_guide.btn_close') %>
        </button>
      </div>
    </div>
  </div>
</div>
