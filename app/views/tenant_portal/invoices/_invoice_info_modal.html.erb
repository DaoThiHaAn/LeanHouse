<%
  inv = local_assigns[:invoice] || @invoice
  r_total = local_assigns[:rent_total] || inv.rent_total
  s_total = local_assigns[:services_total] || inv.services_total
  a_total = local_assigns[:additions_total] || inv.additions_total
  d_total = local_assigns[:discounts_total] || inv.discounts_total
%>

<!-- Modal Chi tiết Tổng tiền cho Khách thuê -->
<div class="modal fade" id="invoiceInfoModal" tabindex="-1" aria-labelledby="invoiceInfoModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content rounded-4 shadow">
      <div class="modal-header border-bottom">
        <h6 class="modal-title fw-bold" id="invoiceInfoModalLabel"><%= t('invoice.calculate_formula_title') %></h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body small">
        <p class="mb-1"><strong><%= t('invoice.rent_fee') %>:</strong> <%= number_to_currency(r_total, unit: "đ", format: "%n %u") %></p>
        <p class="mb-1"><strong><%= t('invoice.service_fee') %>:</strong> +<%= number_to_currency(s_total, unit: "đ", format: "%n %u") %></p>
        <% if a_total > 0 %>
          <p class="mb-1 text-primary"><strong><%= t('invoice.addition_items') %>:</strong> +<%= number_to_currency(a_total, unit: "đ", format: "%n %u") %></p>
        <% end %>
        <% if d_total > 0 %>
          <p class="mb-1 text-danger"><strong><%= t('invoice.discount_items') %>:</strong> -<%= number_to_currency(d_total, unit: "đ", format: "%n %u") %></p>
        <% end %>
        <hr>
        <p class="mb-0 fw-bold fs-6"><%= t('invoice.total_payment') %>: <%= number_to_currency(inv.total_amount, unit: "đ", format: "%n %u") %></p>
      </div>
    </div>
  </div>
</div>
