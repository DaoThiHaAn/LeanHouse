<% content_for :title, "#{t('invoice.my_invoices')} - LeanHouse" %>

<div class="main-container py-4 invoice-wrapper">
  <div class="mb-4 pb-2 border-bottom text-center">
    <h1 class="mb-3"><%= t('invoice.my_invoices') %></h1>
    <p class="text-secondary mb-0"><%= t('invoice.my_invoices_subtitle') %></p>
  </div>

  <% if params[:status].present? || params[:month].present? %>
    <div class="d-flex align-items-center justify-content-between invoice-filter-bar mb-3 shadow-sm">
      <div class="small d-flex align-items-center gap-2">
        <span class="material-symbols-outlined text-primary fs-5">filter_alt</span>
        <span>
          <%= t("filtering", default: "Đang lọc:") %>
          <% if params[:status].present? %>
            <strong><%= t("invoice.status.#{params[:status]}", default: params[:status]) %></strong>
          <% end %>
          <% if params[:month].present? %>
            <strong><%= t("month_val", params[:month]) %></strong>
          <% end %>
        </span>
      </div>
      <%= link_to t("view_all"), tenant_invoices_path, class: "btn btn-sm btn-outline-secondary py-0" %>
    </div>
  <% end %>

  <% if @invoices.empty? %>
    <div class="invoice-empty-state mx-auto">
      <span class="material-symbols-outlined invoice-empty-icon">receipt_long</span>
      <p class="fs-5 fw-bold mb-1"><%= t('invoice.no_invoices_tenant') %></p>
      <p class="text-secondary mb-0"><%= t('invoice.no_invoices_tenant_hint') %></p>
    </div>
  <% else %>
    <div class="table-responsive bg-white rounded-3 shadow-sm border">
      <table class="table invoice-table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th class="ps-3"><%= t('invoice.code') %></th>
            <th><%= t('invoice.payment_term') %></th>
            <th><%= t('invoice.due_date') %></th>
            <th><%= t('invoice.total') %></th>
            <th><%= t('common.status', default: 'Trạng thái') %></th>
            <th class="text-end pe-3"><%= t('invoice.title') %></th>
          </tr>
        </thead>
        <tbody>
          <% @invoices.each do |inv| %>
            <tr>
              <td class="ps-3">
                <div class="invoice-code-tag">
                  <%= link_to inv.code, tenant_invoice_path(inv), class: "text-decoration-none" %>
                </div>
                <div class="text-secondary small font-monospace">ID: #<%= inv.id %></div>
              </td>
              <td class="font-monospace fw-semibold"><%= t('common.month', default: 'Tháng') %> <%= inv.billing_month.strftime("%m/%Y") %></td>
              <td>
                <span class="<%= 'text-danger fw-bold' if inv.overdue? %> font-monospace">
                  <%= inv.due_date.strftime("%d/%m/%Y") %>
                </span>
              </td>
              <td>
                <span class="fs-6 invoice-amount-pill">
                  <%= number_to_currency(inv.total_amount, unit: "đ", format: "%n %u") %>
                </span>
              </td>
              <td>
                <% case inv.status %>
                <% when "paid" %>
                  <span class="invoice-badge invoice-badge-paid">
                    <span class="material-symbols-outlined fs-6">check_circle</span> <%= t('invoice.status.paid') %>
                  </span>
                <% when "pending" %>
                  <% if inv.overdue? %>
                    <span class="invoice-badge invoice-badge-overdue">
                      <span class="material-symbols-outlined fs-6">error</span> <%= t('invoice.status.overdue') %>
                    </span>
                  <% else %>
                    <span class="invoice-badge invoice-badge-pending">
                      <span class="material-symbols-outlined fs-6">hourglass_top</span> <%= t('invoice.status.waiting_payment') %>
                    </span>
                  <% end %>
                <% end %>
              </td>
              <td class="text-end pe-3">
                <%= link_to tenant_invoice_path(inv), class: "btn btn-sm btn-primary d-inline-flex align-items-center gap-1 shadow-sm" do %>
                  <span class="material-symbols-outlined fs-6">qr_code_2</span> <%= t('invoice.actions.detail_and_qr') %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
