<%# locals: (inv:) %>
<tr id="<%= dom_id(inv) %>">
  <td class="ps-3">
    <p class="invoice-code-tag mb-1"><%= inv.code %></p>
    <p class="fw-semibold mb-1"><%= inv.title %></p>
    <div class="d-flex align-items-center flex-wrap gap-1 mt-1">
      <% if inv.room.present? %>
        <span class="badge bg-light text-secondary border"><%= inv.room.title_name %></span>
      <% end %>
      <%= invoice_type_badge(inv, show_target: false) %>
    </div>
  </td>
  <td class="fw-semibold"><%= t('month') %> <%= format_month(inv.billing_month) %></td>
  <td>
    <span class="<%= 'text-danger fw-bold' if inv.overdue? %>">
      <%= format_date(inv.due_date) %>
    </span>
  </td>
  <td>
    <span class="fs-6 invoice-amount-pill">
      <%= format_money(inv.total_amount) %>
    </span>
  </td>
  <td>
    <%= invoice_status_badge(inv) %>
  </td>
  <td class="text-center">
    <div class="d-flex align-items-center justify-content-center gap-2">
      <% if inv.pending? || inv.overdue? %>
        <button type="button"
                class="table-action text-success border-0"
                data-bs-toggle="modal"
                data-bs-target="#tenantMarkPaidModal_<%= inv.id %>"
                title="<%= t('invoice.actions.done') %>">
          <span class="material-symbols-filled">paid</span>
        </button>
      <% end %>

      <%= link_to tenant_invoice_path(inv),
                  data: { turbo_frame: "_top" },
                  class: "table-action px-1 py-0",
                  title: t('invoice.actions.detail_and_qr') do %>
        <span class="material-symbols-filled">visibility</span>
      <% end %>
    </div>

    <% if inv.pending? || inv.overdue? %>
      <%= render "tenant_portal/invoices/payment_modal", invoice: inv %>
    <% end %>
  </td>
</tr>
