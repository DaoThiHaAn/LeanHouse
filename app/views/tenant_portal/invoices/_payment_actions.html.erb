<%# locals: (invoice:) %>
<% if invoice.paid? %>
  <div class="d-flex gap-2 flex-wrap align-items-center">
    <span class="badge bg-success px-3 py-2 fs-6"><%= t('invoice.paid_completed') %></span>
    <span class="badge bg-light text-dark border px-3 py-2 fs-6">
      <%= t('invoice.payment_method_label') %>: <%= invoice.cash? ? t('invoice.payment_methods.cash') : t('invoice.payment_methods.transfer') %>
    </span>
    <% if invoice.paid_at.present? %>
      <span class="text-secondary small"><%= format_datetime(invoice.paid_at) %></span>
    <% end %>
  </div>

  <div class="mt-3 pt-3 border-top">
    <label class="form-label fw-bold text-dark mb-1 d-block"><%= t('invoice.payment_proof') %>:</label>
    <% if invoice.payment_proof.attached? %>
      <div class="payment-proof-thumb-wrapper" data-bs-toggle="modal" data-bs-target="#tenantViewPaymentProofModal" title="<%= t('invoice.payment_proof_zoom') %>">
        <%= image_tag invoice.payment_proof, class: "payment-proof-thumb", alt: t('invoice.payment_proof') %>
        <div class="payment-proof-zoom-icon">
          <span class="material-symbols-outlined fs-6">zoom_in</span>
        </div>
      </div>
    <% else %>
      <span class="text-secondary small fst-italic"><%= t('invoice.no_payment_proof') %></span>
    <% end %>
  </div>
<% else %>
  <div class="p-3 bg-light rounded border mb-3">
    <div class="small text-secondary"><%= t('invoice.transfer_note_strict') %>:</div>
    <div class="fs-6 font-monospace fw-bold text-primary mt-1"><%= invoice.transfer_note %></div>
  </div>

  <div class="d-flex gap-2 flex-wrap d-print-none">
    <button type="button" class="btn btn-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#tenantMarkPaidModal">
      <span class="material-symbols-outlined fs-5">payments</span>
      <%= t('invoice.submit_tenant_payment') %>
    </button>
  </div>
<% end %>
