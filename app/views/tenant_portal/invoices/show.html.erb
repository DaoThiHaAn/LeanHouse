<% content_for :title, "#{t('invoice.self')} #{@invoice.code} - #{@invoice.house.name}" %>
<%= turbo_stream_from @invoice, :payment %>

<div class="container py-4 invoice-detail-wrapper">
  <!-- Navigation Top Bar -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom d-print-none flex-wrap gap-2">
    <div>
      <%= back_link_to tenant_invoices_path, t("invoice.my_invoices") %>
    </div>

    <h1><%= t('invoice.detail') %></h1>

    <div class="d-flex align-items-center gap-2">
      <button type="button" class="manual-btn d-flex align-items-center gap-1 px-2" data-bs-toggle="modal" data-bs-target="#tenantInvoiceGuideModal">
        <span class="material-symbols-outlined fs-6">help</span> <%= t('invoice.tenant_guide.btn_title') %>
      </button>

      <button onclick="window.print()" class="btn btn-outline-dark btn-sm d-flex align-items-center gap-1 shadow-sm px-3 py-1-5 rounded-pill">
        <span class="material-symbols-outlined fs-6">print</span> <%= t('invoice.actions.print') %>
      </button>
    </div>
  </div>

  <div id="invoice_detail_card_<%= @invoice.id %>">
    <%= render "layouts/shared_components/invoice_detail_card", invoice: @invoice, bank_account: @bank_account do %>
      <%= render "layouts/shared_components/invoices/payment_actions", invoice: @invoice, portal: :tenant %>
    <% end %>
  </div>
</div>

<%= render "tenant_portal/invoices/show_modals", invoice: @invoice, bank_account: @bank_account %>
