<% content_for :title, "#{t('invoice.title')} #{@invoice.code} - #{@house.name}" %>

<div class="container py-4 invoice-detail-wrapper">
  <!-- Navigation Top Bar -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom d-print-none">
    <%= link_to tenant_invoices_path, class: "btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 shadow-sm" do %>
      <span class="material-symbols-outlined fs-6">arrow_back</span> <%= t('invoice.my_invoices') %>
    <% end %>

    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-dark btn-sm d-flex align-items-center gap-1 shadow-sm">
        <span class="material-symbols-outlined fs-6">print</span> <%= t('invoice.actions.print') %>
      </button>
    </div>
  </div>

  <%= render "layouts/shared_components/invoice_detail_card", invoice: @invoice, bank_account: @bank_account do %>
    <%= render "tenant_portal/invoices/payment_actions", invoice: @invoice %>
  <% end %>
</div>

<%= render "tenant_portal/invoices/show_modals", invoice: @invoice, bank_account: @bank_account %>
