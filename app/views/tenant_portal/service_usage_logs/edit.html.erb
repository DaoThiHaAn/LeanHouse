<%= turbo_frame_tag dom_id(@log), class: "table-row-frame" do %>
  <% if turbo_frame_request? %>
    <tr class="table-light">
      <td colspan="8" class="p-3">
        <div class="card shadow-sm border rounded-3 bg-white">
          <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="card-title fw-bold mb-0 d-flex align-items-center gap-2">
              <span class="material-symbols-outlined text-primary fs-5">photo_camera</span>
              <span><%= t("invoice.submit_service_log_header", service: @log.service_name, month: @log.billing_month.strftime("%m/%Y")) %></span>
            </h6>
            <%= link_to t("invoice.actions.back"), tenant_service_usage_log_path(@log), class: "btn btn-sm btn-outline-secondary py-0 px-2" %>
          </div>
          <div class="card-body p-3">
            <%= render "form", log: @log %>
          </div>
        </div>
      </td>
    </tr>
  <% else %>
    <% content_for :title, t("invoice.submit_meter_log_title") %>
    <div class="container py-4 usage-log-tenant-form-wrapper">
      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h5 class="card-title fw-bold mb-0 d-flex align-items-center gap-2">
            <span class="material-symbols-outlined text-primary">photo_camera</span>
            <%= t("invoice.submit_service_log_header", service: @log.service_name, month: @log.billing_month.strftime("%m/%Y")) %>
          </h5>
          <%= link_to t("invoice.actions.back"), tenant_service_usage_log_path(@log), class: "btn btn-sm btn-outline-secondary" %>
        </div>
        <div class="card-body p-4">
          <%= render "form", log: @log %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
