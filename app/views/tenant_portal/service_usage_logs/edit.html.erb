<% content_for :title, t("invoice.submit_meter_log_title") %>

<div class="container py-4 usage-log-tenant-form-wrapper">
  <div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="card-title fw-bold mb-0 d-flex align-items-center gap-2">
        <span class="material-symbols-outlined text-primary">photo_camera</span>
        <%= t("invoice.submit_service_log_header", service: @log.service_name, month: @log.billing_month.strftime("%m/%Y")) %>
      </h5>
      <%= link_to t("invoice.actions.back"), tenant_service_usage_logs_path, class: "btn btn-sm btn-outline-secondary" %>
    </div>
    <div class="card-body p-4">
      <div class="alert alert-info py-2 small mb-4">
        <%= t("invoice.tenant_meter_warning_html", reading: @log.prev_reading, unit: @log.unit) %>
      </div>

      <%= form_with model: [:tenant, @log], local: true do |f| %>
        <% if @log.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @log.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :latest_reading, t("invoice.current_meter_reading_label", unit: @log.unit), class: "form-label fw-semibold" %>
          <%= f.number_field :latest_reading, class: "form-control form-control-lg font-monospace fw-bold", placeholder: t("invoice.reading_example_placeholder", val: @log.prev_reading + 50), required: true, min: @log.prev_reading %>
        </div>

        <div class="mb-4">
          <%= f.label :reading_photo, t("invoice.upload_meter_photo_label"), class: "form-label fw-semibold" %>
          <%= f.file_field :reading_photo, accept: "image/*", capture: "environment", class: "form-control shadow-sm" %>
          <% if @log.reading_photo.attached? %>
            <div class="mt-2">
              <span class="text-secondary small"><%= t("invoice.previously_uploaded_photo") %></span><br>
              <%= image_tag @log.reading_photo.variant(resize_to_limit: [120, 120]), alt: t("invoice.meter_photo"),
                  class: "rounded border mt-1 shadow-sm" %>
            </div>
          <% end %>
        </div>

        <div class="d-grid">
          <%= f.submit t("invoice.submit_reading_btn_text"), class: "btn btn-primary btn-lg fw-semibold" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

