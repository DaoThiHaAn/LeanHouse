<% content_for :title, t("invoice.submit_meter_log_title") %>

<div class="container py-4 usage-log-tenant-form-wrapper">
  <div class="card shadow-sm">
    <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between gap-2 align-items-center">
      <div>
        <h1 class="d-flex align-items-center gap-2 mb-2">
          <span class="material-symbols-filled fs-2">photo_camera</span>
          <%= t("invoice.submit_meter_log_title") %>
        </h1>

        <p class="ms-5 fs-5 fw-bold d-flex align-items-center gap-3">
          <%= @log.service_name %>
          <span class="badge text-bg-secondary">
            <%= t("invoice.billing_month").capitalize %>
            <%= @log.billing_month.strftime("%m/%Y") %>
          </span>
        </p>
      </div>

      <%= back_link_to tenant_service_usage_log_path(@log), t("invoice.actions.back") %>
    </div>

    <div class="card-body p-4">
      <%= render "form", log: @log %>
    </div>
  </div>
</div>
