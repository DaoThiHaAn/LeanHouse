<div class="alert alert-info py-2 small mb-3">
  <%= t("invoice.tenant_meter_warning_html", reading: log.prev_reading, unit: log.unit) %>
</div>

<%= form_with model: [:tenant, log],
              data: {
                turbo_frame: "_top",
                controller: "loading",
                loading_text_value: "#{t('saving')}...",
                action: "submit->loading#submit"
              } do |f| %>
  <% if log.errors.any? %>
    <div class="alert alert-danger py-2 px-3 small mb-3">
      <ul class="mb-0 ps-3">
        <% log.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :latest_reading, class: "form-label fw-semibold small" do %>
        <%= t("invoice.current_meter_reading_label", unit: log.unit) %> <span class="text-danger">*</span>
      <% end %>
      <%= f.number_field :latest_reading,
          class: "form-control",
          placeholder: t("invoice.reading_example_placeholder", val: log.prev_reading + 1),
          required: true, min: log.prev_reading %>
    </div>

    <% has_attached_photo = log.reading_photo.attached? %>
    <div class="col-md-6"
         data-controller="file-preview"
         data-file-preview-storage-key-value="usage_log_photo_<%= log.id || 'new' %>">
      <%= f.label :reading_photo, class: "form-label fw-semibold small" do %>
        <%= t("invoice.upload_meter_photo_label") %>
        <span class="text-danger <%= 'd-none' if has_attached_photo %>" data-file-preview-target="requiredAsterisk">*</span>
      <% end %>
      <%= f.file_field :reading_photo,
                       accept: "image/*",
                       capture: "environment",
                       class: "form-control shadow-sm",
                       required: !has_attached_photo,
                       data: {
                         file_preview_target: "input",
                         action: "change->file-preview#preview"
                       } %>
      <%= f.hidden_field :purge_reading_photo, value: "0", data: { file_preview_target: "purgeInput" } %>

      <!-- Live upload preview with remove (x) button -->
      <div class="position-relative d-inline-block mt-3 <%= 'd-none' unless has_attached_photo %>" data-file-preview-target="container">
        <img src="<%= url_for(log.reading_photo) if has_attached_photo %>"
             alt="<%= t("invoice.meter_photo") %>"
             class="rounded border shadow-sm img-preview"
             data-file-preview-target="preview">
        <button type="button"
                class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 d-flex align-items-center justify-content-center p-0 shadow"
                style="width: 24px; height: 24px; transform: translate(30%, -30%); z-index: 5;"
                data-action="click->file-preview#clear"
                title="<%= t("clear_img") %>">
          <span class="material-symbols-outlined fs-5">close</span>
        </button>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top">
    <%= f.button type: :submit,
                 class: "custom-primary-btn d-inline-flex align-items-center justify-content-center gap-2",
                 data: { loading_target: "button" } do %>
      <span data-loading-target="text"><%= t("invoice.submit_reading_btn_text") %></span>
      <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">
        progress_activity
      </span>
    <% end %>
  </div>
<% end %>
