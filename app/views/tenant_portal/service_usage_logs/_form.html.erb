<div class="alert alert-info py-2 small mb-3">
  <%= t("invoice.tenant_meter_warning_html", reading: log.prev_reading, unit: log.unit) %>
</div>

<%= form_with model: [:tenant, log],
              data: {
                controller: "loading",
                loading_text_value: "#{t('saving')}...",
                action: "submit->loading#submit"
              } do |f| %>
  <% if log.errors.any? %>
    <div class="alert alert-danger py-2 px-3 small mb-3">
      <ul class="mb-0 ps-3">
        <% log.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :latest_reading, class: "form-label fw-semibold small" do %>
        <%= t("invoice.current_meter_reading_label", unit: log.unit) %> <span class="text-danger">*</span>
      <% end %>
      <%= f.number_field :latest_reading, class: "form-control font-monospace fw-bold", placeholder: t("invoice.reading_example_placeholder", val: log.prev_reading + 50), required: true, min: log.prev_reading %>
    </div>

    <div class="col-md-6">
      <%= f.label :reading_photo, class: "form-label fw-semibold small" do %>
        <%= t("invoice.upload_meter_photo_label") %>
        <% unless log.reading_photo.attached? %>
          <span class="text-danger">*</span>
        <% end %>
      <% end %>
      <%= f.file_field :reading_photo, accept: "image/*", capture: "environment", class: "form-control shadow-sm", required: !log.reading_photo.attached? %>
      <% if log.reading_photo.attached? %>
        <div class="mt-2 d-flex align-items-center gap-2">
          <span class="text-secondary small"><%= t("invoice.previously_uploaded_photo") %>:</span>
          <%= image_tag log.reading_photo.variant(resize_to_limit: [40, 40]), alt: t("invoice.meter_photo"), class: "rounded border shadow-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-end align-items-center gap-2 pt-2 border-top">
    <%= link_to t("invoice.actions.back"), tenant_service_usage_log_path(log), class: "btn btn-sm btn-outline-secondary" %>
    <%= f.button type: :submit,
                 class: "btn btn-sm btn-primary fw-semibold d-inline-flex align-items-center justify-content-center gap-2",
                 data: { loading_target: "button" } do %>
      <span data-loading-target="text"><%= t("invoice.submit_reading_btn_text") %></span>
      <span class="material-symbols-outlined spin d-none" data-loading-target="spinner">
        progress_activity
      </span>
    <% end %>
  </div>
<% end %>
