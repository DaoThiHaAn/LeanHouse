<% content_for :title, t("invoice.meter_logs_tenant_title", room: "#{@room.title_name}, #{@room.floor&.title_name}") %>

<div class="main-container py-4 usage-log-wrapper">
  <%= turbo_frame_tag "tenant_service_logs_section",
        data: {
          controller: "pagination-sync",
          pagination_sync_canonical_url_value: tenant_service_usage_logs_path,
          pagination_sync_default_params_value: { tab: @current_tab, month: @billing_month.strftime("%Y-%m") }.to_json,
          pagination_sync_query_params_value: ["tab", "month"].to_json,
          pagination_sync_total_pages_selector_value: "[data-pagination-total-pages]",
          action: "turbo:frame-load->pagination-sync#updateUrl"
        } do %>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
      <div>
        <h1 class="mb-3 d-flex align-items-center gap-2">
          <%= t("invoice.service_usage_details") %> - <%= @room.title_name %>, <%= @room.floor&.title_name %>
        </h1>
        <p class="text-secondary"><%= t("invoice.meter_logs_tenant_subtitle") %></p>
      </div>

      <!-- 2 Tabs and Guide Button at the right end of the header row -->
      <div class="d-flex align-items-center gap-2 flex-wrap justify-content-between w-100">
        <%= back_link_to tenant_services_path, t("service.back") %>

        <div class="d-inline-flex bg-light p-1 rounded-pill border gap-1 shadow-sm fs-5">
          <%= link_to tenant_service_usage_logs_path(tab: "real_time", month: @billing_month.strftime("%Y-%m")),
                      class: "log-tab d-flex align-items-center gap-1 px-3 rounded-pill small text-decoration-none fw-semibold transition #{@current_tab == 'real_time' ? 'active shadow-sm' : 'text-secondary'}",
                      data: { turbo_action: "advance" } do %>
            <span class="material-symbols-filled fs-4">speed</span>
            <span><%= t("service_usage_logs.tab_real_time") %></span>
            <% if @unconfirmed_count.to_i > 0 %>
              <span class="badge rounded-pill ms-1"><%= @unconfirmed_count %></span>
            <% end %>
          <% end %>

          <%= link_to tenant_service_usage_logs_path(tab: "fixed", month: @billing_month.strftime("%Y-%m")),
                      class: "log-tab d-flex align-items-center gap-1 px-3 rounded-pill small text-decoration-none fw-semibold transition #{@current_tab == 'fixed' ? 'active shadow-sm' : 'text-secondary'}",
                      data: { turbo_action: "advance" } do %>
            <span class="material-symbols-filled fs-4">lock</span>
            <span><%= t("service_usage_logs.tab_fixed") %></span>
            <% if @fixed_services_count.to_i > 0 %>
              <span class="badge rounded-pill ms-1"><%= @fixed_services_count %></span>
            <% end %>
          <% end %>
        </div>

        <button type="button"
                class="btn btn-outline-primary d-inline-flex align-items-center gap-1 px-3 py-1 small"
                data-bs-toggle="modal" data-bs-target="#billingMonthGuideModal">
          <span class="material-symbols-outlined fs-6">help_outline</span>
          <span><%= t("guide") %></span>
        </button>
      </div>
    </div>

    <% if @stay_start_month.present? %>
      <div class="tenant-stay-scope-notice mb-4 d-flex align-items-center gap-2 shadow-sm">
        <span class="material-symbols-outlined fs-5">info</span>
        <span class="small fw-medium">
          <%= t("invoice.tenant_history_scope_notice", month: @stay_start_month.strftime("%m/%Y")) %>
        </span>
      </div>
    <% end %>

    <% if @current_tab == "fixed" %>
      <%= render "tenant_fixed_services",
                 summary: @fixed_services_summary,
                 min_billing_month: @stay_start_month %>
    <% else %>
      <!-- Real-time Tab Content -->
      <!-- Filter Toolbar -->
      <div class="card bg-light border-0 rounded-3 p-3 mb-4">
        <%= form_with url: tenant_service_usage_logs_path,
                      method: :get,
                      class: "d-flex align-items-center justify-content-between flex-wrap gap-3",
                      data: {
                        turbo_frame: "tenant_service_logs_section",
                        turbo_action: "advance"
                      } do |f| %>
          <%= f.hidden_field :tab, value: "real_time" %>

          <div class="d-flex flex-column gap-1">
            <div class="d-flex align-items-center flex-wrap gap-2">
              <label for="realtime_month_filter" class="fw-bold text-nowrap mb-0">
                <%= t("invoice.billing_month") %>:
              </label>

              <div class="d-flex align-items-center flex-wrap gap-2">
                <%= f.month_field :month,
                                  id: "realtime_month_filter",
                                  value: @billing_month.strftime("%Y-%m"),
                                  min: @stay_start_month, placeholder: "yyyy-mm",
                                  class: "form-control shadow-sm w-auto",
                                  onchange: "this.form.requestSubmit()" %>

                <% valid_filter = @stay_start_month.nil? || @billing_month >= @stay_start_month %>
                <% if valid_filter %>
                  <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle d-inline-flex align-items-center gap-1 py-1 px-2">
                    <span class="material-symbols-outlined fs-6">calendar_month</span>
                    <span><%= t("service_usage_logs.filtering_month", month: @billing_month.strftime("%m/%Y")) %></span>
                  </span>
                <% else %>
                  <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-inline-flex align-items-center gap-1 py-1 px-2">
                    <span class="material-symbols-outlined fs-6">warning</span>
                    <span><%= t("service_usage_logs.outside_stay_period") %></span>
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @logs.empty? %>
        <div class="empty card bg-light text-center py-5 rounded-4">
          <span class="material-symbols-outlined text-secondary fs-1 mb-2">fact_check</span>
          <p class="fs-5 fw-bold mb-1"><%= t("invoice.no_logs_for_month") %></p>
          <p class="text-secondary small mb-0"><%= t("invoice.no_logs_for_month_hint") %></p>
        </div>
      <% else %>
      <div class="table-responsive bg-white rounded-3 shadow-sm border">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">
                <span><%= t("common.month") %></span>
                <span class="material-symbols-outlined fs-6 text-secondary cursor-pointer align-middle"
                      <%= tooltip("top", :"service_usage_logs.billing_month_explanation_tooltip", html: true) %>>
                  help
                </span>
              </th>
              <th><%= t("service.self") %></th>
              <th><%= t("invoice.prev_reading") %></th>
              <th><%= t("invoice.latest_reading") %></th>
              <th><%= t("invoice.consumption") %></th>
              <th><%= t("invoice.meter_photo") %></th>
              <th><%= t("status") %></th>
              <th class="text-end pe-3"><%= t("actions") %></th>
            </tr>
          </thead>

          <tbody>
            <% @logs.each do |log| %>
              <%= render "tenant_portal/service_usage_logs/row", log: log %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>

  <%= render "billing_month_guide_modal" %>
<% end %>
</div>
