<%# Local variables: contract, days_stayed, total_days, stay_progress_pct, pending_requests_count, soonest_vehicle_request %>

<div class="row g-4 mt-1 mb-4">
  <!-- Card 1: Thời hạn hợp đồng & Tiến độ ở -->
  <div class="col-12 col-lg-6">
    <div class="dashboard-stat-card tenant-stat-card card-contract-due p-3 shadow-sm d-flex flex-column justify-content-between h-100">
      <div class="d-flex align-items-start justify-content-between gap-3">
        <div class="d-flex gap-3 align-items-center">
          <%= image_tag 'contract-tenant.png', alt: "Contract icon", width: "50px" %>

          <div>
            <h2 class="stat-card-title contract-title mb-2"><%= t("dashboard.tenant.contract_due_title") %></h2>
            <div class="stat-value contract-value mb-1">
              <%= contract&.due_date ? contract.due_date.strftime("%d/%m/%Y") : t("dashboard.tenant.no_contract") %>
            </div>
          </div>
        </div>

        <% if contract.present? %>
          <%= link_to tenant_contract_path, class: "action-arrow-btn arrow-contract", title: t("dashboard.tenant.view_contract") do %>
            <span class="material-symbols-outlined">arrow_forward</span>
          <% end %>
        <% else %>
          <div class="action-arrow-btn arrow-contract disabled">
            <span class="material-symbols-outlined">arrow_forward</span>
          </div>
        <% end %>
      </div>

      <!-- Counter of days stayed + Circular chart -->
      <% if contract&.start_date.present? %>
        <div class="stat-subtext mt-3 pt-2 border-top border-light-subtle d-flex align-items-center justify-content-between flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2">
            <!-- Circular progress ring -->
            <svg class="stay-progress-ring flex-shrink-0" viewBox="0 0 36 36" width="36" height="36">
              <path class="ring-bg"
                d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                fill="none" stroke="#D3DDF8" stroke-width="3.5" />
              <path class="ring-progress"
                stroke-dasharray="<%= stay_progress_pct %>, 100"
                d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                fill="none" stroke="#2B368C" stroke-width="3.5" stroke-linecap="round" />
              <text x="18" y="20.5" class="ring-text" text-anchor="middle" font-size="8.5" font-weight="bold" fill="#2B368C"><%= stay_progress_pct %>%</text>
            </svg>

            <div class="stay-days-info">
              <span class="fw-bold text-dark"><%= t("dashboard.tenant.days_stayed", days: days_stayed) %></span>
              <span class="material-symbols-outlined fs-6"
                  <%= tooltip("right", :"dashboard.tenant.stay_progress", html: true) %>>
                info
              </span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Card 2: Yêu cầu chờ xử lý -->
  <div class="col-12 col-lg-6">
    <div class="dashboard-stat-card tenant-stat-card card-pending-requests p-3 shadow-sm d-flex flex-column justify-content-between h-100">
      <div class="d-flex align-items-start justify-content-between gap-3">
        <div class="d-flex gap-3 align-items-center">
          <%= image_tag 'request-tenant.png', alt: "Contract icon", width: "50px" %>

          <div>
            <h2 class="stat-card-title request-title mb-1"><%= t("dashboard.tenant.pending_requests_title") %></h2>
            <div class="stat-value request-value mb-1">
              <%= pending_requests_count %>
            </div>
          </div>
        </div>

        <%= link_to tenant_requests_path(status: "pending"), class: "action-arrow-btn arrow-requests", title: t("dashboard.tenant.view_requests") do %>
          <span class="material-symbols-outlined">arrow_forward</span>
        <% end %>
      </div>

      <div class="stat-subtext mt-3 pt-2 border-top border-light-subtle">
        <% if soonest_vehicle_request %>
          <% if soonest_vehicle_request[:remaining_days] > 0 %>
            <span class="<%= soonest_vehicle_request[:is_urgent] ? 'text-danger fw-bold' : 'text-warning-emphasis fw-semibold' %>">
              <%= t("dashboard.tenant.vehicle_request_due_in_days", days: soonest_vehicle_request[:remaining_days]) %>
            </span>
          <% elsif soonest_vehicle_request[:remaining_hours] > 0 %>
            <span class="text-danger fw-bold">
              <%= t("dashboard.tenant.vehicle_request_due_in_hours", hours: soonest_vehicle_request[:remaining_hours]) %>
            </span>
          <% else %>
            <span class="text-danger fw-bold">
              <%= t("dashboard.tenant.vehicle_request_due_today") %>
            </span>
          <% end %>
        <% else %>
          <span class="text-muted"><%= t("dashboard.tenant.view_requests") %></span>
        <% end %>
      </div>
    </div>
  </div>
</div>
