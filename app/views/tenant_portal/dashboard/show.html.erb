<%# Variables: @tenant, @tenant_stay, @house, @stats %>
<% content_for :title, t("dashboard.self") %>

<div class="tenant-dashboard house-main-container">
  <h1 class="text-center my-4"><%= t("dashboard.self") %></h1>

  <%= render "tenant_portal/shared/room_info_zone", house: @house, tenant_stay: @tenant_stay %>

  <%= render "tenant_portal/dashboard/stats_grid", stats: @stats %>
</div>
