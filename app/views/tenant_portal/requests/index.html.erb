<%= content_for :title, t("request.mine") %>

<div class="request main-container">
  <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
    <div>
      <h1 class="mb-2"><%= t("request.mine") %></h1>
      <p class="text-secondary"><%= t("request.mine_mng") %></p>
    </div>

    <!-- Create Button / Dropdown -->
    <% if @tenant_stay.present? %>
      <!-- Active Stay: Show Working Dropdown -->
      <div class="dropdown">
        <button class="main-btn shadow-sm px-3 py-2 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <%= t("request.create") %>
        </button>

        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
          <li>
            <%= link_to new_tenant_vehicle_request_path,
                class: "dropdown-item py-2",
                data: { turbo_frame: "new_vehicle_modal" } do %>
              <%= image_tag 'vehicle.png', alt: "Vehicle Add icon", height: "20px" %>&nbsp;
              <%= t("request.vehicle_register") %>
            <% end %>
          </li>

          <li>
            <%= link_to new_tenant_repair_request_path,
                class: "dropdown-item py-2",
                data: { turbo_frame: "new_repair_modal" } do %>
              <%= image_tag 'repair.png', alt: "Repair icon", height: "20px" %>&nbsp;
              <%= t("request.repair_request") %>
            <% end %>
          </li>

          <li>
            <% confirm_text = [
                 t("request.confirm_leave_house", default: "Bạn có chắc chắn muốn gửi Yêu cầu rời nhà?"),
                 (@tenant_stay&.has_contract? ? t("request.leave_house_contract_warning", default: "Lưu ý: Hợp đồng thuê hiện tại của bạn sẽ bị chấm dứt khi Chủ nhà xét duyệt yêu cầu này.") : nil)
               ].compact.join("\n\n") %>
            <%= button_to tenant_leave_house_requests_path,
                method: :post,
                class: "dropdown-item py-2 text-danger d-flex align-items-center gap-1",
                data: { turbo_confirm: confirm_text } do %>
              <%= image_tag 'exit.png', alt: "Exit icon", height: "20px" %>&nbsp;
              <%= t("request.leave_house") %>
            <% end %>
          </li>
        </ul>
      </div>
    <% else %>
      <!-- Unlinked Tenant: Disabled Button with Tooltip -->
      <span class="d-inline-block" tabindex="0" <%= tooltip("top", :"request.create_note", html: true) %>>
        <button class="main-btn px-3 py-2 disabled" type="button" disabled style="pointer-events: none;">
          <%= t("request.create") %>
        </button>
      </span>
    <% end %>
  </div>

  <!-- Filter Form -->
  <%= form_with url: filtered_tenant_requests_path,
      method: :get,
      class: "request-form d-flex align-items-center flex-wrap gap-3 mt-4 p-3 justify-content-around rounded-3",
      data: {
        controller: "filter-form",
        filter_form_default_house_value: @house&.id&.to_s || "",
        turbo_frame: "requests_table",
        turbo_action: "advance"
      } do |f| %>

    <!-- 1. House Filter -->
    <div class="d-flex flex-column gap-1">
      <%= f.label :house_id, t("request.house_filter"), class: "form-label fw-semibold mb-0" %>
      <%= f.select :house_id,
            tenant_house_filter_options(@linked_houses, @house),
            { selected: @selected_house_id },
            class: "form-select form-select-sm shadow-sm",
            data: {
              filter_form_target: "houseSelect",
              action: "change->filter-form#changed"
            } %>
    </div>

    <!-- 2. Sent Time Filter (Month + Year) -->
    <div class="d-flex flex-column gap-1">
      <%= f.label :month, t("request.sent_time"), class: "form-label fw-semibold mb-0" %>

      <div class="input-group flex-nowrap">
        <span class="input-group-text"><%= t("request.sent_month") %></span>
        <%= f.select :month,
              [[t("all"), ""]] + (1..12).map { |m| [m.to_s.rjust(2, "0"), m.to_s] },
              { selected: params[:month] },
              class: "form-select form-select-sm shadow-sm",
              data: {
                filter_form_target: "monthSelect",
                action: "change->filter-form#changed"
              } %>

        <span class="input-group-text"><%= t("request.sent_year") %></span>
        <%= f.select :year,
              tenant_year_filter_options(@tenant),
              { selected: params[:year] },
              class: "form-select form-select-sm shadow-sm",
              data: {
                filter_form_target: "yearSelect",
                action: "change->filter-form#changed"
              } %>
      </div>
    </div>

    <!-- 3. Status Filter -->
    <div class="d-flex flex-column gap-1">
      <%= f.label :status, t("request.status"), class: "form-label  fw-semibold mb-0" %>
      <%= f.select :status,
            [[t("all"), ""]] + Request.status_options,
            { selected: params[:status] },
            class: "form-select form-select-sm shadow-sm",
            data: {
              filter_form_target: "statusSelect",
              action: "change->filter-form#changed"
            } %>
    </div>

    <!-- 4. Request Type Filter -->
    <div class="d-flex flex-column gap-1">
      <%= f.label :request_type, t("request.type"), class: "form-label  fw-semibold mb-0" %>
      <%= f.select :request_type,
            [[t("all"), ""]] + Request.request_type_options,
            { selected: params[:request_type] },
            class: "form-select form-select-sm shadow-sm",
            data: {
              filter_form_target: "requestTypeSelect",
              action: "change->filter-form#changed"
            } %>
    </div>

    <!-- Clear Filter Button (Dynamically toggled by Stimulus) -->
    <div class="align-self-end ms-auto d-none" data-filter-form-target="clearButton">
      <button type="button"
              class="filter-off btn btn-sm btn-outline-secondary bg-light d-flex align-items-center gap-1"
              data-action="click->filter-form#clear">
        <span class="material-symbols-outlined fs-6">filter_alt_off</span>
        <%= t("request.clear_filter") %>
      </button>
    </div>
  <% end %>

  <h2 class="mt-5 ms-3"><%= t("request.list") %></h2>

  <!-- Requests Table Section (Turbo Frame) -->
  <%= turbo_frame_tag "requests_table",
        src: filtered_tenant_requests_path(params.permit(:page, :house_id, :month, :year, :status, :request_type)),
        loading: :lazy,
        data: {
          controller: "pagination-sync",
          pagination_sync_canonical_url_value: tenant_requests_path,
          pagination_sync_default_params_value: {}.to_json,
          pagination_sync_query_params_value: ["house_id", "month", "year", "status", "request_type"].to_json,
          pagination_sync_total_pages_selector_value: "[data-pagination-total-pages]",
          action: "turbo:frame-load->pagination-sync#updateUrl"
        } do %>
    <%= loading_spinner %>
  <% end %>
</div>

<%= turbo_frame_tag "new_vehicle_modal" %>
<%= turbo_frame_tag "new_repair_modal" %>
<%= turbo_frame_tag "request_detail_modal" %>
