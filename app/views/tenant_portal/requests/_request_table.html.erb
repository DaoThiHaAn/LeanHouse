<%# Local variables: requests %>

<%= turbo_frame_tag "requests_table" do %>
  <!-- Used by Stimulus pagination-sync to update URL -->
  <span hidden data-pagination-total-pages="<%= requests.total_pages %>"></span>

  <% if requests.empty? %>
    <div class="text-center py-5">
      <p class="fs-5 fw-medium text-muted mb-2">
        <%= (params[:house_id].present? || params[:month].present? || params[:year].present? || params[:status].present? || params[:request_type].present?) ? t("request.unfound") : t("request.none") %>
      </p>
      <%= image_tag 'request.png', alt: "Request icon", width: "160px", class: "d-block mx-auto mt-3 opacity-75" %>
    </div>
  <% else %>
    <div class="table-responsive border rounded-3 bg-white mt-3">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="py-3 px-3"><%= t("request.id") %></th>
            <th scope="col" class="py-3 px-3"><%= t("request.type") %></th>
            <th scope="col" class="py-3 px-3 text-center"><%= t("request.status") %></th>
            <th scope="col" class="py-3 px-3 text-center"><%= t("request.sent_at") %></th>
            <th scope="col" class="py-3 px-3 text-center"><%= t("request.updated_at") %></th>
            <th scope="col" class="py-3 px-3 text-center"><%= t("actions", default: "Hành động") %></th>
          </tr>
        </thead>
        <tbody>
          <% requests.each do |request| %>
            <tr>
              <!-- Request ID -->
              <td class="px-3 fw-semibold text-muted">
                #<%= request.id %>
              </td>

              <!-- Request Type (Clickable to open detail modal) -->
              <td class="px-3">
                <%= link_to tenant_request_path(request),
                      class: "text-decoration-none fw-semibold text-primary d-inline-flex align-items-center gap-1",
                      data: { turbo_frame: "request_detail_modal" },
                      title: t("request.detail_title", default: "Xem chi tiết yêu cầu") do %>
                  <%= request.human_request_type %>
                <% end %>
              </td>

              <!-- Status -->
              <td class="px-3 text-center">
                <%= request_status_badge(request.status) %>
              </td>

              <!-- Sent Time -->
              <td class="px-3 text-center text-muted small">
                <%= request.created_at.strftime("%H:%M - %d/%m/%Y") %>
              </td>

              <!-- Updated Time -->
              <td class="px-3 text-center text-muted small">
                <%= request.updated_at.strftime("%H:%M - %d/%m/%Y") %>
              </td>

              <!-- Action: View Detail button -->
              <td class="px-3 text-center">
                <%= link_to tenant_request_path(request),
                      class: "table-action text-secondary",
                      data: { turbo_frame: "request_detail_modal" },
                      title: t("request.detail_title", default: "Xem chi tiết yêu cầu") do %>
                  <span class="material-symbols-filled fs-5">visibility</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-center mt-4">
      <%= paginate requests,
            params: {
              house_id: params[:house_id],
              month: params[:month],
              year: params[:year],
              status: params[:status],
              request_type: params[:request_type]
            } %>
    </div>
  <% end %>
<% end %>
