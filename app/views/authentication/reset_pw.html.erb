<% content_for :title, "Reset Password" %>

<div class="custom card px-5 py-4 m-5 mx-auto">
    <div class="card-body d-flex flex-column gap-3">
        <h1 class="card-title text-center"><%=t('form.profile.reset_pw').upcase %></h1>

        <!-- TODO handle-->
        <%= form_with model: @user, local: true,
                    data: {
                      controller: "loading",
                      loading_text_value: "#{t('saving', default: 'Đang lưu')}...",
                      action: "submit->loading#submit"
                    },
                    class:"signup-form w-100 d-flex align-items-center flex-column gap-4" do |form| %>

             <!-- Password -->
            <div class="form-group w-100" data-controller="form password-validation">
                <%= form.label :password, class: "form-label d-flex justify-content-between" do%>
                    <div>
                        <%= t('form.profile.password') +  ": "%>
                        <span class="asterisk">*</span>
                    </div>

                    <small class="counter-text">
                        <span data-form-target="charCount">0</span>
                    </small>
                <% end %>

                <div class="position-relative">
                    <%= form.password_field :password, minlength: 8, maxlength: 72, required: true,
                        class: "form-control pe-5 #{invalid_class(@user, :password)}",
                        placeholder: t('form.profile.pw_placeholder'),
                        aria: { describedby: "reset-password-rules" },
                        data: {
                            form_target: "input",
                            password_validation_target: "input",
                            action: "input->form#update input->password-validation#validate blur->password-validation#onBlur focus->password-validation#onFocus"
                        }
                    %>

                    <span class="eye position-absolute me-2 top-50 end-0 translate-middle-y material-symbols-outlined password-toggle"
                            data-action="click->form#togglePasswordVisibility">
                        visibility
                    </span>
                </div>

                <%= field_error(@user, :password) %>

                <div class="field-info mt-2 mb-1 d-flex align-items-center gap-1">
                    <span class="material-symbols-outlined fs-5">info</span>
                    <p class="mb-0"><%= t('form.profile.required_pw') %></p>
                </div>

                <ul class="field-info list-unstyled d-flex flex-column gap-1 mb-1 ps-1 pw-requirements" id="reset-password-rules" aria-live="polite">
                    <li class="pw-requirement d-flex align-items-center gap-2"
                        data-password-validation-target="rule"
                        data-rule="length">
                        <span class="material-symbols-outlined pw-rule-icon fs-6" data-password-validation-target="icon" aria-hidden="true">radio_button_unchecked</span>
                        <span class="pw-rule-text"><%= t('form.profile.pw_length')%></span>
                    </li>
                    <li class="pw-requirement d-flex align-items-center gap-2"
                        data-password-validation-target="rule"
                        data-rule="letter">
                        <span class="material-symbols-outlined pw-rule-icon fs-6" data-password-validation-target="icon" aria-hidden="true">radio_button_unchecked</span>
                        <span class="pw-rule-text"><%= t('form.profile.pw_letters')%></span>
                    </li>
                    <li class="pw-requirement d-flex align-items-center gap-2"
                        data-password-validation-target="rule"
                        data-rule="number">
                        <span class="material-symbols-outlined pw-rule-icon fs-6" data-password-validation-target="icon" aria-hidden="true">radio_button_unchecked</span>
                        <span class="pw-rule-text"><%= t('form.profile.pw_numbers')%></span>
                    </li>
                </ul>
            </div>


            <div class="form-group w-100" data-controller="form">
                <%= form.label :password_confirmation, class: "form-label d-flex justify-content-between" do%>
                    <div>
                        <%= t('form.profile.password_confirmation') +  ": "%>
                        <span class="asterisk">*</span>
                    </div>

                    <small class="counter-text">
                        <span data-form-target="charCount">0</span>
                    </small>
                <% end %>

                <div class="position-relative">
                    <%= form.password_field :password_confirmation, minLength: 8, maxLength: 72, required: true,
                        class: "form-control pe-5 #{invalid_class(@user, :password_confirmation)}",
                        placeholder: t('form.profile.pw_cf_placeholder'),
                        data: {
                            form_target: "input",
                            action: "input->form#update"
                        }
                    %>

                    <span class="eye position-absolute me-2 top-50 end-0 translate-middle-y material-symbols-outlined password-toggle"
                            data-action="click->form#togglePasswordVisibility">
                        visibility
                    </span>
                </div>

                <%= field_error(@user, :password_confirmation) %>
            </div>

            <%= form.button type: :submit,
                  class: "mx-auto custom-primary-btn d-flex align-items-center justify-content-center gap-2",
                  data: { loading_target: "button" } do %>
              <span class="material-symbols-outlined fs-5" data-loading-target="icon">save</span>
              <span class="material-symbols-outlined spin d-none fs-5" data-loading-target="spinner">progress_activity</span>
              <span data-loading-target="text"><%= t("save") %></span>
            <% end %>
        <%end%>

        <% back_path = logged_in? ? (current_user.landlord? ? landlord_profile_path : tenant_profile_path) : forgot_pw_path %>
        <%= back_link_to back_path, class: "mx-auto mt-3" %>

        </div>
    </div>
</div>
