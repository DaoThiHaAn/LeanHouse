# ==============================================================================
# LeanHouse - Environment Variables Template (.env.example)
#
# Use this as a reference when configuring Environment Variables on Render.com
# or in your local deployment tools. Do NOT commit real secrets (.env) to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RAILS CORE
# ------------------------------------------------------------------------------
# The master key used to decrypt config/credentials.yml.enc.
# Found inside config/master.key on your development machine.
RAILS_MASTER_KEY=your_rails_master_key_here

# The environment mode (production for Render deployment)
RAILS_ENV=production

# Logging detail level (info, debug, warn, error)
RAILS_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DATABASE (Neon.tech PostgreSQL)
# ------------------------------------------------------------------------------
# Full PostgreSQL connection string provided by Neon.tech dashboard
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. FILE STORAGE (Backblaze B2 - S3 Compatible, 10 GB Free)
# ------------------------------------------------------------------------------
# Tells Rails Active Storage to use the :backblaze service configured in storage.yml
ACTIVE_STORAGE_SERVICE=backblaze

# Application Key ID from Backblaze B2 (under Application Keys)
B2_KEY_ID=your_backblaze_key_id

# Application Secret Key from Backblaze B2 (shown once when created)
B2_APPLICATION_KEY=your_backblaze_application_key

# Name of your Backblaze B2 bucket
B2_BUCKET_NAME=leanhouse-storage-2026

# Backblaze S3 Endpoint (include https://)
# Example: https://s3.us-east-005.backblazeb2.com or https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# Region code extracted from the endpoint (e.g. us-east-005, us-west-004)
B2_REGION=us-east-005

# ------------------------------------------------------------------------------
# 4. SERVER & BACKGROUND JOBS OPTIMIZATION (Puma & Solid Queue)
# ------------------------------------------------------------------------------
# Set to 0 to run Puma in single-process mode (saves memory on Render's 512MB RAM free tier)
WEB_CONCURRENCY=0

# Number of concurrent threads per process
RAILS_MAX_THREADS=3

# Runs Solid Queue background workers inside the Puma web server (0 extra servers needed)
SOLID_QUEUE_IN_PUMA=true

# ------------------------------------------------------------------------------
# 5. PAYMENT INTEGRATION (payOS)
# ------------------------------------------------------------------------------
# Your public domain on Render (without https://) for generating payment return URLs
# Example: leanhouse.onrender.com
APP_HOST=leanhouse.onrender.com

# Optional: Custom payOS webhook URL if overridden
# PAYOS_WEBHOOK_URL=https://leanhouse.onrender.com/webhooks/payos
